+    # [KVC][KVS] _kvc_rel_snapshot/_kvc_kv_save: 释放前物理 KV tensor 原样归档(每步前向后调用)。
+    # v2(接替 v1 打印版): 请求结束不再逐层打印物理 cache, 而是本 worker 把该请求覆盖的
+    # 全部物理块整块(含未写槽位)cpu().clone() 后 torch.save 落盘为 .pt, 离线用
+    # scripts/inspect_kv_tensors.py 查看张量/shape/统计:
+    #   TERM=终值归档(written>=prompt+max_tokens-1, 恰在释放前) | LATE=兜底告警(不归档,
+    #   块或已被复用, 非证据级)。free() 在 EngineCore 进程而物理张量在各 worker 进程,
+    # 跨进程不可直读, 故以"最后一次写卡完成"为等价时点, 恰位于 L5 释放横幅之前。
+    # env 开关: KVC_SAVE_KV=1 启用(默认关, 零侵入); KVC_SAVE_DIR 输出目录(默认
+    # log/tensors, 相对 worker cwd=工作区根)。PP2×TP2 下 4 worker 各归档一份。
+    def _kvc_rel_snapshot(self, scheduler_output) -> None:
+        try:
+            kv_caches = getattr(self, "kv_caches", None)
+            if not kv_caches or scheduler_output is None:
+                return
+            if not getattr(self, "_kvc_kvs_armed", False):
+                self._kvc_kvs_armed = True
+                import os
+                if os.environ.get("KVC_SAVE_KV", "0") == "1":
+                    logger.info(
+                        "[KVC][KVS] 物理KV原样归档已启用: KVC_SAVE_KV=1, 输出目录=%s "
+                        "(相对 worker cwd)",
+                        os.environ.get("KVC_SAVE_DIR", "log/tensors"))
+            rt = getattr(self, "_kvc_rt", None)
+            if rt is None:
+                rt = self._kvc_rt = {}
+            # (a) 上轮结束后 finished 的请求: 清理追踪; 未捕获 TERM 仅告警不归档
+            #     (此时块已释放, 内容或已被复用覆盖, 非证据级)
+            for rid in getattr(scheduler_output, "finished_req_ids", None) or ():
+                st = rt.pop(rid, None)
+                if st is not None and not st["done"]:
+                    logger.info(
+                        "[KVC][KVS] LATE req=%s 已结束但未见 TERM(final 推算偏移?), "
+                        "不归档(块或已复用): written=%d final=%d blocks=%s",
+                        rid, st["written"], st["final"],
+                        st["blocks"][0] if st["blocks"] else [])
+            # (b) 新请求注册: 初始块表(含前缀命中块) / 已算前缀 / prompt长度 / 终值目标
+            for req in scheduler_output.scheduled_new_reqs:
+                if req.req_id not in rt:
+                    rt[req.req_id] = {
+                        "blocks": [list(g) for g in req.block_ids] if req.block_ids else [],
+                        "written": int(req.num_computed_tokens or 0),
+                        "p_tok": len(req.prompt_token_ids or []),
+                        "final": (len(req.prompt_token_ids or [])
+                                  + (req.sampling_params.max_tokens
+                                     if req.sampling_params is not None else 0) - 1),
+                        "done": False,
+                    }
+            # (c) 续算请求: 追加本步新分配的块(每个 KV 组一条增量)
+            cr = scheduler_output.scheduled_cached_reqs
+            for i, rid in enumerate(cr.req_ids):
+                st = rt.get(rid)
+                if st is None:
+                    continue
+                nb = cr.new_block_ids[i] if i < len(cr.new_block_ids) else None
+                if nb:
+                    for gi, gnew in enumerate(nb):
+                        if gnew and gi < len(st["blocks"]):
+                            st["blocks"][gi].extend(gnew)
+            # (d) 累加本步调度 token 数; written 达到终值即触发原样归档
+            # num_scheduled_tokens 双形态: 同步路径 dict[req_id->n]; 异步调度路径为
+            # 按批内槽位顺序的 list/ndarray —— 用 input_batch.req_ids(本步执行批)按位 zip 对齐
+            nst = scheduler_output.num_scheduled_tokens
+            if hasattr(nst, "items"):
+                sched_pairs = list(nst.items())
+            else:
+                ib = getattr(self, "input_batch", None)
+                n_reqs = int(getattr(ib, "num_reqs", 0) or 0)
+                rid_list = list(getattr(ib, "req_ids", []) or [])[:n_reqs]
+                if n_reqs > 0 and len(nst) >= n_reqs:
+                    sched_pairs = list(zip(rid_list, [int(x) for x in list(nst)[:n_reqs]]))
+                else:
+                    sched_pairs = []
+            for rid, ntok in sched_pairs:
+                st = rt.get(rid)
+                if st is None:
+                    continue
+                st["written"] += int(ntok)
+                if not st["done"] and st["written"] >= st["final"]:
+                    st["done"] = True
+                    self._kvc_kv_save(rid, st, "TERM")
+        except Exception as e:  # 归档追踪绝不影响服务
+            import traceback as _tb
+            logger.info("[KVC][KVS] _kvc_rel_snapshot exception: %s (%s)", e,
+                        _tb.format_exc().strip().splitlines()[-1])
+
+    def _kvc_kv_save(self, rid: str, st: dict, tag: str) -> None:
+        # [KVC][KVS] v2 核心: 请求结束物理 KV tensor 原样归档(仅 TERM)。
+        # K_layers/V_layers: [层序 list, 每层 dict{块号: 整块张量}] —— 每块形状
+        # (block_size, kv_heads, head_dim) 与 NPU 池块逐字节同构, 不 cat 不切片,
+        # 保留原始 dtype(未写槽位一并保存)。meta 记录块表/cov/有效区, 由
+        # scripts/inspect_kv_tensors.py 离线查看与统计。
+        # 落盘安全: 先同步 cpu().clone() 位级快照脱离池存储, 再后台线程 torch.save
+        # (TERM 不等 IO); 异常兜底绝不影响服务。文件名 kv_pp{p}tp{t}_s{seq}_{rid尾8}.pt
+        try:
+            import os
+            import threading
+            if os.environ.get("KVC_SAVE_KV", "0") != "1":
+                return
+            kv_caches = getattr(self, "kv_caches", None)
+            blocks = st["blocks"][0] if st["blocks"] else []
+            written = st["written"]
+            if not kv_caches or not blocks or written <= 0:
+                return
+            # kv_caches 双形态: 运行时 self.kv_caches 为 list[层序 -> (K,V) tuple]
+            # (base 类定义为 list; model_runner_v1.py 将 reshape dict 逐层 append 解包),
+            # dict 形态(层名 -> tuple)保留兼容 —— 实测教训: list 无 .items()
+            if isinstance(kv_caches, dict):
+                kv_iter = list(kv_caches.items())
+            else:
+                kv_iter = list(enumerate(kv_caches))
+            layers: list = []
+            for nm, kv in kv_iter:
+                if not isinstance(kv, (tuple, list)) or len(kv) < 2:
+                    continue
+                kt, vt = kv[0], kv[1]
+                if kt is None or vt is None or kt.dim() < 2:
+                    continue
+                layers.append((nm, kt, vt))
+            if not layers:
+                return
+            # worker 身份: PP stage + TP rank(vllm 并行组; 失败兜底 0/0)
+            try:
+                pp_rank = int(get_pp_group().rank_in_group)
+            except Exception:
+                pp_rank = 0
+            try:
+                tp_rank = int(get_tp_group().rank_in_group)
+            except Exception:
+                tp_rank = 0
+            # 本 worker 归档序号(每 worker 独立递增): seq=1 → 本 worker 第 1 个结束请求
+            _seq_map = getattr(self, "_kvc_kvs_seq", None)
+            if _seq_map is None:
+                _seq_map = self._kvc_kvs_seq = {}
+            _key = (pp_rank, tp_rank)
+            seq = int(_seq_map.get(_key, 0)) + 1
+            _seq_map[_key] = seq
+            # 块覆盖槽数: 第 e 块 cov = min(block_size, w_tok - e*block_size)
+            lb = int(layers[0][1].shape[1])
+            covs = [min(lb, max(0, written - e * lb)) for e in range(len(blocks))]
+            _kt0 = layers[0][1]
+            dev = str(_kt0.device)
+            _rid8 = rid.split("-")[-1][:8]
+            out_dir = os.environ.get("KVC_SAVE_DIR", "log/tensors")
+            os.makedirs(out_dir, exist_ok=True)
+            fname = "kv_pp{}tp{}_s{}_{}.pt".format(pp_rank, tp_rank, seq, _rid8)
+            path = os.path.join(out_dir, fname)
+            # [KVC][KVS] v2.3 横幅两行式(与 L5 "======== 分配/释放 ========" 同风格):
+            # 每 worker 每请求 1 行开始横幅(归档启动, 携带保存对象身份) + 1 行完成横幅
+            # (落盘完成)。逐层逐块打印已移除(信息由 .pt 的 meta 全量承载)。
+            logger.info(
+                "[KVC][KVS] ======== 开始保存物理tensor worker=PP%d_TP%d dev=%s "
+                "%s seq=%d req尾8=%s: K_cache/V_cache(双独立张量池, 每块 "
+                "shape=(%d,%d,%d) %s, 含未写槽位) %d 层 × %d 块 blk=%s cov=%s -> %s ========",
+                pp_rank, tp_rank, dev, tag, seq, _rid8,
+                lb, int(_kt0.shape[2]), int(_kt0.shape[3]), str(_kt0.dtype),
+                len(layers), len(blocks), [int(b) for b in blocks],
+                [int(c) for c in covs], fname,
+            )
+            # ★ 原样归档: 每层每块整块 (block_size, kv_heads, head_dim), 含未写槽位。
+            #    PP2×TP2 下本 worker 的 layers 只含本 stage 的 16 层(meta.layer_ids 记
+            #    worker 本地层序; 全局层号=pp*len(layers)+本地序, 由检查器重建), 4 worker
+            #    联合覆盖全 32 层。
+            K_layers: list = []
+            V_layers: list = []
+            for nm, kt, vt in layers:
+                kd: dict = {}
+                vd: dict = {}
+                for e, blk in enumerate(blocks):
+                    if covs[e] <= 0 or blk >= int(kt.shape[0]):
+                        continue
+                    kd[int(blk)] = kt[blk].cpu().clone()
+                    vd[int(blk)] = vt[blk].cpu().clone()
+                K_layers.append(kd)
+                V_layers.append(vd)
+            if not K_layers or not K_layers[0]:
+                return
+            meta = {
+                "schema": "kvt4-raw",
+                "pp": pp_rank, "tp": tp_rank, "seq": seq,
+                "request_id": rid, "tag": tag,
+                "p_tok": int(st.get("p_tok", -1)),
+                "w_tok": int(written),
+                "final": int(st["final"]),
+                "block_size": lb,
+                "block_table": [int(b) for b in blocks],
+                "cov": [int(c) for c in covs],
+                "layers": len(layers),
+                "layer_ids": [str(nm) for nm, _, _ in layers],
+                "kv_heads": int(_kt0.shape[2]) if _kt0.dim() >= 3 else -1,
+                "head_dim": int(_kt0.shape[3]) if _kt0.dim() >= 4 else -1,
+                "dtype": str(_kt0.dtype),
+                "dev": str(_kt0.device),
+                "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
+            }
+            bundle = {"K": K_layers, "V": V_layers, "meta": meta}
+            # cpu().clone() 已同步快照进 host; torch.save 后台线程(TERM 不等 IO);
+            # 落盘完成后一行 SAVED 回执: 告知已保存的 tensor 名/规模/耗时; 失败仅一行 FAIL
+            def _kvc_flush() -> None:
+                try:
+                    import os
+                    t0 = time.time()
+                    torch.save(bundle, path)
+                    _ms = (time.time() - t0) * 1000.0
+                    _nb = os.path.getsize(path)
+                    logger.info(
+                        "[KVC][KVS] ======== 完成保存物理tensor worker=PP%d_TP%d dev=%s "
+                        "seq=%d req尾8=%s: %s (K_cache/V_cache, %d 层 × %d 块, "
+                        "%d B = %.1f MiB) 落盘 %.1f ms ========",
+                        pp_rank, tp_rank, dev, seq, _rid8, fname,
+                        len(K_layers), len(K_layers[0]) if K_layers else 0,
+                        _nb, _nb / 1048576.0, _ms,
+                    )
+                except Exception as fe:  # 落盘失败仅记录, 不影响服务
+                    logger.info(
+                        "[KVC][KVS] ARCHIVE-FAIL worker=PP%d_TP%d dev=%s seq=%d "
+                        "req尾8=%s -> %s: %s (%s)",
+                        pp_rank, tp_rank, dev, seq, _rid8, path, fe,
+                        type(fe).__name__,
+                    )
+            threading.Thread(target=_kvc_flush, daemon=True).start()
+        except Exception as e:  # 归档绝不影响服务
+            logger.info("[KVC][KVS] %s 归档异常(忽略): %s (%s)", tag, e,
+                        type(e).__name__)
+
