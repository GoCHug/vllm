+    # [KVC][KVB] _kvc_block_dump: 11 号补丁 —— block 原样物理张量归档(pp2tp2 实验)。
+    # env: KVC_DUMP_BLOCKS=1 启用(默认关, 零侵入); 输出目录 KVC_DUMP_DIR(默认
+    # log/tensors, 相对 cwd=工作区根)。TP2 下每 rank worker 进程各自执行(TP rank
+    # 取 get_tp_group().rank_in_group), 产出 kv_{side}{rank}_{seq}_{rid尾8}.pt 多路
+    # 文件; (side,rank) 各自 seq 计数, 跨侧按 side+rank+seq 配对。
+    # 时点/安全语义同 10 号: TERM 在释放前触发, cpu().clone() 位级镜像脱离池存储,
+    # torch.save 后台落盘 TERM 不等 IO, 异常兜底绝不影响服务。
+    def _kvc_block_dump(self, tag, rid, st, layers, written, p_tok) -> None:
+        try:
+            import os
+            import threading
+            if os.environ.get("KVC_DUMP_BLOCKS", "0") != "1":
+                return
+            if tag != "TERM":  # LATE 是释放后兜底, 块内容或已被复用, 非证据级
+                return
+            ok_blocks = st["blocks"][0] if st["blocks"] else []
+            if not ok_blocks or written <= 0 or not layers:
+                return
+            # 实例角色(P/D/X): kv_transfer_config.kv_role
+            try:
+                _kv_role = str(getattr(self.vllm_config.kv_transfer_config,
+                                       "kv_role", ""))
+            except Exception:
+                _kv_role = ""
+            side = ("P" if "producer" in _kv_role
+                    else "D" if "consumer" in _kv_role else "X")
+            # TP rank: TP1 时 rank_in_group=0 退化为单路; TP2 时双 rank 各dump各的
+            try:
+                from vllm.distributed.parallel_state import get_tp_group
+                tp_rank = int(get_tp_group().rank_in_group)
+            except Exception:
+                tp_rank = 0
+            _seq_map = getattr(self, "_kvc_kvb_seq", None)
+            if _seq_map is None:
+                _seq_map = self._kvc_kvb_seq = {}
+            _key = (side, tp_rank)
+            seq = int(_seq_map.get(_key, 0)) + 1
+            _seq_map[_key] = seq
+            # 块覆盖槽数(与 09 指纹同公式): 第 e 块 cov = min(bs, w_tok - e*bs)
+            lb0 = int(layers[0][1].shape[1])
+            covs = [min(lb0, max(0, written - e * lb0))
+                    for e in range(len(ok_blocks))]
+            # ★ 原样归档核心: 每层每块 kt[blk] 整块 (bs, kv_heads, head_dim),
+            #    不 cat 不切片 —— .pt 张量与 NPU 池块逐字节同构, 含未写槽位
+            K_layers: list = []
+            V_layers: list = []
+            for nm, kt, vt in layers:
+                kd: dict = {}
+                vd: dict = {}
+                for e, blk in enumerate(ok_blocks):
+                    if covs[e] <= 0 or blk >= int(kt.shape[0]):
+                        continue
+                    kd[int(blk)] = kt[blk].cpu().clone()
+                    vd[int(blk)] = vt[blk].cpu().clone()
+                K_layers.append(kd)
+                V_layers.append(vd)
+            if not K_layers or not K_layers[0]:
+                return
+            meta = {
+                "schema": "kvt2-raw",
+                "side": side, "rank": tp_rank, "seq": seq,
+                "request_id": rid, "tag": tag,
+                "p_tok": int(p_tok), "w_tok": int(written),
+                "final": int(st["final"]),
+                "cov": [int(c) for c in covs],
+                "block_table": [int(b) for b in ok_blocks],
+                "layers": len(layers),
+                "layer_ids": [str(nm) for nm, _, _ in layers],
+                "kv_heads": int(layers[0][1].shape[2]),
+                "head_dim": int(layers[0][1].shape[3]),
+                "block_size": int(layers[0][1].shape[1]),
+                "dtype": str(layers[0][1].dtype),
+                "dev": str(layers[0][1].device),
+                "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
+            }
+            bundle = {"K": K_layers, "V": V_layers, "meta": meta}
+            out_dir = os.environ.get("KVC_DUMP_DIR", "log/tensors")
+            os.makedirs(out_dir, exist_ok=True)
+            fname = "kv_{}{}_{}_{}.pt".format(side, tp_rank, seq,
+                                              rid.split("-")[-1][:8])
+            path = os.path.join(out_dir, fname)
+            # cpu().clone() 已同步快照进 host; torch.save 后台线程, TERM 不等 IO
+            threading.Thread(target=torch.save, args=(bundle, path),
+                             daemon=True).start()
+            logger.info(
+                "[KVC][KVB] %s %s r%d s%d block原样归档(与指纹同点双证据): "
+                "layers=%d w_tok=%d p_tok=%d block_table=%s cov=%s "
+                "kv_heads=%d -> %s (后台落盘)",
+                tag, side, tp_rank, seq, len(layers), written, p_tok,
+                [int(b) for b in ok_blocks], meta["cov"],
+                meta["kv_heads"], path,
+            )
+        except Exception as e:  # 归档绝不影响服务
+            logger.info("[KVC][KVB] block 归档异常(忽略): %s (%s)", e,
+                        type(e).__name__)
+
