                <mxCell id="c_cell0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#95a3b8;fontSize=9;" value="步1｜128tok·K页128KiB" vertex="1">
