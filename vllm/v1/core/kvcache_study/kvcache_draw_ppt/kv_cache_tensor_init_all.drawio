                <mxCell id="a_full_txt" parent="1" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;" value="Full 原生页 = 2(K+V) × 2kv头 × 16tok × 256(head_dim) × 2B(bf16) = 32KiB" vertex="1">
