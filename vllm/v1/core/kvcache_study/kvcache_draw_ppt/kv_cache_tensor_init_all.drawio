                    <mxGeometry x="60" y="2016" width="240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="leg2" value="TP 镜像卡（KV 头 4–7，虚线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;dashed=1;" parent="1" vertex="1">
