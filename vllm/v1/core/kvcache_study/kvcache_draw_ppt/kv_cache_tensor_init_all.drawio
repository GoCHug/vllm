                </mxCell>
                <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" value="num_blocks = 8GiB ÷ 1,048KiB ÷ 4 = 2,001 · 每卡 4 张量&#xa;每 ID 本卡：4 层 × 1,048KiB ≈ 4.1MiB&#xa;每张量：2,001 页 × 1,048KiB ≈ 2GiB" vertex="1">
                    <mxGeometry height="72" width="660" x="60" y="2356" as="geometry"/>
                </mxCell>
                <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" value="全模型每步（4 ID）：32 层 × 2TP × 1,048KiB = 65.5MiB&#xa;全模型物理：4 卡 × 8GiB = 32GiB（教学值）&#xa;四卡同构无 shrink（PP 16+16）· 并发位 ≈ 500 步 · 空洞率 ≈ 37%" vertex="1">
                    <mxGeometry height="72" width="660" x="740" y="2356" as="geometry"/>
                </mxCell>
                <mxCell id="foot" parent="1" style="text;html=1;fontSize=11;fontColor=#888888;align=left;verticalAlign=middle;" value="附：PD 分离（AscendStoreConnector）强制 mamba_cache_mode none→align（:136-142）；prefix caching + align → mamba_block_size=block_size，否则 = max_model_len（:143-146）；refresh_block_size 对 hybrid 直接 return（utils.py:1257-1260）；三模式不改页字节（1,048KiB），只改快照份数/块表编址/前缀命中 → 第 8 页" vertex="1">
                    <mxGeometry height="56" width="1340" x="60" y="2440" as="geometry"/>
                </mxCell>
                <mxCell id="f_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=9;" value="" vertex="1">
                    <mxGeometry height="360" width="460" x="1700" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="f_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" value="⓪ 对齐账 + page_size / num_blocks" vertex="1">
                    <mxGeometry height="24" width="460" x="1700" y="146" as="geometry"/>
                </mxCell>
                <mxCell id="f_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=12;fontFamily=Courier New;verticalAlign=top;" value="【⓪ 对齐账（TP2 口径）】&lt;br&gt;K/token = 2头×256×2B = 1,024B&lt;br&gt;（K/V 分离 → 只对齐 K）&lt;br&gt;ssm = 512KiB · conv = 24KiB（隔离）&lt;br&gt;bs = 128×524288/(128×1024) = 512&lt;br&gt;assert 精确整除（:95-97）&lt;br&gt;统一页 = K512+V512+conv24&lt;br&gt;= 1,073,152B = 1,048KiB&lt;br&gt;GDN 尾垫 = 512KiB（=ssm 等量）&lt;br&gt;&lt;br&gt;【num_blocks】&lt;br&gt;= 8GiB ÷ 1,048KiB ÷ 4 = 2,001&lt;br&gt;每步 4ID 全模型 = 65.5MiB&lt;br&gt;空洞 24.4MiB/步 → 率 ≈ 37%" vertex="1">
                    <mxGeometry height="320" width="436" x="1712" y="174" as="geometry"/>
                </mxCell>
                <mxCell id="mm_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=9;" value="" vertex="1">
                    <mxGeometry height="220" width="460" x="1700" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="mm_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;" value="三个易混量（真实例口径）" vertex="1">
                    <mxGeometry height="24" width="460" x="1700" y="526" as="geometry"/>
                </mxCell>
                <mxCell id="mm_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;verticalAlign=top;" value="group_size（张量数）= max(投影后各组层数) = 4&lt;br&gt;（每卡 G0..G3 各 4 层：1Full+3GDN 共享）&lt;br&gt;num_groups（manager 数）= 4（全局定）&lt;br&gt;　→ 每请求每步消耗 4 个 block ID&lt;br&gt;page_size（统一页）= 1,048KiB（bs=512）&lt;br&gt;&lt;br&gt;两处口径：&lt;br&gt;:1224 合并后全局算 → 每组 8 层&lt;br&gt;:1399 投影本 worker 算 → 4 张量" vertex="1">
                    <mxGeometry height="180" width="436" x="1712" y="554" as="geometry"/>
                </mxCell>
                <mxCell id="code_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=9;" value="" vertex="1">
                    <mxGeometry height="380" width="460" x="1700" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="code_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#33691e;" value="源码调用链" vertex="1">
                    <mxGeometry height="24" width="460" x="1700" y="766" as="geometry"/>
                </mxCell>
                <mxCell id="code_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=12;fontFamily=Courier New;verticalAlign=top;" value="NPU 对齐链：&lt;br&gt;patch_mamba_config.py（post-init）&lt;br&gt; ├ 读参 :65-92&lt;br&gt; ├ 推导 :94 → assert :95-97&lt;br&gt; ├ 只增不减 :102-103&lt;br&gt; ├ 垫页 :110-117&lt;br&gt; └ PD :136-142 / 前缀 :143-146&lt;br&gt;refresh_block_size hybrid return&lt;br&gt; utils.py:1257-1260&lt;br&gt;get_kv_cache_configs() :2073&lt;br&gt; ├ groups hybrid：&lt;br&gt; │　 unify :1070（⓪后 no-op）&lt;br&gt; │　 stride=4 切组 :1140&lt;br&gt; ├ 投影 :2031 → nb/显存校验&lt;br&gt; ├ :1399-1416 → min :2192&lt;br&gt; └ worker 落显存 :7286" vertex="1">
                    <mxGeometry height="340" width="436" x="1712" y="794" as="geometry"/>
                </mxCell>
                <mxCell id="bind_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=9;" value="" vertex="1">
                    <mxGeometry height="230" width="460" x="1700" y="1160" as="geometry"/>
                </mxCell>
                <mxCell id="bind_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" value="①~④ 与 ⑤ 的衔接" vertex="1">
                    <mxGeometry height="24" width="460" x="1700" y="1166" as="geometry"/>
                </mxCell>
                <mxCell id="bind_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;verticalAlign=top;" value="· ⓪ 对齐先于一切：NPU config post-init&lt;br&gt;　（GPU 在 executor 模型加载后）&lt;br&gt;· ①② 每卡 profile 后收集；合并分组在控制器&lt;br&gt;· 投影只算物理账，不回流调度器&lt;br&gt;· ④ 4 张量/卡 bind 到 16 层（4 层共享 1 张量）&lt;br&gt;· ⑤ 运行期只动 block_id（零显存拷贝）&lt;br&gt;· 4 组 = 4 manager = 每步 4 ID&lt;br&gt;· 同一 ID 在本卡 4 张量各写 1 页" vertex="1">
                    <mxGeometry height="190" width="436" x="1712" y="1194" as="geometry"/>
                </mxCell>
                <mxCell id="leg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="Full 层（G0，i%4=3）" vertex="1">
                    <mxGeometry height="20" width="150" x="60" y="2508" as="geometry"/>
