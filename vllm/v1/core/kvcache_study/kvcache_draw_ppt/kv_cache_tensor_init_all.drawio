                <mxCell id="mm_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;verticalAlign=top;" value="group_size（张量数）= max(投影后各组层数) = 4&lt;br&gt;（每卡 G0..G3 各 4 层：1Full+3GDN 共享）&lt;br&gt;num_groups（manager 数）= 4（全局定）&lt;br&gt;　→ 每请求每步消耗 4 个 block ID&lt;br&gt;page_size（统一页）= 544KiB（bs=272）&lt;br&gt;&lt;br&gt;两处口径：&lt;br&gt;:1224 合并后全局算 → 每组 8 层&lt;br&gt;:1399 投影本 worker 算 → 4 张量" vertex="1">
                    <mxGeometry height="180" width="436" x="1712" y="554" as="geometry"/>
                </mxCell>
                <mxCell id="code_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=9;" value="" vertex="1">
