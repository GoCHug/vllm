                <mxCell id="c_cell3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=9;strokeWidth=1.5" value="第 4 步｜128tok·K页128KiB" vertex="1">
