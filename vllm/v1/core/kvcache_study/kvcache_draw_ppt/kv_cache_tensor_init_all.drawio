                </mxCell>
                <mxCell id="c_bar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="ssm 524,288B = 512KiB（与 4 格 K 页精确等长 → assert 通过；无余数）" vertex="1">
                    <mxGeometry height="22" width="1052" x="236" y="376" as="geometry"/>
                </mxCell>
                <mxCell id="c_res" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;align=center;verticalAlign=middle;" value="524,288 ÷ (128 × 1,024) = 4（精确整除）→ block_size = 128 × 4 = 512 ✓；不整除则 assert 报错拒绝启动（:95-97，页不会悄悄变大）；只增不减（:102-103）；步进是基数不是结果" vertex="1">
                    <mxGeometry height="48" width="1340" x="60" y="404" as="geometry"/>
