                <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="GDN 混合张量布局：Qwen3.5 · PP2×TP2（Ascend NPU）—— ⓪ 页对齐（32KiB / 536KiB → 1,048KiB，bs=512）＋ 从多 Worker 到单 Worker 的 KV Cache 张量建设（源码流程）" vertex="1">
                    <mxGeometry height="32" width="2000" x="100" y="10" as="geometry" />
                </mxCell>
                <mxCell id="params" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#555555;" value="真实例设定：Qwen3.5 GDN 混合，num_hidden_layers=32 = 8 FullAttention + 24 GDN（Mamba），层序 (3 GDN + 1 Full)×8，bf16&lt;br&gt;部署 PP2×TP2：每卡 16 层（PP 均分 16+16）· TP 切头：Full KV 头 4→2（head_dim=256）｜ GDN ssm v 头 32→16（k_dim=v_dim=128）｜ conv 通道 64→32（conv 窗 3）&lt;br&gt;⓪ 前置页对齐（本页新增）：K/V 分离只对齐 K，conv 隔离垫 → 统一页 1,048KiB（bs=512，assert 精确整除）· 每卡可用显存 8GiB（教学值）｜ get_kv_cache_configs() :2073" vertex="1">
                    <mxGeometry height="54" width="2080" x="60" y="48" as="geometry" />
                </mxCell>
                <mxCell id="a0_lab" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" value="⓪ 前置流程：hybrid page size 对齐 —— patch_mamba_config.py（VllmConfig post-init）：K 页精确铺满 ssm + conv 隔离垫，Full 32KiB / GDN 536KiB → 统一页 1,048KiB" vertex="1">
                    <mxGeometry height="22" width="1340" x="60" y="114" as="geometry" />
                </mxCell>
                <mxCell id="a_full_lab" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=9;align=center;verticalAlign=middle;" value="FullAttentionSpec&lt;br&gt;（2 KV 头·head_dim 256）&lt;br&gt;初始 block_size=16" vertex="1">
                    <mxGeometry height="30" width="166" x="60" y="142" as="geometry" />
                </mxCell>
                <mxCell id="a_full_bar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=8;" value="" vertex="1">
                    <mxGeometry height="30" width="60" x="236" y="142" as="geometry" />
                </mxCell>
                <mxCell id="a_full_txt" parent="1" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;" value="Full 原生页 = 2(K+V) × 2kv头 × 16tok × 256(head_dim) × 2B(bf16) = 32KiB" vertex="1">
                    <mxGeometry height="30" width="1090" x="310" y="142" as="geometry" />
                </mxCell>
                <mxCell id="a_gdn_lab" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=9;align=center;verticalAlign=middle;" value="MambaSpec（GDN）&lt;br&gt;页 = state 固定字节&lt;br&gt;（16 ssm v 头）" vertex="1">
                    <mxGeometry height="30" width="166" x="60" y="178" as="geometry" />
                </mxCell>
                <mxCell id="a_ssm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="ssm 512KiB" vertex="1">
                    <mxGeometry height="30" width="955" x="236" y="178" as="geometry" />
                </mxCell>
                <mxCell id="a_conv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=7;" value="conv 24KiB" vertex="1">
                    <mxGeometry height="30" width="45" x="1191" y="178" as="geometry" />
                </mxCell>
                <mxCell id="a_gdn_txt" parent="1" style="text;html=1;fontSize=10;fontColor=#c62828;align=left;verticalAlign=middle;" value="GDN 原生页 = ssm：16(v头)×128(k_dim)×128(v_dim)×2B = 512KiB ＋ conv：(2×8k头+16v头)×128×3×2B = 24KiB → 共 536KiB（不随 block_size 变）= 16.75 × Full 页 → 页不等，必须先对齐" vertex="1">
                    <mxGeometry height="14" width="1340" x="60" y="212" as="geometry" />
                </mxCell>
                <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" value="ssm = 524,288B（512KiB）&lt;br&gt;对齐目标：让 K 页精确铺满它&lt;br&gt;（patch_mamba_config.py:65-92）" vertex="1">
                    <mxGeometry height="60" width="320" x="60" y="234" as="geometry" />
                </mxCell>
                <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" value="conv = 24,576B（24KiB）&lt;br&gt;不进 ssm 对齐&lt;br&gt;→ 隔离块独立垫（:110-117）" vertex="1">
                    <mxGeometry height="60" width="320" x="400" y="234" as="geometry" />
