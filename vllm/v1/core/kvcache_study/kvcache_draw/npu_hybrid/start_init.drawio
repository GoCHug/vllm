<diagram id="p5_gdn_ascend" name="7-GDN混合·Qwen3.5@Ascend">
        <mxGraphModel dx="3019" dy="2552" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2550" math="0" shadow="0">
            <root>
                <mxCell id="0" />
