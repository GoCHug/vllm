                <mxCell id="c_cell0" value="步1-2｜256tok·K页256KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#95a3b8;fontSize=9;" parent="1" vertex="1">
