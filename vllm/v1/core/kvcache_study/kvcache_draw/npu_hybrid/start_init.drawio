    <diagram id="p5e_step4" name="7-5 ④ 落张量（每卡 4 张量 · 6,003 × 2,072KB）">
        <mxGraphModel dx="1698" dy="1409" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="658" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title_4" value="GDN 混合张量布局：Qwen3.5 · PP2×TP2（Ascend NPU）—— ④ 建张量：每卡 4 张量、每张量 6,003 页 × 2,072KB（4 层共享）" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="10" width="2000" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="params_4" value="真实例设定：Qwen3.5 GDN 混合，num_hidden_layers=32 = 8 FullAttention + 24 GDN（Mamba），层序 (3 GDN + 1 Full)×8，bf16&lt;br&gt;部署 PP2×TP2：每卡 16 层（PP 均分 16+16）· TP 切头：Full KV 头 4→2（head_dim=256）｜ GDN ssm v 头 32→16（k_dim=v_dim=128）｜ conv 通道 64→32（conv 窗 3）&lt;br&gt;⓪ 前置页对齐：K/V 分离只对齐 K，conv 隔离垫 → 统一页 2,072KB（bs=1024，assert 精确整除）· 每卡可用显存 51.90 GiB（实测）｜ get_kv_cache_configs() :2073" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="60" y="48" width="2080" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="s4_label" value="④ 建张量（每 worker 独立执行 :1399-1416）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="60" y="130" width="1340" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s4_desc" value="张量数 = max(本卡各组层数) = 4（:1399）· 第 j 张量 shared_by = [G0第j层, G1第j层, G2第j层, G3第j层] = 1 Full+3 GDN 共 4 层共享（:1413）· pop 的每个 block id 在全部 4 个张量上各写一页" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" parent="1" vertex="1">
                    <mxGeometry x="60" y="156" width="1340" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="steps_box" value="④ 每卡执行步骤（:1399-1416）&lt;br&gt;（每卡只跑一遍，四卡同构）&lt;br&gt;&lt;br&gt;1. 输入 = 投影后的 4 组（各 4 层）&lt;br&gt;　　组数/顺序/gid 全局一致&lt;br&gt;&lt;br&gt;2. 张量数 = max(各组层数) = 4（:1399）&lt;br&gt;&lt;br&gt;3. 第 j 张量 shared_by（:1413）=&lt;br&gt;　　[G0第j层, G1第j层, G2第j层, G3第j层]&lt;br&gt;　　= 1 Full + 3 GDN 共 4 层共享&lt;br&gt;　　W0 张量0 = [F3, G0, G1, G2]&lt;br&gt;　　W2 张量0 = [F19, G16, G17, G18]&lt;br&gt;&lt;br&gt;4. num_blocks（:993）&lt;br&gt;　　= 51.90GiB ÷ 2,072KB ÷ 4 ≈ 6,003（实测）&lt;br&gt;　　四卡相同 → min 对齐无 shrink&lt;br&gt;&lt;br&gt;5. pop 的每个 ID 在 4 张量各写 1 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;" parent="1" vertex="1">
