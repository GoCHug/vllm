                <mxCell id="f_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="270" width="460" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="f_title" value="⓪ 对齐账 + page_size / num_blocks" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="276" width="460" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="f_content" value="【⓪ 对齐账（TP2 口径）】&lt;br&gt;K/token = 2头×256×2B = 1,024B&lt;br&gt;（K/V 分离 → 只对齐 K）&lt;br&gt;ssm = 1,024KB（fp32）· conv = 24KB（隔离）&lt;br&gt;bs = 128×1048576/(128×1024) = 1,024&lt;br&gt;assert 精确整除（:95-97）&lt;br&gt;统一页 = K1024+V1024+conv24&lt;br&gt;= 2,121,728B = 2,072KB&lt;br&gt;GDN 尾垫 = 1,024KB（=ssm 等量）&lt;br&gt;&lt;br&gt;【num_blocks】&lt;br&gt;= 51.90GiB ÷ 2,072KB ÷ 4 ≈ 6,003&lt;br&gt;每步 4ID 全模型 = 129.5MiB&lt;br&gt;空洞 48.4MiB/步 → 率 ≈ 37%" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=12;fontFamily=Courier New;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1712" y="304" width="436" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="mm_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="650" width="460" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="mm_title" value="三个易混量（真实例口径）" style="text;html=1;fontSize=14;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="656" width="460" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="mm_content" value="group_size（张量数）= max(投影后各组层数) = 4&lt;br&gt;（每卡 G0..G3 各 4 层：1Full+3GDN 共享）&lt;br&gt;num_groups（manager 数）= 4（全局定）&lt;br&gt;　→ 每请求每步消耗 4 个 block ID&lt;br&gt;page_size（统一页）= 2,072KB（bs=1024）&lt;br&gt;&lt;br&gt;两处口径：&lt;br&gt;:1224 合并后全局算 → 每组 8 层&lt;br&gt;:1399 投影本 worker 算 → 4 张量" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1712" y="684" width="436" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
