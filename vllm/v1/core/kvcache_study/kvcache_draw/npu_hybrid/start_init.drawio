                <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" value="Full K 页 = 1,024B/token&lt;br&gt;= 2kv头 × 256 × 2B&lt;br&gt;K/V 分离布局 → 只对齐 K" vertex="1">
                    <mxGeometry height="60" width="320" x="740" y="234" as="geometry" />
