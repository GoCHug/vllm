                <mxCell id="a_full_txt" value="Full 原生页 = 2(K+V) × 2kv头 × 1024tok × 256(head_dim) × 2B(bf16) = 2,048KB" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;" parent="1" vertex="1">
