                <mxCell id="c_cell2" value="步5-6｜256tok·K页256KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#95a3b8;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="764" y="464" width="260" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c_cell3" value="第 7-8 步｜256tok·K页256KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=9;strokeWidth=1.5" parent="1" vertex="1">
                    <mxGeometry x="1028" y="464" width="260" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c_bar" value="ssm 1,048,576B = 1,024KB（与 4 格 × 256KB 的 K 页精确等长 → assert 通过；无余数）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="236" y="506" width="1052" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_res" value="1,048,576 ÷ (128 × 1,024) = 8（精确整除）→ block_size = 128 × 8 = 1,024 ✓；不整除则 assert 报错拒绝启动（:95-97，页不会悄悄变大）；只增不减（:102-103）；步进是基数不是结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="534" width="1340" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="d_lab" value="⓪-4 统一页落定：两族页全等 2,072KB（mamba_page_size_padded = attn 页，:914-934 / patch :110-117），此后 unify 验收 no-op" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="60" y="594" width="1340" height="22" as="geometry"/>
