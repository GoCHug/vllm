    <diagram id="p6_mamode" name="8-GDN·mamba_cache_mode三模式">
        <mxGraphModel dx="3056" dy="2536" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1010" math="0" shadow="0">
