                <mxCell id="d_gdn_lab" value="GDN 页&lt;br&gt;页 = state 固定字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="658" width="166" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d_g0" value="ssm 1,024KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="236" y="658" width="561" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d_g1" value="conv 24KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="797" y="658" width="26" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d_g2" value="垫 1,024KB（=ssm 等量）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="823" y="658" width="561" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d_note" value="空洞账单（随每个 block 线性重复）：每步 4 个 block ID → 24 GDN 页×2TP×1,024KB + 8 Full 页×2TP×24KB = 49,536KB ≈ 48.4MiB；全模型每步 = 32层×2TP×2,072KB = 132,608KB ≈ 129.5MiB → &lt;b&gt;空洞率 ≈ 37%（attn 1.16% · mamba 49.4%）&lt;/b&gt;。根因：GDN 没有 V，却要为统一页里 V 等量的空间买单；assert 把 bs 锁死 1,024（:95-97），约束内无法取更小块消空洞。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="694" width="1340" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_m0" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_m1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1">
