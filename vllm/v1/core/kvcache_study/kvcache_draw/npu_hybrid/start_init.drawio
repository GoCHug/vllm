                <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=10;align=center;verticalAlign=middle;" value="kernel 步进 = 128（NPU 限制）&lt;br&gt;bs = 128 × ssm ÷ (128×K/token)&lt;br&gt;assert 精确整除（:95-97）" vertex="1">
