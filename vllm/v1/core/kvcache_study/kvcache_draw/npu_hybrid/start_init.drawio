                <mxCell id="d_full_lab" value="Full 页&lt;br&gt;block_size=1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
