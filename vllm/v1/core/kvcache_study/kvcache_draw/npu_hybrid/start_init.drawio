                    <mxGeometry x="1191" y="308" width="45" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="a_gdn_txt" value="GDN 原生页 = ssm：16(v头)×128(k_dim)×128(v_dim)×4B(fp32) = 1,024KB ＋ conv：(2×8k头+16v头)×128×3×2B = 24KB → 共 1,048KB（不随 block_size 变）≈ 0.51 × Full 页 → 页不等，必须先对齐" style="text;html=1;fontSize=10;fontColor=#c62828;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="342" width="1340" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="ssm = 1,048,576B（1,024KB·fp32）&lt;br&gt;对齐目标：让 K 页精确铺满它&lt;br&gt;（patch_mamba_config.py:65-92）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="364" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="conv = 24,576B（24KB）&lt;br&gt;不进 ssm 对齐&lt;br&gt;→ 隔离块独立垫（:110-117）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="400" y="364" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="Full K 页 = 1,024B/token&lt;br&gt;= 2kv头 × 256 × 2B&lt;br&gt;K/V 分离布局 → 只对齐 K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="740" y="364" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="kernel 步进 = 128（NPU 限制）&lt;br&gt;bs = 128 × ssm ÷ (128×K/token)&lt;br&gt;assert 精确整除（:95-97）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="364" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c_lab" value="步进推导 block_size（:94；只增不减 :102-103）：K 页按 128tok 步进生长（每步 +128KB），8 步精确铺满 ssm 1,024KB —— 不整除则 assert 拒绝启动（:95-97）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="60" y="436" width="1340" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_lf" value="K 页按 128tok 步进&lt;br&gt;（每步 +1,024B×128 = 128KB）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7b1fa2;fontSize=9;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="464" width="166" height="36" as="geometry"/>
