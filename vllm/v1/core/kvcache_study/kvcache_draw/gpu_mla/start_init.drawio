                <mxCell id="req" value="一次调度：请求 R 4,096 tok → ⌈4096/64⌉ = 64 块（4096=64×64，本请求无尾块；一般尾块浪费上限 63 token）｜ Manager 0 popleft ×64 → [1..64] → NewRequestData(block_ids) ── collective_rpc ──▶ 4 卡同号落写（请求全模型物理 ≈ 61×2×4096×1,152B ≈ 549MiB，与块大小无关）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1888" width="1340" height="56" as="geometry" />
                </mxCell>
                <mxCell id="a1" value="num_blocks = min(3,758, 3,883) = 3,758&#xA;每 ID 本卡：31/30 × 72KiB ≈ 2.2/2.1MiB&#xA;每张量：3,758 页 × 72KiB ≈ 264MiB（W2/W3 shrink 125 块）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1958" width="660" height="72" as="geometry" />
                </mxCell>
                <mxCell id="a2" value="全模型每 ID：61 层 × 2TP × 72KiB ≈ 8.58MiB&#xA;全模型物理：4 卡 × 8GiB = 32GiB ✓&#xA;PP 段不均（31+30）由 min 对齐吸收 · 无 padding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="740" y="1958" width="660" height="72" as="geometry" />
                </mxCell>
                <mxCell id="foot" value="附：block_size=64 为 DeepSeek-V3 serving 惯例（通用默认 16；storage_block_size 表达 MLA 压缩 :395）· MLA 每 token 只存 1 份 576 维 latent（512 c_KV + 64 rope，128 个 Q 头共享读出，存 1 读 128，约为 MHA 的 1/71）· NPU 对照（bs=128 → 页 144KiB / nb=1,879 / 每 ID 17.16MiB）→ 第 5 页" style="text;html=1;fontSize=11;fontColor=#888888;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="2042" width="1340" height="40" as="geometry" />
                </mxCell>
                <mxCell id="f_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="140" width="460" height="230" as="geometry" />
                </mxCell>
                <mxCell id="f_title" value="page_size / num_blocks 公式（MLA 源码口径）" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="146" width="460" height="24" as="geometry" />
                </mxCell>
                <mxCell id="f_content" value="MLA（压缩 KV，不分 K/V）：&lt;br&gt; page = bs × (kv_lora 512 + rope 64)&lt;br&gt;　　　　　× 1 头 × dtype_size&lt;br&gt;= 64 × 576 × 2B = 73,728B = 72KiB&lt;br&gt;（KV 头=1：TP 不切，latent 复制）&lt;br&gt;&lt;br&gt;num_blocks = 8GiB ÷ 72KiB ÷ 本卡层数&lt;br&gt;　31 层卡 ≈ 3,758；30 层卡 ≈ 3,883&lt;br&gt;→ min 对齐 :2192 = 3,758（−125）&lt;br&gt;&lt;br&gt;每块全模型 = 61 层 × 2TP × 72KiB&lt;br&gt;≈ 8.58MiB" style="text;html=1;fontSize=12;fontColor=#333333;align=left;spacingLeft=12;fontFamily=Courier New;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="1712" y="174" width="436" height="190" as="geometry" />
                </mxCell>
                <mxCell id="mm_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="444" width="460" height="210" as="geometry" />
                </mxCell>
                <mxCell id="mm_title" value="三个易混量（真实例口径）" style="text;html=1;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="450" width="460" height="24" as="geometry" />
                </mxCell>
                <mxCell id="mm_content" value="group_size（张量数）= max(本卡各组层数)&lt;br&gt;　W0/W1 = 31；W2/W3 = 30（PP 不均）&lt;br&gt;num_groups（manager 数）= 1（全局定）&lt;br&gt;　→ 每请求每步消耗 1 个 block ID&lt;br&gt;page_size = 72KiB（bs=64，MLA 576 维）&lt;br&gt;&lt;br&gt;两处 group_size 口径：&lt;br&gt;:1224 全局 1 组含 61 层&lt;br&gt;:1399 投影后 31/30 → 31/30 张量" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="1712" y="478" width="436" height="170" as="geometry" />
                </mxCell>
                <mxCell id="code_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="760" width="460" height="330" as="geometry" />
                </mxCell>
                <mxCell id="code_title" value="源码调用链" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#33691e;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="766" width="460" height="24" as="geometry" />
                </mxCell>
                <mxCell id="code_content" value="get_kv_cache_configs() :2073&lt;br&gt; ├─ 合并 specs（同层断言相等）&lt;br&gt; ├─ get_kv_cache_groups() :1760&lt;br&gt; │　 ├ uniform → 单 group :1022&lt;br&gt; │　 └ hybrid → unify page :1070&lt;br&gt; │　　　└ 切组（stride+padding）:1140&lt;br&gt; ├─ 投影 _project_to_worker() :2031&lt;br&gt; │　 └ 每卡 num_blocks / 显存校验&lt;br&gt; ├─ config_from_groups() :1340&lt;br&gt; │　 ├ 按列切张量 + shared_by&lt;br&gt; │　 └ min 对齐 shrink :2192&lt;br&gt; └─ worker 落显存 :7286&lt;br&gt; 　　int8 池 → view/permute → bind&lt;br&gt;&lt;br&gt;本模型走 uniform 分支：61 层全等&lt;br&gt;→ 1 group / 1 manager / 31·30 张量每卡&lt;br&gt;（PP 31+30：30 层卡少建 1 张量）" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=12;fontFamily=Courier New;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="1712" y="794" width="436" height="290" as="geometry" />
                </mxCell>
                <mxCell id="bind_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=9;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="1170" width="460" height="210" as="geometry" />
                </mxCell>
                <mxCell id="bind_title" value="①~④ 与 ⑤ 的衔接" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" vertex="1" parent="1">
                    <mxGeometry x="1700" y="1176" width="460" height="24" as="geometry" />
                </mxCell>
                <mxCell id="bind_content" value="· ①② 每卡 profile 后收集；③ 合并分组在控制器&lt;br&gt;· 投影结果只算物理账，不回流调度器&lt;br&gt;· ④ 建出的 31/30 张量/卡 bind 到各 MLA 层&lt;br&gt;· ⑤ 运行期调度器只动 block_id（零显存拷贝）&lt;br&gt;· 4 卡物理张量按同一张全局块表对号入座&lt;br&gt;· 单组：每请求每步只取 1 个 block ID" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="1712" y="1204" width="436" height="170" as="geometry" />
                </mxCell>
                <mxCell id="leg1" value="MLA 层（61 层 spec 全等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="60" y="2102" width="240" height="20" as="geometry" />
                </mxCell>
                <mxCell id="leg2" value="TP 镜像卡（latent 576 维复制，虚线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="320" y="2102" width="260" height="20" as="geometry" />
                </mxCell>
                <mxCell id="leg3" value="未高亮 block 槽位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="600" y="2102" width="150" height="20" as="geometry" />
                </mxCell>
                <mxCell id="leg4" value="本批连续块 1..64（五色示意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="770" y="2102" width="230" height="20" as="geometry" />
                </mxCell>
                <mxCell id="leg6" value="真实 config 口径：MLA latent TP 不切（KV头=1，576=512 c_KV+64 rope，bf16）；可用显存为每卡教学值 8GiB；单组 → 每请求每步 1 个 block ID；61=31+30 PP 不均 → min 对齐 3,758（W2/W3 shrink 125 块）" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="2102" width="1140" height="20" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram></mxfile>