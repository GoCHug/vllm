<mxfile host="65bd71144e" pages="4">
    <diagram id="p1_why" name="1-为什么需要">
        <mxGraphModel dx="1433" dy="1278" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g1_0"/>
                <mxCell id="g1_1" parent="g1_0"/>
                <mxCell id="g1_title" value="1. 为什么需要 KV Cache 管理" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g1_badge" value="图表类型 · 系统示意图" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="1020" y="26" width="220" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="g1_sub" value="Full Attention 主线（Llama-3-8B · pp2tp2）｜ 用显存换计算：把每步 O(n²) 的重复计算降为 O(n)" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="62" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g1_prob" value="&lt;b&gt;问题&lt;/b&gt;　自回归推理：每生成一个 token 都依赖之前所有 token 的 K/V；不缓存则每步重算全部历史，注意力计算量随序列长度呈 &lt;b&gt;O(n²)&lt;/b&gt; 增长" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=16;spacingRight=12;fontSize=13;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="100" width="590" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="g1_sol" value="&lt;b&gt;办法&lt;/b&gt;　把算好的 K/V 缓存起来，每步只算新 token → 注意力降为 &lt;b&gt;O(n)&lt;/b&gt;；代价：KV 状态随并发与序列长度增长，占用大量 GPU 显存，必须精细管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=16;spacingRight=12;fontSize=13;" parent="g1_1" vertex="1">
                    <mxGeometry x="650" y="100" width="590" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="g1_v1t" value="无缓存：第 n 步要重算 t1…tn 的全部 K/V → O(n²)" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#b85450;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="196" width="590" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="g1_t1" value="t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="185" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_t2" value="t2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="237" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_t3" value="t3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="289" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_t4" value="t4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="341" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_t5" value="t5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="393" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_t6" value="t6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="g1_1" vertex="1">
                    <mxGeometry x="445" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_ra" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeColor=#b85450;strokeWidth=2;" parent="g1_1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="205" y="264" as="sourcePoint"/>
                        <mxPoint x="465" y="264" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="g1_rl" value="每步重算全部历史 K/V" style="text;html=1;fontSize=10;align=center;fontColor=#b85450;" parent="g1_1" vertex="1">
                    <mxGeometry x="185" y="272" width="300" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="g1_v2t" value="有 KV Cache：历史 K/V 命中缓存，每步只算新 token → O(n)" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#82b366;" parent="g1_1" vertex="1">
                    <mxGeometry x="650" y="196" width="590" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="g1_u1" value="t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="795" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_u2" value="t2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="847" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_u3" value="t3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="899" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_u4" value="t4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="g1_1" vertex="1">
                    <mxGeometry x="951" y="224" width="40" height="30" as="geometry"/>
