                <mxCell id="g1_kc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="g1_1" vertex="1">
                    <mxGeometry x="795" y="262" width="248" height="8" as="geometry"/>
                </mxCell>
                <mxCell id="g1_kl" value="KV Cache（已缓存 t1…t5）" style="text;html=1;fontSize=10;align=center;fontColor=#82b366;" parent="g1_1" vertex="1">
                    <mxGeometry x="795" y="272" width="248" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="g1_a1" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;① PagedAttention 分页管理&lt;/b&gt;&lt;/font&gt;&#10;&#10;连续 KV 序列切成固定大小的 block（如每块 16 token）&#10;&#10;按块分配 / 回收 / 共享&#10;&#10;彻底解决内存碎片问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fontSize=12;align=left;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="312" width="386" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="g1_a2" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;② 逻辑管理与物理存储分离&lt;/b&gt;&lt;/font&gt;&#10;&#10;BlockPool 只管逻辑块（KVCacheBlock：block_id ＋ 元数据）&#10;&#10;物理显存由 GPUModelRunner 一次性申请并 reshape&#10;&#10;两者通过 block_id 关联，调度决策全程零显存拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fontSize=12;align=left;" parent="g1_1" vertex="1">
                    <mxGeometry x="447" y="312" width="386" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="g1_a3" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;③ 前缀缓存 ＋ 引用计数共享&lt;/b&gt;&lt;/font&gt;&#10;&#10;相同前缀的 block 通过链式哈希定位&#10;&#10;多请求共享同一块物理空间，ref_cnt 跟踪生命周期&#10;&#10;LRU 空闲队列决定驱逐顺序：有哈希的缓存块尽量保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fontSize=12;align=left;" parent="g1_1" vertex="1">
                    <mxGeometry x="854" y="312" width="386" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="g1_key" value="核心：调度器全程只搬运 block_id（整数）；物理张量启动时一次成型，运行期所有分配 / 共享 / 驱逐只改引用计数与哈希表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="508" width="1200" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="g1_nav" value="后文路线：§2 五层架构静态总览 → §3 启动时五层如何装配 → §4 一条请求的动态生命周期" style="text;html=1;fontSize=12;align=center;fontColor=#888888;fontStyle=2;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="590" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g1_leg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" parent="g1_1" vertex="1">
                    <mxGeometry x="40" y="640" width="1200" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="g1_lgt" value="图例" style="text;html=1;fontSize=12;fontStyle=1;align=left;" parent="g1_1" vertex="1">
                    <mxGeometry x="56" y="652" width="44" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g1_c1" value="问题" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="108" y="652" width="70" height="24" as="geometry"/>
