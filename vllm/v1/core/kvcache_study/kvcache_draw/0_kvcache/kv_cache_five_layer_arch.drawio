                    <mxGeometry x="506" y="652" width="70" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p2_arch" name="2-五层架构总览">
        <mxGraphModel dx="860" dy="767" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g2_0"/>
                <mxCell id="g2_1" parent="g2_0"/>
                <mxCell id="g2_title" value="vLLM V1 KV Cache 管理五层架构总览（Full Attention 视角）" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="40" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g2_sch" value="&lt;b&gt;Scheduler（调度器 · 调用者）&lt;/b&gt;　只通过第 5 层门面统一调用，不直接触碰 KV cache 内部结构" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="96" width="680" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L5" value="&lt;b&gt;第 5 层 · 顶层门面　KVCacheManager&lt;/b&gt;　持有 1 个第 4 层；对 Scheduler 暴露统一 API（get_computed_blocks / allocate_slots / free 等）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="188" width="680" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L4" value="&lt;b&gt;第 4 层 · 协调器　UnitaryKVCacheCoordinator（主线）&lt;/b&gt;　持有 N 个第 3 层＋ 1 个第 2 层；按group分发给第3层各manager" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="280" width="680" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L3" value="&lt;b&gt;第 3 层 ×N · 单类型管理　FullAttentionManager（主线 N=1）&lt;/b&gt;　前缀查找（链式哈希）/ 分配释放 / block_table 维护" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="372" width="680" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L2" value="&lt;b&gt;第 2 层 ×1 · 逻辑块池　BlockPool（唯一，所有第 3 层共享）&lt;/b&gt;　逻辑块分配 / 释放 / 缓存哈希 / LRU 驱逐（仅 block_id，无显存）&#10;内件：FreeKVCacheBlockQueue（LRU 空闲块队列）＋ BlockHashToBlockMap（链式哈希 → block 映射）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="464" width="680" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="g2_bnote" value="&lt;span style=&quot;font-style: normal;&quot;&gt;桥接（非持有）：L2 在引擎进程、L1 在 worker 进程，无对象引用&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;同一份 KVCacheConfig 定两侧容量，block_id 从 0 编号即物理张量行号&lt;/span&gt;&lt;/div&gt;" style="text;html=1;fontSize=10;align=left;spacingLeft=110;fontColor=#9673a6;fontStyle=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="530" width="680" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L1" value="&lt;b&gt;第 1 层 · 物理显存　GPUModelRunner.kv_caches[layer]（worker 进程）&lt;/b&gt;&lt;br&gt;torch [num_blocks, num_kv_heads, block_size, 2·head_dim]；block_id 直接索引第 0 维（物理行号）；K/V 读写由 attention 算子完成" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="576" width="680" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e1" value="调用" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_sch" target="g2_L5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e2" value="持有 1 个" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_L5" target="g2_L4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e3" value="持有 ×N（主线 N=1）" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_L4" target="g2_L3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e4" value="引用同一个 BlockPool" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_L3" target="g2_L2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;exitX=0.13;exitY=1;exitDx=0;exitDy=0;entryX=0.13;entryY=0;entryDx=0;entryDy=0;" parent="g2_1" source="g2_L2" target="g2_L1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_fmap" value="&lt;b&gt;关键文件地图（vllm/v1/）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;&lt;b&gt;L5&lt;/b&gt;&lt;/font&gt; core/kv_cache_manager.py——KVCacheBlocks、KVCacheManager&lt;div&gt;&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;&lt;b&gt;L4&lt;/b&gt;&lt;/font&gt; core/kv_cache_coordinator.py——&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;KVCacheCoordinator、UnitaryKVCacheCoordinator&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;L3&lt;/b&gt;&lt;/font&gt; core/single_type_kv_cache_manager.py——&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SingleTypeKVCacheManager、FullAttentionManager&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;L2&lt;/b&gt;&lt;/font&gt; core/block_pool.py——&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;BlockHashToBlockMap、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;BlockPool&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;L2&lt;/b&gt;&lt;/font&gt; core/kv_cache_utils.py——&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;BlockHash、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;KVCacheBlock、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;FreeKVCacheBlockQueue&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;L1&lt;/b&gt;&lt;/font&gt; worker/gpu_model_runner.py——申请 int8 Tensor → reshape 并 bind 到层&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;L1&lt;/b&gt;&lt;/font&gt; kv_cache_interface.py——KVCacheSpec、&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;FullAttentionSpec、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;KVCacheGroupSpec、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;KVCacheTensor、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;KVCacheConfig&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=10;align=left;" parent="g2_1" vertex="1">
