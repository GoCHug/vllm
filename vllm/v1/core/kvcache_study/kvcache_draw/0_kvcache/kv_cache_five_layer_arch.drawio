                <mxCell id="61O2GWZmRc9N9AN2w9-5-1" value="&lt;div style=&quot;line-height: 19px; color: rgb(59, 59, 59);&quot;&gt;&lt;font color=&quot;#3b3b3b&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Scheduler（调度器 · 调用者）&lt;br&gt;└─1→ KVCacheManager（第5层 · 顶层门面）── 对 Scheduler 暴露统一 API&lt;br&gt;    └─1→ UnitaryKVCacheCoordinator（第4层 · 协调器）&lt;br&gt;        ├─1→ 第3层 FullAttentionManager（前缀查找/分配释放/block_table 维护）&lt;br&gt;        └─1→ 第2层 BlockPool（唯一，所有第3层共享）── 仅索引 block_id&lt;br&gt;             │    FreeKVCacheBlockQueue(LRU) + BlockHashToBlockMap(链式哈希)&lt;br&gt;             │&lt;br&gt;             ╎ 桥接（不是持有）：逻辑侧在引擎进程、物理侧在 worker 进程&lt;br&gt;             ╎ 同一份 KVCacheConfig 下发两侧——&lt;br&gt;             ╎   物理侧：遍历 KVCacheConfig.kv_cache_tensors，按每个&lt;br&gt;             ╎           KVCacheTensor.size 字节数 torch.zeros 出 int8 张量&lt;br&gt;             ╎           （shared_by 里的多个层名（每个group中的同一层）共享同一张，主线每层一张）&lt;br&gt;             ╎   逻辑侧：new 出 num_blocks 个逻辑块 KVCacheBlock，block_id 取序号 0…n−1&lt;br&gt;             ╎ 两侧约定 block_id 从 0 编号、即物理行号&lt;br&gt;             ▼&lt;br&gt;             第1层 物理显存 GPUModelRunner.kv_caches[layer]&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;spacingLeft=12;fontSize=10;align=left;fontFamily=Helvetica;fontColor=default;fontStyle=0;" parent="g2_1" vertex="1">
                    <mxGeometry x="740" y="96" width="482" height="326" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p4_deploy" name="3-启动期装配与衔接">
        <mxGraphModel dx="860" dy="767" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g4_0"/>
                <mxCell id="g4_1" parent="g4_0"/>
                <mxCell id="g4_title" value="系统启动期：五层初始化" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g4_sub" value="上：规格先行，物理先于逻辑；下：同一份 KVCacheConfig 定两侧容量，block_id 即行号" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="62" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g4_lane_e" value="引擎进程（EngineCore）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=14;fontStyle=1;align=center;dashed=1;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="90" width="700" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="g4_lane_w" value="worker 进程（每卡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f0f8;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=14;fontStyle=1;align=center;dashed=1;" parent="g4_1" vertex="1">
                    <mxGeometry x="800" y="90" width="440" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s1" value="&lt;b&gt;① 算规格　get_kv_cache_specs()&lt;/b&gt;&#10;收集每个 attention 层的 spec；纯 Full Attention 各层相同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="128" width="650" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="g4_w1" value="每层 attention 返回一个&lt;b&gt;FullAttentionSpec&lt;/b&gt;&lt;br&gt;同规格 ⇒ 合并为全模型唯一&amp;nbsp;&lt;span style=&quot;font-size: 10px; text-align: left;&quot;&gt;KVCacheGroupSpec&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=middle;align=center;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="816" y="128" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s2" value="&lt;b&gt;② 测预算　determine_available_memory()&lt;/b&gt;&#10;RPC 让各卡 dummy forward（profile_run）实测可用显存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="190" width="650" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="g4_w2" value="总显存 × 利用率 − 权重 − 激活 − CUDAGraph 预留&#10;&lt;b&gt;＝ 本卡 KV 可用字节数&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=middle;align=center;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="816" y="190" width="410" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s3" value="&lt;b&gt;③ 做编排　get_kv_cache_configs()&lt;/b&gt;&#10;同规格层合并为 1 个 group；page_size ＝ 2 × block_size × num_kv_heads × head_dim × dtype_size（系数 2 对应 K＋V）&#10;本卡 num_blocks ＝ 可用显存 // page_size // 本 worker 层数；多卡取最小值、共享同一套 block_id 空间 ⇒ 产出 &lt;b&gt;KVCacheConfig&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="254" width="650" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="g4_w4" value="&lt;b&gt;④ 落张量　initialize_from_config()&lt;/b&gt;&lt;br&gt;遍历 config.kv_cache_tensors，按 size 申请 int8 字节张量 → view 成后端 shape → bind 到各 attention 层&lt;br&gt;worker 只按配置执行，不自行算块数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="816" y="256" width="410" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s5" value="&lt;b&gt;⑤ 建逻辑层（RPC 返回后）&lt;/b&gt;&#10;Scheduler（engine/core.py:149）→ KVCacheManager（sched/scheduler.py:231）&#10;→ Coordinator（L4）→ 先建 BlockPool（L2）再建 FullAttentionManager（L3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="328" width="650" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="g4_e1" value="RPC" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="g4_1" source="g4_s1" target="g4_w1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_e2" value="RPC" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="g4_1" source="g4_s2" target="g4_w2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_e3" value="下发" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="g4_1" source="g4_s3" target="g4_w4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_e4" value="RPC 返回" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="g4_1" source="g4_w4" target="g4_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_note" value="入口：EngineCore._initialize_kv_caches()（engine/core.py:236）　·　物理先于逻辑：Scheduler 在物理张量落地之后才创建" style="text;html=1;fontSize=12;align=center;fontColor=#666666;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="386" width="1200" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="g4_h32" value="&lt;b&gt;衔接点：物理 ↔ 逻辑——同一份 KVCacheConfig 定两侧容量，block_id 编号即物理行号&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;fontColor=#333333;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="413" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g4_cfg2" value="&lt;b&gt;KVCacheConfig&lt;/b&gt;&#10;num_blocks ＋ kv_cache_tensors[*].size / shared_by" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=middle;align=center;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="450" y="444" width="380" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="g4_physc" value="&lt;b&gt;物理侧（worker）&lt;/b&gt;&lt;div&gt;按 size（＝num_blocks × page_size 字节）torch.zeros int8 → reshape 零拷贝视图 → bind 到层&lt;/div&gt;&lt;div&gt;只按配置执行，不自行算块数&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=10;" parent="g4_1" vertex="1">
                    <mxGeometry x="100" y="536" width="520" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="g4_logicc" value="&lt;b&gt;逻辑侧（引擎 BlockPool）&lt;/b&gt;&lt;div&gt;new 出 num_blocks 个 KVCacheBlock（0 … n−1，仅元数据，不含 K/V）&lt;/div&gt;&lt;div&gt;块 0＝null_block 占位，实分 n−1&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=10;" parent="g4_1" vertex="1">
                    <mxGeometry x="660" y="536" width="520" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="g4_ce1" value="下发" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g4_1" source="g4_cfg2" target="g4_physc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_ce2" value="下发" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g4_1" source="g4_cfg2" target="g4_logicc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_res2" value="&lt;b&gt;桥接结果&lt;/b&gt;　两侧容量必然相等；block_id 即物理张量第 0 维行号——无需查表或拷贝，调度全程零显存拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=center;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="140" y="605" width="1000" height="26" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p6_fsm" name="4-运行期请求生命周期">
        <mxGraphModel dx="860" dy="767" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g6_0"/>
                <mxCell id="g6_1" parent="g6_0"/>
                <mxCell id="g6_title" value="系统运行期：一条请求的 KV Cache 生命周期" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g6_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g6_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="g6_1" vertex="1">
                    <mxGeometry x="56" y="100" width="26" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="g6_wait" value="&lt;b&gt;WAITING&lt;/b&gt;&lt;div&gt;等待首次调度&lt;br&gt;入队即切块、按满块预计算链式哈希&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=center;fontSize=12;" parent="g6_1" vertex="1">
                    <mxGeometry x="110" y="80" width="300" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="g6_run" value="&lt;b&gt;RUNNING&lt;/b&gt;&#10;prefill 完成后持续 decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=middle;align=center;fontSize=12;" parent="g6_1" vertex="1">
