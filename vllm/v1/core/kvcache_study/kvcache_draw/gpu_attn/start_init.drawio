<mxfile host="65bd71144e">
    <diagram id="startup_fullattn" name="FullAttention·Llama-3-8B 启动期全流程（物理+逻辑层·融合第2页图示）">
        <mxGraphModel dx="1700" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="3664" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t_title" value="FullAttention · Llama-3-8B pp2tp2 —— 系统启动期全流程：物理层 + 逻辑层初始化（源码口径）" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="10" width="1780" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="t_params" value="真实例：num_hidden_layers=32 全 FullAttention（32 份 spec 全等）· PP2×TP2 每卡 16 层 · TP 切 KV 头 8→4（head_dim=128，bf16）· block_size=16 → page=32KiB&lt;br&gt;各卡可用显存 2GiB（教学值）→ num_blocks=4,096 · 16 张量/卡 · 每张 128MiB ｜ 全模型物理 4 卡 × 2GiB = 8GiB&lt;br&gt;引擎进程：③⑤ 纯引擎侧 + ①②④ 的发起端 ｜ worker 进程：①②④ 的执行端（唯一碰显存的地方）—— 物理先于逻辑：Scheduler 在 ④ RPC 返回后才创建" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="60" y="48" width="1860" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pre_label" value="前置 · 启动入口与两件预备工作" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="60" y="108" width="1340" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="pre_entry" value="&lt;b&gt;EngineCore._initialize_kv_caches()&lt;/b&gt;（engine/core.py:236）&lt;br&gt;启动期唯一入口：串起 ①②③④ 四次交互与 ⑤ 建逻辑层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="136" width="410" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="pre_reg" value="&lt;b&gt;※ 注册 spec ↔ manager&lt;/b&gt;（single_type_kv_cache_manager.py:1349）&lt;br&gt;register_all_kvcache_specs：FullAttentionSpec → FullAttentionManager（③ 分组后按 spec 类型查表实例化 manager）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="490" y="136" width="410" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="pre_nc" value="&lt;b&gt;※ 扫描 non_causal&lt;/b&gt;（core.py:263，位于 ①② 之间）&lt;br&gt;存在非因果层则关闭 chunked prefill + 前缀缓存；纯 Full Attention 全因果 → 不触发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="920" y="136" width="480" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="e_pre" value="" style="edgeStyle=none;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="pre_entry" target="pre_reg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_pre2" value="" style="edgeStyle=none;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="pre_reg" target="pre_nc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s1_label" value="① 算规格（RPC）——每卡只遍历本卡实例化的层，产出 16 份 FullAttentionSpec" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="60" y="246" width="1340" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s1_desc" value="get_kv_cache_specs（core.py:243）→ RPC → GPUModelRunner.get_kv_cache_spec（gpu_model_runner.py:7440）｜ kv_sharing 目标层跳过 ｜ TP 同层 spec 相等（KV 头 8→4）｜ 层名全局唯一（model.layers.N）" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" parent="1" vertex="1">
                    <mxGeometry x="60" y="270" width="1340" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s1_box" value="① 每卡提交两样东西：&lt;br&gt;1) 本卡 16 份 FullAttentionSpec&lt;br&gt;　（TP 切头后 num_kv_heads=4）&lt;br&gt;2) ② profile 出的可用显存 2GiB&lt;br&gt;&lt;br&gt;TP 镜像卡用虚线（头 4–7）&lt;br&gt;四卡同构：均 16 层单类型&lt;br&gt;32 份 spec 按值全等 → 单组前提&lt;br&gt;GPU：block_size=16（通用默认，无对齐 patch）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="294" width="300" height="210" as="geometry"/>
                </mxCell>
