                <mxCell id="summary_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="860" y="100" width="360" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="summary_title" value="三个易混量" style="text;html=1;fontSize=16;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="870" y="110" width="340" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="summary_content" value="group_size = 2（列数/张量数）&lt;br&gt;= 每个 group 最多几层&lt;br&gt;→ 决定建几个张量&lt;br&gt;→ 决定每个 block_id 的物理代价 = group_size x page_size&lt;br&gt;→ num_blocks = available / (group_size x page_size)&lt;br&gt;&lt;br&gt;num_groups = 3（manager 数）&lt;br&gt;→ 决定每个请求消耗几个 block_id&lt;br&gt;→ 不参与 num_blocks 计算&lt;br&gt;&lt;br&gt;page_size = 256B（每页字节）&lt;br&gt;→ 决定每页大小" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="870" y="135" width="340" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="formula_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" parent="1" vertex="1">
                    <mxGeometry x="860" y="398" width="360" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="formula_title" value="核心公式" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" parent="1" vertex="1">
                    <mxGeometry x="860" y="403" width="360" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="formula_content" value="建张量：group_size 个&lt;br&gt;每个张量大小 = available / group_size&lt;br&gt;每张量页数 = (available/group_size) / page_size&lt;br&gt;&lt;br&gt;num_blocks = available / page_size / group_size&lt;br&gt;         = 10240 / 256 / 2 = 20&lt;br&gt;&lt;br&gt;总物理显存 = group_size x page_size x num_blocks&lt;br&gt;            = 2 x 256 x 20 = 10240 = available" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="870" y="425" width="340" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="alloc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" parent="1" vertex="1">
                    <mxGeometry x="860" y="613" width="360" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="alloc_title" value="1 个请求 = 3 个 group x 1 个 block 位置" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="860" y="618" width="360" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="alloc_content" value="Manager 0 -&amp;gt; block_id=5 -&amp;gt; 512B&lt;br&gt;Manager 1 -&amp;gt; block_id=6 -&amp;gt; 512B&lt;br&gt;Manager 2 -&amp;gt; block_id=7 -&amp;gt; 512B&lt;br&gt;  (其中 256B 浪费)&lt;br&gt;---------------------------&lt;br&gt;共消耗 3 个 block ID (= num_groups)&lt;br&gt;共锁 3 x 512 = 1536B&lt;br&gt;  = num_groups x group_size x page_size&lt;br&gt;  = 3 x 2 x 256&lt;br&gt;&lt;br&gt;池子限制：总 block ID &amp;lt;= num_blocks&lt;br&gt;-&amp;gt; 一个请求 &amp;lt;= num_blocks/num_groups 个位置&lt;br&gt;-&amp;gt; 满载约 20/3 = 6 个序列（seq_len &amp;lt; block_size）" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;fontFamily=Courier New;" parent="1" vertex="1">
