                <mxCell id="g4_s1" value="&lt;b&gt;① 算规格　get_kv_cache_specs()&lt;/b&gt;&#xa;收集每个 attention 层的 spec；纯 Full Attention 各层相同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=11;" parent="g4_1" vertex="1">
