                <mxCell id="g4_s2" value="&lt;b&gt;② 测预算　determine_available_memory()&lt;/b&gt;&#xa;RPC 让各卡 dummy forward（profile_run）实测可用显存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=11;" parent="g4_1" vertex="1">
