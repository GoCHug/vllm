                    <mxGeometry x="40" y="328" width="190" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r1b" value="不创建管理对象；Request 只持有按满块预计算的链式哈希" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=left;spacingLeft=12;fontSize=10;" vertex="1" parent="g6_1">
