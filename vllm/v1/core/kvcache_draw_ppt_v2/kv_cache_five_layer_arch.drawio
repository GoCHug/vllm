                    <mxGeometry x="1003" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_u6" value="t6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="g1_1" vertex="1">
                    <mxGeometry x="1080" y="224" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g1_ua" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" parent="g1_1" edge="1">
