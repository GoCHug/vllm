                </mxCell>
                <mxCell id="g6_r5b" value="逆序 ref_cnt--；共享块只减计数，归零才回收（有哈希入队尾、无哈希入队首）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="230" y="496" width="710" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r5c" value="无" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="940" y="496" width="300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_con1" value="&lt;b&gt;① 唯一接口：block_table&lt;/b&gt;　逻辑链用它完成全部分配 / 共享 / 驱逐，物理算子用它 gather 张量行；调度全程零显存拷贝，物理张量自申请后不再变动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=10;fontSize=10;align=left;" vertex="1" parent="g6_1">
                    <mxGeometry x="40" y="552" width="386" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="g6_con2" value="&lt;b&gt;② prefill / decode 同一骨架&lt;/b&gt;　都走「分配 slot → GPU 执行」；decode 每步 1 个新 token、新增 0/1 块、跳过前缀查找；没有两套逻辑、没有全局阶段切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=10;fontSize=10;align=left;" vertex="1" parent="g6_1">
                    <mxGeometry x="447" y="552" width="386" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="g6_con3" value="&lt;b&gt;③ 块的命运＝引用计数＋队列位置&lt;/b&gt;　命中前缀 → touch 零拷贝共享；归零才回收：有哈希入队尾（LRU 保护）、无哈希入队首（优先复用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=10;fontSize=10;align=left;" vertex="1" parent="g6_1">
                    <mxGeometry x="854" y="552" width="386" height="80" as="geometry"/>
                </mxCell>
