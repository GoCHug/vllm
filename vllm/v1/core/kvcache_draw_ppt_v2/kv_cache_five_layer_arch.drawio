                    <mxGeometry x="940" y="328" width="300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r2a" value="前缀查找｜仅 prefill 一次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="40" y="370" width="190" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r2b" value="沿编排链只读哈希表；命中块只标记可复用，ref_cnt 不变" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=left;spacingLeft=12;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="230" y="370" width="710" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r2c" value="无" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="940" y="370" width="300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r3a" value="分配 slot｜prefill ＋ 每步 decode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="40" y="412" width="190" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r3b" value="touch 命中块（ref_cnt++、摘出空闲队列）→ 弹空闲块得新 block_id → 组成 block_table；写满的块顺带写入哈希表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="230" y="412" width="710" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r3c" value="无；仅登记「待清零新块」清单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="940" y="412" width="300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r4a" value="GPU 执行｜每调度步" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="40" y="454" width="190" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r4b" value="不参与；SchedulerOutput 把 block_table 下发给 worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;verticalAlign=middle;align=left;spacingLeft=12;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="230" y="454" width="710" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r4c" value="先清零本轮新块；attention 算子按 block_table 为 fancy index gather 物理行、写入新 K/V" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f0f8;strokeColor=#cccccc;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;fontSize=10;" vertex="1" parent="g6_1">
                    <mxGeometry x="940" y="454" width="300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="g6_r5a" value="释放｜生成结束" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="g6_1">
