<mxfile host="65bd71144e">
    <diagram id="ov_type_overview" name="类型总览">
        <mxGraphModel dx="722" dy="714" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="ov_title" value="KV Cache 管理相关类型总览" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1F2A44;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1340" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ov_sub" value="配置侧 4 个类型（引擎进程 · 启动期一次生成 · 运行期只读）　｜　逻辑侧 5 个类型（引擎进程 · 每调度步读写 · 只碰元数据不碰显存）&lt;span style=&quot;white-space: pre;&quot;&gt;&#9;&lt;/span&gt;|&lt;span style=&quot;white-space: pre;&quot;&gt;&#9;&lt;/span&gt;物理侧worker 进程根据 `KVCacheConfig.kv_cache_tensors` 申请的物理张量 kv_caches[layer]，不展开张量本身" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="66" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="ov_cb" value="配置侧 · 启动期配置生成（引擎进程，一次生成后运行期只读）" style="rounded=1;arcSize=20;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=14;fontStyle=1;fontColor=#1f5fa8;fillColor=#dae8fc;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="1520" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ov_c1" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheSpec&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;一层 KV Cache 的存储格式规格&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #bcd2ee;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· &lt;b&gt;block_size&lt;/b&gt;：每块装几个 token&lt;br&gt;· &lt;b&gt;page_size_bytes&lt;/b&gt;：每块字节数（抽象属性）&lt;br&gt;· merge / storage_block_size&lt;br&gt;· copy_with_new_block_size&lt;br&gt;· frozen dataclass，不可变&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot; size=&quot;2&quot;&gt;主线子类 FullAttentionSpec&lt;br&gt;（经 AttentionSpec 继承）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="40" y="142" width="350" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="ov_c2" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheGroupSpec&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;共享同一份 block_table 的一组模型层&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #bcd2ee;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· &lt;b&gt;layer_names&lt;/b&gt;：组内模型层名&lt;br&gt;· &lt;b&gt;kv_cache_spec&lt;/b&gt;：组内 merge 出的统一规格&lt;br&gt;· &lt;b&gt;is_eagle_group&lt;/b&gt;：bool = False&lt;br&gt;· 组内各层 merge（断言字段全等）&lt;br&gt;· 一起分配 / 命中 / 驱逐&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot; size=&quot;2&quot;&gt;组列表下标 = group_id&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="426" y="142" width="350" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="ov_c3" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheTensor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;物理张量如何申请的元数据（非张量本身）&lt;/font&gt;&lt;div style=&quot;border-top: 1px solid rgb(188, 210, 238); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· &lt;b&gt;size&lt;/b&gt;：字节数 = num_blocks × page_size_bytes&lt;br&gt;· &lt;b&gt;shared_by&lt;/b&gt;：关联层名列表&lt;br&gt;· &lt;b&gt;offset / block_stride&lt;/b&gt;：packed 布局参数&lt;br&gt;· 共 group_size 张&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot; size=&quot;2&quot;&gt;示例：每张 128 MiB&lt;br&gt;（4096&amp;nbsp;× 32 KB）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="812" y="142" width="350" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="ov_c4" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheConfig&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;一次编排的最终产物，配置侧出口&lt;/font&gt;&lt;div style=&quot;border-top: 1px solid rgb(188, 210, 238); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· &lt;b&gt;num_blocks&lt;/b&gt;：对齐后的总块数&lt;br&gt;· &lt;b&gt;kv_cache_tensors&lt;/b&gt;：张量元数据列表&lt;br&gt;· &lt;b&gt;kv_cache_groups&lt;/b&gt;：分组列表（顺序即 group_id）&lt;br&gt;· 每 worker 一份&lt;/font&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="1198" y="142" width="350" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="ov_pb" value="&lt;b&gt;物理侧（worker 进程 · 第 1 层）&lt;/b&gt;　据 &lt;font color=&quot;#1f5fa8&quot;&gt;&lt;b&gt;kv_cache_tensors&lt;/b&gt;&lt;/font&gt; 申请物理张量 kv_caches[layer]（&lt;b&gt;torch.Tensor&lt;/b&gt;，无自定义类型）：torch.zeros(size, dtype=int8) → reshape；&lt;b&gt;block_id = 张量第 0 维行号&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="40" y="374" width="1520" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="ov_lb" value="逻辑侧 · 运行时块管理（第 2～5 层，只碰元数据不碰显存）" style="rounded=1;arcSize=20;html=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=14;fontStyle=1;fontColor=#54823b;fillColor=#d5e8d4;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="446" width="1520" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ov_l1" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#54823b&quot;&gt;BlockHash&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;块内容哈希值，前缀缓存比对的 key&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #b9d8b0;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· BlockHash = NewType(bytes)&lt;br&gt;· 链式：H(bₙ)=fn(H(bₙ₋₁), tokens(bₙ))&lt;br&gt;· 首块父哈希：哨兵 NONE_HASH&lt;br&gt;· +4 字节大端 group_id&lt;br&gt;　→ BlockHashWithGroupId&lt;br&gt;· 内容相同 → 哈希相同&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F3F8F1;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="40" y="488" width="288" height="258" as="geometry"/>
                </mxCell>
                <mxCell id="ov_l2" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#54823b&quot;&gt;KVCacheBlock&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;块的标识符 + 元数据，不含显存&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #b9d8b0;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· @dataclass(slots=True)&lt;br&gt;· &lt;b&gt;block_id&lt;/b&gt;：= 物理张量行号&lt;br&gt;· &lt;b&gt;ref_cnt&lt;/b&gt;：引用计数，归零可回收&lt;br&gt;· &lt;b&gt;_block_hash&lt;/b&gt;：缓存哈希 key&lt;br&gt;· &lt;b&gt;prev/next_free_block&lt;/b&gt;：空闲链表指针&lt;br&gt;· &lt;b&gt;is_null&lt;/b&gt;：null 块标记&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F3F8F1;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="348" y="488" width="288" height="258" as="geometry"/>
                </mxCell>
                <mxCell id="ov_l3" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#54823b&quot;&gt;FreeKVCacheBlockQueue&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;空闲块组成的双向链表&lt;/font&gt;&lt;div style=&quot;border-top: 1px solid rgb(185, 216, 176); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· 哨兵头尾节点（block_id=-1）&lt;br&gt;· popleft / append / prepend_n&lt;br&gt;· remove：中间摘除 O(1)&lt;br&gt;· 直接改指针，不新建对象&lt;br&gt;· 分配摘头、释放回队&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#54823b&quot; size=&quot;2&quot;&gt;队头优先复用：有哈希块入队尾，无哈希块插队头&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F3F8F1;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="656" y="488" width="288" height="258" as="geometry"/>
                </mxCell>
                <mxCell id="ov_l4" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#54823b&quot;&gt;BlockHashToBlockMap&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;块哈希 → 已缓存块的映射表&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #b9d8b0;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· key = BlockHashWithGroupId&lt;br&gt;· value = 块 ｜ {block_id: 块}&lt;br&gt;· get_one_block / insert / pop&lt;br&gt;· 相同哈希直接命中&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#54823b&quot; size=&quot;2&quot;&gt;不去重：&lt;br&gt;block_table append-only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F3F8F1;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="964" y="488" width="288" height="258" as="geometry"/>
                </mxCell>
                <mxCell id="ov_l5" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#54823b&quot;&gt;KVCacheBlocks&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;一次分配/命中结果的打包&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #b9d8b0;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;font size=&quot;2&quot;&gt;· blocks[i][j] = 第 i 组第 j 块引用&lt;br&gt;· blocks: tuple[Sequence, ...]&lt;br&gt;· get_block_ids()：抽出块号&lt;br&gt;· __add__ / new_empty&lt;br&gt;· Scheduler ↔ KVCacheManager 接口&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#54823b&quot; size=&quot;2&quot;&gt;零显存、零拷贝&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=12;fontColor=#333333;fillColor=#F3F8F1;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1272" y="488" width="288" height="258" as="geometry"/>
                </mxCell>
                <mxCell id="ov_fb" value="&lt;b&gt;运行时数据流（全程只碰元数据）&lt;/b&gt;&lt;br&gt;KVCacheBlock：空闲（ref_cnt=0）→ FreeKVCacheBlockQueue　｜　满块缓存 → BlockHashToBlockMap　｜　&lt;div&gt;分配/命中 → KVCacheBlocks（块引用汇聚，非映射表产出）→ 返回给 Scheduler，调 get_block_ids() 抽出 block_id → 组装 block_table 下发 Worker（逻辑侧到此为止）&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontSize=12;fontColor=#333333;fillColor=#fffdf5;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="40" y="766" width="1520" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="cf_config_pipeline" name="配置侧·生成流水线">
        <mxGraphModel dx="1805" dy="1785" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="cf_title" value="配置侧 · 启动期生成（引擎进程 · 一次生成 · 运行期只读）" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1F2A44;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="cf_sub" value="每层格式规格 → 同规格层归组 → group_size 张物理张量元数据 → 组装为一份 KVCacheConfig；Llama-3-8B 纯 FullAttention 单组：32 层各一张张量单，num_blocks = 4096" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="66" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="cf_b1" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheSpec&lt;/font&gt;&lt;/b&gt;　&lt;font color=&quot;#888888&quot;&gt;基类 · frozen dataclass&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #bcd2ee;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;· block_size: int&lt;br&gt;&lt;b&gt;抽象属性&lt;/b&gt;&lt;br&gt;· page_size_bytes：每块字节数&lt;br&gt;· storage_block_size：默认 = block_size&lt;br&gt;&lt;b&gt;方法&lt;/b&gt;&lt;br&gt;· merge(specs)：同规格层合并&lt;br&gt;· max_num_blocks_per_req(max_len)&lt;br&gt;· copy_with_new_block_size(bs)&lt;br&gt;&lt;b&gt;继承链&lt;/b&gt;&lt;br&gt;KVCacheSpec → AttentionSpec → FullAttentionSpec&lt;br&gt;AttentionSpec 加 num_kv_heads / head_size /&lt;br&gt;dtype / kv_quant_mode&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;&lt;b&gt;Llama-3-8B：&lt;/b&gt;block_size=16，page_size=32 KB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="40" y="112" width="260" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cf_b2" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheGroupSpec&lt;/font&gt;&lt;/b&gt;　&lt;font color=&quot;#888888&quot;&gt;层分组&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #bcd2ee;margin:5px 0 6px&quot;&gt;&lt;/div&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;· layer_names: list[str]&lt;br&gt;· kv_cache_spec: KVCacheSpec&lt;br&gt;· is_eagle_group: bool = False&lt;br&gt;&lt;b&gt;怎么来的&lt;/b&gt;&lt;br&gt;create_kv_cache_group_specs()：&lt;br&gt;· 组内各层 spec merge（断言字段全等）&lt;br&gt;· 纯 FullAttention → 全模型单 group&lt;br&gt;· 混合模型按 spec 类型切多组&lt;br&gt;&lt;b&gt;关键身份&lt;/b&gt;&lt;br&gt;· 组列表下标 = group_id&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;&lt;b&gt;Llama-3-8B：&lt;/b&gt;1 个组，含全部 32 层&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="400" y="112" width="260" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cf_b3" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheTensor&lt;/font&gt;&lt;/b&gt;　&lt;font color=&quot;#888888&quot;&gt;物理张量元数据&lt;/font&gt;&lt;div style=&quot;border-top: 1px solid rgb(188, 210, 238); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;· size: int（字节数）&lt;br&gt;· shared_by: list[str]&lt;br&gt;· offset: int = 0&lt;br&gt;· block_stride: int = 0&lt;br&gt;&lt;b&gt;通用场景（group_size 张）&lt;/b&gt;&lt;br&gt;· size = page_size_bytes × num_blocks&lt;br&gt;· shared_by = 各组的第 i 层&lt;br&gt;&lt;b&gt;消费方&lt;/b&gt;&lt;br&gt;· worker：torch.zeros(size, int8) 字节池&lt;br&gt;· shared_by 各层挂接后 reshape&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;&lt;b&gt;Llama-3-8B：&lt;/b&gt;32 张，每张 128 MiB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="760" y="112" width="260" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cf_b4" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheConfig&lt;/font&gt;&lt;/b&gt;　&lt;font color=&quot;#888888&quot;&gt;配置侧出口&lt;/font&gt;&lt;div style=&quot;border-top: 1px solid rgb(143, 179, 221); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;· num_blocks: int&lt;br&gt;· kv_cache_tensors: list[KVCacheTensor]&lt;br&gt;· kv_cache_groups: list[KVCacheGroupSpec]&lt;br&gt;&lt;b&gt;派生属性&lt;/b&gt;&lt;br&gt;· has_mamba_layers&lt;br&gt;· has_mixed_precision_kv_cache&lt;br&gt;· needs_kv_cache_zeroing&lt;br&gt;&lt;b&gt;要点&lt;/b&gt;&lt;br&gt;· 每 worker 一份&lt;br&gt;· 多 worker 对齐 min(num_blocks)，tensors 等比缩小&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;&lt;b&gt;Llama-3-8B：&lt;/b&gt;4096 块 / 32 tensors / 1 group&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="112" width="260" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cf_e1" value="同规格层 merge()（断言字段全等）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=classic;endFill=1;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="cf_b1" target="cf_b2" edge="1">
                    <mxGeometry x="-0.2" y="22" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cf_e2" value="收集为有序列表（下标=group_id）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=classic;endFill=1;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="cf_b2" target="cf_b3" edge="1">
                    <mxGeometry x="-0.0435" y="22" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cf_e3" value="两个列表一并组装" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=classic;endFill=1;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="cf_b3" target="cf_b4" edge="1">
                    <mxGeometry x="-0.0292" y="12" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cf_fm" value="&lt;b&gt;num_blocks = available_memory ÷ page_size_bytes ÷ group_size&lt;/b&gt;&lt;br&gt;page_size = 2(K/V) × 16 token × 4 KV 头 × 128 × 2 字节(fp16) = 32 KB　｜　Llama-3-8B（pp2tp2）：2 GiB ÷ 32 KB ÷ 16 层 = 4096 块" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="40" y="430" width="1340" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="cf_dl" value="KVCacheConfig 三个字段的去向 —— 配置侧的全部意义" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#B85450;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="502" width="1000" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="cf_d1" value="&lt;b&gt;&lt;font color=&quot;#54823b&quot; style=&quot;font-size: 13px;&quot;&gt;num_blocks → BlockPool（逻辑侧）&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;border-top: 1px solid rgb(185, 216, 176); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;· 建 KVCacheBlock(0..num_blocks−1)&lt;br&gt;　保证 block_id == i&lt;br&gt;· 块 0 = null_block，永不分配&lt;br&gt;· 决定块池容量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#eef7ec;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="40" y="532" width="360" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="cf_d2" value="&lt;b&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:13px&quot;&gt;kv_cache_tensors → worker（物理侧）&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #cccccc;margin:5px 0 6px&quot;&gt;&lt;/div&gt;· torch.zeros(size, dtype=int8) 字节池&lt;br&gt;· shared_by 各层挂接&lt;br&gt;· reshape 成 kv_caches[layer]&lt;br&gt;· block_id 索引张量第 0 维行号" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="530" y="532" width="360" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="cf_d3" value="&lt;b&gt;&lt;font color=&quot;#1f5fa8&quot; style=&quot;font-size: 13px;&quot;&gt;kv_cache_groups → coordinator 与哈希 key&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;border-top: 1px solid rgb(188, 210, 238); margin: 5px 0px 6px;&quot;&gt;&lt;/div&gt;· 每组一个 single-type manager&lt;br&gt;· 下标 = group_id&lt;br&gt;· 打包进 BlockHashWithGroupId" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="532" width="360" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="cf_note" value="配置在引擎进程生成、运行期只读；物理侧与逻辑侧据同一份 KVCacheConfig 各自落地、互无对象持有关系。" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="690" width="1520" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="lg_logical_flow" name="逻辑侧·运行时结构">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="lg_title" value="逻辑侧 · 运行时结构（第 2～5 层 · 4 个运行时组件与数据类型）" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1F2A44;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="lg_sub" value="青色 = 运行时组件（持有 / 调用）；层内是其数据类型与内件；固定链路 Scheduler → KVCacheManager → Coordinator → FullAttentionManager → BlockPool" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="66" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7f0ee;strokeColor=#10a39a;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="96" width="1150" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c5lab" value="&lt;b style=&quot;font-size:16px&quot;&gt;KVCacheManager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;第5层 · 顶层门面&lt;/font&gt;&lt;br&gt;· 持有 1 个协调器&lt;br&gt;· 对 Scheduler 统一 API&lt;br&gt;· 编排完整请求生命周期" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="56" y="108" width="184" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_s" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1f5fa8&quot;&gt;KVCacheBlocks&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#999999&quot;&gt;块集合 · 返回值&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #bcd2ee;margin:4px 0 6px&quot;&gt;&lt;/div&gt;· blocks: tuple[Sequence[KVCacheBlock], …]&lt;br&gt;· blocks[i][j] = 第 i 组第 j 块引用&lt;br&gt;· get_block_ids()：抽出各组块号&lt;br&gt;· __add__ 拼接命中块与新块&lt;br&gt;· 只装引用：零显存、零拷贝" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10.5;fontColor=#333333;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="850" y="108" width="270" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7f0ee;strokeColor=#10a39a;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="264" width="1150" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c4lab" value="&lt;b style=&quot;font-size:15px&quot;&gt;UnitaryKVCacheCoordinator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;第4层 · 协调器&lt;/font&gt;&lt;br&gt;· 持有 1 个 L3&lt;br&gt;· 共享 1 个 BlockPool&lt;br&gt;· 单组直通" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="56" y="276" width="192" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c4note" value="&lt;b&gt;单组直通（主线 N=1）&lt;/b&gt;：L5 的调用原样转发给 L3 / L2，自身不增加数据结构。&lt;br&gt;&lt;br&gt;扩展：多组混合模型时持有多个 L3，负责跨组对齐与结果汇总。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#9bcfca;" parent="1" vertex="1">
                    <mxGeometry x="268" y="282" width="684" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7f0ee;strokeColor=#10a39a;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="432" width="1150" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c3lab" value="&lt;b style=&quot;font-size:15px&quot;&gt;FullAttentionManager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;第3层 · 单类型管理&lt;/font&gt;&lt;br&gt;· 前缀哈希查找&lt;br&gt;· 分配 / 释放&lt;br&gt;· block_table 维护" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="56" y="444" width="184" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c3note" value="&lt;b&gt;输入：block_hashes（查询 key）&lt;/b&gt;　由请求 token 预先算出，沿调用链传入；L3 不产生、不存储哈希&lt;br&gt;· 沿哈希链逐块问 BlockPool：block_pool.get_cached_block()&lt;br&gt;· 链式性质：某块未命中，其后块必未命中 → 命中必为连续前缀" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#9bcfca;" parent="1" vertex="1">
                    <mxGeometry x="240" y="444" width="590" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_bt" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#3b5b80&quot;&gt;block_table&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#999999&quot;&gt;每请求逻辑表&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #b9c6d6;margin:4px 0 6px&quot;&gt;&lt;/div&gt;· list[KVCacheBlock]，下发时取 block_id&lt;br&gt;· 命中块 + 新块按序 append&lt;br&gt;· 随 execute_model 下发 Worker&lt;br&gt;· Worker 按表索引物理张量 K/V" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10.5;fontColor=#333333;fillColor=#ffffff;strokeColor=#9aa7b4;" parent="1" vertex="1">
                    <mxGeometry x="850" y="444" width="270" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7f0ee;strokeColor=#10a39a;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="600" width="1150" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lg_h" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#a67c00&quot;&gt;BlockHash&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#999999&quot;&gt;哈希类型&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #e3cc80;margin:4px 0 6px&quot;&gt;&lt;/div&gt;· NewType(&quot;BlockHash&quot;, bytes)&lt;br&gt;· 链式累加 H(bₙ)=fn(H(bₙ₋₁), tokens)&lt;br&gt;· 首块父哈希 NONE_HASH&lt;br&gt;· +4 字节 group_id 打包&lt;br&gt;· 内容相同哈希相同，免逐 token 比对" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10.5;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="160" y="612" width="202" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_c2lab" value="&lt;b style=&quot;font-size:16px&quot;&gt;BlockPool&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;第2层 · 逻辑块池&lt;/font&gt;&lt;br&gt;· 仅 block_id 元数据&lt;br&gt;· 内件在右&lt;br&gt;· 全组唯一" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="56" y="612" width="120" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_b" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#54823b&quot;&gt;KVCacheBlock&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#999999&quot;&gt;逻辑块&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #b9d8b0;margin:4px 0 6px&quot;&gt;&lt;/div&gt;· block_id（= 物理张量行号）&lt;br&gt;· ref_cnt：=0 才可回收&lt;br&gt;· _block_hash / prev·next_free&lt;br&gt;· is_null&lt;br&gt;· set / reset_hash&lt;br&gt;· 只存元数据，不含 K/V" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=10.5;fontColor=#333333;fillColor=#eaf4e8;strokeColor=#82b366;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="389" y="612" width="292" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="lg_q" value="&lt;b&gt;FreeKVCacheBlockQueue&lt;/b&gt; 空闲块双向链表（哨兵 -1）；popleft(_n) 摘头分配，append(_n) 释放回队尾，prepend_n 无哈希块插队头；&lt;b&gt;队头 = 先复用 / 先驱逐&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=10.5;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="728" y="612" width="444" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="lg_m" value="&lt;b&gt;BlockHashToBlockMap&lt;/b&gt; key = HashWithGroupId → KVCacheBlock；get_one_block 取任一块 / insert / pop；值多为单块削减 GC；满块才入表；table append-only 不去重" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=10.5;fontColor=#333333;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="728" y="672" width="444" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="lg_sc" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#7a4f91&quot;&gt;Scheduler&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#999999&quot;&gt;调度器 · 调用者&lt;/font&gt;&lt;div style=&quot;border-top:1px solid #c7b2dd;margin:5px 0 6px&quot;&gt;&lt;/div&gt;· 只经 L5 门面调用，不碰 BlockPool&lt;br&gt;· 接收 KVCacheBlocks&lt;br&gt;· get_block_ids() 抽出块号&lt;br&gt;· 组装 block_table 下发 Worker" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#f3eef8;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="100" width="230" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="lg_legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #dddddd;margin:4px 0 6px&quot;&gt;&lt;/div&gt;&lt;font color=&quot;#10a39a&quot;&gt;■&lt;/font&gt; 运行时组件（持有 / 调用）&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; 逻辑块　&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; 哈希　&lt;font color=&quot;#999999&quot;&gt;■&lt;/font&gt; 队列&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; 映射表　&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; 块集合　&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; 调用者" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#cccccc;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="312" width="230" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="lg_hold" value="&lt;b&gt;持有 / 共享关系&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #dddddd;margin:4px 0 6px&quot;&gt;&lt;/div&gt;L5 KVCacheManager → L4 ×1&lt;br&gt;L4 → L3 ×1&lt;br&gt;L4 → L2 ×1（共享）&lt;br&gt;L3 按哈希查询 L2&lt;br&gt;L2 存储哈希（块字段 + 映射表）&lt;br&gt;L2 拥有全部 KVCacheBlock（4096 个）&lt;br&gt;&lt;br&gt;&lt;b&gt;调用链&lt;/b&gt;&lt;br&gt;Scheduler → L5 → L4 → L3 → L2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=9;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#cccccc;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="480" width="230" height="248" as="geometry"/>
                </mxCell>
                <mxCell id="lg_ecall" value="调用入口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;endArrow=classic;endFill=1;endSize=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#9673a6;fontColor=#333333;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="lg_sc" target="lg_c5" edge="1">
                    <mxGeometry x="0.2131" y="11" relative="1" as="geometry">
                        <mxPoint y="-22" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lg_e54" value="持有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;endArrow=classic;endFill=1;endSize=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#0d8f88;fontColor=#333333;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" parent="1" source="lg_c5" target="lg_c4" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="10" y="-2" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lg_e43" value="持有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;endArrow=classic;endFill=1;endSize=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#0d8f88;fontColor=#333333;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" parent="1" source="lg_c4" target="lg_c3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="10" y="-2" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lg_e32" value="按哈希查询" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;endArrow=classic;endFill=1;endSize=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#0d8f88;fontColor=#333333;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" parent="1" source="lg_c3" target="lg_c2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="10" y="-2" as="offset"/>
