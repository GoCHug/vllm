                    <mxGeometry x="40" y="520" width="490" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="hs_c2" value="同一哈希在不同 group 各占一格：&lt;br&gt;key 含 group_id，跨组不串门" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="555" y="520" width="490" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="hs_c3" value="request.block_hashes 存纯 BlockHash&lt;br&gt;（不含 group id）：&lt;br&gt;入队即预计算，R 得 H₀..H₃ 共 4 个" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="520" width="490" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s3_label" value="③ 哈希什么时候算、什么时候消" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#B85450;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="644" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="hs_t1" value="&lt;b&gt;1. prefill 分配后&lt;/b&gt;&lt;br&gt;为请求预计算满块链式哈希&lt;br&gt;request.block_hashes = [H₀,H₁,H₂,H₃]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="40" y="676" width="490" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="hs_t2" value="&lt;b&gt;2. 块写满时&lt;/b&gt;&lt;br&gt;set_block_hash(hash, tokens) 只写一次&lt;br&gt;拼 group_id 挂到块上；块5未满 → None" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#fffdf5;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="555" y="676" width="490" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="hs_t3" value="&lt;b&gt;3. 块释放 / 被驱逐&lt;/b&gt;&lt;br&gt;reset_hash() 清空哈希&lt;br&gt;物理行归零后可再分给新内容" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#fbeceb;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="676" width="490" height="112" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="blk_block" name="KVCacheBlock 逻辑块">
        <mxGraphModel dx="1887" dy="1005" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="blk_t" value="KVCacheBlock · 一个物理 KV 块（张量一行）对应的逻辑元数据对象" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1F2A44;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="blk_s" value="只存元数据、不占显存：block_id 定位物理行，ref_cnt 决定能否回收，_block_hash 支持前缀命中" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="64" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="blk_card" value="&lt;b style=&quot;font-size:16px&quot;&gt;KVCacheBlock&lt;/b&gt;　&lt;font color=&quot;#666666&quot; size=&quot;2&quot;&gt;@dataclass(slots=True) · kv_cache_utils.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;· &lt;b&gt;block_id&lt;/b&gt;: int&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;物理张量第 0 维行号，范围 0..num_blocks−1&lt;/font&gt;&lt;br&gt;· &lt;b&gt;ref_cnt&lt;/b&gt;: int = 0&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;分配 +1 / 前缀命中 +1 / 释放 −1；归零才可回收&lt;/font&gt;&lt;br&gt;· &lt;b&gt;_block_hash&lt;/b&gt;: BlockHashWithGroupId | None&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;块内容哈希（含 group_id），攒满才写&lt;/font&gt;&lt;br&gt;· &lt;b&gt;_block_hash_num_tokens&lt;/b&gt;: int | None&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;哈希对应的 token 数&lt;/font&gt;&lt;br&gt;· &lt;b&gt;prev_free_block / next_free_block&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;空闲队列双向链表指针，仅空闲时有意义&lt;/font&gt;&lt;br&gt;· &lt;b&gt;is_null&lt;/b&gt;: bool = False&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;块 0 置 True，永不分配&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;方法&lt;/b&gt;&lt;br&gt;· &lt;b&gt;set_block_hash(hash, num_tokens)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;assert _block_hash is None：哈希只写一次&lt;/font&gt;&lt;br&gt;· &lt;b&gt;reset_hash()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;驱逐 / 重用前清空哈希&lt;/font&gt;&lt;br&gt;&lt;br&gt;────────────&lt;br&gt;· slots 固定属性集合，省对象内存&lt;br&gt;· 对象只存元数据，不持有显存张量&lt;br&gt;· BlockPool 按 num_blocks 一次性创建&lt;br&gt;　block_id 恒等于对象数组下标" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;fontSize=11;fontColor=#333333;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="400" height="660" as="geometry"/>
                </mxCell>
                <mxCell id="blk_mp" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="464" y="100" width="520" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="blk_mp_lab" value="block_id 即物理张量行号" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f5fa8;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="484" y="114" width="480" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="blk_inst" value="&lt;b style=&quot;font-size:13px&quot;&gt;KVCacheBlock 实例&lt;/b&gt;&lt;br&gt;&lt;br&gt;block_id = &lt;b style=&quot;font-size:15px&quot;&gt;3&lt;/b&gt;&lt;br&gt;ref_cnt = 1&lt;br&gt;_block_hash = H₂&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#777777&quot;&gt;（R prefill 新写满块，哈希内含 group_id=0）&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontSize=11;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" parent="1" vertex="1">
