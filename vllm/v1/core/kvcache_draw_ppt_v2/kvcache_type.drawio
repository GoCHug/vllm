                <mxCell id="a_mla" value="&lt;b&gt;MLAAttentionSpec&lt;/b&gt;&lt;br&gt;&lt;br&gt;cache_dtype_str: str | None&lt;br&gt;alignment: int | None = None&amp;nbsp;&amp;nbsp;（对齐填充）&lt;br&gt;compress_ratio: int = 1&lt;br&gt;model_version: str | None = None&lt;br&gt;─── 关键 ───&lt;br&gt;storage_block_size = block_size // compress_ratio&lt;br&gt;real_page_size_bytes():&lt;br&gt;&amp;nbsp;&amp;nbsp;DeepseekV4 → 584B/token&amp;nbsp;&amp;nbsp;（448B NoPE+128B RoPE+8B scale）&lt;br&gt;&amp;nbsp;&amp;nbsp;fp8_ds_mla(V3.2) → 656B/token" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=12;fillColor=#FFCCCC;strokeColor=#9AA7B8;" parent="1" vertex="1">
                    <mxGeometry x="1680" y="415" width="380" height="190" as="geometry"/>
