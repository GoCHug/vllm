                </mxCell>
                <mxCell id="spec_ql_lab" value="③ 三个核心量：一个统一字段 + 两个多态量" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#B85450;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="700" width="1520" height="22" as="geometry"/>
