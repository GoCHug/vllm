                </mxCell>
                <mxCell id="fq_r2" value="&lt;b&gt;分配：popleft / popleft_n&lt;/b&gt;&lt;br&gt;队头即 LRU 最久未用块，&lt;br&gt;优先覆写；num_free_blocks&lt;br&gt;常数计数，O(1) 知空闲量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="555" y="690" width="490" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="fq_r3" value="&lt;b&gt;回收分两种入队位置&lt;/b&gt;&lt;br&gt;有哈希 → append 队尾，&lt;br&gt;多留一会等待前缀命中；&lt;br&gt;无哈希 → prepend 队头，&lt;br&gt;最先被覆写复用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="690" width="490" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
