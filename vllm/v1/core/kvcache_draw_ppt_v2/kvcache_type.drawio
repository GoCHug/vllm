                </mxCell>
                <mxCell id="blk_rc" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="464" y="446" width="520" height="314" as="geometry"/>
                </mxCell>
                <mxCell id="blk_rc_lab" value="ref_cnt 引用计数：决定块何时能被回收" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f5fa8;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="484" y="460" width="480" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="blk_b0" value="&lt;b&gt;空闲&lt;/b&gt;&lt;br&gt;ref_cnt=0&lt;br&gt;&lt;font size=&quot;1&quot;&gt;在空闲队列中&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="480" y="494" width="88" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="blk_b1" value="&lt;b&gt;新分配&lt;/b&gt;&lt;br&gt;ref_cnt=1&lt;br&gt;&lt;font size=&quot;1&quot;&gt;allocate_slots&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fontColor=#333333;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="584" y="494" width="88" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="blk_b2" value="&lt;b&gt;两请求共享&lt;/b&gt;&lt;br&gt;ref_cnt=2&lt;br&gt;&lt;font size=&quot;1&quot;&gt;前缀命中 +1&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fontColor=#333333;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="688" y="494" width="88" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="blk_b3" value="&lt;b&gt;一请求结束&lt;/b&gt;&lt;br&gt;ref_cnt=1&lt;br&gt;&lt;font size=&quot;1&quot;&gt;释放 −1&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fontColor=#333333;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="792" y="494" width="88" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="blk_b4" value="&lt;b&gt;全部结束&lt;/b&gt;&lt;br&gt;ref_cnt=0&lt;br&gt;&lt;font size=&quot;1&quot;&gt;挂回队列再分配&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="896" y="494" width="88" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e1" value="分配 +1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=classic;endFill=1;fontSize=9;fontColor=#3e6b2e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="blk_b0" target="blk_b1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e2" value="命中 +1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=classic;endFill=1;fontSize=9;fontColor=#a67c00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="blk_b1" target="blk_b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e3" value="完成 −1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;endArrow=classic;endFill=1;fontSize=9;fontColor=#1f5fa8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="blk_b2" target="blk_b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e4" value="完成 −1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=classic;endFill=1;fontSize=9;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="blk_b3" target="blk_b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="blk_rc_note" value="规则：&lt;br&gt;· allocate_slots 从空闲队列取出，ref_cnt 0→1&lt;br&gt;· 前缀命中不复制块，仅 ref_cnt +1，多请求共享同一物理行&lt;br&gt;· 请求结束（或被换出）时 −1&lt;br&gt;· ref_cnt &amp;gt; 0 的块绝不回收、绝不写入新内容；归零才挂回 FreeKVCacheBlockQueue&lt;br&gt;· null_block 不参与计数" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontSize=10;fontColor=#333333;fillColor=#fafcff;strokeColor=#cccccc;" parent="1" vertex="1">
                    <mxGeometry x="484" y="592" width="480" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="blk_hl" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="1008" y="100" width="552" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="blk_hl_lab" value="_block_hash 哈希生命周期：只写一次，清空后行可重用" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f5fa8;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="114" width="512" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="blk_h1" value="&lt;b style=&quot;font-size:12px&quot;&gt;① 新块&lt;/b&gt;　_block_hash = None&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;不在映射表中，前缀查询不可见；物理行尚未攒满&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="144" width="512" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="blk_h2" value="&lt;b style=&quot;font-size:12px&quot;&gt;② set_block_hash(h, n)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;assert _block_hash is None —— 只写一次&lt;br&gt;以 BlockHashWithGroupId 为 key 进 BlockHashToBlockMap，可被前缀命中&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="232" width="512" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="blk_h3" value="&lt;b style=&quot;font-size:12px&quot;&gt;③ reset_hash()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;_block_hash = None，从映射表摘除&lt;br&gt;哈希只描述行内容、不持有 KV 数据；清空后物理行可写入新内容&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="328" width="512" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="blk_eh1" value="攒满 16 token 且前向计算完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=classic;endFill=1;fontSize=9;fontColor=#3e6b2e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="blk_h1" target="blk_h2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="blk_eh2" value="块被驱逐 / 块被重新分配前" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=classic;endFill=1;fontSize=9;fontColor=#a67c00;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="blk_h2" target="blk_h3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="blk_te" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="1008" y="446" width="552" height="314" as="geometry"/>
                </mxCell>
                <mxCell id="blk_te_lab" value="同一个块的三条边：按状态被不同结构引用" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f5fa8;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="460" width="512" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e_q" value="&lt;b style=&quot;font-size:12px&quot;&gt;空闲 → FreeKVCacheBlockQueue&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;prev_free_block / next_free_block 串成双向链表，等待 allocate_slots 取出&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="490" width="512" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e_m" value="&lt;b style=&quot;font-size:12px&quot;&gt;哈希满块 → BlockHashToBlockMap&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;BlockHashWithGroupId → 块引用，供所有请求做前缀查找&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#eef7ec;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="566" width="512" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="blk_e_b" value="&lt;b style=&quot;font-size:12px&quot;&gt;被请求占用 → KVCacheBlocks&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;块引用进入请求的块序列；get_block_ids() 抽号生成 block_table 下发 Worker&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="642" width="512" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="blk_te_note" value="三条边引用的是同一个 KVCacheBlock 对象，流转过程不复制块、不复制数据。" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#666666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1028" y="724" width="512" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="blk_note" value="&lt;b style=&quot;font-size:13px&quot;&gt;对象池生命周期&lt;/b&gt;　BlockPool 启动时按 num_blocks 一次性创建 KVCacheBlock(0..4095)：block_id 恒等于对象数组下标 = 物理张量行号。块 0 = null_block（is_null=True，永不分配，仅作 attention 中的占位行）。运行期对象池不增不减，块只在空闲队列、映射表与请求块集合之间流转。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="780" width="1520" height="84" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="free_queue_pr" name="FreeKVCacheBlockQueue 空闲队列（P/R 示例）">
        <mxGraphModel dx="2021" dy="1077" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="fq_t" value="FreeKVCacheBlockQueue 空闲块队列：双向链表（P/R 完整过程）" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1F2A44;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="22" width="1520" height="40" as="geometry"/>
                </mxCell>
