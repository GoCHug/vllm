                    <mxGeometry x="700" y="306" width="190" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="blk_mp_note" value="逻辑块不复制 KV 数据：attention 凭 block_id 直接索引张量对应行；所有层共用同一行号体系。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=10;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
