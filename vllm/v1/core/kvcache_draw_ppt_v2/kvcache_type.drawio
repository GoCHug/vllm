                    <mxGeometry x="730" y="240" width="130" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="blk_rd2" value="⋮" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#999999;align=center;fillColor=#fafafa;strokeColor=none;" parent="1" vertex="1">
