                </mxCell>
                <mxCell id="strip_grp" value="&lt;b&gt;group_id&lt;/b&gt;&lt;br&gt;4 字节 big-endian&lt;br&gt;（示例 = 0）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="880" y="422" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="strip_arr" value="" style="endArrow=classic;html=1;strokeColor=#888888;strokeWidth=2;endFill=1;" edge="1" parent="1">
