                <mxCell id="fq_3_n" value="&lt;b&gt;队头 = LRU 最久未用&lt;/b&gt;：&lt;br&gt;最该被覆写复用，所以分配从&lt;br&gt;队头开始，O(1)" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=11;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="1">
