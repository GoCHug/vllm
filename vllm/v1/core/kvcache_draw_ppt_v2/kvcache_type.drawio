                    <mxGeometry x="608" y="584" width="110" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="fq_4_n" value="get_block_ids → block_table 下发 Worker / attention：&lt;br&gt;attention 凭块号直接索引 kv_caches[layer] 对应行；块5未满，decode 继续原地写入，不占新块" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#f3eef8;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="740" y="584" width="820" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="fq_r1" value="&lt;b&gt;中间摘除 O(1)&lt;/b&gt;&lt;br&gt;touch 命中块靠 prev/next&lt;br&gt;双向指针直接 remove，&lt;br&gt;这是用链表而非数组的原因" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
