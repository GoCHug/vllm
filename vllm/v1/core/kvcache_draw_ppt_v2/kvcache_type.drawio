                <mxCell id="kbs_ap_note" value="· __add__ 按组对应顺序拼接；blocks 是 tuple，不可变 → 返回新对象&lt;br&gt;· Scheduler 把新增块累积到请求的 req_to_new_blocks，同批生成 slot_mapping&lt;br&gt;&lt;br&gt;· get_unhashed_block_ids() 查出未哈希块：&lt;br&gt;　新写块在对应计算完成前不能被命中&lt;br&gt;&lt;br&gt;· allow_none=True 时未到位的块给 None，&lt;br&gt;　用于异步等待计算完成的场景" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#555555;align=left;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="430" y="560" width="578" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_rp" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="100" width="510" height="660" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_rp_lab" value="三个生产者 / 一个出口" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f5fa8;align=left;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="114" width="470" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_p1" value="&lt;b style=&quot;font-size:12px&quot;&gt;get_computed_blocks&lt;/b&gt; · 前缀命中&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;引用来自 BlockHashToBlockMap 查询结果：命中的满块直接引用，不重新分配&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#eef7ec;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="144" width="470" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_p2" value="&lt;b style=&quot;font-size:12px&quot;&gt;allocate_slots&lt;/b&gt; · 新分配&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;按 num_new_tokens 从 BlockPool 取新块并建立引用&lt;br&gt;空闲块不足时返回 None → Scheduler 触发抢占&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#F4F8FE;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="246" width="470" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_p3" value="&lt;b style=&quot;font-size:12px&quot;&gt;get_blocks&lt;/b&gt; · 续算取回&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;decode 阶段取回请求已登记占用的块&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="360" width="470" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_merge" value="&lt;b style=&quot;font-size:13px&quot;&gt;KVCacheBlocks 实例&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;本次调度该请求的块引用集合（元数据）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="456" width="470" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_exit" value="&lt;b style=&quot;font-size:12px&quot;&gt;出口：Scheduler → Worker&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#555555&quot;&gt;Scheduler 存入 req_to_new_blocks&lt;br&gt;get_block_ids() 抽号生成 block_table&lt;br&gt;与 slot_mapping 一起下发，attention 按号取物理行&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#333333;fillColor=#fffaf2;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="552" width="470" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_e_p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=classic;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kbs_p1" target="kbs_merge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_e_p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kbs_p2" target="kbs_merge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_e_p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=classic;endFill=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kbs_p3" target="kbs_merge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_e_me" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="kbs_merge" target="kbs_exit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_rp_note" value="· 零显存、零拷贝：流动的只有对象引用&lt;br&gt;· 空集合复用单例 empty_kv_cache_blocks&lt;br&gt;· get_unhashed_block_ids() 查出未哈希块，需等待计算完成后才能命中" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#555555;align=left;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="666" width="470" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="kbs_note" value="&lt;b style=&quot;font-size:13px&quot;&gt;性质小结&lt;/b&gt;　blocks 为 tuple（不可变），__add__ 返回新对象；元素是引用，同一 KVCacheBlock 可被多个请求的 KVCacheBlocks 同时持有（共享、零拷贝、零显存）；create_kv_cache_blocks() 在全空时复用单例 empty_kv_cache_blocks；KVCacheBlocks 是逻辑侧给 Scheduler 的块视图，最终只有 block_id 数字跨过逻辑 / 物理边界进入 block_table。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="780" width="1520" height="84" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="kvcache_types_v2" name="结构速查">
        <mxGraphModel dx="2573" dy="1371" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="qv_t" value="KV Cache 管理 · 结构速查（一页回顾全部类型）" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1F2A44;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="22" width="1520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="qv_s" value="示例始终统一：Llama-3-8B · pp2tp2 四卡 · 纯 FullAttention · 单组 group_id=0 · block_size=16" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="64" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="qv_l1" value="① 启动期配置链路：每类型只由上一类型推导，产出后只读" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#B85450;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="102" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="qv_c1" value="&lt;b&gt;KVCacheSpec&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;层 KV 格式定义&lt;br&gt;主线 FullAttentionSpec&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="40" y="132" width="200" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="qv_c2" value="&lt;b&gt;KVCacheGroupSpec&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;同规格层经 merge 归组&lt;br&gt;下标 = group_id&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="280" y="132" width="220" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="qv_c3" value="&lt;b&gt;KVCacheTensor&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;物理张量申请元数据&lt;br&gt;size / shared_by&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="540" y="132" width="200" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="qv_c4" value="&lt;b&gt;KVCacheConfig&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;唯一编排总结果&lt;br&gt;三字段覆盖全部下游&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;" vertex="1" parent="1">
                    <mxGeometry x="780" y="132" width="220" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="qv_a0" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;endFill=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="242" y="174" as="sourcePoint"/>
                        <mxPoint x="278" y="174" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="qv_a1" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;endFill=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="502" y="174" as="sourcePoint"/>
                        <mxPoint x="538" y="174" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="qv_a2" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;endFill=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="742" y="174" as="sourcePoint"/>
                        <mxPoint x="778" y="174" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="qv_num" value="&lt;b&gt;关键数字&lt;/b&gt;　page_size_bytes = 2×16×4×128×2 = &lt;b&gt;32 KB&lt;/b&gt;　·　num_blocks = 2GiB÷32KB÷16层 = &lt;b&gt;4096&lt;/b&gt;（块0=null）　·　每卡 16层 × &lt;b&gt;128 MiB&lt;/b&gt; = 2 GiB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="132" width="540" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="qv_l2" value="② 运行期：一个物理张量池，逻辑块按状态走三个去向" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#B85450;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="246" width="1520" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="qv_phys" value="&lt;b style=&quot;font-size:14px&quot;&gt;物理侧 · worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;kv_caches[layer]：torch.Tensor&lt;br&gt;&lt;br&gt;int8 字节池 torch.zeros(2GiB)&lt;br&gt;reshape / bind：&lt;br&gt;&lt;br&gt;&lt;b&gt;shape (4096, 4, 16, 256) fp16&lt;/b&gt;&lt;br&gt;128 MiB/层，16 层/卡&lt;br&gt;&lt;br&gt;唯一真实数据所在；attention&lt;br&gt;凭 block_id 直接索引第0维行" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;fontSize=11;fillColor=#f3eef8;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="40" y="278" width="480" height="424" as="geometry"/>
                </mxCell>
                <mxCell id="qv_blk" value="&lt;b style=&quot;font-size:14px&quot;&gt;逻辑侧 · BlockPool&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;KVCacheBlock(0..4095)&lt;/b&gt;&lt;br&gt;每块只存元数据：&lt;br&gt;block_id（= 张量行号）&lt;br&gt;ref_cnt（引用计数）&lt;br&gt;_block_hash（满块哈希）&lt;br&gt;prev/next 空闲指针&lt;br&gt;&lt;br&gt;不持数据、不占显存；&lt;br&gt;三去向随状态切换，&lt;br&gt;见右侧 →" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="555" y="278" width="490" height="424" as="geometry"/>
                </mxCell>
                <mxCell id="qv_d0" value="&lt;b&gt;空闲 → FreeKVCacheBlockQueue&lt;/b&gt;&lt;br&gt;双向链表：队头 LRU 先分配；有哈希回收进队尾" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="278" width="490" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="qv_d1" value="&lt;b&gt;满块 → BlockHashToBlockMap&lt;/b&gt;&lt;br&gt;BlockHashWithGroupId → 块；前缀命中查询此表" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#F4F8FE;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="418" width="490" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="qv_d2" value="&lt;b&gt;被请求占用 → KVCacheBlocks&lt;/b&gt;&lt;br&gt;引用集合 → get_block_ids → block_table [1,2,3,4,5] → Worker" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fillColor=#fffaf2;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="558" width="490" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="qv_e_pb" value="block_id == 行号" style="endArrow=none;html=1;strokeColor=#b3b3b3;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;fontSize=10;fontColor=#666666;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="522" y="490" as="sourcePoint"/>
                        <mxPoint x="553" y="490" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="qv_e_bd0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="qv_blk" target="qv_d0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="qv_e_bd1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="qv_blk" target="qv_d1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="qv_e_bd2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=classic;endFill=1;exitX=1;exitY=0.82;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="qv_blk" target="qv_d2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="qv_foot" value="&lt;b&gt;一句话主线&lt;/b&gt;：配置链路 Spec → GroupSpec → Tensor → Config 单向产出、运行期只读；运行期只动元数据，&lt;b&gt;只有 block_id 数字跨过逻辑 / 物理边界&lt;/b&gt; —— R 的 [1, 2, 3, 4, 5] 串起全部结构。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#f5f5f5;strokeColor=#b3b3b3;" vertex="1" parent="1">
                    <mxGeometry x="40" y="722" width="1520" height="96" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
