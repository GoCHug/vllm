                <mxCell id="bm_card" value="&lt;b style=&quot;font-size:14px&quot;&gt;命中查询怎么走&lt;/b&gt;&lt;br&gt;&lt;br&gt;request.block_hashes = [H₀,H₁,H₂,H₃]&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#666&quot;&gt;（纯 BlockHash，不含 group id）&lt;/font&gt;&lt;br&gt;&lt;br&gt;① 拼 group_id=0 成 key&lt;br&gt;② get_one_block(key)：查到任一&lt;br&gt;　块即可，不在乎是哪一块&lt;br&gt;③ H₀/H₁ 命中 P 留下的 #1/#2&lt;br&gt;　hit_length = 32，不重算&lt;br&gt;&lt;br&gt;contain(key, block_id) 才精确匹配&lt;br&gt;&lt;br&gt;value 是块对象引用而非 id 复制；&lt;br&gt;全程只改元数据，不碰显存。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=12;fontSize=11;fillColor=#F4F8FE;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="128" width="500" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="bm_l2" value="② 同一个 key 的值会进化：常态是一个块，冲突时才升级为 {block_id: block}" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#B85450;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="588" width="1520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="bm_p1" value="&lt;b&gt;insert(key, block #3)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#666&quot;&gt;block_pool.py · R 写满块3&lt;/font&gt;&lt;br&gt;&lt;br&gt;首次写该 key&lt;br&gt;值 = block #3&lt;br&gt;&lt;br&gt;&lt;b&gt;常态：1 key → 1 块&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="40" y="620" width="490" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="bm_arr0" value="" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;endFill=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="532" y="700" as="sourcePoint"/>
                        <mxPoint x="552" y="700" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bm_p2" value="&lt;b&gt;insert(同 key, block #7)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#666&quot;&gt;另一请求写出同内容的块&lt;/font&gt;&lt;br&gt;&lt;br&gt;值 = {3: #3, 7: #7}&lt;br&gt;同哈希两块并存，不去重&lt;br&gt;&lt;br&gt;&lt;b&gt;仅冲突才建 dict（省 GC）&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="555" y="620" width="490" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="bm_arr1" value="" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;endFill=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1047" y="700" as="sourcePoint"/>
                        <mxPoint x="1067" y="700" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bm_p3" value="&lt;b&gt;pop(key, block_id=7)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot; color=&quot;#666&quot;&gt;块7 被重分配 / 驱逐时&lt;/font&gt;&lt;br&gt;&lt;br&gt;值 = block #3（回到单块）&lt;br&gt;值空了 → 整个 key 移除&lt;br&gt;&lt;br&gt;&lt;b&gt;append-only 记账，不去重&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1070" y="620" width="490" height="160" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
