                        <mxPoint x="1142" y="462" as="sourcePoint"/>
                        <mxPoint x="1178" y="462" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="strip_key" value="&lt;b&gt;BlockHashWithGroupId&lt;/b&gt;&lt;br&gt;仍是纯 bytes&lt;br&gt;直接当 dict key" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="1180" y="422" width="380" height="80" as="geometry"/>
                </mxCell>
