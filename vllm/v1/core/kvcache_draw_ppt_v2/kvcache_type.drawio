                <mxCell id="spec_q1" value="&lt;b style=&quot;font-size:12px&quot;&gt;block_size&lt;/b&gt;　每块容纳 token 数；逻辑 ↔ 物理的换算系数；全局统一" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1">
