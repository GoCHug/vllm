                <mxCell id="fq_2_n" value="&lt;b&gt;为何用双向链表&lt;/b&gt;：靠块上残留的&lt;br&gt;prev/next 指针，中间摘除 O(1)，&lt;br&gt;无需遍历挪动" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=11;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="1">
