                <mxCell id="spec_fa_card" value="&lt;b style=&quot;font-size:15px&quot;&gt;FullAttentionSpec 实例&lt;/b&gt;&lt;br&gt;Llama-3-8B · TP2 worker 视角&lt;br&gt;&lt;br&gt;block_size = 16&lt;br&gt;num_kv_heads = 4&lt;br&gt;head_size = 128&lt;br&gt;dtype = fp16（2 B）&lt;br&gt;&lt;br&gt;&lt;b&gt;page_size_bytes&lt;/b&gt;&lt;br&gt;= 2 × 16 × 4 × 128 × 2&lt;br&gt;= &lt;b&gt;32,768 B（32 KB）&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#666&quot;&gt;系数 2（首）= K、V 各一份&lt;/font&gt;&lt;br&gt;&lt;br&gt;storage_block_size = 16&lt;br&gt;&lt;br&gt;→ kv_caches[layer]&lt;br&gt;shape (4096, 4, 16, 256)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;fontSize=11;fontColor=#333333;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="104" width="540" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="spec_nb_card" value="&lt;b style=&quot;font-size:13px&quot;&gt;page_size_bytes → num_blocks&lt;/b&gt;&lt;br&gt;&lt;br&gt;2 GiB ÷ 32 KB ÷ 16 层（PP 切后/worker） = &lt;b&gt;4096&lt;/b&gt;&lt;br&gt;&lt;br&gt;BlockPool 建 KVCacheBlock(0..4095)：block_id == 数组下标 == 张量行号；块 0 = null_block，实际可分 4095。" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;fontSize=11;fontColor=#333333;fillColor=#fffdf5;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="494" width="540" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="spec_lc_lab" value="② Spec 生命周期（框架侧五步）" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#B85450;align=left;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="588" width="1520" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="spec_s1" value="S1&lt;br&gt;各层 backend 初始化&lt;br&gt;每层产出 Spec" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontSize=10.5;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
