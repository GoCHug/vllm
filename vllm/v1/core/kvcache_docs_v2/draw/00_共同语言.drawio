=1;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="800" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_bt" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="210" height="125" as="geometry"/></mxCell><mxCell id="p3_s1_bt_title" value="block_table 翻译卡（每请求一份）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="269" width="198" height="16" as="geometry"/></mxCell><mxCell id="p3_s1_bt_map" value="L0 → P7&#10;L1 → P2&#10;L2 → P9&#10;L3 → P1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="287" width="200" height="60" as="geometry"/></mxCell><mxCell id="p3_s1_id0" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="349" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_id1" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="349" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_id2" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="349" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_id3" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="349" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_bt_note" value="（P? = 物理 block_id）" style="text;html=1;whiteSpace=wrap;al