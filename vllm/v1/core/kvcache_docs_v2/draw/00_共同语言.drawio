ht="20" as="geometry"/></mxCell><mxCell id="p2_s3_drug" value="照方抓药 → PagedAttention" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="300" height="20" as="geometry"/></mxCell><mxCell id="p2_s3_os" value="类比 OS 虚拟内存：固定页 + 页表" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="350" y="578" width="490" height="20" as="geometry"/></mxCell><mxCell id="p2_s3_block0" value="逻辑块 0&#10;t0..t15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s3_block1" value="逻辑块 1&#10;t16..t31" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="605" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s3_block2" value="逻辑块 2&#10;t32..t47" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="605" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s3_block3" value="逻辑块 3&#10;t48..t59" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="605" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s3_tail" value="60 token → 切 4 块；逻辑块 3 只 12/16 满（60 = 3×16 + 12）；写满一块才领一块" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="605" width="580" height="30" as="geometry"/></mxCell><mxCell id="p2_s4_label" value="④ block_table 翻译卡：虚线点亮物理条带对应块" style="text;html=1;whiteSp