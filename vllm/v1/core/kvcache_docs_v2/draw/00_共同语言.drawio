<mxfile host="65bd71144e" modified="2026-09-03T00:00:00.000Z" agent="gen_v3" version="24.0.0"><diagram id="d00-p1-why-kvcache" name="P1 为什么需要KV Cache"><mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="P1 · 为什么需要 KV Cache（归属 00 · 0.1）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="p1_s1_label" value="① 无缓存：每步重算全部历史 K/V" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="800" height="30" as="geometry"/></mxCell><mxCell id="p1_s1_desc" value="生成第 i 步：拿新 token 的 q 与「之前所有」token 的 K/V 做注意力 → 每步要处理 i 个站点" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_user" value="用户 · 提问 t0 → 逐 token 自回归生成" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_r1_label" value="第 1 步 · q(t0) 到来 → 重算 [t0] 的 K/V" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="230" height="30" as="geometry"/></mxCell><mxCell id="p1_s1g_r1_0" value="重算 t0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="155" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s1_r1_cnt" value="→ 1 个站点" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="345" y="160" width="100" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_r1_again" value="↓ 再来一遍，继续重算" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_r2_label" value="第 2 步 · t1 到来 → 重算 [t0,t1] 的 K/V" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="230" height="30" as="geometry"/></mxCell><mxCell id="p1_s1g_r2_0" value="重算 t0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="215" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s1g_r2_1" value="重算 t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="215" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s1_r2_cnt" value="→ 2 个站点" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="395" y="220" width="100" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_r2_again" value="↓ 再来一遍，继续重算" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_r3_label" value="第 3 步 · t2 到来 → 重算 [t0,t1,t2] 的 K/V" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="230" height="30" as="geometry"/></mxCell><mxCell id="p1_s1g_r3_0" value="重算 t0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="275" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s1g_r3_1" value="重算 t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="275" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s1g_r3_2" value="重算 t2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="275" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s1_r3_cnt" value="→ 3 个站点" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="445" y="280" width="100" height="20" as="geometry"/></mxCell><mxCell id="p1_s1_note" value="红格 = 每一步都被重复重算的历史 K/V（序列越长，重算的越多）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s2_label" value="② 无缓存的账单：O(n²)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="800" height="30" as="geometry"/></mxCell><mxCell id="p1_s2_desc" value="站点数 1 + 2 + 3 + … 逐累加 → 等效 O(n²)，每步都比上一步更慢 —— 长序列直接不可接受" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s2_formula" value="Σ 1 + 2 + 3 + … + n → 等效代价 O(n²)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#b85450;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="433" width="800" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_label" value="③ 有缓存：历史 K/V 算一次就存进显存" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="800" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_desc" value="之后每步只算新 token 这一份 + 读一次缓存" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s3_user" value="用户 · 提问 → 逐 token 生成（一次生成，不再重算）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s3_steps" value="第 1 步：算出 K/V(t0) 入库，写入仓库 ｜ 第 2 步：只算新 K/V(t1)，追加一格 ｜ 第 3 步：只算新 K/V(t2)，再追加一格" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s3_warehouse" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="560" height="145" as="geometry"/></mxCell><mxCell id="p1_s3_wh_title" value="KV Cache 仓库（常驻显存）· 逐格收纳（只增不减）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="610" width="540" height="18" as="geometry"/></mxCell><mxCell id="p1_s3_k0" value="t0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="635" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_k1" value="t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="635" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_k2" value="t2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="635" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_k3" value="空闲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="635" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_k4" value="空闲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="635" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_k5" value="…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="635" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_v0" value="t0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="675" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_v1" value="t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="675" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_v2" value="t2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="675" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_v3" value="空闲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="675" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_v4" value="空闲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="675" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_v5" value="…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="675" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_klab" value="K" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="635" width="25" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_vlab" value="V" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="50" y="675" width="25" height="30" as="geometry"/></mxCell><mxCell id="p1_s3_wh_note" value="第 2 步：+ t1（只算新的）｜ 第 3 步：+ t2（只算新的）｜ 黄格 = 最新一步的新 token 增量；灰格 = 空闲" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="50" y="713" width="540" height="34" as="geometry"/></mxCell><mxCell id="p1_s3_on" value="角标 O(n)：每步 O(1) 份增量 + 一次缓存读取 → 整条序列 O(n)&#10;第 1 步后 [t0] → 第 2 步后 [t0,t1] → 第 3 步后 [t0,t1,t2]（只增不减）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="605" width="220" height="145" as="geometry"/></mxCell><mxCell id="p1_s4_label" value="④ 有缓存的账单：O(n) + 常驻显存" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="800" height="30" as="geometry"/></mxCell><mxCell id="p1_s4_desc" value="每步 O(1) 份增量计算 + 一次缓存读取 → 整条序列 O(n)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="800" height="20" as="geometry"/></mxCell><mxCell id="p1_s4_body" value="硬币另一面 —— 历史 K/V 全部常驻显存：显存决定能同时跑多少请求、每条请求能多长" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="800" height="45" as="geometry"/></mxCell><mxCell id="p1_concl" value="时间换空间：把「重复计算」换成「常驻显存」 —— 历史 K/V 算一次、存进显存，之后每步增量 + 读缓存；显存自此成为核心资源，问题从「怎么算」变成「怎么管显存」 → 见 P2 · 0.2 为什么分页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1520" height="70" as="geometry"/></mxCell><mxCell id="p1_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="360" height="190" as="geometry"/></mxCell><mxCell id="p1_c1_title" value="无缓存的账单 · O(n²)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#01579b;" vertex="1" parent="1"><mxGeometry x="868" y="105" width="344" height="22" as="geometry"/></mxCell><mxCell id="p1_c1_body" value="每个站点都要算一遍注意力（q × 全部 K/V）&#10;站点数 = 1 + 2 + 3 + … + n&#10;＝ Σ(1+2+…+n) → 等效代价 O(n²)&#10;角标 Σ：1 个站点 + 2 个 + 3 个 … 逐累加，整条序列 Σ(1+2+…+n) 等效代价 O(n²)&#10;每步都比上一步更慢&#10;→ 长序列直接不可接受" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="340" height="154" as="geometry"/></mxCell><mxCell id="p1_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="340" width="360" height="200" as="geometry"/></mxCell><mxCell id="p1_c2_title" value="有缓存的账单 · O(n)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="345" width="344" height="22" as="geometry"/></mxCell><mxCell id="p1_c2_body" value="每步 O(1) 份增量计算 + 一次缓存读取&#10;→ 整条序列 O(n)&#10;&#10;硬币另一面 —— 历史 K/V 全部常驻显存&#10;显存决定能同时跑多少请求、每条请求能多长" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="370" width="340" height="164" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="860" y="590" width="360" height="110" as="geometry"/></mxCell><mxCell id="p1_c3_title" value="图例" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="595" width="344" height="22" as="geometry"/></mxCell><mxCell id="p1_c3_body" value="红格 = 被重算的历史 token ｜ 黄格 = 新 token 增量&#10;淡蓝格 = K、淡绿格 = V ｜ 灰格 = 空闲" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="870" y="620" width="340" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d00-p2-why-paging" name="P2 为什么分页"><mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="P2 · 为什么分页（归属 00 · 0.2）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="p2_s1_label" value="① 连续预留：请求 A 一次绑死 max_model_len = 4096 槽" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="800" height="30" as="geometry"/></mxCell><mxCell id="p2_s1_desc" value="天真做法：每个请求按 max_model_len 一次性预留一段连续显存（请求 A 实际只用 60 个 token 槽）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="800" height="20" as="geometry"/></mxCell><mxCell id="p2_s1_region" value="一次绑死 4096 槽 —— 请求 A 独占的连续预留区（图中 64 格 ≙ 4096 槽：每格 ≙ 64 个真实槽；亮橙 8 格 ≙ 实际 60 槽）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="113" width="800" height="20" as="geometry"/></mxCell><mxCell id="p2_s1g_0" value="实际 60 槽" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="138" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s1g_1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="138" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s1g_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="138" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s1g_3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="138" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s1g_4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="138" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s1g_5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillCo