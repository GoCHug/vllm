try"/></mxCell><mxCell id="p2_s4_b12" value="块 12&#10;空闲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="780" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s4_b13" value="块 13&#10;请求B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="780" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s4_b14" value="块 14&#10;请求C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="780" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s4_b15" value="块 15&#10;空闲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="780" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_s4_ids" value="block_id = 7 (L0) ｜ block_id = 2 (L1) ｜ block_id = 9 (L2) ｜ block_id = 1 (L3)&#10;点亮 ★ = 请求 A 的 4 个块（对应左侧翻译卡）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="818" width="550" height="42" as="geometry"/></mxCell><mxCell id="p2_flow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;" edge="1" parent="1" source="p2_s3_block3" target="p2_s4_bt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_s5_label" value="⑤ 效果：碎片趋近 0，并发 ×2-4" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="800" height="30" as="geometry"/></mxCell><mxCell id="p2_s5_desc" value="num_blocks / block_id / BlockPool 都是「分页」落地名词 → 四要素与两条铁律见 P3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="800" height="20" as="geometry"/></mxCell><mxCell id="p2_s5_body" value="效果：碎片趋近 0 —— 领块按需（写满才领，不预留）、回收即时（还给块池立刻复用）→ 同样显存约容纳 2-4 倍并发请求" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="973" width="810" height="60" as="geometry"/></mxCell><mxCell id="p2_ca" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="360" height="105" as="geometry"/></mxCell><mxCell id="p2_ca_title" value="票据 · 请求 A" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="105" width="344" height="22" as="geometry"/></mxCell><mxCell id="p2_ca_body" value="max_model_len = 4096 一次性预留 4096 槽&#10;实际仅用 60 槽（≈1.5%）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="340" height="69" as="geometry"/></mxCell><mxCell id="p2_cb" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="360" height="140" as="geometry"/></mxCell><mxCell id="p2_cb_title" value="两类浪费" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="868" y="245" width="344" height="22" as="geometry"/></mxCell><mxCell id="p2_cb_body" value="内部浪费（预留即占用，60/4096 在转）＋外部碎片（零散空闲拼不成连续段）→ 旧材料实测：这种连续预分配的显存利用率只有 20%-40%" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="270" width="340" height="104" as="geometry"/></mxCell><mxCell id="p2_cc" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="475" width="360" height="115" as="geometry"/></mxCell><mxCell id="p2_cc_title" value="票据 · 请求 B" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="480" width="344" height="22" as="geometry"/></mxCell><mxCell id="p2_cc_body" value="需要连续 16 槽；总空闲够 → 却进不来&#10;（要 16 连格 ✗）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="505" width="340" height="79" as="geometry"/></mxCell><mxCell id="p2_cd" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" vertex="1" parent="1"><mxGeometry x="860" y="625" width="360" height="115" as="geometry"/></mxCell><mxCell id="p2_cd_title" value="票据 · 请求 A 分块" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#01579b;" vertex="1" parent="1"><mxGeometry x="868" y="630" width="344" height="22" as="geometry"/></mxCell><mxCell id="p2_cd_body" value="已产出 60 token，按 block_size=16&#10;→ 4 块（写满一块才领一块）&#10;60 token → 切 4 块" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="870" y="655" width="340" height="79" as="geometry"/></mxCell><mxCell id="p2_ce" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="775" width="360" height="150" as="geometry"/></mxCell><mxCell id="p2_ce_title" value="效果：碎片趋近 0" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="780" width="344" height="22" as="geometry"/></mxCell><mxCell id="p2_ce_body" value="徽章 ① 无外部碎片：块用完即回收，立刻可再分给别的请求&#10;&#10;徽章 ② 利用率 ↑：同样显存约容纳 2-4 倍并发请求" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="805" width="340" height="114" as="geometry"/></mxCell><mxCell id="p2_cf" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="860" y="955" width="360" height="100" as="geometry"/></mxCell><mxCell id="p2_cf_title" value="图例" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="960" width="344" height="22" as="geometry"/></mxCell><mxCell id="p2_cf_body" value="橙=请求A实际使用 ｜ 金=请求A的块（点亮）&#10;蓝=请求B ｜ 绿=请求C ｜ 灰=空闲&#10;粗黑框=块边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="870" y="985" width="340" height="64" as="geometry"/></mxCell><mxCell id="p2_link1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1" source="p2_s4_bt" target="p2_s4_b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_link2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1" source="p2_s4_bt" target="p2_s4_b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_link3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1" source="p2_s4_bt" target="p2_s4_b9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_link4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1" source="p2_s4_bt" target="p2_s4_b1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d00-p3-block-mental" name="P3 块模型心智图"><mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_title" value="P3 · 块模型心智图（归属 00 · 0.3 + 0.4）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="p3_s1_label" value="① 公共例子：60 token → 4 块 → block_table = [7,2,9,1]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="800" height="30" as="geometry"/></mxCell><mxCell id="p3_s1_desc" value="票据 · 请求 A 已产出 60 个 token（全库公共例子：B/C/D 章复用）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="800" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_gen" value="逐 token 生成 →" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="180" height="20" as="geometry"/></mxCell><mxCell id="p3_s1_b0" value="逻辑块 0&#10;t0..t15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="100" height="40" as="geometry"/></mxCell><mxCell id="p3_s1_b1" value="逻辑块 1&#10;t16..t31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="145" width="100" height="40" as="geometry"/></mxCell><mxCell id="p3_s1_b2" value="逻辑块 2&#10;t32..t47" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="145" width="100" height="40" as="geometry"/></mxCell><mxCell id="p3_s1_b3" value="逻辑块 3&#10;t48..t59" style="round