xt;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="781" width="480" height="16" as="geometry"/></mxCell><mxCell id="p3_s3_right" value="同一 block_id 在所有层都指向同一行 → 全模型只需一份 block_table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="756" width="290" height="40" as="geometry"/></mxCell><mxCell id="p3_s4_label" value="④ 四要素：心智图的 4 个核心变量" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="800" height="30" as="geometry"/></mxCell><mxCell id="p3_s4_desc" value="block_size / page_size_bytes / num_blocks / block_table —— 职责与锚点见右侧四张卡" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="800" height="20" as="geometry"/></mxCell><mxCell id="p3_s4_chain" value="token →（每 16 切一块）→ 逻辑块 →（翻译卡）→ block_id →（== 行号）→ K/V 张量第 0 维行" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="800" height="30" as="geometry"/></mxCell><mxCell id="p3_s5_label" value="⑤ 换算公式与张量形状" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="946" width="800" height="30" as="geometry"/></mxCell><mxCell id="p3_s5_desc" value="块数 = ceil(序列长度 ÷ block_size)；token 下标 = block_index × block_size + 块内 offset" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="976" width="800" height="20" as="geometry"/></mxCell><mxCell id="p3_s5_body" value="GPU 显存仓库 · kv_caches[layer] [num_blocks, num_kv_heads, block_size, 2*head_dim]&#10;图例：金=请求A点亮行 ｜ 蓝=请求B ｜ 绿=请求C ｜ 灰=空闲行 ｜ 浅色小格=槽位（已写/空）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="800" height="44" as="geometry"/></mxCell><mxCell id="p3_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="360" height="170" as="geometry"/></mxCell><mxCell id="p3_c1_title" value="铁律 ① —— 调度只认 block_id" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="868" y="105" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c1_body" value="调度侧只对整数 block_id 记账，从不触碰显存数据；kernel 只认张量行号 → 两套语言互不越界：调度全程零显存拷贝，物理张量启动一次申请、此后不再变动（行索引：vllm/v1/worker/gpu_model_runner.py:563）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="340" height="134" as="geometry"/></mxCell><mxCell id="p3_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1"><mxGeometry x="860" y="295" width="360" height="180" as="geometry"/></mxCell><mxCell id="p3_c2_title" value="铁律 ② —— block_id == 张量第 0 维行号" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="868" y="300" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c2_body" value="逻辑块 KVCacheBlock 的 block_id ∈ [0, num_blocks)，与物理行一一对应（vllm/v1/core/kv_cache_utils.py:118）；同一 block_id 在所有层都指向同一行 → 全模型只需一份 block_table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="325" width="340" height="144" as="geometry"/></mxCell><mxCell id="p3_c3a" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="360" height="90" as="geometry"/></mxCell><mxCell id="p3_c3a_title" value="① block_size（块容量）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="505" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c3a_body" value="一块装多少 token，全局统一，默认 16 锚点：vllm/config/cache.py:47、:49； KVCacheSpec.block_size（kv_cache_interface.py:106）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="530" width="340" height="54" as="geometry"/></mxCell><mxCell id="p3_c3b" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="615" width="360" height="90" as="geometry"/></mxCell><mxCell id="p3_c3b_title" value="② page_size_bytes（块字节）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="620" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c3b_body" value="一个物理块占的显存字节数，类型差异集中于此 锚点：vllm/v1/kv_cache_interface.py:109（各 Spec 多态实现）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="645" width="340" height="54" as="geometry"/></mxCell><mxCell id="p3_c3c" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="730" width="360" height="90" as="geometry"/></mxCell><mxCell id="p3_c3c_title" value="③ num_blocks（池容量）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="735" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c3c_body" value="显存总字节 ÷ page_size_bytes 锚点：gpu_model_runner.py:7389； get_num_blocks（vllm/v1/core/kv_cache_utils.py:993）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="760" width="340" height="54" as="geometry"/></mxCell><mxCell id="p3_c3d" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="845" width="360" height="90" as="geometry"/></mxCell><mxCell id="p3_c3d_title" value="④ block_table（翻译器）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="850" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c3d_body" value="逻辑块号 → 物理 block_id，每请求一份 锚点：封装为 KVCacheBlocks （vllm/v1/core/kv_cache_manager.py:33）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="875" width="340" height="54" as="geometry"/></mxCell><mxCell id="p3_c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" vertex="1" parent="1"><mxGeometry x="860" y="960" width="360" height="115" as="geometry"/></mxCell><mxCell id="p3_c4_title" value="换算公式" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#01579b;" vertex="1" parent="1"><mxGeometry x="868" y="965" width="344" height="22" as="geometry"/></mxCell><mxCell id="p3_c4_body" value="token 下标 = block_index × block_size + 块内 offset&#10;块数 = ceil(序列长度 ÷ block_size)&#10;num_blocks = numel() ÷ page_size_bytes（gpu_model_runner.py:7389）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="870" y="990" width="340" height="79" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>