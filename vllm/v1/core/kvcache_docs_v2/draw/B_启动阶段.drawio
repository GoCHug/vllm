                <mxCell id="rc_sp_bd" value="FullAttentionSpec 规格牌（本章例值）： block_size=16｜num_kv_heads=4（TP 后）｜head_size=128｜head_size_v=128｜dtype=bf16(2B)｜kv_quant_mode=NONE｜sliding_window=None｜attention_chunk_size=None｜non_causal=False｜indexes_kv_by_block_stride=视后端（GMR:7810-7816）。 页：16×4×(128+128)×2B = 32 KiB/层/块（TP1 8 头版 64 KiB →A2.1；GQA 8 头较满 32 头省 4 倍）。" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="376" width="340" height="111" as="geometry"/></mxCell>
                <mxCell id="rc_mech" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="519" width="360" height="127" as="geometry"/></mxCell>
                <mxCell id="rc_mech_bd" value="TP 切头：GQA 8 个 KV 头 → 每卡 4 个（vllm/config/model.py:1384 get_num_kv_heads）；PP 切层：32 层 → 每卡 16 层（vllm/config/model.py:1407）。每层 spec 在切分后参数上产出（GMR:7793-7794）；kv_sharing 层跳过（GMR:7796-7807，本主线无）；encoder-only 层返回 None 跳过（attention.py:629-630）。page_size_bytes = block_size × num_kv_heads × (head+head_v) × dtype（KI:338-342）。" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="527" width="340" height="111" as="geometry"/></mxCell>
                <mxCell id="leg_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="958" width="360" height="106" as="geometry"/></mxCell>
                <mxCell id="leg_tt" value="图例" style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="962" width="340" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw0_0" value="spec / 主线卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="872" y="982" width="58" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw0_1" value="组卡/TP1 子集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="934" y="982" width="58" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw1_0" value="同款省略 …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="872" y="1006" width="58" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw1_1" value="对照 / 兜底卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="934" y="1006" width="58" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_r2" value="虚线箭头 = 支路 / 映射；蓝=主线，绿=次类型" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="870" y="1030" width="340" height="18" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="B-boot-p3" name="P3 · 测预算">
        <mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title_" value="P3 · 测预算（归属 B3）" style="text;html=1;fontSize=20;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="780" height="40" as="geometry"/></mxCell>
                <mxCell id="sub_" value="公式链：total → requested → 扣项 → available → 预算校验 → num_blocks → min 对齐｜输出=每卡 num_blocks（演算 4096）＋写进 cache_config 的容量数值。机制一次讲清：profile 量峰 ＋ 水位除法。" style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="780" height="37" as="geometry"/></mxCell>
                <mxCell id="s1_label" value="① 进水：requested 总额（横条 = 显存示意宽）" style="text;html=1;fontSize=16;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="540" height="30" as="geometry"/></mxCell>
                <mxCell id="s1_desc" value="1 · 进水：total_memory（init_snapshot 显存快照 gpu_worker.py:394-398）→ requested = ceil(total × gpu_memory_utilization)（wutils.py:393-400）；free 不足 → ValueError（wutils.py:402-411）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="780" height="33" as="geometry"/></mxCell>
                <mxCell id="s1_bar" value="requested ＝ ceil(total × gpu_memory_utilization)（条宽示意）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="700" height="26" as="geometry"/></mxCell>
                <mxCell id="s1_note" value="条宽 = 显存占比示意，非严格等比" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="320" height="16" as="geometry"/></mxCell>
                <mxCell id="s2_label" value="② 舀出扣项（non_kv_cache_memory）" style="text;html=1;fontSize=16;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="430" height="30" as="geometry"/></mxCell>
                <mxCell id="s2_desc" value="2 · 舀出扣项：non_kv_cache_memory = total_consumed（权重＋激活＋非torch，mem_utils.py:317-326）＋ transient_peak_headroom（:323-325）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="780" height="18" as="geometry"/></mxCell>
                <mxCell id="s2_b1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="280" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_l1" value="权重 weights（驻留，随 weights_memory 传入）mem_utils.py:294-296、:317-319" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="328" y="270" width="452" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_b2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="150" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_l2" value="激活峰值：transient_peak_headroom = torch_peak − torch_allocated（mem_utils.py:323-325）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="198" y="300" width="582" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_b3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="70" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_l3" value="非 torch：NCCL / 通信 buffer 等（mem_utils.py:311）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="118" y="330" width="662" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_b4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="110" height="24" as="geometry"/></mxCell>
                <mxCell id="s2_l4" value="CUDA graph 预算估算（默认计入 gpu_worker.py:511-516、:519-523）&#10;→ 再舀 ↓ 再扣 graph" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="158" y="356" width="622" height="36" as="geometry"/></mxCell>
                <mxCell id="s2_total" value="合计扣项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="610" height="26" as="geometry"/></mxCell>
                <mxCell id="s3_label" value="③ 再舀得 available ＆ 准入校验" style="text;html=1;fontSize=16;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="430" height="30" as="geometry"/></mxCell>
                <mxCell id="s3_desc" value="3 · 再舀：cudagraph_memory_estimate → available = requested − non_kv − cudagraph（gpu_worker.py:543-547）→ 例 2 GiB（多模态 IPC 保留 :606-610，本主线原值）&#10;4 · 校验：装得下一条跑满 max_model_len=8192 的请求？needed = cdiv(8192,16)×32KiB×16层 = 256MiB ≪ 2GiB ✓（KCU:2166-2174 → :751-788；needed 公式 :1869-1892）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="780" height="62" as="geometry"/></mxCell>
                <mxCell id="s3_avail" value="得 available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="534" width="180" height="26" as="geometry"/></mxCell>
                <mxCell id="s3_gold" value="KV 金色水位 = available 全额可配给 KV（例 2 GiB，gpu_worker.py:543-547）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="240" y="528" width="430" height="28" as="geometry"/></mxCell>
                <mxCell id="s3_wmline" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="180" height="2" as="geometry"/></mxCell>
                <mxCell id="s3_wm" value="watermark 警戒线（默认 0.0 · 运行期准入门槛 · 启动不预扣）" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="240" y="562" width="430" height="20" as="geometry"/></mxCell>
                <mxCell id="s3_stamp" value="过审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="530" width="84" height="24" as="geometry"/></mxCell>
                <mxCell id="s4_ramp" value="读数 → 上台阶" style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="592" width="220" height="16" as="geometry"/></mxCell>
                <mxCell id="s4_label" value="④ 阶梯除法：÷32KiB ÷16（每步一阶）" style="text;html=1;fontSize=16;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="460" height="30" as="geometry"/></mxCell>
                <mxCell id="s4_formula" value="5 · 阶梯除法（每步一阶）：2 GiB ÷ 32 KiB = 65536 页（页 = 16×4×256×2B，KI:338-342）→ ÷ 16（组内层数）= 4096 块（KCU:1390-1416；get_num_blocks :993-1010；max(0) 与 override :962-969）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="646" width="660" height="37" as="geometry"/></mxCell>
                <mxCell id="s4_stamp" value="除法完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="704" y="652" width="84" height="24" as="geometry"/></mxCell>
                <mxCell id="s4_div16" value="除 16！（每卡组内 16 层 × 一层一页 → 一块真实代价 512 KiB）不除 32：num_blocks 算在投影后的每卡组上（KCU:2177-2187 传 projected_groups；group_size = max(len(layer_names)) = 16，KCU:1399）→ 详见 B3/B4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="660" height="43" as="geometry"/></mxCell>
                <mxCell id="s4_blk" value="每块 16 token → 跨组内 16 层 = 512 KiB（KCU:972-990）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="340" height="42" as="geometry"/></mxCell>
                <mxCell id="s5_label" value="⑤ min 对齐 → 每卡订货单" style="text;html=1;fontSize=16;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="822" width="430" height="30" as="geometry"/></mxCell>
                <mxCell id="s5_card" value="6 · min 对齐：四卡各算 → 取全 worker 最小值 → 订货单 size 等比缩小（KCU:2192-2202）——集中式调度共享同一 block_id 空间，以最穷的卡设上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="660" height="41" as="geometry"/></mxCell>
                <mxCell id="s5_stamp" value="对齐产出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="704" y="862" width="84" height="24" as="geometry"/></mxCell>
                <mxCell id="bar_" value="7 · 产出：KVCacheConfig{num_blocks=4096; 订货单 16×128MiB（shared_by 单层）; 1 组×16 层}（KCU:2183-2202；KI:953-967）；core.py:314 → num_gpu_blocks；:317 → 块尺寸；:320-324 → 容量 / 并发度（口径取自 deepcopy 0 号卡，KCU:1834-1853）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="988" width="780" height="62" as="geometry"/></mxCell>
                <mxCell id="rcA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="88" width="360" height="98" as="geometry"/></mxCell>
                <mxCell id="rcA_bd" value="显存水桶 · profile run 后的可用余量：requested − 扣项 = available（gpu_worker.py:543-547）→ 本例 2 GiB/卡。外壳：memory_profiling 前后双快照（mem_utils.py:234、:289-326）；内核：_dummy_run(max_num_tokens, is_profile=True)（GMR:6471-6473）。" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="96" width="340" height="82" as="geometry"/></mxCell>
                <mxCell id="rcB" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="198" width="360" height="98" as="geometry"/></mxCell>
                <mxCell id="rcB_bd" value="watermark（B3.5）：∈[0,1) 默认 0.0（vllm/config/scheduler.py:136-141）；watermark_blocks = int(w×num_blocks)（kvcm.py:170-171；sched.py:284 传入）；只对 waiting / preempted 准入计入 required_blocks（kvcm.py:463-470、:522-524）；启动不预扣、默认 0 完全不生效 → D2。" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="206" width="340" height="82" as="geometry"/></mxCell>
                <mxCell id="rcC" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="308" width="360" height="113" as="geometry"/></mxCell>
                <mxCell id="rcC_bd" value="旁路：① cache_config.kv_cache_memory_bytes 显式给值 → 跳过自动 profile、原样返回（gpu_worker.py:473-495，仍跑一次 profile 完成编译 :476）；② num_gpu_blocks_override 覆盖（KCU:962-969）＋ Engine 联动改写 available（:2144-2158）；③ max_model_len=−1 → 投影组二分自动拟合（KCU:2160-2163 → :800-851；广播 update_max_model_len core.py:309-311）。" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="316" width="340" height="97" as="geometry"/></mxCell>
                <mxCell id="rcD" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="433" width="360" height="113" as="geometry"/></mxCell>
                <mxCell id="rcD_bd" value="公式速查：page（单层一块）= 16×4×256×2B = 32 KiB；一块真实跨层代价 = group_size×page = 512 KiB（KCU:972-990）；num_blocks = 2048MiB // 32KiB // 16 = 4096（每卡编址行数）；单层张量 = 32KiB×4096 = 128 MiB；16 层 × 128MiB = 2 GiB 与 available 闭合；物理页总数 = 4096×16 层（num_blocks 数的是行号空间）。验收对应 B6.2 第 5/6 项。" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="870" y="441" width="340" height="97" as="geometry"/></mxCell>
                <mxCell id="leg_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="958" width="360" height="106" as="geometry"/></mxCell>
                <mxCell id="leg_tt" value="图例" style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="962" width="340" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw0_0" value="requested / 入账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="872" y="982" width="58" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw0_1" value="扣项条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="934" y="982" width="58" height="18" as="geometry"/></mxCell>
                <mxCell id="leg_sw0_2" value="available / 命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="996" y="982" width="58" height="18" as="geometry"/></mxCell>
