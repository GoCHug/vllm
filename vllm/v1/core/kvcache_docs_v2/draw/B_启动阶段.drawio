                <mxCell id="e_e3" value="否 →E3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7b1fa2;strokeWidth=1;endArrow=block;dashed=1;" edge="1" parent="1" source="s2_card" target="rc_fb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="525"/><mxPoint x="824" y="525"/><mxPoint x="824" y="250"/><mxPoint x="860" y="250"/></Array></mxGeometry></mxCell>
