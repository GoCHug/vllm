                <mxCell id="pool_note" value="点亮 #fff2cc = 00 章例块 1/2/7/9 命中；块边界 #333333 加粗；其余 = 空闲 #f5f5f5" style="text;html=1;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="720" height="18" as="geometry"/></mxCell>
                <mxCell id="bar_" value="验收口径：四卡 spec 全等（KCU:2117）· num_blocks 四卡一致（min 对齐）· 调度只认 block_id，对头切分 / 层切分透明（→C 章）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="780" height="56" as="geometry"/></mxCell>
                <mxCell id="s5_label" value="⑤ 验收自查（B6.2 · 11 项）" style="text;html=1;fontSize=16;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="88" width="360" height="30" as="geometry"/></mxCell>
                <mxCell id="rc_chk" value="验收自查（B6.2 清单） &#10;① 每卡层分布：16 层/卡（model.py:1407-1415）✓ &#10;② 每卡 KV 头数：4（TP 对半切 8，model.py:1384）✓ &#10;③ 组结构：全局 1 组 32 层 / 每卡投影 16 层（KCU:1036、:2031-2070）✓ &#10;④ 张量 shape：(4096,4,16,256)（flash_attn.py:144）✓ &#10;⑤ 页大小：32 KiB（16×4×256×2B，KI:338-342）✓ &#10;⑥ num_blocks=4096 四卡一致（KCU:1008、:2192-2194）✓ &#10;⑦ 订货单：16 张单 ×128MiB、shared_by=[单层]（KCU:1409-1416）✓ &#10;⑧ 底座/视图：int8 底座 ↔ bf16 视图零拷贝（GMR:7315、attn_utils.py:261-265）✓ &#10;⑨ 绑定：kv_caches 16 项有序＋forward context 齐备（wutils.py:476-503）✓ &#10;⑩ 管理层：Unitary 协调器＋FullAttentionManager×1＋4096 块池（kvcco.py:877-890、st.py:678、bp.py:175-181）✓ &#10;⑪ watermark_blocks=0 默认不缩池（scheduler.py:136、kvcm.py:171）✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="122" width="360" height="200" as="geometry"/></mxCell>
                <mxCell id="rc_case" value="00 章例转写：60-token 请求 block_table=[7,2,9,1] → 同一 block_id b 在每张卡都指本卡 16 张张量的第 b 行（min 对齐保证四卡行数一致，KCU:2192-2202）。W0 第 7 行 = layers.0–15 各自的页（头 0–3 那半）；W1 同层页（头 4–7）；PP 边界后 W2/W3 以同一 id 空间编址层 16–31（请求级解释 →C4）。null_block 占 id 0 → 实际可分配 4095（bp.py:190-191）。调度器对头切分 / 层切分透明：只认 block_id。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="334" width="360" height="176" as="geometry"/></mxCell>
                <mxCell id="rc_map" value="四卡对位速记&#10;· GPU0 = PP0·TP0：layers.0–15 · 头 0–3&#10;· GPU1 = PP0·TP1：layers.0–15 · 头 4–7（等值断言）&#10;· GPU2 = PP1·TP0：layers.16–31 · 头 0–3&#10;· GPU3 = PP1·TP1：layers.16–31 · 头 4–7&#10;同一 block_id ⇔ 每张卡本卡 16 张张量的第 b 行（min 对齐担保）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="522" width="360" height="160" as="geometry"/></mxCell>
