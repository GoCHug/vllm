="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#82b366;" parent="1" vertex="1"><mxGeometry x="634" y="248" width="160" height="16" as="geometry"/></mxCell><mxCell id="p3_q2_c1" value="顺序切段会让某 stage 空组、被迫垫 padding 浪费显存；group_size 4 → 每卡 2 层 → num_blocks = avail/page/2 翻倍（B3.4）；跨 stage num_blocks 取 min 收口（B3.6）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="484" y="282" width="332" height="58" as="geometry"/></mxCell><mxCell id="p3_q3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="394" width="380" height="268" as="geometry"/></mxCell><mxCell id="p3_q3_t" value="③ Q3 · DP 复制——整模型 N 份（图示 N=3）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="52" y="400" width="356" height="26" as="geometry"/></mxCell><mxCell id="p3_q3_d" value="什么都不切：三间镜像机房各跑各的（页 / 块表 / 锁口径原样）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="52" y="428" width="356" height="18" as="geometry"/></mxCell><mxCell id="p3_q3_c0" value="EngineCore DP0｜权重全份 · 独立五层架构 · Pool=num_blocks=2048" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="64" y="452" width="332" height="40" as="geometry"/></mxCell><mxCell id="p3_q3_c1" value="EngineCore DP1｜权重全份 · 独立五层架构 · Pool=num_blocks=2048" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="64" y="498" width="332" height="40" as="geometry"/></mxCell><mxCell id="p3_q3_c2" value="EngineCore DP2｜权重全份 · 独立五层架构 · Pool=num_blocks=2048" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="64" y="544" width="332" height="40" as="geometry"/></mxCell><mxCell id="p3_q3_r" value="请求 R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="64" y="592" width="96" height="28" as="geometry"/></mxCell><mxCell id="p3_q3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=none;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="606" as="sourcePoint"/><mxPoint x="408" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3_q3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=none;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="408" y="606" as="sourcePoint"/><mxPoint x="408" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3_q3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="408" y="470" as="sourcePoint"/><mxPoint x="396" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3_q3_e_t" value="整条请求路由到单一 rank" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="216" y="610" width="150" height="14" as="geometry"/></mxCell><mxCell id="p3_q3_note" value="容量判定只看本 rank get_num_free_blocks（BP:799）；跨 DP rank 不做 min 对齐（B3.6 的 min 仅跨同模型 TP/PP worker）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="64" y="626" width="332" height="30" as="geometry"/></mxCell><mxCell id="p3_q4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="394" width="380" height="268" as="geometry"/></mxCell><mxCell id="p3_q4_t" value="④ Q4 · CP/DCP——同一块 KV 沿 rank 再切" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="472" y="400" width="356" height="26" as="geometry"/></mxCell><mxCell id="p3_q4_d" value="一条调度口径的逻辑块 512 token（scheduler 视角 block_size ×= dcp_world_size · KVCCO:471-474）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="472" y="428" width="356" height="24" as="geometry"/></mxCell><mxCell id="p3_q4_sl" value="逻辑块 512 tok（全序列口径）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="488" y="456" width="240" height="14" as="geometry"/></mxCell><mxCell id="p3_q4_seg1" value="t0–255" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="488" y="474" width="110" height="30" as="geometry"/></mxCell><mxCell id="p3_q4_seg2" value="t256–511" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="606" y="474" width="110" height="30" as="geometry"/></mxCell><mxCell id="p3_q4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;dashed=1;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="543" y="504" as="sourcePoint"/><mxPoint x="543" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3_q4_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;dashed=1;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="661" y="504" as="sourcePoint"/><mxPoint x="661" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3_q4_l1" value="对撕 ↓ 前半" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="550" y="508" width="90" height="14" as="geometry"/></mxCell><mxCell id="p3_q4_l2" value="对撕 ↓ 后半" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="672" y="508" width="90" height="14" as="geometry"/></mxCell><mxCell id="p3_q4_c1" value="左撕半 · DCP rank0 存前半 t0-255（物理页 = 逻辑页 / CP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="476" y="530" width="176" height="60" as="geometry"/></mxCell><mxCell id="p3_q4_c2" value="右撕半 · DCP rank1 存后半 t256-511（物理页 = 逻辑页 / CP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="660" y="530" width="176" height="60" as="geometry"/></mxCell><mxCell id="p3_q4_mam" value="Mamba 整环例外（脚注）：递归状态跨 DCP/PCP 全量复制不切分（KI:721-722、ST:1260-1263）→ Hybrid+DCP 白名单只许 Full+Mamba（KVCCO:570-580）；PCP 拒绝混合（pcp==1 断言）；Mamba 组查找再拒 DCP/PCP（ST:1295-1296）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="476" y="598" width="332" height="58" as="geometry"/></mxCell><mxCell id="p3_s5_label" value="⑤ 一致性约束（E2.2）——跨 rank 相等与收口" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="702" width="780" height="30" as="geometry"/></mxCell><mxCell id="p3_s5_d" value="同组 spec 跨 TP rank 等值（同 stage 的 TP rank 提交同层名、字段全等——头数均为切分后值）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="736" width="760" height="20" as="geometry"/></mxCell><mxCell id="p3_constr" value="① 同组 spec 跨 TP rank 等值（B2.2 / KCU:2111-2120）· ② num_blocks 跨 TP/PP worker 取 min（B3.6）· ③ Hybrid+DCP 白名单仅 Full+Mamba、PCP 拒绝混合（KVCCO:570-580）· ④ Mamba 组断言 dcp==1 且 pcp==1（ST:1295-1296）· ⑤ 块编号空间跨卡一致：同一 block_id 各卡各自解释为同语义 buffer（C4.3）· ⑥ 块表仍按全序列记录，查命中带 dcp_world_size（ST:1289）；CP 物理页变小、id 空间不变（铁律②照旧）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="762" width="800" height="96" as="geometry"/></mxCell><mxCell id="p3_table" value="四变体对照速查：TP=只切不复制，页字节 ×1/TP → 32 KB/卡（B6.1），每卡独立 num_blocks；PP=stride 偶位切组（layers[i::num_groups]），组内层变少、num_blocks 翻倍，跨 stage 取 min；DP=整份复制，三间镜像机房各套各的，无 min 对齐（BP:799）；CP=逻辑页 scheduler 口径放大（bs ×= dcp_world_size），物理页 = 逻辑页 / CP，id 空间不变。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="884" width="800" height="96" as="geometry"/></mxCell><mxCell id="p3_concl" value="结论 · 并行变体只改「投影面与除数」：TP 把一层摊到多卡（页变小）、PP 把一组分层到多卡（块更少）、DP 复制整个引擎（吞吐翻倍）、CP 把一块沿 rank 对分（物理页更小）——块表语义、调度时序、BlockPool 编址全保持不变；跨卡一致性由⑤五条约束守护。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="1004" width="800" height="76" as="geometry"/></mxCell><mxCell id="p3_rc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="160" as="geometry"/></mxCell><mxCell id="p3_rc_A_title" value="四变体一句话" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="100" width="352" height="22" as="geometry"/></mxCell><mxCell id="p3_rc_A_txt" value="TP：同层 KV 头竖切两瓣（8→4），页 32 KB/卡&#10;PP：组内层 stride 切两碟（L8,L10｜L9,L11）&#10;DP：整份复制 N=3，三间镜像机房&#10;CP：物理页 = 逻辑页 / CP，scheduler 口径 bs ×= dcp_world_size（KVCCO:471-474）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="126" width="332" height="116" as="geometry"/></mxCell><mxCell id="p3_rc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="268" width="360" height="140" as="geometry"/></mxCell><mxCell id="p3_rc_B_title" value="容量除数公式" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="276" width="352" height="22" as="geometry"/></mxCell><mxCell id="p3_rc_B_txt" value="TP：page/卡 = 全页 × head/TP → 8→4 = ×1/2 = 32 KB&#10;PP：num_blocks = avail/page/(group_size/PP)，跨 stage min&#10;DP：num_blocks 不变，各 rank 独立判定（BP:799）&#10;CP：物理页 = 逻辑页 / CP；逻辑 bs' = bs × dcp_world_size" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="874" y="302" width="332" height="96" as="geometry"/></mxCell><mxCell id="p3_rc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="424" width="360" height="140" as="geometry"/></mxCell><mxCell id="p3_rc_C_title" value="同 block_id 的跨卡语义" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="432" width="352" height="22" as="geometry"/></mxCell><mxCell id="p3_rc_C_txt" value="TP = 拼同一头（两卡各持不同头子集）&#10;DP = 各自的请求（各套各的）&#10;CP = 同一块的两半（拼回 512 token）&#10;PP = 不同层（stride 偶位互补）&#10;spec 相等 ≠ 物理同份——同 id 各自解释为同语义 buffer（C4.3）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="458" width="332" height="96" as="geometry"/></mxCell><mxCell id="p3_rc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="580" width="360" height="140" as="geometry"/></mxCell><mxCell id="p3_rc_D_title" value="Mamba 并行白名单" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="588" width="352" height="22" as="geometry"/></mxCell><mxCell id="p3_rc_D_txt" value="Hybrid+DCP 仅 Full+Mamba（KVCCO:570-580）；PCP 拒绝混合；Mamba 组断言 dcp==1 &amp; pcp==1（ST:1295-1296）；递归状态跨 DCP/PCP 全量复制不切分（KI:721-722、ST:1260-1263）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="614" width="332" height="96" as="geometry"/></mxCell><mxCell id="p3_rc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="736" width="360" height="166" as="geometry"/></mxCell><mxCell id="p3_rc_L_title" value="图例" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="742" width="360" height="20" as="geometry"/></mxCell><mxCell id="p3_rc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="766" width="30" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_t0" value="本卡持有的头 / 层 / 块段" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="766" width="280" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="788" width="30" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_t1" value="对卡持有的头（灰珠）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="788" width="280" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="810" width="30" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_t2" value="PP Stage1 组（绿）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="810" width="280" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="832" width="30" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_t3" value="Mamba 例外 / 白名单警示" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="832" width="280" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="854" width="30" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_t4" value="四象限容器（容灰边）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="854" width="280" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_L_note" value="虚线 = 切分 / 映射关系 · 实线 = 路由流向" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="878" y="878" width="320" height="18" as="geometry"/></mxCell><mxCell id="p3_rc_F_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="916" width="360" height="150" as="geometry"/></mxCell><mxCell id="p3_rc_F_title" value="索引与记账不变项" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="924" width="352" height="22" as="geometry"/></mxCell><mxCell id="p3_rc_F_txt" value="块表仍按全序列记录；查命中带 dcp_world_size（ST:1289）；block_id 空间跨卡一致（C4.3）；调度器对 TP/PP 切分无感知（B2.4 投影 KCU:2031-2070）；PP 跨 stage num_blocks 取 min（B3.6），DP 无 min 对齐（BP:799）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="950" width="332" height="106" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="P4_" name="P4 · KV Connector 数据流"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0"