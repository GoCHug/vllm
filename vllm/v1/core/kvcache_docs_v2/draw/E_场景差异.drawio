" y="912" width="332" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="P2_" name="P2 · 页字节统一四路线"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="P2 · 页字节统一四路线（归属 E1.2）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="p2_s0" value="主场景：两族页不等（Full 65,536 B / Mamba·GDN 262,144 B / HND 98,304 B）→ unify_kv_cache_spec_page_size（KCU:1070-1132）用四路线判定链把所有 spec 拉到统一 max 页 262,144 B —— 等大页 + block_id==张量行号（铁律②）必须保住" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1520" height="34" as="geometry"/></mxCell><mxCell id="p2_s1_label" value="① 输入清单 kv_cache_spec · 三块页（层名 → spec）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="90" width="620" height="30" as="geometry"/></mxCell><mxCell id="p2_s1_d" value="三块页宽不齐，逐层归类；max_page_size 取全组最大（KCU:1091-1096）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="124" width="700" height="20" as="geometry"/></mxCell><mxCell id="p2_pg_full" value="页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="120" y="150" width="50" height="30" as="geometry"/></mxCell><mxCell id="p2_pg_mam" value="页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;" parent="