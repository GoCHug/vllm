eometry x="40" y="1022" width="760" height="16" as="geometry"/></mxCell><mxCell id="p4_concl" value="三问收口（E4.1~E4.3）：改了什么 = 前缀来源「本地哈希表」→「本地 + 连接器」、可用量 free → free−reserved、缓存时点可延迟；为什么 = KV 可在别处算好再搬进来，调度与记账必须先为这些 token 预定槽位；管理上多出 = 混合感知查找变体（hit_diverged）、ext_comp 第二分配来源段、reserved 扣减项、WAITING_FOR_REMOTE_KV 状态闭环。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="1044" width="800" height="52" as="geometry"/></mxCell><mxCell id="p4_rc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="160" as="geometry"/></mxCell><mxCell id="p4_rc_A_title" value="外部 KV 云（连接器命中段）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="100" width="352" height="22" as="geometry"/></mxCell><mxCell id="p4_rc_A_txt" value="外部 KV Connector（P/D 分离：LMCache · Nixl / offloading）：远端引擎已把 prompt 128 中 96 token 算好——KV 已算、却不在本地哈希表，调度记账必须先为这些 token 预槽（ext_comp 段；可同步搬入 load_kv_async=false，或异步拖后）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="126" width="332" height="116" as="geometry"/></mxCell><mxCell id="p4_rc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="268" width="360" height="140" as="geometry"/></mxCell><mxCell id="p4_rc_B_title" value="落槽与 reserved 公式" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="276" width="352" height="22" as="geometry"/></mxCell><mxCell id="p4_rc_B_txt" value="available = free − reserved&#10;reserved = Σ in-flight prefill 余需&#10;（SCH:2573-2578）&#10;num_computed_tokens = 32 + 96 = 128&#10;空间检查 required &gt; free − reserved −&#10;  watermark → 拒排（KCM:472-488）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="874" y="302" width="332" height="96" as="geometry"/></mxCell><mxCell id="p4_rc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="424" width="360" height="200" as="geometry"/></mxCell><mxCell id="p4_rc_C_title" value="两阶段分配（issue #33775，同 E1.4⑤）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="432" width="352" height="22" as="geometry"/></mxCell><mxCell id="p4_rc_C_txt" value="阶段②条件多一条 ext_comp&gt;0（KCM:529-532）：ext 的 token 不来自本地哈希表、却仍需物理块——补窗内跳不掉的槽位（ST:291-328，get_num_skipped_tokens 抵扣）；先全组 touch 本地命中 → allocate_external_computed_blocks 补 ext 段新块（吊装）；阶段③新块分配补足 new+lookahead；阶段④ cache_blocks 写回——delay_cache_blocks=True 时延后（KCM:542-565）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="458" width="332" height="156" as="geometry"/></mxCell><mxCell id="p4_rc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="640" width="360" height="170" as="geometry"/></mxCell><mxCell id="p4_rc_D_title" value="异步支线 · WAITING_FOR_REMOTE_KV" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="648" width="352" height="22" as="geometry"/></mxCell><mxCell id="p4_rc_D_txt" value="load_kv_async=true：num_new_tokens=0 仍须 allocate_slots 占位（KCM:440-446；SCH:839-842）；delay_cache_blocks=True → 阶段④缓存延后（KCM:549-552）；到货 _update_waiting_for_remote_kv 补写 cache_blocks，失败清零回收、退出 failed_recving_kv_req_ids（SCH:2580-2615）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="674" width="332" height="126" as="geometry"/></mxCell><mxCell id="p4_rc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="826" width="360" height="170" as="geometry"/></mxCell><mxCell id="p4_rc_L_title" value="图例" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="832" width="360" height="20" as="geometry"/></mxCell><mxCell id="p4_rc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="856" width="30" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_t0" value="本地命中 comp/new_comp（蓝）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="856" width="280" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="878" width="30" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_t1" value="外部 ext_comp（红箱·红）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="878" width="280" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="900" width="30" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_t2" value="新块 new（绿）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="900" width="280" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="922" width="30" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_t3" value="reserved 边沿 / 改道警示" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="922" width="280" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="944" width="30" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_t4" value="look / free（灰）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="944" width="280" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_L_note" value="实线 = 流向 · 虚线 = 异步 / 映射" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="878" y="968" width="320" height="18" as="geometry"/></mxCell><mxCell id="p4_rc_F_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="1004" width="360" height="94" as="geometry"/></mxCell><mxCell id="p4_rc_F_title" value="海关闸机 · 改道章（改动点①）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="1012" width="352" height="22" as="geometry"/></mxCell><mxCell id="p4_rc_F_txt" value="混合组命中可分歧（FA 尾被逐 / Mamba checkpoint 还在，反之亦然）→ 以 FullAttention 组命中为准 + 返回 hit_diverged；非混合 / 已收敛直通 get_computed_blocks（KCM:318-321）——同一关卡。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="1038" width="332" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="P5_" name="P5 · MLA/GDN 部署差异"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_title" value="P5 · MLA / GDN 部署差异对照（归属 E3）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="p5_s0" value="主场景：两个变体家族 × 三行差异（初始化 / 索引 / 释放）——MLA = latent 压缩「页变宽」· GDN = 状态环「生命周期」——机制详情只留链接 → A2 / C5 / C6 / E1" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1520" height="34" as="geometry"/></mxCell><mxCell id="p5_s1_label" value="① MLA 页结构 · 两管串接、无 head 维拆分（DeepSeek-V3/V2 类）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="88" width="780" height="30" as="geometry"/></mxCell><mxCell id="p5_s1_d" value="每 token 定宽 656 B（V3 fp8_ds）/ 584 B（V4）由 spec 写死（KI:397-416 → A2.2）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="122" width="780" height="16" as="geometry"/></mxCell><mxCell id="p5_latent" value="latent c_kv 管（压缩潜向量）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="148" width="170" height="34" as="geometry"/></mxCell><mxCell id="p5_plus" value="+" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="236" y="148" width="26" height="34" as="geometry"/></mxCell><mxCell id="p5_rope" value="rope k_pe 管（解耦旋转）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="266" y="148" width="170" height="34" as="geometry"/></mxCell><mxCell id="p5_eq" value="=" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="444" y="148" width="30" height="34" as="geometry"/></mxCell><mxCell id="p5_page" value="页 = 两管串接 · 无 head 维拆分（A2.2）· 页内 token 少而页值大" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="492" y="148" width="250" height="34" as="geometry"/></mxCell><mxCell id="p5_s2_label" value="② MLA 初始化 &amp; 索引：单 group 免统一 · 与基准同构（页更宽）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="196" width="780" height="30" as="geometry"/></mxCell><mxCell id="p5_s2_d" value="DSv4 storage_block_size = bs/compress_ratio → 物理块容纳多逻辑段（KI:393-395）；含 alignment 自动上取整（KI:345-351 → A3.5）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="230" width="780" height="16" as="geometry"/></mxCell><mxCell id="p5_m_init" value="① 初始化差异：全层同为 MLAAttentionSpec → 单 group、走 B2.3 主线「全同」分支（A5.1 merge 全等）；页天然全等、无需跨层统一——is_kv_cache_page_size_uniform 直接 True（KCU:1056-1067），不经过 E1.2 四路线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="254" width="380" height="92" as="geometry"/></mxCell><mxCell id="p5_m_idx" value="② 索引差异：与基准同构——slot_mapping 写 + kernel 吃 block_table tensor（flashattn_mla.py:199/252，C5/C6.3 行 2）；页更宽（A2.2 / C6.2 心智不变）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="254" width="380" height="92" as="geometry"/></mxCell><mxCell id="p5_m_c1" value="→ A2.2 / A3.5 / A5.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="352" width="130" height="22" as="geometry"/></mxCell><mxCell id="p5_m_c2" value="→ C5 / C6.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="352" width="100" height="22" as="geometry"/></mxCell><mxCell id="p5_m_rel" value="③ 释放策略差异：与基准一致——满块写回（C3.4）→ ref_cnt 归 0 回收（C2.3/D6），无任何特殊化；特例 SlidingWindowMLA 属 DSv4 packed 通道（KCU:1571-1611 → E1.2 注），不占通用主线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="382" width="380" height="66" as="geometry"/></mxCell><mxCell id="p5_m_c3" value="→ C2.3 / C3.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="382" width="110" height="22" as="geometry"/></mxCell><mxCell id="p5_m_1s" value="一句话：MLA 是「页变宽」变体——除页因子外管理栈零改动（单 group，走基准主线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="460" y="410" width="380" height="38" as="geometry"/></mxCell><mxCell id="p5_s3_label" value="③ GDN 页 = 状态字节（Qwen3-Next / Mamba 类）· 必过统一（E1.2/E1.3）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="494" width="780" height="30" as="geometry"/></mxCell><mxCell id="p5_s3_d" value="spec = MambaSpec：页 = 状态字节和，与 block_size 无关（KI:698-707 → A2.3）；状态环：第 t 态只能推第 t+1（链式依赖·A2.3）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="528" width="780" height="16" as="geometry"/></mxCell><mxCell id="p5_ckpt0" value="ckpt t-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="556" width="70" height="30" as="geometry"/></mxCell><mxCell id="p5_ckpt1" value="ckpt t" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="190" y="556" width="70" height="30" as="geometry"/></mxCell><mxCell id="p5_ckpt2" value="ckpt t+1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="320" y="556" width="70" height="30" as="geometry"/></mxCell><mxCell id="p5_e_k1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="571" as="sourcePoint"/><mxPoint x="190" y="571" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_e_k2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="571" as="sourcePoint"/><mxPoint x="320" y="571" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5_conv" value="conv_state（短卷积）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="430" y="556" width="150" height="30" as="geometry"/></mxCell><mxCell id="p5_ssm" value="ssm_state（递归主状态）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="596" y="556" width="180" height="30" as="geometry"/></mxCell><mxCell id="p5_s3_la" value="页 = 状态 checkpoint（链式相续）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="60" y="590" width="330" height="16" as="geometry"/></mxCell><mxCell id="p5_s3_lb" value="bind 扁平字节缓冲 → conv/ssm 零拷贝 view（A2.3 §6.4）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="430" y="590" width="410" height="16" as="geometry"/></mxCell><mxCell id="p5_s4_label" value="④ GDN 索引（state_indices gather）与常驻释放" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="628" width="780" height="30" as="geometry"/></mxCell><mxCell id="p5_s4_d" value="不走 slot_mapping——块表行号即状态槽号；none/all 常驻不释放，align 一步一换（mamba_cache_mode → E1.3）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="662" width="780" height="16" as="geometry"/></mxCell><mxCell id="p5_g_init" value="① 初始化差异：必须与 Full 组过页字节统一（E1.2）：通常落路线①「已是 max」或路线②「垫页」；页 = 状态字节和（conv_state + ssm_state），与 block_size 无关（KI:698-707 → A2.3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="686" width="380" height="86" as="geometry"/></mxCell><mxCell id="p5_g_idx" value="② 索引差异：不走 slot_mapping——按 state_indices gather 状态槽（gdn_attn.py:219 → C6.3 行 3），块表行号即状态槽号；spec/prefill 两套块索引取不同列（gdn_attn.py:267-291）；页 = 状态 checkpoint 而非逐 token K/V 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="686" width="380" height="86" as="geometry"/></mxCell><mxCell id="p5_g_c1" value="→ A2.3 / E1.2 / E1.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="780" width="130" height="22" as="geometry"/></mxCell><mxCell id="p5_g_c2" value="→ C6.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="780" width="90" height="22" as="geometry"/></mxCell><mxCell id="p5_g_rel" value="③ 释放策略差异：状态块请求期常驻——none/all 模式窗外也不释放（E1.3 生命周期变体·弃「窗外释放」优化）；align 模式一步一换：旧 checkpoint free + null 回填（ST:1416-1444）；free / 抢占回归基准逆序归还（ST:1653-1665 → C2.3/D6）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="810" width="560" height="66" as="geometry"/></mxCell><mxCell id="p5_g_c3" value="→ C2.3 / D6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="620" y="810" width="100" height="22" as="geometry"/></mxCell><mxCell id="p5_s5_label" value="⑤ 一句话对照总结（与基准三行差）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="904" width="780" height="30" as="geometry"/></mxCell><mxCell id="p5_s5_d" value="先记两个关键词：MLA「页变宽」· GDN「生命周期」——其余走法全同基准" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="938" width="780" height="18" as="geometry"/></mxCell><mxCell id="p5_concl" value="与基准对照（Full Attention 单组 → 00.5.1/B6）：请求块表 1 套、写走 slot_mapping、窗外块可丢 + 满块写回。MLA 只改「每页存什么」——布局变宽 · 单 group · 管理栈零改动（基准主线）；GDN 改「每块是什么、活多久」——生命周期变体 · 绕开 slot_mapping · 必过 E1.2 页统一 + E1.3 状态常驻两条通道。同走「分配 / 写读 / 释放」主干，差异只差三行｜图源：旧图 kv_cache_mla / kv_cache_gdn 重绘提炼。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="962" width="800" height="116" as="geometry"/></mxCell><mxCell id="p5_rc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="150" as="geometry"/></mxCell><mxCell id="p5_rc_A_title" value="为什么 MLA 免统一、GDN 必统一" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="100" width="352" height="22" as="geometry"/></mxCell><mxCell id="p5_rc_A_txt" value="MLA：全层同 spec、页相等 → uniform 直接 True，不走 E1.2；&#10;GDN：页 = 状态字节与 bs 无关，必须与 Full 组拉平——常落 P2 路线①「已是 max」或②「垫页」" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="126" width="332" height="106" as="geometry"/></mxCell><mxCell id="p5_rc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="258" width="360" height="160" as="geometry"/></mxCell><mxCell id="p5_rc_B_title" value="页宽与常驻公式" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="266" width="352" height="22" as="geometry"/></mxCell><mxCell id="p5_rc_B_txt" value="MLA 每 token：c_kv + k_pe 定宽&#10;V3 fp8_ds = 656 B；V4 = 584 B（KI:397-416）&#10;DSv4 storage_block_size = bs/compress_ratio&#10;GDN 页 = conv_state + ssm_state（与 bs 无关）&#10;mamba_cache_mode（KI:709-718）：&#10;  none=1+spec · align=2+spec · all=cdiv(max_len,bs)+spec" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="874" y="292" width="332" height="116" as="geometry"/></mxCell><mxCell id="p5_rc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="434" width="360" height="190" as="geometry"/></mxCell><mxCell id="p5_rc_C_title" value="三行差异速查（MLA ｜ GDN）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="442" width="352" height="22" as="geometry"/></mxCell><mxCell id="p5_rc_C_txt" value="初始化：单 group 基准主线 ｜ Hybrid 组过 E1.2&#10;索引：slot_mapping 同构 ｜ state_indices gather（两套索引取不同列）&#10;释放：满块写回收 ｜ 常驻 / align 一步一换&#10;链接：A2.2/A3.5/A5.1 · C5/C6.3 ｜ A2.3/E1.2/E1.3/C2.3/D6" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="468" width="332" height="146" as="geometry"/></mxCell><mxCell id="p5_rc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="640" width="360" height="140" as="geometry"/></mxCell><mxCell id="p5_rc_D_title" value="索引机制对照" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="648" width="352" height="22" as="geometry"/></mxCell><mxCell id="p5_rc_D_txt" value="MLA——kernel 吃 block_table、slot_mapping 写（flashattn_mla.py:199/252）；GDN——gather 状态槽（gdn_attn.py:219），spec/prefill 两套块索引取不同列（gdn_attn.py:267-291）；页 = 状态 checkpoint 而非逐 token K/V 页" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="674" width="332" height="96" as="geometry"/></mxCell><mxCell id="p5_rc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="796" width="360" height="146" as="geometry"/></mxCell><mxCell id="p5_rc_L_title" value="图例" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="802" width="360" height="20" as="geometry"/></mxCell><mxCell id="p5_rc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="826" width="30" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_t0" value="MLA / 基准主线（蓝）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="826" width="280" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="848" width="30" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_t1" value="GDN 状态组（绿）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="848" width="280" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="870" width="30" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_t2" value="rope 通道（橙）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="870" width="280" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="892" width="30" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_t3" value="链接跳转章（紫）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="892" width="280" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_L_note" value="实线 = 状态推进流向 · 紫卡 = 跳转锚链接" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="878" y="916" width="320" height="18" as="geometry"/></mxCell><mxCell id="p5_rc_M_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="958" width="360" height="120" as="geometry"/></mxCell><mxCell id="p5_rc_M_title" value="读图动线" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="966" width="352" height="22" as="geometry"/></mxCell><mxCell id="p5_rc_M_txt" value="① MLA 页结构 → ② MLA 三行差 → ③ GDN 页结构 → ④ GDN 索引/常驻 → ⑤ 一句话对照；机制深读：A2.2 / A2.3 / C5 / C6.3 / E1.2 / E1.3" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="992" width="332" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>