ndColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="321" as="sourcePoint"/><mxPoint x="460" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_y2a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=none;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="321" as="sourcePoint"/><mxPoint x="745" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_y2b" value="no-op 直达" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="321" as="sourcePoint"/><mxPoint x="745" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_s3_label" value="③ 四路线判定链：是 → 统一 max 页；否 → 下一条" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="396" width="420" height="30" as="geometry"/></mxCell><mxCell id="p2_s3_d" value="no：取 max_page_size=262,144 B（KCU:1091-1096）逐层判定；各「是」汇入终点格" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="430" width="560" height="20" as="geometry"/></mxCell><mxCell id="p2_no_chip" value="no → 逐层进入③判定链（每层落统一 max 页）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="358" width="320" height="16" as="geometry"/></mxCell><mxCell id="p2_j1" value="路线① page == max？（KCU:1096-1100）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="470" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2_a1" value="若是：spec 原样保留——GDN 262,144 B 不动（已是 max）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="390" y="458" width="220" height="64" as="geometry"/></mxCell><mxCell id="p2_e_j1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="490" as="sourcePoint"/><mxPoint x="390" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_j2" value="路线② isinstance(MambaSpec)？（KCU:1101-1110）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="546" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2_a2" value="若是：垫页 page_size_padded = max，只垫空字节（页字节与 bs 无关）；页内 padding 空洞：例 Mamba 200 KB 垫到 262,144 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="390" y="534" width="220" height="64" as="geometry"/></mxCell><mxCell id="p2_e_j2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="566" as="sourcePoint"/><mxPoint x="390" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_j3" value="路线③ max % page == 0？（KCU:1112-1116）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="622" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2_a3" value="若是：整除放大 block_size ×= ratio；例：Full 65,536 B · ratio=4 · bs 16→64（同 token 消耗更少块）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="390" y="610" width="220" height="64" as="geometry"/></mxCell><mxCell id="p2_e_j3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="642" as="sourcePoint"/><mxPoint x="390" y="642" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_j4" value="路线④ indexes_kv_by_block_stride？（KCU:1117-1121）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="698" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2_a4" value="若是：stride 垫页 page_size_padded = max：98,304→262,144 B，kernel 经 stride view 读 padding 页（A3.4）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="390" y="686" width="220" height="64" as="geometry"/></mxCell><mxCell id="p2_e_j4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="718" as="sourcePoint"/><mxPoint x="390" y="718" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_c1" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="510" as="sourcePoint"/><mxPoint x="220" y="546" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_c2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="586" as="sourcePoint"/><mxPoint x="220" y="622" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_c3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;dashed=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="662" as="sourcePoint"/><mxPoint x="220" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_dsc" value="不整除 &amp; 无 stride —— 两侧都不行 ↓" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#b85450;" parent="1" vertex="1"><mxGeometry x="252" y="754" width="170" height="14" as="geometry"/></mxCell><mxCell id="p2_peak" value="统一 max 页 262,144 B（终点）&#10;· get_uniform_page_size 断言集合恰为 1（KCU:1013-1019）&#10;· get_kv_cache_config_from_groups 通用分支：建 group_size 个共享张量（KCU:1390-1416）&#10;· 块表行号 = 页号（铁律②）&#10;· 进 P1 多 group 双块表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="650" y="434" width="190" height="316" as="geometry"/></mxCell><mxCell id="p2_e_no" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="738" as="sourcePoint"/><mxPoint x="240" y="848" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="490" as="sourcePoint"/><mxPoint x="650" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="566" as="sourcePoint"/><mxPoint x="650" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="642" as="sourcePoint"/><mxPoint x="650" y="642" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_e_p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="718" as="sourcePoint"/><mxPoint x="650" y="718" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_s4_label" value="④ 悬崖兜底" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="786" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_s4_d" value="两侧都不行才抛错（KCU:1122-1129）；SW 组合可救（A4 语义不变）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="280" y="820" width="520" height="20" as="geometry"/></mxCell><mxCell id="p2_cliff" value="悬崖警示：非 Mamba 也整除不了、还没有 stride → NotImplementedError（KCU:1122-1129）——两侧都不行才坠落" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="848" width="340" height="84" as="geometry"/></mxCell><mxCell id="p2_e_cf" value="SW 类可救" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="894" as="sourcePoint"/><mxPoint x="460" y="894" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2_fb" value="fallback 虚线路径：Full + SW / ChunkedLocal 组合 → unify_hybrid_kv_cache_specs（KCU:1547-1568）调用 _promote_local_kv_cache_specs（KCU:1425-1510）把 SW 类 spec 提升为 FullAttentionSpec 参与分配 → 退化回基准的单组形态；层计算仍是窗口注意力（A4 语义不变）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="460" y="848" width="380" height="84" as="geometry"/></mxCell><mxCell id="p2_s5_label" value="⑤ 结论 · 为什么必须统一 + 副作用收束 + DSv4 特例" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="972" width="620" height="30" as="geometry"/></mxCell><mxCell id="p2_s5_d" value="统一不是为了好看，是为了 BlockPool 只有一套编址（铁律②）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="1006" width="700" height="18" as="geometry"/></mxCell><mxCell id="p2_concl" value="为什么必须统一：等大页 + block_id == 张量行号（00 章铁律②）——不统一则 BlockPool 无法同时给两种块编址（碎片化，KCU:1170-1172 注释）。副作用收束：真块尺寸（放大后 bs）≠ hash_block_size → Hybrid 断言 bs % hash == 0（KVCCO:554-569）；padding 由 bind / stride view 消化（B4/A3.4）；find_longest_cache_hit 按哈希粒度对齐跨组边界（→ E1.4）。DSv4 特例（E3 注脚）：group_and_unify_kv_cache_specs（KCU:1571-1611）+ packed 布局 _get_packed_kv_cache_layout（KCU:1262-1284）：组间页可不等、块 ID 密叠共享 slab；层元组数由 _approximate_gcd（KCU:1614-1646）按总 padding 最小选取。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="1030" width="800" height="68" as="geometry"/></mxCell><mxCell id="p2_rc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="160" as="geometry"/></mxCell><mxCell id="p2_rc_A_title" value="四路线速记（判定链）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="100" width="352" height="22" as="geometry"/></mxCell><mxCell id="p2_rc_A_txt" value="① page==max → 原样保留（GDN 262,144 B 不动）&#10;② isinstance(MambaSpec) → 垫空字节（页与 bs 无关）&#10;③ max % page == 0 → 整除放大 bs ×= ratio&#10;④ indexes_kv_by_block_stride → stride 垫页&#10;全否 → NotImplementedError；SW 组合走 _promote_local 提升，退化回单组（A4 语义不变）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="126" width="332" height="116" as="geometry"/></mxCell><mxCell id="p2_rc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="268" width="360" height="140" as="geometry"/></mxCell><mxCell id="p2_rc_B_title" value="页字节统一公式" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="276" width="352" height="22" as="geometry"/></mxCell><mxCell id="p2_rc_B_txt" value="max_page_size = max(65,536, 98,304, 262,144) B&#10;page_size_padded = max(page, max_page_size)&#10;ratio：max % page == 0 → block_size *= ratio&#10;FullAtt：65,536 B · ratio=4 · bs 16 → 64&#10;Mamba：200 KB → 262,144 B（只垫空字节）&#10;HND：98,304 B → 262,144 B（stride view）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="874" y="302" width="332" height="96" as="geometry"/></mxCell><mxCell id="p2_rc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="424" width="360" height="140" as="geometry"/></mxCell><mxCell id="p2_rc_C_title" value="全等 vs 放大 vs 垫页" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="432" width="352" height="22" as="geometry"/></mxCell><mxCell id="p2_rc_C_txt" value="· 页全等：no-op，直接走 B2.3 主线「全同」分组&#10;· 放大 bs：同 token 数消耗更少的更大块，块表按放大后 bs 记账&#10;· 垫页：绝对页宽拉齐，多出的是字节空洞，由 bind / stride view 消化&#10;· 真 bs ≠ hash bs：构造期断言 bs % hash == 0（KVCCO:554-569）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="458" width="332" height="96" as="geometry"/></mxCell><mxCell id="p2_rc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="580" width="360" height="130" as="geometry"/></mxCell><mxCell id="p2_rc_D_title" value="为什么必须统一（铁律②）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="588" width="352" height="22" as="geometry"/></mxCell><mxCell id="p2_rc_D_txt" value="等大页 + block_id == 张量行号不能破：BlockPool 只有一套 id 编址，两种块宽无法同时编址（KCU:1170-1172 碎片化注释）；不统一 → 跨组命中与块表记账全部无法收口（find_longest_cache_hit 按哈希粒度对齐 → E1.4）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="614" width="332" height="86" as="geometry"/></mxCell><mxCell id="p2_rc_E_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="726" width="360" height="120" as="geometry"/></mxCell><mxCell id="p2_rc_E_title" value="DSv4 专用通道（知其存在即可）" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="864" y="734" width="352" height="22" as="geometry"/></mxCell><mxCell id="p2_rc_E_txt" value="group_and_unify_kv_cache_specs（KCU:1571-1611）+ packed 布局 _get_packed_kv_cache_layout（KCU:1262-1284）：组间页可不等、块 ID 密叠共享 slab；层元组数由 _approximate_gcd（KCU:1614-1646）选取" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="874" y="760" width="332" height="76" as="geometry"/></mxCell><mxCell id="p2_rc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="862" width="360" height="190" as="geometry"/></mxCell><mxCell id="p2_rc_L_title" value="图例" style="text;html=1;verticalAlign=middle;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="868" width="360" height="20" as="geometry"/></mxCell><mxCell id="p2_rc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="892" width="30" height="18" as="geometry"/></mxCell><mxCell id="p2_rc_L_t0" value="FullAtt 页 / THEN 动作卡" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="892" width="280" height="18" as="geometry"/></mxCell><mxCell id="p2_rc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="914" width="30" height="18" as="geometry"/></mxCell><mxCell id="p2_rc_L_t1" valu