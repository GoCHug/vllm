ometry"/></mxCell><mxCell id="s1c_vnote" value="▲ V 条带：同宽同长，K/V 拼最后一维" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="410" y="180" width="290" height="16" as="geometry"/></mxCell><mxCell id="s1c_badge" value="64KB/页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="140" y="208" width="96" height="26" as="geometry"/></mxCell><mxCell id="s1c_badge_note" value="dtype_size 直接进公式" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="250" y="214" width="220" height="16" as="geometry"/></mxCell><mxCell id="s2_label" value="家族 B · latent 打包（MLA） MLAAttentionSpec （KI:381 · 继承 FullAttentionSpec，覆写公式）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="246" width="780" height="28" as="geometry"/></mxCell><mxCell id="s2_desc" value="管道示意：多头 K/V 粗条 → 压缩鼓 → 每 token 只存一个 latent（无 head 维）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="278" width="780" height="20" as="geometry"/></mxCell><mxCell id="s2c_kh0" value="K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="316" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_kh1" value="K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="90" y="316" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_kh2" value="K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;vertica