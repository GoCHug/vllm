"898" width="50" height="30" as="geometry"/></mxCell><mxCell id="s3c_r7c14" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="740" y="898" width="50" height="30" as="geometry"/></mxCell><mxCell id="s3c_r7c15" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="790" y="898" width="50" height="30" as="geometry"/></mxCell><mxCell id="s3c_h7" value="h7" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="898" width="50" height="30" as="geometry"/></mxCell><mxCell id="s3c_note" value="HND 一格 = 1 头 1 token 左半 K (128 维) 右半 V (128 维) 行 = KV 头（8） 列 = token（16） HND/NHD 只是 view+permute 零拷贝重排，总字节不变" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="940" width="780" height="36" as="geometry"/></mxCell><mxCell id="s5_label" value="⑤ 履带底座 —— kernel 按 block_dim（=0）取完整一页" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="984" width="620" height="26" as="geometry"/></mxCell><mxCell id="s5c_pool" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1016" width="780" height="80" as="geometry"/></mxCell><mxCell id="s5c_t1" value="块表（block_id → 页）：命中 / 已载 K-V / 空闲 / 浪费（示意）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="1022" width="460" height="18" as="geometry"/></mxCell><mxCell id="s5c_b0" value="block 0 命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="48" y="1044" width="88" height="24" as="geometry"/></mxCell><mxCell id="s5c_b1" value="block 1 已载 K/V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="142" y="1044" width="88" height="24" as="geometry"/></mxCell><mxCell id="s5c_b2" value="block 2 已载 K/V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="236" y="1044" width="88" height="24" as="geometry"/></mxCell><mxCell id="s5c_b3" value="block 3 空闲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="330" y="1044" width="88" height="24" as="geometry"/></mxCell><mxCell id="s5c_b4" value="block 4 浪费(对齐)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="424" y="1044" width="88" height="24" as="geometry"/></mxCell><mxCell id="s5c_lug" value="履带底座" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="560" y="1072" width="96" height="22" as="geometry"/></mxCell><mxCell id="s5c_pg" value="整页 (16, 8, 256) 65,536 B&#10;kernel 工友 拉取整页" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="656" y="1022" width="160" height="42" as="geometry"/></mxCell><mxCell id="s5c_lg" value="kernel 按 block_dim（=0）取一行：沿 block_id 行号拿整页（铁律② block_id ↔ 张量行号）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="48" y="1068" width="460" height="26" as="geometry"/></mxCell><mxCell id="idc_K1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="116" as="geometry"/></mxCell><mxCell id="idc_K1_title" value="算例 · Llama-3-8B · TP1" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="98" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_K1_txt" value="算例 · Llama-3-8B （FlashInfer, bf16, bs=16, GQA nh=8, h=hv=128）TP1： page = 16 × 8 × (128+128) × 2 = 65,536 B = 64 KB / 块 / 层 页内 = 16 token × 8 头 × 256 宽；block_size 要求 %16==0（flash_attn.py:141-142）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;" parent="1" vertex="1"><mxGeometry x="872" y="122" width="336" height="76" as="geometry"/></mxCell><mxCell id="idc_K2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="216" width="360" height="100" as="geometry"/></mxCell><mxCell id="idc_K2_title" value="全库基准 · pp2tp2（nh=4）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="222" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_K2_txt" value="全库基准 pp2tp2 ：TP2 把 8 个 KV 头对半切 → nh=4： page = 16 × 4 × 256 × 2 = 32,768 B = 32 KB / 块 / 层 PP2 再把 32 层按 stage 对半分（每 worker 16 层）→ 验收口径见 B6" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;" parent="1" vertex="1"><mxGeometry x="872" y="246" width="336" height="60" as="geometry"/></mxCell><mxCell id="idc_K3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="324" width="360" height="116" as="geometry"/></mxCell><mxCell id="idc_K3_title" value="NVFP4 微算例（FlashInfer）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="330" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_K3_txt" value="NVFP4 微算例 （FlashInfer）h=hv=128, nh=8, bs=16： last_dim = (64+8)×2 = 144； page = 16 × 8 × 144 × 1B = 18,432 B ≈ bf16 的 28%； 物理 (B, 2·nh, N, 144)（flashinfer.py:404-406）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;" parent="1" vertex="1"><mxGeometry x="872" y="354" width="336" height="76" as="geometry"/></mxCell><mxCell id="idc_C1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="448" width="360" height="110" as="geometry"/></mxCell><mxCell id="idc_C1_title" value="每 token 对照 · 页字节杠杆" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="454" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_C1_txt" value="每 token 4,096 B （= 8 头 × 512 B）→ 与 P4 DSv3 每 token 1,152 B 对照； 页字节直接杠杆 = num_kv_heads（GQA 省 4 倍）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="478" width="336" height="70" as="geometry"/></mxCell><mxCell id="idc_I1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="566" width="360" height="116" as="geometry"/></mxCell><mxCell id="idc_I1_title" value="索引：block_id ↔ 张量行号（铁律②）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="572" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_I1_txt" value="索引：block_id ↔ 张量行号（铁律②）；kernel 按 block_dim（=0）fancy index：kv_cache[block_id] 取整页（16×8×256）。混合模型统一页字节时 indexes_kv_by_block_stride=True 行按块 stride 读取（KI:182 → B2/E1）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;" parent="1" vertex="1"><mxGeometry x="872" y="596" width="336" height="76" as="geometry"/></mxCell><mxCell id="idc_I2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="690" width="360" height="112" as="geometry"/></mxCell><mxCell id="idc_I2_title" value="backend 不改页字节" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="696" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_I2_txt" value="同模型切换 backend（FlashAttn / FlashInfer / CPU / Triton / Flex / ROCm Aiter）不改 page_size_bytes —— 公式只看 spec 字段；量化时物理 dtype 为 uint8，dtype_size 变化进公式（→ P6）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;" parent="1" vertex="1"><mxGeometry x="872" y="720" width="336" height="72" as="geometry"/></mxCell><mxCell id="idc_I3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="810" width="360" height="112" as="geometry"/></mxCell><mxCell id="idc_I3_title" value="K/V 拼接三种 backend 形式" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="816" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_I3_txt" value="K/V 拼接三种 backend 形式： A ：(B,H,N,2D) FlashAttn / FlashInfer / CPU / Triton / Flex； B ：(2,B,N,H,D) ROCm Attn（block_dim=1）； C ：(B,2,N,H,D) HPC（SM90+）—— 三者字节数完全相同，仅维度摆放不同（block_dim 细节 → B/C 章）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="840" width="336" height="72" as="geometry"/></mxCell><mxCell id="idc_I4_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="930" width="360" height="112" as="geometry"/></mxCell><mxCell id="idc_I4_title" value="变体（→ A3）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="936" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_I4_txt" value="变体（→A3）：Diff-KV 末维显式相加 h + hv（flash_attn_diffkv / triton_attn_diffkv）；INT4 per-token-head 打包 h/2 + hv/2 + fp32 scale；NVFP4 在 FlashInfer 中 K/V 头数翻倍 (B, 2·nh, N, h/2+h/16)（flashinfer.py:404-406）—— 容量估算不受 backend / 布局选择影响" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="960" width="336" height="72" as="geometry"/></mxCell><mxCell id="idc_R9" value="attention kernel 引擎（FlashInfer） 按 block_dim fancy-index&#10;显存池按最多块数 × page_size_bytes 订货（→ B3）；页 64 KB（TP1）/ 32 KB（pp2tp2 基准）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="860" y="1050" width="360" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pgA4" name="P4 MLA 块布局"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_p4" value="P4 · MLA 块布局（归属 A2）—— latent 压缩 + storage_block_size + 72KB/页算例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="s0_desc" value="MLA：低秩联合投影把每 token 的 K/V 压进一个 latent，宽 576 = kv_lora_rank 512（NoPE）+ qk_rope_head_dim 64（RoPE）；KV cache 无独立 head 维（nh=1 并入宽度），推理时用小投影矩阵还原各头 K/V。MLAAttentionSpec 继承 FullAttentionSpec 但覆写字节公式（KI:381、:397-416）。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1520" height="34" as="geometry"/></mxCell><mxCell id="s1_label" value="① 低秩联合投影：只缓存 latent" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="86" width="560" height="28" as="geometry"/></mxCell><mxCell id="s1_desc" value="多头 K/V 各一份 → 一次投影 → 每 token 只存一条 latent；还原开销在 kernel 侧" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="118" width="780" height="20" as="geometry"/></mxCell><mxCell id="s1c_kc" value="K：(seq, nh 头, head 维) 多头独立 K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="148" width="210" height="30" as="geometry"/></mxCell><mxCell id="s1c_vc" value="V：(seq, nh 头, head 维) 多头独立 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="186" width="210" height="30" as="geometry"/></mxCell><mxCell id="s1c_proj" value="低秩联合投影 K, V → c_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="320" y="152" width="200" height="44" as="geometry"/></mxCell><mxCell id="s1c_proj2" value="投影吸收进上游权重（推理开销 ≈ 0）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="330" y="200" width="190" height="32" as="geometry"/></mxCell><mxCell id="s1c_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="163" as="sourcePoint"/><mxPoint x="316" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1c_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="170" as="sourcePoint"/><mxPoint x="592" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1c_nope" value="NoPE 512（kv_lora_rank）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="596" y="152" width="164" height="36" as="geometry"/></mxCell><mxCell id="s1c_rope" value="RoPE 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="760" y="152" width="80" height="36" as="geometry"/></mxCell><mxCell id="s1c_lat" value="latent c_t ∈ R⁵⁷⁶ —— 每 token 只存这一个向量：" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="596" y="192" width="244" height="20" as="geometry"/></mxCell><mxCell id="s1c_link" value="只输出一条 latent：nh 份 → 1 条" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="330" y="240" width="360" height="18" as="geometry"/></mxCell><mxCell id="s2_label" value="② 一页：64 个 token 槽 × 宽 576（DSv3 bs=64）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="268" width="560" height="28" as="geometry"/></mxCell><mxCell id="s2_desc" value="逻辑 latent (num_seq, seq_len, 576) → 按 bs=64 切块 → 物理 (num_blocks, 64, 576)（KI:411-416，nh=1）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="780" height="32" as="geometry"/></mxCell><mxCell id="s2c_blk" value="块 block_id = 3 · storage_bs = 64 槽（一页 = 8×8，t0 ↑ … t63）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="350" y="336" width="300" height="34" as="geometry"/></mxCell><mxCell id="s2c_t0" value="t0 ↑" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="344" width="60" height="14" as="geometry"/></mxCell><mxCell id="s2c_g00" value="t0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g01" value="t1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="70" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g02" value="t2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="100" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g03" value="t3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="130" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g04" value="t4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="160" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g05" value="t5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="190" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g06" value="t6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="220" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g07" value="t7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g10" value="t8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="380" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g11" value="t9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="70" y="380" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g12" value="t10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="100" y="380" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c_g13" value="t11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;stroke