e="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=1;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="190" as="sourcePoint"/><mxPoint x="290" y="352" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2c_chunk" value="按 bs 切块" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#d79b00;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="470" y="340" width="110" height="16" as="geometry"/></mxCell><mxCell id="s3_label" value="③ 三版本每 token 打包宽（决定 page 字节）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="556" width="560" height="28" as="geometry"/></mxCell><mxCell id="s3c_v3" value="V3（bf16） ：576 dims × 2B = 1152 B/token page = storage_bs × 576 × 2B（KI:411-416） 构成：NoPE 1024B + RoPE 128B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="590" width="250" height="112" as="geometry"/></mxCell><mxCell id="s3c_v32" value="V3.2（fp8_ds_mla） ：打包 656 B/token = NoPE 512 + RoPE 128 + fp8 scale 16 page = bs × 656（KI:404-406，自定义布局）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="302" y="590" width="250" height="112" as="geometry"/></mxCell><mxCell id="s3c_v4" value="V4（fp8_ds_mla · deepseek_v4） ：584 B/token = NoPE 448 + RoPE 128 + scale 8 page = storage_bs × 584（KI:399-403）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="564" y="590" width="276" height="112" as="geometry"/></mxCell><mxCell id="s3c_scale" value="scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="774" y="674" width="58" height="20" as="geometry"/></mxCell><mxCell id="s4_label" value="storage_block_size：3 小格并 1 大格（图示）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="720" width="560" height="28" as="geometry"/></mxCell><mxCell id="s4c_lg0" value="逻辑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="80" y="780" width="30" height="20" as="geometry"/></mxCell><mxCell id="s4c_lg1" value="逻辑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="110" y="780" width="30" height="20" as="geometry"/></mxCell><mxCell id="s4c_lg2" value="逻辑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="140" y="780" width="30" height="20" as="geometry"/></mxCell><mxCell id="s4c_lg_note" value="逻辑槽 ×3（每 token 一份 latent）→ compress_ratio 收纳" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="200" y="772" width="300" height="36" as="geometry"/></mxCell><mxCell id="s4c_ph" value="1 物理槽（装 ratio 份）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="530" y="776" width="150" height="36" as="geometry"/></mxCell><mxCell id="s4c_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="790" as="sourcePoint"/><mxPoint x="526" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4c_note" value="compress_ratio 收纳 → 1 物理槽 = ratio 份逻辑槽" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="80" y="812" width="400" height="16" as="geometry"/></mxCell><mxCell id="s5_concl" value="算例 · DeepSeek-V3（FlashMLA, bf16, bs=64）：page = 64 × 1 × 576 × 2 = 73,728 B = 72 KB / 块 / 层 。对比基准家族 A：Llama-3-8B 每 token 4,096 B（8 头 × 512B）vs DSv3 每 token 1,152 B —— 独立多头被压进一个 576 宽向量。V3.2：64×656 = 41,984 B；V4（bs=64, ratio=4）：16×584 = 9,344 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="930" width="780" height="90" as="geometry"/></mxCell><mxCell id="idc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="134" as="geometry"/></mxCell><mxCell id="idc_A_title" value="shape 对比 · 省显存来源" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="98" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_A_txt" value="shape 对比：家族 A 逻辑 (seq, nh, D)；家族 B 逻辑 (seq, 576) —— head 维消失即省显存来源。缓存 1 个向量 vs nh 份 K/V；还原开销在 kernel 侧" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="122" width="336" height="94" as="geometry"/></mxCell><mxCell id="idc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="238" width="360" height="142" as="geometry"/></mxCell><mxCell id="idc_B_title" value="一页网格怎么数" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="244" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_B_txt" value="… t63（64 槽）。共 8×8 = 64 格 = 64 个 token 的 latent（每格宽 576）；kernel: kv_cache[block_id] 一次取整页。格内 NoPE 512 / RoPE 64 分界由 kernel 切分（见 ③ 放大条）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="268" width="336" height="102" as="geometry"/></mxCell><mxCell id="idc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="392" width="360" height="126" as="geometry"/></mxCell><mxCell id="idc_L_title" value="图例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="398" width="360" height="20" as="geometry"/></mxCell><mxCell id="idc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="420" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t0" value="NoPE 段（kv_lora_rank 512）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="420" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="444" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t1" value="RoPE 段（head_dim 64/128）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="444" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="468" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t2" value="蓝格 = 1 token latent 槽" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="468" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="492" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t3" value="灰徽章 = fp8 scale" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="492" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="530" width="360" height="96" as="geometry"/></mxCell><mxCell id="idc_C_title" value="三版本物理 shape" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="536" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_C_txt" value="物理 shape 三版本恒为 (num_blocks, storage_bs, 打包宽)；物理底座仍是 int8（→ B4）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="560" width="336" height="56" as="geometry"/></mxCell><mxCell id="idc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="638" width="360" height="160" as="geometry"/></mxCell><mxCell id="idc_D_title" value="storage_block_size 与 alignment" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="644" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_D_txt" value="storage_block_size = block_size // compress_ratio（KI:393-395；基类默认 = block_size，KI:118-120）—— 逻辑块 64 槽 → 物理 16 槽（ratio=4）。V4 取值 {1, 4, 128}：1=SWA 无压缩 / 4=c4a / 128=c128a。alignment 对齐在 __post_init__ 自动 pad 页字节（_apply_alignment_padding，KI:345-351、:389-391），不改变 block_size" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="668" width="336" height="120" as="geometry"/></mxCell><mxCell id="idc_E_box" value="打包宽速记：V3=1152 · V3.2=656 · V4=584（B/token）&#10;页 = storage_bs × 打包宽 × (1B｜2B：bf16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="810" width="360" height="68" as="geometry"/></mxCell><mxCell id="idc_E_note" value="公式细节见底部结论条与 P6 签卡" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="868" y="884" width="344" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pgA5" name="P5 Mamba/GDN 状态块布局"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_p5" value="P5 · Mamba/GDN 状态块布局（归属 A2）—— conv+ssm 状态 · 固定字节 · 常驻语义" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="s0_desc" value="SSM/GDN 每步只就地更新几份状态矩阵、不逐 token 存 K/V；KV cache 是扁平 int8 字节缓冲，物理 shape 恒 (num_blocks, 1, 1, page_size_bytes)（worker reshape，旧材料 §6.2）。索引与家族 A/B 完全一致：state_view[block_id] 就地读写。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1520" height="34" as="geometry"/></mxCell><mxCell id="s1_label" value="① 递归语义与常驻份数（块 i = 前缀累积状态）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="86" width="560" height="28" as="geometry"/></mxCell><mxCell id="s1_desc" value="token 流 → 逐步递归更新（就地写状态）→ 到块边界落一份 checkpoint；常驻份数由 mamba_cache_mode 定" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="118" width="400" height="20" as="geometry"/></mxCell><mxCell id="s1c_tk" value="token 流队列" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="46" y="148" width="100" height="20" as="geometry"/></mxCell><mxCell id="s1c_c0" value="c0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="150" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="s1c_c1" value="c1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="s1c_c2" value="c2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="210" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="s1c_c3" value="c3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" pa