<mxfile host="65bd71144e"><diagram id="pgA1" name="P1 家族总览"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_p1" value="P1 · 家族总览（归属 A1）——三大家族：一层每步缓存什么" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="s0_desc" value="三大家族回答「一层每步该缓存什么」。基准场景 = Llama-3-8B · FullAttention（→00 章 0.5.1），本章记其他类型与基准的差异。三族共用同一套块表索引：block_id → 物理张量行号（铁律②），差别只在页内容。主源码：vllm/v1/kv_cache_interface.py（下称 KI，行号均已核实）。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1520" height="34" as="geometry"/></mxCell><mxCell id="s1_label" value="家族 A · 每头独立 K/V FullAttentionSpec （KI:227 · Attention 支）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="90" width="780" height="28" as="geometry"/></mxCell><mxCell id="s1_desc" value="内嵌 K/V 双条带微缩网格 —— 每个 KV 头各存一份完整 K 和 V，历史 token 全保留" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="122" width="780" height="20" as="geometry"/></mxCell><mxCell id="s1c_tok" value="token 珠 →" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="60" y="158" width="70" height="16" as="geometry"/></mxCell><mxCell id="s1c_K0" value="K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="140" y="156" width="30" height="20" as="geometry"/></mxCell><mxCell id="s1c_K1" value=