l><mxCell id="s3c_f5" value="f5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="260" y="544" width="30" height="20" as="geometry"/></mxCell><mxCell id="s3c_f6" value="f6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="290" y="544" width="30" height="20" as="geometry"/></mxCell><mxCell id="s3c_f7" value="f7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="320" y="544" width="30" height="20" as="geometry"/></mxCell><mxCell id="s3c_conv" value="conv（滑窗）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="110" y="574" width="90" height="16" as="geometry"/></mxCell><mxCell id="s3c_ptr" value="推杆指针" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="380" y="552" width="90" height="16" as="geometry"/></mxCell><mxCell id="s3c_ptr_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="600" as="sourcePoint"/><mxPoint x="400" y="568" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3c_ptr_note" value="推杆：每步把状态就地覆写一份" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="480" y="552" width="340" height="18" as="geometry"/></mxCell><mxCell id="s3c_ind" value="家族 C 无 head 维 / 无 token 槽维 —— 独立支（与 A/B 布局根本不同）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="380" y="576" width="440" height="18" as="geometry"/></mxCell><mxCell id="s4_label" value="④ 变体面：A3 格式 / A4 语义 / A5 分组三张清单" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="640" width="780" height="28" as="geometry"/></mxCell><mxCell id="s4_desc" value="改字节与布局 → A3；布局不变、只改驻留 → A4；层间合成 → A5（→ B2/E1）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="672" width="780" height="20" as="geometry"/></mxCell><mxCell id="s4c_a3" value="A3 格式变体（改字节与布局）：量化 FP8 / INT8 / INT4-per-token-head / NVFP4 · TurboQuant（TQFullAttentionSpec） · Diff-KV（h + hv） · HND/NHD stride 布局 —— 块语义不变，字节宽度 / 维度摆位改变。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="698" width="250" height="122" as="geometry"/></mxCell><mxCell id="s4c_a4" value="A4 语义变体（布局不变、只改驻留策略）：SWA / RSWA / ChunkedLocal / SlidingWindowMLA / Sink / Cross / EncoderOnly / HiddenState。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="302" y="698" width="250" height="122" as="geometry"/></mxCell><mxCell id="s4c_a5" value="A5 层间 merge 与分组：同值层 merge() → KVCacheGroupSpec（KI:938）；同型不同参数层 → UniformTypeKVCacheSpecs 聚合（page=Σ，KI:827-829）；分组 / 统一页字节细节 → B2/E1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="564" y="698" width="276" height="122" as="geometry"/></mxCell><mxCell id="s5_label" value="⑤ 误区与完成标准" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="832" width="780" height="28" as="geometry"/></mxCell><mxCell id="s5_desc" value="家族 C 块 ≠ 每 token 一份 K/V；能否落纸看 P6 公式卡" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="864" width="780" height="20" as="geometry"/></mxCell><mxCell id="s5c_mis" value="误区：家族 C 不是「每 token 一份 K/V」。家族 A 块 i 存 token [i·bs,(i+1)·bs) 各自的 K/V / latent；家族 C 块 i 存处理完前 i·bs 个 token 后的累积状态。完成标准：给任意模型能算出每层块内容 + page_size_bytes + 物理 shape（P6 公式卡实操）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="888" width="780" height="74" as="geometry"/></mxCell><mxCell id="s6_concl" value="字节随序列长度的缩放：家族 A 线性（斜率 ∝ nh·D）；家族 B 线性但每 token 窄一个量级；家族 C 恒定、与序列长度无关。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="986" width="780" height="58" as="geometry"/></mxCell><mxCell id="idc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="186" as="geometry"/></mxCell><mxCell id="idc_A_title" value="家族 A · FullAttentionSpec 要点" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="98" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_A_txt" value="── 驻留 ── 每个 KV 头各存一份完整 K 和 V；历史 token 全保留&#10;── 字节公式 ── page = bs · nh · (head_size + head_size_v) · dtype_size（KI:340-342）&#10;── 物理 shape ── (num_blocks, nh, bs, 2·head_size) — K/V 拼最后一维&#10;── 算例 ── Llama-3-8B bf16 bs=16 TP1： 64 KB/页/层 ；pp2tp2（nh=4）： 32 KB/页/层&#10;典型模型：Llama、Qwen、Mistral&#10;GQA：32 Query 头共享 8 个 KV 头 → num_kv_heads 是页字节直接杠杆" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="122" width="336" height="146" as="geometry"/></mxCell><mxCell id="idc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="288" width="360" height="158" as="geometry"/></mxCell><mxCell id="idc_B_title" value="家族 B · MLAAttentionSpec 要点" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="294" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_B_txt" value="── 驻留 ── 每 token 只存一个压缩 latent（576 = NoPE 512 + RoPE 64），head 维并入宽度&#10;── 字节公式 ── V3：storage_bs·576·dt；V3.2：bs·656；V4：storage_bs·584（KI:397-416）&#10;── 物理 shape ── (num_blocks, storage_bs, 打包宽) — 无 head 维&#10;── 算例 ── DS-V3 bf16 bs=64：73,728 B = 72 KB/页/层 （每 token 1,152 B）&#10;典型模型：DeepSeek V2/V3/V4" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="318" width="336" height="118" as="geometry"/></mxCell><mxCell id="idc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="456" width="360" height="158" as="geometry"/></mxCell><mxCell id="idc_C_title" value="家族 C · MambaSpec 要点" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="462" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_C_txt" value="── 驻留 ── 每块 = 一份就地更新的状态（conv + ssm）；常驻份数由 mamba_cache_mode 定：none=1 / align=2 / all=每块边界（KI:709-718）&#10;── 字节公式 ── page = Σ prod(shape) · dtype_size（KI:698-707），与 block_size 无关&#10;── 物理 shape ── (num_blocks, 1, 1, page_size_bytes) — 扁平 int8 字节缓冲&#10;── 算例 ── Qwen3-Next GDN bf16：280,576 B = 274 KB/页/层&#10;典型模型：Qwen3-Next (GDN)、Mamba2&#10;继承 FullAttentionSpec（复用 merge 等组内逻辑），只覆写字节公式 → P2 继承树" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="486" width="336" height="118" as="geometry"/></mxCell><mxCell id="idc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="624" width="360" height="122" as="geometry"/></mxCell><mxCell id="idc_L_title" value="图例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="630" width="360" height="20" as="geometry"/></mxCell><mxCell id="idc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="652" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t0" value="家族 A · K/V 条带（蓝）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="652" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="676" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t1" value="家族 B · latent（绿）/ RoPE 橙" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="676" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="700" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t2" value="家族 C · 状态格（灰）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="700" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="724" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t3" value="页字节徽章（黄）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="724" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_M_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="756" width="360" height="336" as="geometry"/></mxCell><mxCell id="idc_M_title" value="三族页字节缩放心智线" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="764" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_M_y" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="880" y="796" width="10" height="240" as="geometry"/></mxCell><mxCell id="idc_M_x" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="880" y="1036" width="290" height="10" as="geometry"/></mxCell><mxCell id="idc_M_ylab" value="y = 页字节" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="886" y="790" width="100" height="16" as="geometry"/></mxCell><mxCell id="idc_M_xlab" value="x = token 数" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="1080" y="1050" width="110" height="16" as="geometry"/></mxCell><mxCell id="idc_M_a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1026" as="sourcePoint"/><mxPoint x="1155" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="idc_M_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1028" as="sourcePoint"/><mxPoint x="1155" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="idc_M_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=2;endArrow=none;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1012" as="sourcePoint"/><mxPoint x="1155" y="1012" as="targetPoint"/></mxGeometry></mxCell><mxCell id="idc_M_la" value="A 线性（斜率 ∝ nh·D）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="1000" y="826" width="180" height="16" as="geometry"/></mxCell><mxCell id="idc_M_lb" value="B 线性 · 每 token 窄一个量级" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1000" y="946" width="180" height="16" as="geometry"/></mxCell><mxCell id="idc_M_lc" value="C 恒定（与序列长度无关）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="1000" y="986" width="180" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pgA2" name="P2 spec 继承树"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_p2" value="P2 · spec 继承树（归属 A1 · 行号 = vllm/v1/kv_cache_interface.py，已逐行核实）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="s1_label" value="① 根：KVCacheSpec —— 唯一实例字段 + merge 契约" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="460" height="28" as="geometry"/></mxCell><mxCell id="s1c_root" value="KVCacheSpec （KI:100） block_size: int — 唯一实例字段（KI:106） page_size_bytes → 多态（KI:109，抽象） storage_block_size = block_size（KI:118） merge()：同组必全等（KI:149-157）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="370" y="78" width="340" height="104" as="geometry"/></mxCell><mxCell id="s2_label" value="② 两大继承支 + 容器支（每个节点挂 KI 行号）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="224" width="560" height="26" as="geometry"/></mxCell><mxCell id="s2_desc" value="两大继承支 ① Attention 支（家族 A + B）—— 家族 B 复用 merge 逻辑、只覆写字节公式" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="252" width="780" height="20" as="geometry"/></mxCell><mxCell id="s2c_ta" value="Attention 支（家族 A+B）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="278" width="240" height="16" as="geometry"/></mxCell><mxCell id="s2c_tm" value="独立支（家族 C）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#82b366;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="300" y="278" width="230" height="16" as="geometry"/></mxCell><mxCell id="s2c_tu" value="容器支（非格式）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="550" y="278" width="290" height="16" as="geometry"/></mxCell><mxCell id="s2c_att" value="AttentionSpec （KI:176） num_kv_heads:177 · head_size:178 · dtype:179 kv_quant_mode:180 · page_size_padded:181 indexes_kv_by_block_stride:182 unpadded = real + scale 预算 2·bs·nh·4B（KI:184-194）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="296" width="240" height="108" as="geometry"/></mxCell><mxCell id="s2c_mam" value="MambaSpec （KI:690） shapes:691 · dtypes:692 · mamba_type:694 mamba_cache_mode:695 num_speculative_blocks:696 page = Σ prod(shape)·dtype（KI:698-707）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="300" y="296" width="230" height="108" as="geometry"/></mxCell><mxCell id="s2c_uni" value="UniformTypeKVCacheSpecs （KI:817 · 容器） kv_cache_specs: dict（KI:825） page = Σ 各层（KI:827-829） is_uniform_type / from_specs（KI:838-863）&#10;同型不同参数层聚成一个组 page = Σ（→ A5.2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="550" y="296" width="290" height="108" as="geometry"/></mxCell><mxCell id="s3_label" value="③ 家族节点：Full 基准 + MLA（覆写字节公式）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="412" width="460" height="26" as="geometry"/></mxCell><mxCell id="s3c_full" value="FullAttentionSpec （KI:227）· 基准 head_size_v:237 · sliding_window:239 attention_chunk_size:243 · non_causal:245 page = bs·nh·(h+hv)·dt（KI:340-342） max_memory = cdiv(len,bs)·page（KI:258-263）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="448" width="280" height="112" as="geometry"/></mxCell><mxCell id="s3c_base" value="基准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="452" width="64" height="22" as="geometry"/></mxCell><mxCell id="s3c_mla" value="MLAAttentionSpec （KI:381）· 家族 B 根 cache_dtype_str:383 · alignment:385 compress_ratio:386 · model_version:387 storage_bs = bs//compress_ratio（KI:393-395） V3: storage_bs·576·dt（KI:411-416）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="560" y="448" width="280" height="112" as="geometry"/></mxCell><mxCell id="s3c_lat" value="latent 管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="456" y="494" width="96" height="22" as="geometry"/></mxCell><mxCell id="s3c_ovw" value="覆写字节公式" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#d79b00;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="478" width="180" height="16" as="geometry"/></mxCell><mxCell id="s4_label" value="④ 变体节点：Full 支 5 · MLA 支 4 · 标记类 + Mamba 说明" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="572" width="560" height="26" as="geometry"/></mxCell><mxCell id="s4c_sw" value="SlidingWindowSpec （KI:539） sliding_window:540 · head_size_v:541 公式同 Full（KI:547-565） 准入上限 cdiv(sw-1+in-flight,bs)+1（KI:567-588）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="604" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_ck" value="ChunkedLocalAttentionSpec （KI:499） attention_chunk_size:500 公式同 Full；上限 cdiv(chunk+in-flight,bs)（KI:502-526）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="222" y="604" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_cr" value="CrossAttentionSpec （KI:750） 缓存 encoder 输出，解码全程不释放 预算 cdiv(max_encoder_len,bs)·page（KI:755-759）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="404" y="604" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_tq" value="TQFullAttentionSpec （KI:355） tq_slot_size:363 — K+V 交织单 slot（TurboQuant） page = bs·nh·tq_slot_size（KI:365-369）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="586" y="604" width="254" height="96" as="geometry"/></mxCell><mxCell id="s4c_eo" value="EncoderOnlyAttentionSpec （KI:743） 无 KV cache max_memory_usage_bytes = 0（KI:744-746）&#10;（整层无缓存 → 空格）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="712" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_rs" value="RSWASpec （KI:459） rswa_window:469 — prefill 全局可见，仅尾窗生成 token 驻留，gap 块每 decode 步驱逐（KI:460-467）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="222" y="712" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_sk" value="SinkFullAttentionSpec （KI:763） sink_len:764 — 前 sink_len 个 token 的块永久驻留；merge 细则同 Full（KI:767-813）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="404" y="712" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_sm" value="SlidingWindowMLASpec （KI:611） SWA 驻留 + MLA 打包（DeepSeek V4 组合层） 公式镜像 MLA：storage_bs·584 等（KI:627-642） alignment / compress_ratio / model_version 同 MLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="586" y="712" width="254" height="96" as="geometry"/></mxCell><mxCell id="s4c_hs" value="HiddenStateCacheSpec （KI:452） 标记类：供 extract_hidden_states 识别隐藏状态缓存层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="820" width="170" height="96" as="geometry"/></mxCell><mxCell id="s4c_hs_t" value="标记类" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#7b1fa2;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="116" y="890" width="90" height="20" as="geometry"/></mxCell><mxCell id="s4c_mnote" value="一份 MambaSpec 覆盖六种 SSM： Mamba1 / Mamba2 / GDN ShortConv / LinearAttn / KDA 物理 shape 恒 (num_blocks,1,1,page)（差异只在 state shapes → P5）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="222" y="820" width="254" height="96" as="geometry"/></mxCell><mxCell id="s4c_mn_t" value="mamba_type 覆盖" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#d79b00;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="382" y="888" width="90" height="22" as="geometry"/></mxCell><mxCell id="s5_label" value="⑤ 组内合成（merge 家族）与注册表" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="920" width="400" height="24" as="geometry"/></mxCell><mxCell id="s5c_merge" value="merge() 家族（组内多层 → 一个组 spec，速讲 → A5.1）： 基类：字段全等 + deepcopy（KI:149-157） Full：窗口字段收集一致且互斥、non_causal 取或（KI:277-325） MLA：量化 / 压缩比 / 版本 / stride 四项一致（KI:418-448） Mamba：不 merge，is_uniform_with_collection 判同型（KI:732-739）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="948" width="780" height="64" as="geometry"/></mxCell><mxCell id="s5c_reg" value="分组兼容性由注册表决定：KVCacheSpecRegistry.get_uniform_type_base_spec()（vllm/v1/kv_cache_spec_registry.py:25-40）——自定义 spec 继承同一基类即可视为同类型（is_uniform_with_collection，KI:159-172）。聚合容器进阶用法当前仅 DeepseekV4 使用（KI:865-878）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="1020" width="780" height="64" as="geometry"/></mxCell><mxCell id="e_r_a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s1c_root" target="s2c_att" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r_m" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s1c_root" target="s2c_mam" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r_u" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s1c_root" target="s2c_uni" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a_f" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s2c_att" target="s3c_full" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f_m" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=none;dashed=1;" parent="1" source="s3c_full" target="s3c_mla" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f_sw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_full" target="s4c_sw" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f_ck" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_full" target="s4c_ck" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f_cr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_full" target="s4c_cr" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f_tq" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_full" target="s4c_tq" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f_eo" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_full" target="s4c_eo" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_rs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_mla" target="s4c_rs" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_sk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_mla" target="s4c_sk" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_sm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_mla" target="s4c_sm" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_hs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7b1fa2;strokeWidth=1;endArrow=block;dashed=0;" parent="1" source="s3c_mla" target="s4c_hs" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ma_n" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=1;endArrow=block;dashed=1;" parent="1" source="s2c_mam" target="s4c_mnote" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="idc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="140" as="geometry"/></mxCell><mxCell id="idc_A_title" value="页怎么读（每个节点 = 一张卡片）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="98" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_A_txt" value="Spec = 每层 KV cache 的格式定义（@dataclass(frozen=True)，多 rank 间可安全比较 / 共享）。两大继承支：Attention 支（家族 A+B）与独立支（家族 C）；另有容器支（非格式）。每个节点是一张卡片，右侧挂家族迷你图形（微型 K/V 条带 · latent 管 · mamba 环）。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="122" width="336" height="100" as="geometry"/></mxCell><mxCell id="idc_B_box" value="两大继承支 ② 独立支（家族 C）+ 容器支（A5）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="244" width="360" height="62" as="geometry"/></mxCell><mxCell id="idc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="318" width="360" height="196" as="geometry"/></mxCell><mxCell id="idc_L_title" value="图例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="324" width="360" height="20" as="geometry"/></mxCell><mxCell id="idc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="348" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t0" value="Attention 支节点（家族 A 全家）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="348" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="372" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t1" value="独立支（家族 C）/ 家族 B · MLA" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="372" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="396" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t2" value="容器支 UniformType（非格式）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="396" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="420" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t3" value="整层无缓存（空格）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="420" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="444" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t4" value="标记类 / 注册表说明" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="444" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="468" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t5" value="徽章：基准 / latent 管" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="468" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_dash" value="虚线 = 只覆写字节公式 / 说明关联（继承为实线）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="878" y="492" width="336" height="18" as="geometry"/></mxCell><mxCell id="idc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="524" width="360" height="120" as="geometry"/></mxCell><mxCell id="idc_D_title" value="行号口径（verify 逐条核对）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="530" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_D_txt" value="所有 （KI:xxx） = vllm/v1/kv_cache_interface.py 行号，已逐行核实；其余（flash_attn.py 等）标注在对应节点卡内。读卡：首行 = 类名与 KI 定位，缩进行 = 字段与公式。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#01579b;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="872" y="554" width="336" height="80" as="geometry"/></mxCell><mxCell id="idc_E_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="656" width="360" height="170" as="geometry"/></mxCell><mxCell id="idc_E_title" value="继承读法三点" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="662" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_E_txt" value="① frozen dataclass：多 rank 间可安全比较 / 共享，无运行时状态。&#10;② merge()：组内字段全等才能合成一个组 spec（速讲 → A5.1）。&#10;③ 同型判定：registry 同一基类即视为同类型（is_uniform_with_collection）。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="686" width="336" height="130" as="geometry"/></mxCell><mxCell id="idc_F_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="838" width="360" height="178" as="geometry"/></mxCell><mxCell id="idc_F_title" value="往下看什么" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="844" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_F_txt" value="家族 A 块内长什么样 → P3（NHD/HND 网格）&#10;家族 B 一页 = 64 槽 → P4（latent + storage_block_size）&#10;家族 C 扁平字节 → P5（四步零拷贝 + 274 KB 算例）&#10;所有字节公式集中 → P6（12 张签卡速查）&#10;四步都能落纸 → A 章达标。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="868" width="336" height="138" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pgA3" name="P3 FullAttention 块布局"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_p3" value="P3 · FullAttention 块布局（归属 A2/A3）—— NHD 与 HND 双栏 · K/V 分开 · 32KB/页算例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="s0_desc" value="逻辑 shape 全局统一 (B,H,N,2D) = (num_blocks, nh, bs, 2·head_size)（flash_attn.py:143-144 / flashinfer.py:407-408）；物理 contiguous 顺序由 get_kv_cache_stride_order() 的 permute 决定，两种布局张量总字节完全相同、只换 H/N 维摆位。K/V 拼在最后一维（前半 K 后半 V）。布局选择：_KV_CACHE_LAYOUT_OVERRIDE → env VLLM_KV_CACHE_LAYOUT → connector 要求 → 默认 NHD（kv_connector/utils.py:48-50）。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1520" height="34" as="geometry"/></mxCell><mxCell id="s1_label" value="① 图例 · 同一份页数据的两种 stride 视图" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="86" width="560" height="28" as="geometry"/></mxCell><mxCell id="s1_desc" value="怎么读双栏：两栏画的是同一份 Llama-3-8B 页（16 token × 8 头，K 蓝 / V 绿，每格 128 维）。左 NHD 按「token」成行、右 HND 按「头」成行 —— shape 语义不变、page_size_bytes 不变，切换只是 view + permute（零拷贝）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="118" width="780" height="36" as="geometry"/></mxCell><mxCell id="s1c_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="160" width="780" height="78" as="geometry"/></mxCell><mxCell id="s1c_title" value="图例" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="50" y="168" width="120" height="18" as="geometry"/></mxCell><mxCell id="s1c_chp58" value="K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="58" y="194" width="34" height="22" as="geometry"/></mxCell><mxCell id="s1c_cht58" value="K 半格（128 维示意）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="100" y="194" width="150" height="22" as="geometry"/></mxCell><mxCell id="s1c_chp268" value="V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="268" y="194" width="34" height="22" as="geometry"/></mxCell><mxCell id="s1c_cht268" value="V 半格" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="310" y="194" width="70" height="22" as="geometry"/></mxCell><mxCell id="s1c_chp400" value="✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="400" y="194" width="34" height="22" as="geometry"/></mxCell><mxCell id="s1c_cht400" value="命中 / kernel 取行" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="442" y="194" width="130" height="22" as="geometry"/></mxCell><mxCell id="s1c_chp590" value="空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="590" y="194" width="34" height="22" as="geometry"/></mxCell><mxCell id="s1c_cht590" value="空闲" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="632" y="194" width="50" height="22" as="geometry"/></mxCell><mxCell id="s1c_chp704" value="浪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="704" y="194" width="34" height="22" as="geometry"/></mxCell><mxCell id="s1c_cht704" value="浪费（对齐 padding）" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="746" y="194" width="70" height="22" as="geometry"/></mxCell><mxCell id="s2_label_c" value="左栏 · NHD 布局（默认，Token 在前）：(B, N, H, 2D)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=16;align=left;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="246" width="780" height="28" as="geometry"/></mxCell><mxCell id="s2_desc" value="stride_order = (0,2,1,3)：view 后 permute 交换 H/N（flash_attn.py:157-159）——对 token 连续读写友好&#10;块 block_id = 7（示例页）· 一格 = 1 token × 1 头 · 上半 K(128 维) / 下半 V(128 维) · 行 = token（t0–t15），列 = KV 头（h0–h7）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="280" width="780" height="34" as="geometry"/></mxCell><mxCell id="s2c_hd0" value="h0 (K|V)" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="316" width="100" height="16" as="geometry"/></mxCell><mxCell id="s2c_hd1" value="h1 (K|V)" s