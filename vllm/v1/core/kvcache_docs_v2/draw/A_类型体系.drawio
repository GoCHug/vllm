Color=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="466" y="126" width="360" height="16" as="geometry"/></mxCell><mxCell id="s1c_s0" value="s0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="470" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s1" value="s1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="514" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s2" value="s2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="558" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s3" value="s3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="602" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s4" value="s4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="646" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s5" value="s5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="690" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s6" value="s6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="734" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_s7" value="s7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="778" y="148" width="40" height="20" as="geometry"/></mxCell><mxCell id="s1c_ptr" value="推杆指针（每步覆写）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="466" y="176" width="354" height="16" as="geometry"/></mxCell><mxCell id="s1c_pe" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="218" as="sourcePoint"/><mxPoint x="620" y="172" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1c_ckpt" value="块边界 checkpoint（每块恒定 274 KB，块号即前缀长度 i×bs）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="230" width="780" height="20" as="geometry"/></mxCell><mxCell id="s1c_b0" value="block 0 前 i×bs token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="254" width="120" height="40" as="geometry"/></mxCell><mxCell id="s1c_b1" value="block 1 前 i×bs token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="188" y="254" width="120" height="40" as="geometry"/></mxCell><mxCell id="s1c_b2" value="block 2 前 i×bs token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="316" y="254" width="120" height="40" as="geometry"/></mxCell><mxCell id="s1c_b3" value="block 3 前 i×bs token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="444" y="254" width="120" height="40" as="geometry"/></mxCell><mxCell id="s1c_b4" value="block 4 前 i×bs token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="572" y="254" width="120" height="40" as="geometry"/></mxCell><mxCell id="s1c_b5" value="block 5 前 i×bs token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="700" y="254" width="120" height="40" as="geometry"/></mxCell><mxCell id="s1c_sem" value="块 i 存「处理完前 i·bs 个 token 之后」的状态：conv_state = 最近 conv_kernel-1 个 token 的滑窗；ssm_state = 含全部历史的递归矩阵 —— prefix 命中可从最近 checkpoint 直接恢复" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="302" width="780" height="34" as="geometry"/></mxCell><mxCell id="s2_label" value="mamba_cache_mode 三档（锚钉数 = 常驻 checkpoint 份数）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="344" width="620" height="26" as="geometry"/></mxCell><mxCell id="s2c_m0" value="none （默认，KI:717-718）：常驻 1+num_spec 块，仅当前步运行状态、每步原地覆盖；不支持 prefix caching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="376" width="250" height="108" as="geometry"/></mxCell><mxCell id="s2c_pin0" value="锚钉 = 常驻 checkpoint 存放点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="452" width="150" height="22" as="geometry"/></mxCell><mxCell id="s2c_m1" value="align （KI:715-716）：常驻 2+num_spec 块 = 最近块边界 checkpoint；仅尾部命中；块表行仍按全长编址（KI:723-729）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="302" y="376" width="250" height="108" as="geometry"/></mxCell><mxCell id="s2c_pin1" value="锚钉 = 常驻 checkpoint 存放点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="310" y="452" width="150" height="22" as="geometry"/></mxCell><mxCell id="s2c_m2" value="all （KI:710-714）：每个 i×bs 边界一份 checkpoint，共 cdiv(max_len,bs)+spec 块 → 全量前缀复用；Qwen3.5 明确禁用（旧材料 qwen3_5.py:307），官方推荐 align" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="564" y="376" width="276" height="108" as="geometry"/></mxCell><mxCell id="s2c_pin2" value="锚钉 = 常驻 checkpoint 存放点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="572" y="452" width="150" height="22" as="geometry"/></mxCell><mxCell id="s2c_mode" value="mamba_cache_mode 三档 = 常驻锚钉数（块）：none=1 / align=2 / all=每块边界" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="492" width="780" height="18" as="geometry"/></mxCell><mxCell id="s3_label" value="② 一页 = 扁平字节 → 四步零拷贝切状态（bind_kv_cache）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="520" width="620" height="28" as="geometry"/></mxCell><mxCell id="s3_desc" value="一页（280,576 B，GDN 例）按字节切成两个状态：raw int8 → .view(num_blocks, 1, 1, page_size_bytes)（worker reshape 分支）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="552" width="780" height="32" as="geometry"/></mxCell><mxCell id="s3c_conv" value="conv 18,432B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="60" y="592" width="110" height="30" as="geometry"/></mxCell><mxCell id="s3c_ssm" value="ssm_state 262,144 B（占 93%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="170" y="592" width="650" height="30" as="geometry"/></mxCell><mxCell id="s3c_belt" value="零拷贝传送带（同一块 int8 字节上叠 view）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="60" y="628" width="780" height="18" as="geometry"/></mxCell><mxCell id="s3c_s0" value="① squeeze(1,2) → (num_blocks, page_bytes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="60" y="652" width="170" height="56" as="geometry"/></mxCell><mxCell id="s3c_se0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="232" y="680" as="sourcePoint"/><mxPoint x="246" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3c_s1" value="② 逐 state 按字节切片 [:, offset : offset+nbytes]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="246" y="652" width="170" height="56" as="geometry"/></mxCell><mxCell id="s3c_se1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="418" y="680" as="sourcePoint"/><mxPoint x="432" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3c_s2" value="③ .view(dtype) int8 → bf16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="432" y="652" width="170" height="56" as="geometry"/></mxCell><mxCell id="s3c_se2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1;endArrow=block;dashed=0;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="604" y="680" as="sourcePoint"/><mxPoint x="618" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3c_s3" value="④ .view(-1, *shape) → (num_blocks, *state_shape)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="618" y="652" width="170" height="56" as="geometry"/></mxCell><mxCell id="s3c_tray1" value="conv_state 托盘 (num_blocks, 3072, 3) = 18,432 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="720" width="350" height="48" as="geometry"/></mxCell><mxCell id="s3c_tray2" value="ssm_state 托盘 (num_blocks, 8, 128, 128) = 262,144 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="430" y="720" width="380" height="48" as="geometry"/></mxCell><mxCell id="s3c_tray_n" value="双层托盘 = 同一块字节上的两个 view（conv 6.6% + ssm 93.4%）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="60" y="774" width="420" height="18" as="geometry"/></mxCell><mxCell id="s3c_cube" value="ssm 状态立方体" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="500" y="774" width="160" height="18" as="geometry"/></mxCell><mxCell id="s4_label" value="③ GDN 字节算例（Qwen3-Next, bf16, tp=1）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="804" width="560" height="28" as="geometry"/></mxCell><mxCell id="s4_desc" value="page = Σ prod(shape) · dtype_size —— 与 block_size 无关；conv 与 ssm 两份状态字节差约 14 倍" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="836" width="780" height="18" as="geometry"/></mxCell><mxCell id="s4c_ex1" value="conv_dim = head_k_dim·num_k_heads·2 + head_v_dim·num_v_heads = 128×8×2 + 128×8 = 3072 conv_state (3072, 3) × 2B = 18,432 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="862" width="380" height="78" as="geometry"/></mxCell><mxCell id="s4c_ex2" value="temporal（门控 delta-rule 更新矩阵） ssm_state (8, 128, 128) × 2B = 262,144 B —— 非 (h, d, state) 传统 SSM 形状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="436" y="862" width="380" height="78" as="geometry"/></mxCell><mxCell id="s4c_sum" value="page = 18,432 + 262,144 = 280,576 B = 274 KB / 块 / 层 ≈ 4.3 个 Llama-3-8B Full 页（64 KB）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="952" width="776" height="46" as="geometry"/></mxCell><mxCell id="idc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="150" as="geometry"/></mxCell><mxCell id="idc_A_title" value="块语义对照（最易混淆）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="98" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_A_txt" value="块语义对照（最易混淆）：家族 A 块 i 存 token [i·bs, (i+1)·bs) 各自的 K/V（字节 ∝ token 数）；家族 C 块 i 存前缀 i·bs token 的累积状态（字节恒定）。同一 block_id 索引、页内容不同 —— 这正是统一块表能管理混合模型的原因（→ E1）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="122" width="336" height="110" as="geometry"/></mxCell><mxCell id="idc_B_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="254" width="360" height="130" as="geometry"/></mxCell><mxCell id="idc_B_title" value="四步零拷贝（bind_kv_cache）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="260" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_B_txt" value="四步全程零拷贝（mamba/abstract.py:29-43，旧材料 §6.4）：不搬数据，只在同一块字节上叠 view；forward 用 conv_state[block_id] / ssm_state[block_id] 读写；GDN spec 类型 = GDN_ATTN" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="284" width="336" height="90" as="geometry"/></mxCell><mxCell id="idc_C_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="396" width="360" height="130" as="geometry"/></mxCell><mxCell id="idc_C_title" value="page 字节公式" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="402" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_C_txt" value="page = Σ_shape prod(shape) × dtype_size （KI:698-707） 与 block_size 无关 → 混合统一只能 padding 页字节、不能放大 bs（→ B2/E1）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="872" y="426" width="336" height="90" as="geometry"/></mxCell><mxCell id="idc_D_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="538" width="360" height="110" as="geometry"/></mxCell><mxCell id="idc_D_title" value="同一公式覆盖六种 SSM" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="544" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_D_txt" value="同一公式覆盖六种 SSM（Mamba1/2、GDN、ShortConv、LinearAttn、KDA），差别只在 state shapes（→ P2）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="568" width="336" height="70" as="geometry"/></mxCell><mxCell id="idc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="660" width="360" height="148" as="geometry"/></mxCell><mxCell id="idc_L_title" value="图例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="666" width="360" height="20" as="geometry"/></mxCell><mxCell id="idc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="688" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t0" value="蓝段 = ssm_state（约 93%）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="688" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="712" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t1" value="橙段 = conv 滑窗（约 6.6%）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="712" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="736" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t2" value="灰格 = 就地更新状态 / checkpoint 块" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="736" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="760" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t3" value="黄徽章 = 锚钉（常驻 checkpoint 存放点）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="760" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_F_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="820" width="360" height="170" as="geometry"/></mxCell><mxCell id="idc_F_title" value="混合模型记忆点（→ E1）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#666666;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="826" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_F_txt" value="同一 block_id 索引、页内容不同：&#10;· 家族 A 块 i = token 段 K/V（字节 ∝ token 数）&#10;· 家族 B 块 i = token 段 latent（宽 576）&#10;· 家族 C 块 i = 前缀累积状态（字节恒定）&#10;混合统一时：只能 padding 页字节，不能放大 bs。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="850" width="336" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pgA6" name="P6 页字节公式速查"><mxGraphModel dx="1284" dy="1651" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_p6" value="P6 · 页字节公式速查（归属 A2/A3 · 一卡一 spec · 锚点 = vllm/v1/kv_cache_interface.py 已核实）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=20;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="220" y="0" width="1160" height="40" as="geometry"/></mxCell><mxCell id="s0_desc" value="12 张签卡 = 12 个 spec 的 page_size_bytes 速查签名；锚点行号（KI:xxx）已逐行核实" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="40" y="44" width="1140" height="20" as="geometry"/></mxCell><mxCell id="s1_label" value="① 公共包装链卡（三个量的顺序）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="74" width="400" height="28" as="geometry"/></mxCell><mxCell id="s1c_pub" value="公共" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="108" width="56" height="20" as="geometry"/></mxCell><mxCell id="s1_desc" value="padded ?: real + scale 预算" style="text;html=1;verticalAlign=middle;align=left;whiteSpace=wrap;fontSize=11;fontColor=#999999;" parent="1" vertex="1"><mxGeometry x="104" y="108" width="320" height="20" as="geometry"/></mxCell><mxCell id="s1c_outer" value="公共包装（三个量的顺序） page_size_bytes = page_size_padded ?: ( real + quant_scale_budget ) real：各子类真字节（类型差异所在）｜per-token-head 另加 scale 预算 2·bs·nh·4B（KI:190-194） padded 来源：MLA alignment / 混合统一页字节（KI:345-351 → B2/E1） 锚点：KI:109（抽象）/ :184-201（Attention 实装）/ Mamba :698-707" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="134" width="780" height="76" as="geometry"/></mxCell><mxCell id="s2_label" value="横杆 1 · 公共包装 + Full 支 + 变体（6 签）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="222" width="620" height="28" as="geometry"/></mxCell><mxCell id="s2c_k0" value="公共包装（三个量的顺序） page_size_bytes = page_size_padded ?: ( real + quant_scale_budget ) real：各子类真字节（类型差异所在）｜per-token-head 另加 scale 预算 2·bs·nh·4B（KI:190-194） padded 来源：MLA alignment / 混合统一页字节（KI:345-351 → B2/E1） 锚点：KI:109（抽象）/ :184-201（Attention 实装）/ Mamba :698-707" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="40" y="258" width="385" height="116" as="geometry"/></mxCell><mxCell id="s2c_kb0_5" value="公共" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="264" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_k1" value="AttentionSpec（基式） page = 2 · bs · nh · head_dim · dtype_size（KI:212-218） 因子 2 = K、V 各一份 head_dim nvfp4：head_dim = full_dim(h)（KI:205-207）｜int4-per-token-head：h/2（KI:208-211） DCP：max_num_blocks = cdiv(len, bs·kv_shard)（KI:220-223）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="435" y="258" width="385" height="116" as="geometry"/></mxCell><mxCell id="s2c_kb1_8" value="Full 支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="443" y="264" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_kb1_9" value="K/V 条带" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="513" y="264" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_k2" value="FullAttentionSpec（基准） page = bs · nh · (head_size + head_size_v) · dtype_size（KI:340-342） h==hv 时与基式等价：2·D = D + D 算例 Llama-3-8B：16×8×(128+128)×2 = 64 KB（TP1）；pp2tp2 nh=4 → 32 KB max_memory = cdiv(max_len, bs)·page（KI:258-263）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="40" y="380" width="385" height="116" as="geometry"/></mxCell><mxCell id="s2c_kb2_11" value="Full 支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="386" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_kb2_12" value="K/V 条带" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="118" y="386" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_k3" value="SlidingWindowSpec page 同 Full（KI:547-565，含 nvfp4 分支） 差异在预算：max_admission = cdiv(sw-1+in-flight, bs)+1（KI:567-588） +1 因窗口可跨块首（旧例：bs=4 存 6-token 窗要 2 块） max_memory = 上限 × page（KI:590-598）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="435" y="380" width="385" height="116" as="geometry"/></mxCell><mxCell id="s2c_kb3_14" value="Full 支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="443" y="386" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_kb3_15" value="窗口=常驻，窗外可释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="513" y="386" width="132" height="18" as="geometry"/></mxCell><mxCell id="s2c_k4" value="TQFullAttentionSpec（TurboQuant） page = bs · nh · tq_slot_size（KI:365-369） K+V 不再分列，交织打包进单个 slot tq_slot_size=0 时回退父类公式；merge 强制组内一致（KI:371-377） C++ TQ4FullAttentionSpec 的 Python 等价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="40" y="502" width="385" height="116" as="geometry"/></mxCell><mxCell id="s2c_kb4_17" value="变体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="508" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_kb4_18" value="K/V 交织单 slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="118" y="508" width="132" height="18" as="geometry"/></mxCell><mxCell id="s2c_k5" value="特例与聚合速查 SinkFull / RSWA / ChunkedLocal：公式同 Full，只改驻留与预算（→ A4） CrossAttention：cdiv(max_encoder_len, bs) · page（KI:755-759） EncoderOnly：max_memory = 0（KI:743-746） HiddenState：MLA 公式原样（标记类，KI:452-455）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="435" y="502" width="385" height="116" as="geometry"/></mxCell><mxCell id="s2c_kb5_20" value="变体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="443" y="508" width="64" height="18" as="geometry"/></mxCell><mxCell id="s2c_kb5_21" value="金=Sink 头 / 灰=无缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="513" y="508" width="214" height="18" as="geometry"/></mxCell><mxCell id="s3_label" value="横杆 2 · MLA 支 · Mamba · 量化格式 · 容器（6 签）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="630" width="620" height="28" as="geometry"/></mxCell><mxCell id="s3c_k0" value="MLAAttentionSpec V3 bf16：storage_bs · 576 · dt（KI:411-416）｜V3.2：bs · 656（KI:404-406） V4：storage_bs · 584（KI:399-403） storage_bs = bs // compress_ratio（KI:393-395） 算例 DSv3：64×576×2 = 72 KB；V4（bs64, r4）：16×584 = 9,344 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="40" y="664" width="385" height="116" as="geometry"/></mxCell><mxCell id="s3c_kb0_23" value="MLA 支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="670" width="64" height="18" as="geometry"/></mxCell><mxCell id="s3c_kb0_24" value="latent 管（NoPE+RoPE）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="118" y="670" width="214" height="18" as="geometry"/></mxCell><mxCell id="s3c_k1" value="SlidingWindowMLASpec 镜像 MLA：v4 → storage_bs × 584；其余 → storage_bs·nh·h·dt（KI:627-642） = SWA 驻留 + MLA 打包（DeepSeek V4 组合层） merge 额外要求窗口 / 量化 / 压缩比 / 版本 / stride 全组一致（KI:644-677） sliding_window 语义与 c4 相同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="435" y="664" width="385" height="116" as="geometry"/></mxCell><mxCell id="s3c_kb1_26" value="MLA 支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="443" y="670" width="64" height="18" as="geometry"/></mxCell><mxCell id="s3c_kb1_27" value="latent 管（NoPE+RoPE）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="513" y="670" width="214" height="18" as="geometry"/></mxCell><mxCell id="s3c_k2" value="MambaSpec page = Σ_shape prod(shape) × dtype_size（KI:698-707）——与 bs 无关 常驻：none=1+spec / align=2+spec / all=cdiv(len,bs)+spec（KI:709-718） 算例 GDN：conv 18,432 + ssm 262,144 = 280,576 B = 274 KB 统一只能 padding、block_size 不动（→ B2/E1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="40" y="786" width="385" height="116" as="geometry"/></mxCell><mxCell id="s3c_kb2_29" value="Mamba" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="792" width="64" height="18" as="geometry"/></mxCell><mxCell id="s3c_kb2_30" value="状态环（与 bs 无关）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="118" y="792" width="132" height="18" as="geometry"/></mxCell><mxCell id="s3c_k3" value="NVFP4（FlashInfer） full_dim(h) = h/2 + h/16（fp4 数据 + fp8 block scale，torch_utils.py:414-416） Full last_dim = full_dim(h) + full_dim(hv)（KI:333-335）；基类 head_dim 维（KI:205-207） 物理：K/V 头数翻倍 (B, 2·nh, N, full_dim)（flashinfer.py:404-406） 微算例 h=hv=128, nh=8, bs=16：16×8×144×1B = 18,432 B（约 bf16 的 28%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="435" y="786" width="385" height="116" as="geometry"/></mxCell><mxCell id="s3c_kb3_32" value="变体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="443" y="792" width="64" height="18" as="geometry"/></mxCell><mxCell id="s3c_kb3_33" value="h/2 + h/16 打包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="513" y="792" width="132" height="18" as="geometry"/></mxCell><mxCell id="s3c_k4" value="INT4 per-token-head 打包 head_dim = h//2（KI:208-211；Full：h//2 + hv//2，KI:336-337） 另在 unpadded 计入 per-token-head scale 预算 2·bs·nh·4B（KI:190-194） 物理 dtype 固定 uint8（2×int4 打包 1 字节） kv_cache_dtype 字符串 → KVQuantMode（KI:62-74）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="40" y="908" width="385" height="116" as="geometry"/></mxCell><mxCell id="s3c_kb4_35" value="变体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="48" y="914" width="64" height="18" as="geometry"/></mxCell><mxCell id="s3c_kb4_36" value="半宽打包 + fp32 scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="118" y="914" width="214" height="18" as="geometry"/></mxCell><mxCell id="s3c_k5" value="UniformTypeKVCacheSpecs（容器） page = Σ 各层 page_size_bytes（KI:827-829）—— 一个 block id 跨多层拼页 预算 = 各层最大页数 × 聚合页（KI:831-836） is_uniform_type：block_size 一致 + registry 基类判定（KI:838-851） 进阶用法当前仅 DeepseekV4（KI:865-878）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingTop=24;" parent="1" vertex="1"><mxGeometry x="435" y="908" width="385" height="116" as="geometry"/></mxCell><mxCell id="s3c_kb5_38" value="容器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="443" y="914" width="64" height="18" as="geometry"/></mxCell><mxCell id="s3c_kb5_39" value="page = Σ 各层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="513" y="914" width="132" height="18" as="geometry"/></mxCell><mxCell id="s6_concl" value="四步都能落纸，A 章达标（完成标准自查 → 总纲 A 章）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="1036" width="780" height="44" as="geometry"/></mxCell><mxCell id="s4_label" value="④ 完成标准自查（四步落纸）" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="92" width="360" height="28" as="geometry"/></mxCell><mxCell id="s4c_t0" value="① 认 spec 类（P2 继承树 → A1.2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="124" width="360" height="46" as="geometry"/></mxCell><mxCell id="s4c_t1" value="② 找到本卡公式，算 page_size_bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="178" width="360" height="46" as="geometry"/></mxCell><mxCell id="s4c_t2" value="③ 写物理 shape（P3/P4/P5 各族样板）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="232" width="360" height="46" as="geometry"/></mxCell><mxCell id="s4c_t3" value="④ 判分组（A5：同值层 merge / 同型层容器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="286" width="360" height="46" as="geometry"/></mxCell><mxCell id="s4c_ok" value="四步都能落纸，A 章达标（完成标准自查 → 总纲 A 章）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="346" width="360" height="48" as="geometry"/></mxCell><mxCell id="idc_A_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="406" width="360" height="130" as="geometry"/></mxCell><mxCell id="idc_A_title" value="三个贯穿算例（自查用）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="412" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_A_txt" value="三个贯穿算例（完成标准自查用）：Llama-3-8B 64 KB/页/层（TP1）· 32 KB/页/层（pp2tp2 基准，nh=4）；DeepSeek-V3 72 KB；GDN 274 KB。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="436" width="336" height="90" as="geometry"/></mxCell><mxCell id="idc_L_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="548" width="360" height="170" as="geometry"/></mxCell><mxCell id="idc_L_title" value="图例" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="554" width="360" height="20" as="geometry"/></mxCell><mxCell id="idc_L_c0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="576" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t0" value="蓝卡 = Full 支公式" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="576" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="600" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t1" value="绿卡 = MLA 支公式" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="600" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="624" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t2" value="灰卡 = Mamba / 容器" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="624" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="648" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t3" value="白卡橙边 = 量化变体" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="648" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_L_c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="878" y="672" width="30" height="18" as="geometry"/></mxCell><mxCell id="idc_L_t4" value="黄徽章 = 支别 / 特征" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=10;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="916" y="672" width="296" height="18" as="geometry"/></mxCell><mxCell id="idc_E_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="730" width="360" height="130" as="geometry"/></mxCell><mxCell id="idc_E_title" value="与其他页衔接" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="736" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_E_txt" value="① 认 spec 类 → P2 继承树（A1.2）&#10;③ 写物理 shape → P3 / P4 / P5 各族样板&#10;④ 判分组 → A5（同值层 merge / 同型层容器）&#10;预算与容量上限 → B 章。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="760" width="336" height="90" as="geometry"/></mxCell><mxCell id="idc_F_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="860" y="872" width="360" height="170" as="geometry"/></mxCell><mxCell id="idc_F_title" value="抽卡复核（30 秒）" style="text;html=1;verticalAlign=top;align=center;whiteSpace=wrap;fontSize=14;fontColor=#01579b;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="860" y="878" width="360" height="22" as="geometry"/></mxCell><mxCell id="idc_F_txt" value="· Full 支：16×8×(128+128)×2 = 64 KB（TP1）&#10;· MLA：64×576×2 = 72 KB（DSv3）&#10;· GDN：18,432 + 262,144 = 280,576 B = 274 KB&#10;· NVFP4：16×8×144×1B = 18,432 B&#10;对不上一律回 KI 行号核原文。" style="text;html=1;verticalAlign=top;align=left;whiteSpace=wrap;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="872" y="902" width="336" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>