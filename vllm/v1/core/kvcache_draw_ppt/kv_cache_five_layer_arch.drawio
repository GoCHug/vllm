                <mxCell id="g1_c2" value="方案" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="184" y="652" width="70" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g1_c3" value="设计①" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="260" y="652" width="76" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g1_c4" value="设计②" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="342" y="652" width="76" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g1_c5" value="设计③" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="424" y="652" width="76" height="24" as="geometry"/>
