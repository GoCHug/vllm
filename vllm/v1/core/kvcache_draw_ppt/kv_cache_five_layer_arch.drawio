                <mxCell id="g4_e3" value="同一份 KVCacheConfig 下发" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d6b656;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="g4_1" source="g4_s3" target="g4_w4" edge="1">
