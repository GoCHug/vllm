    <diagram id="p5_bridge" name="5-对象桥接图-两个衔接点">
        <mxGraphModel dx="762" dy="511" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g5_0"/>
                <mxCell id="g5_1" parent="g5_0"/>
                <mxCell id="g5_title" value="3.2 两个衔接点（理解后续章节的关键）" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g5_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g5_badge" value="图表类型 · 对象桥接图" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" parent="g5_1" vertex="1">
                    <mxGeometry x="1020" y="26" width="220" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="g5_sub" value="衔接点 1：物理 ↔ 逻辑靠「同一份配置 ＋ block_id 约定」对齐；衔接点 2：逻辑层代码自上而下构造、持有自下而上" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" parent="g5_1" vertex="1">
                    <mxGeometry x="40" y="62" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g5_h1" value="&lt;b&gt;衔接点 1：物理 ↔ 逻辑——同一份配置定容量，block_id 即行号&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;fontColor=#333333;" parent="g5_1" vertex="1">
                    <mxGeometry x="40" y="94" width="620" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g5_cfg" value="&lt;b&gt;KVCacheConfig&lt;/b&gt;&#10;num_blocks ＋ kv_cache_tensors[*].size / shared_by" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;verticalAlign=middle;align=center;fontSize=12;" parent="g5_1" vertex="1">
                    <mxGeometry x="180" y="126" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="g5_phys" value="&lt;b style=&quot;font-size:13px&quot;&gt;物理侧（worker 进程）&lt;/b&gt;　只按配置执行，不自行算块数&#10;· 遍历 KVCacheConfig.kv_cache_tensors&#10;· 每条目按 size（普通 layout 下恰为 num_blocks × page_size 字节）torch.zeros 出 int8 扁平字节张量&#10;· shared_by 列出的层名共享同一张（主线无共享，每层一张）&#10;· 再 reshape 成后端 shape 并 bind 到 attention 层&#10;〔kv_cache_interface.py:926-932 · gpu_model_runner.py:7303-7320〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f0f8;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g5_1" vertex="1">
                    <mxGeometry x="40" y="206" width="300" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="g5_logic" value="&lt;b style=&quot;font-size:13px&quot;&gt;逻辑侧（引擎进程 BlockPool）&lt;/b&gt;　只建元数据对象，不含任何 K/V&#10;· new 出 num_blocks 个 KVCacheBlock&#10;· block_id 取序号 0 … n−1&#10;· 每块只带 block_id、ref_cnt、哈希、空闲队列指针等元数据&#10;· 块 0 开池即留作 null_block 占位：不维护引用计数、不可分配&#10;〔block_pool.py:175-177〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g5_1" vertex="1">
                    <mxGeometry x="360" y="206" width="300" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="g5_ce1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="g5_1" source="g5_cfg" target="g5_phys" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g5_ce2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="g5_1" source="g5_cfg" target="g5_logic" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g5_result" value="&lt;b&gt;桥接结果&lt;/b&gt;　同一份配置 ⇒ 两侧容量必然相等；「从 0 顺序编号」的约定 ⇒ block_id 直接等于物理张量第 0 维行号——无需查表或拷贝。&#10;此后物理张量不再变动，分配 / 共享 / 驱逐只改引用计数与哈希表；实际可分配块为 n−1（null_block 占位）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=12;fontSize=11;" parent="g5_1" vertex="1">
                    <mxGeometry x="40" y="462" width="620" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="g5_h2" value="&lt;b&gt;衔接点 2：逻辑层内部——代码上自上而下构造，持有关系自下而上&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;fontColor=#333333;" parent="g5_1" vertex="1">
                    <mxGeometry x="700" y="94" width="540" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g5_n1" value="&lt;b&gt;1&lt;/b&gt;　Scheduler 构造第 5 层 &lt;b&gt;KVCacheManager&lt;/b&gt;（sched/scheduler.py:271）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=12;" parent="g5_1" vertex="1">
                    <mxGeometry x="700" y="130" width="540" height="52" as="geometry"/>
                </mxCell>
