                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p2_arch" name="2-分层架构图-五层总览">
        <mxGraphModel dx="762" dy="511" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g2_0"/>
                <mxCell id="g2_1" parent="g2_0"/>
                <mxCell id="g2_title" value="2. vLLM V1 KV Cache 管理五层架构（Full Attention 视角）" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g2_badge" value="图表类型 · 分层架构图" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" parent="g2_1" vertex="1">
                    <mxGeometry x="1020" y="26" width="220" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="g2_sub" value="层号自下而上（第 1 层最底）；下图按「上层在下层之上」惯例自上而下排列。Scheduler 是调用者，不算层" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="62" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g2_sch" value="&lt;b&gt;Scheduler（调度器 · 调用者）&lt;/b&gt;　只通过第 5 层门面统一调用，不直接触碰 KV cache 内部结构" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="96" width="680" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L5" value="&lt;b&gt;第 5 层 · 顶层门面　KVCacheManager&lt;/b&gt;　持有 1 个第 4 层；对 Scheduler 暴露统一 API（get_computed_blocks / allocate_slots / free 等）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="160" width="680" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L4" value="&lt;b&gt;第 4 层 · 协调器　UnitaryKVCacheCoordinator（主线）&lt;/b&gt;　持有 N 个第 3 层（每 spec group 1 个，主线 N=1）＋ 1 个第 2 层；混合模型协调器为扩展" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="228" width="680" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L3" value="&lt;b&gt;第 3 层 ×N · 单类型管理　FullAttentionManager（主线 N=1）&lt;/b&gt;　前缀查找（链式哈希）/ 分配释放 / block_table 维护" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="296" width="680" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L2" value="&lt;b&gt;第 2 层 ×1 · 逻辑块池　BlockPool（唯一，所有第 3 层共享）&lt;/b&gt;　逻辑块分配 / 释放 / 缓存哈希 / LRU 驱逐（仅 block_id，无显存）&#10;内件：FreeKVCacheBlockQueue（LRU 空闲块队列）＋ BlockHashToBlockMap（链式哈希 → block 映射）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="364" width="680" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="g2_bnote" value="桥接（非持有）：L2 在引擎进程、L1 在 worker 进程，无对象引用；由同一份 KVCacheConfig ＋「block_id 从 0 编号即物理行号」约定对齐" style="text;html=1;fontSize=10;align=center;fontColor=#9673a6;fontStyle=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="436" width="680" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="g2_L1" value="&lt;b&gt;第 1 层 · 物理显存　GPUModelRunner.kv_caches[layer]（worker 进程）&lt;/b&gt;&#10;torch [num_blocks, num_kv_heads, block_size, 2·head_dim]；block_id 直接索引第 0 维（物理行号）；真正读写 K/V 的是 attention 算子" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" parent="g2_1" vertex="1">
                    <mxGeometry x="40" y="492" width="680" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="g2_1" source="g2_sch" target="g2_L5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e2" value="持有 1 个" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_L5" target="g2_L4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e3" value="持有 ×N（主线 N=1）" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_L4" target="g2_L3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e4" value="引用同一个 BlockPool" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#595959;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#ffffff;" parent="g2_1" source="g2_L3" target="g2_L2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="g2_1" source="g2_L2" target="g2_L1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_tree" value="&lt;b&gt;持有关系树（数字＝持有数量）&lt;/b&gt;&#10;Scheduler（调用者）&#10;└─1→ KVCacheManager（L5 门面）&#10;　　└─1→ UnitaryKVCacheCoordinator（L4）&#10;　　　　├─×N→ FullAttentionManager（L3，主线 N=1）&#10;　　　　└─1→ BlockPool（L2，唯一且共享）&#10;　　　　　　╎ block_id 桥接（非持有）&#10;　　　　　　▼&#10;　　　　　　kv_caches[layer]（L1 · worker 进程）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=18;fontSize=12;align=left;" parent="g2_1" vertex="1">
                    <mxGeometry x="760" y="96" width="480" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="g2_rule" value="&lt;b&gt;全局约定&lt;/b&gt;&#10;① block_id 从 0 顺序编号，即物理张量第 0 维行号&#10;② block 0 开池即留作 null_block 占位：不维护引用计数、不可分配（实际可分配 n−1）&#10;③ 逻辑侧（L2～L5）在引擎进程；物理侧（L1）在 worker 进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;spacingTop=10;spacingLeft=14;fontSize=11;align=left;" parent="g2_1" vertex="1">
                    <mxGeometry x="760" y="308" width="480" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="g2_why" value="&lt;b&gt;为什么快&lt;/b&gt;　调度全程只操作整数 block_id；相同前缀直接复用物理块（ref_cnt++ 零拷贝）；物理张量启动一次成型，运行期零分配、零拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=12;" parent="g2_1" vertex="1">
