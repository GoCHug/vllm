                <mxCell id="g9_title" value="扩展：其他注意力类型概览" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="g9_badge" value="图表类型 · 扩展分类图" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" parent="g9_1" vertex="1">
                    <mxGeometry x="1020" y="26" width="220" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="g9_sub" value="所有类型都在同一五层骨架上派生；卡片底部彩色 L 标签＝主要扩展落点层" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" parent="g9_1" vertex="1">
                    <mxGeometry x="40" y="62" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g9_root" value="&lt;b&gt;五层骨架（Full Attention 主线）&lt;/b&gt;　——　以下类型均在此骨架上按层落点派生" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" parent="g9_1" vertex="1">
                    <mxGeometry x="340" y="96" width="600" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="g9_rule" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1.5;" parent="g9_1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="640" y="152" as="sourcePoint"/>
