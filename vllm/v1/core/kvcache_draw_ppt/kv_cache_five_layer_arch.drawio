                </mxCell>
                <mxCell id="g8_x1" value="block_table 是逻辑与物理之间唯一的接口：逻辑链用它完成全部分配 / 共享 / 驱逐，物理算子用它 gather 张量行。&#10;&#10;调度全程零显存拷贝，物理张量自启动申请后不再变动。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;verticalAlign=top;align=left;spacingLeft=0;fontSize=11;" parent="g8_1" vertex="1">
                    <mxGeometry x="54" y="214" width="358" height="176" as="geometry"/>
