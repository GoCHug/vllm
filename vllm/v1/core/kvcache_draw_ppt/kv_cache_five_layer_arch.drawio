                <mxCell id="g1_c6" value="结论" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontStyle=1;align=center;" parent="g1_1" vertex="1">
                    <mxGeometry x="506" y="652" width="70" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g1_pg" value="第 1 页 · 共 9 页" style="text;html=1;fontSize=10;align=right;fontColor=#999999;" parent="g1_1" vertex="1">
