                <mxCell id="g4_badge" value="图表类型 · 系统部署图" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" parent="g4_1" vertex="1">
