                    <mxGeometry x="447" y="100" width="386" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="g8_t2" value="&lt;b&gt;② prefill / decode 同一骨架&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;fontColor=#4d7d3f;" parent="g8_1" vertex="1">
                    <mxGeometry x="461" y="112" width="358" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g8_m1" value="prefill：前缀查找 → 分配 slot → GPU 执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8f2;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=middle;align=center;fontSize=10;" parent="g8_1" vertex="1">
                    <mxGeometry x="461" y="144" width="358" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="g8_m2" value="decode：分配 slot → GPU 执行　↻ 每步循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8f2;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=middle;align=center;fontSize=10;" parent="g8_1" vertex="1">
                    <mxGeometry x="461" y="176" width="358" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="g8_x2" value="decode 只是规模变小：每步 1 个新 token、新增 0/1 块，并跳过前缀查找。&#10;&#10;系统里没有独立的 prefill / decode 两套管理逻辑，也没有全局阶段切换；调度器在一个共享 token 预算下按「先 RUNNING、后 WAITING」逐请求填充。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;verticalAlign=top;align=left;spacingLeft=0;fontSize=11;" parent="g8_1" vertex="1">
                    <mxGeometry x="461" y="214" width="358" height="176" as="geometry"/>
                </mxCell>
                <mxCell id="g8_card3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" parent="g8_1" vertex="1">
                    <mxGeometry x="854" y="100" width="386" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="g8_t3" value="&lt;b&gt;③ 块的命运 ＝ 引用计数 ＋ 队列位置&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;fontColor=#8a6d1f;" parent="g8_1" vertex="1">
                    <mxGeometry x="868" y="112" width="358" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g8_qz1" value="队首：无哈希块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;align=center;" parent="g8_1" vertex="1">
                    <mxGeometry x="868" y="144" width="173" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="g8_qz2" value="队尾：有哈希块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=center;" parent="g8_1" vertex="1">
                    <mxGeometry x="1041" y="144" width="173" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="g8_l3" value="分配：弹队首（优先复用）　·　回收：有哈希入队尾（LRU 保护）、无哈希排队首" style="text;html=1;fontSize=10;align=center;fontColor=#666666;" parent="g8_1" vertex="1">
                    <mxGeometry x="868" y="188" width="358" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="g8_x3" value="命中前缀 → touch（计数加一、移出空闲队列）实现零拷贝共享；请求结束 → 计数减一，仍被引用则不回收。&#10;&#10;归零回收时，带哈希的块排到队尾受 LRU 保护、无哈希的块排到队首被优先复用——前缀缓存由此跨请求持续积累并被后续请求复用。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;verticalAlign=top;align=left;spacingLeft=0;fontSize=11;" parent="g8_1" vertex="1">
                    <mxGeometry x="868" y="214" width="358" height="176" as="geometry"/>
                </mxCell>
                <mxCell id="g8_sum" value="&lt;b&gt;一句话总结&lt;/b&gt;　逻辑层（L2～L5）只操作整数 block_id 与元数据；物理张量（L1）静态待命；block_table 是两边唯一的桥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=16;spacingRight=12;fontSize=13;" parent="g8_1" vertex="1">
                    <mxGeometry x="40" y="430" width="1200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="g8_leg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" parent="g8_1" vertex="1">
                    <mxGeometry x="40" y="640" width="1200" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="g8_lgt" value="图例" style="text;html=1;fontSize=12;fontStyle=1;align=left;" parent="g8_1" vertex="1">
                    <mxGeometry x="56" y="652" width="44" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g8_c1" value="① 接口" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;align=center;" parent="g8_1" vertex="1">
