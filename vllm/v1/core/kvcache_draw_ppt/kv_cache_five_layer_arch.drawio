                    <mxGeometry x="300" y="652" width="100" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="g8_lnt" value="队列示意：蓝区＝队首（优先复用） · 绿区＝队尾（LRU 保护）" style="text;html=1;fontSize=10;align=left;fontColor=#666666;" parent="g8_1" vertex="1">
