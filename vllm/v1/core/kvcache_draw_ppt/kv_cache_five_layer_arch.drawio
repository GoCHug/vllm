                </mxCell>
                <mxCell id="g4_sub" value="规格先行，物理先于逻辑：①～③ 引擎进程纯 CPU 推导 → ④ RPC 到每卡落物理张量 → ⑤ RPC 返回后才建逻辑三层" style="text;html=1;fontSize=12;align=left;fontColor=#666666;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="62" width="960" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="g4_lane_e" value="引擎进程（EngineCore）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=14;fontStyle=1;align=center;dashed=1;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="96" width="700" height="496" as="geometry"/>
                </mxCell>
                <mxCell id="g4_lane_w" value="worker 进程（每卡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f0f8;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=14;fontStyle=1;align=center;dashed=1;" parent="g4_1" vertex="1">
                    <mxGeometry x="780" y="96" width="460" height="496" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s1" value="&lt;b&gt;① 算规格　get_kv_cache_specs()&lt;/b&gt;&#10;收集每个 attention 层的 spec；纯 Full Attention 各层相同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="148" width="470" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="g4_w1" value="每层 attention 返回一个&lt;b&gt;FullAttentionSpec&lt;/b&gt;&#10;同规格 ⇒ 合并为全模型唯一 KV cache group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=middle;align=center;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="900" y="148" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s2" value="&lt;b&gt;② 测预算　determine_available_memory()&lt;/b&gt;&#10;RPC 让各卡 dummy forward（profile_run）实测可用显存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="240" width="470" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="g4_w2" value="总显存 × 利用率 − 权重 − 激活 − CUDAGraph 预留&#10;&lt;b&gt;＝ 本卡 KV 可用字节数&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=middle;align=center;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="900" y="240" width="300" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s3" value="&lt;b&gt;③ 做编排　get_kv_cache_configs()&lt;/b&gt;&#10;同规格层合并为 1 个 group；page_size ＝ 2 × block_size × num_kv_heads × head_dim × dtype_size（系数 2 对应 K＋V）&#10;本卡 num_blocks ＝ 可用显存 // page_size // 本 worker 层数；多卡取最小值、共享同一套 block_id 空间 ⇒ 产出 &lt;b&gt;KVCacheConfig&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="330" width="660" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="g4_w4" value="&lt;b&gt;④ 落张量　initialize_from_config()&lt;/b&gt;&#10;遍历 config.kv_cache_tensors，按 size 申请 int8 字节张量 → 零拷贝 view 成后端 shape → bind 到各 attention 层&#10;worker 只按配置执行，不自行算块数&#10;〔engine/core.py:329 · gpu_worker.py:649 → gpu_model_runner.py:7606〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="800" y="448" width="420" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="g4_s5" value="&lt;b&gt;⑤ 建逻辑层（RPC 返回后）&lt;/b&gt;&#10;Scheduler（engine/core.py:158）→ KVCacheManager（sched/scheduler.py:271）&#10;→ Coordinator（L4）→ 先建 BlockPool（L2）再建 FullAttentionManager（L3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=10;fontSize=11;" parent="g4_1" vertex="1">
                    <mxGeometry x="64" y="452" width="660" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="g4_e1" value="RPC 收集 spec" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="g4_1" source="g4_s1" target="g4_w1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g4_e2" value="RPC profile" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="g4_1" source="g4_s2" target="g4_w2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
