    <diagram id="p4_deploy" name="4-系统部署图-启动装配流水线">
        <mxGraphModel dx="1545" dy="848" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="g4_0"/>
                <mxCell id="g4_1" parent="g4_0"/>
                <mxCell id="g4_title" value="3. 系统初始化：五层如何装配（启动时一次性）" style="text;html=1;fontSize=24;fontStyle=1;align=left;" parent="g4_1" vertex="1">
                    <mxGeometry x="40" y="24" width="900" height="34" as="geometry"/>
