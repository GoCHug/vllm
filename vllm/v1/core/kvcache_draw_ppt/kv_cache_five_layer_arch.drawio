                    </mxGeometry>
                </mxCell>
                <mxCell id="g9_rule2" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1.5;" parent="g9_1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="233" y="172" as="sourcePoint"/>
                        <mxPoint x="1047" y="172" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="g9_st1" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1.5;" parent="g9_1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="233" y="172" as="sourcePoint"/>
                        <mxPoint x="233" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="g9_st2" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1.5;" parent="g9_1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="640" y="172" as="sourcePoint"/>
                        <mxPoint x="640" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="g9_st3" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1.5;" parent="g9_1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1047" y="172" as="sourcePoint"/>
                        <mxPoint x="1047" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="g9_e1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Sliding Window Attention（SWA）&lt;/b&gt;&#10;代表：Mistral-SA、Gemma2&#10;&#10;只缓存最近 sliding_window 个 token 的 KV，更早的 block 可驱逐；前缀查找从右往左找窗口内命中&#10;&#10;落点：&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;L3&lt;/b&gt;&lt;/font&gt; 滑窗管理器 · &lt;font color=&quot;#d6b656&quot;&gt;&lt;b&gt;L4&lt;/b&gt;&lt;/font&gt; 协调器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="40" y="190" width="386" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="g9_e2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mamba / SSM&lt;/b&gt;&#10;代表：Bamba、Jamba&#10;&#10;无 KV 只有 state，block 存 recurrent state 而非 K/V；缓存逻辑不同&#10;&#10;落点：&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;L3&lt;/b&gt;&lt;/font&gt; 状态管理器 · &lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;L1&lt;/b&gt;&lt;/font&gt; 张量布局" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="447" y="190" width="386" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="g9_e3" value="&lt;b style=&quot;font-size:14px&quot;&gt;混合模型（Full ＋ SWA / Mamba）&lt;/b&gt;&#10;代表：Gemma3、Jamba、Llama4&#10;&#10;多个 KV group，Coordinator 做跨组命中交集；所有 group 共享同一个 BlockPool，page size 必须统一&#10;&#10;落点：&lt;font color=&quot;#d6b656&quot;&gt;&lt;b&gt;L4&lt;/b&gt;&lt;/font&gt; HybridKVCacheCoordinator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e7;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="854" y="190" width="386" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="g9_e4" value="&lt;b style=&quot;font-size:14px&quot;&gt;MLA（Multi-head Latent Attention）&lt;/b&gt;&#10;代表：DeepSeek-V2 / V3&#10;&#10;KV 低秩压缩，物理张量形状与 Full Attention 不同&#10;&#10;落点：&lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;L1&lt;/b&gt;&lt;/font&gt; MLA 规格与张量布局" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="40" y="380" width="386" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="g9_e5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cross-Attention&lt;/b&gt;&#10;代表：编码器-解码器模型&#10;&#10;额外的 encoder KV group，静态分配、不释放&#10;&#10;落点：&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;L3&lt;/b&gt;&lt;/font&gt; CrossAttentionManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="447" y="380" width="386" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="g9_e6" value="&lt;b style=&quot;font-size:14px&quot;&gt;投机解码（EAGLE / MTP）&lt;/b&gt;&#10;代表：EAGLE、Medusa&#10;&#10;draft 层额外 group，需要 last-block drop 逻辑&#10;&#10;落点：&lt;font color=&quot;#d6b656&quot;&gt;&lt;b&gt;L4&lt;/b&gt;&lt;/font&gt; 协调器 · &lt;font color=&quot;#d79b00&quot;&gt;&lt;b&gt;L5&lt;/b&gt;&lt;/font&gt; 门面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e7;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=11;align=left;" parent="g9_1" vertex="1">
                    <mxGeometry x="854" y="380" width="386" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="g9_tip" value="阅读建议：按层号自底向上（L1 物理显存 → L2 块池 → L3 单类型管理 → L4 协调器 → L5 门面）吃透 Full Attention 主线，再对照本页理解复杂场景" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;" parent="g9_1" vertex="1">
