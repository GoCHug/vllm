    <diagram id="p8_mla_ascend" name="5-MLA·DeepSeek-V3@Ascend">
        <mxGraphModel dx="714" dy="708" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="MLA 类（DeepSeek-V3 · pp2tp2 @Ascend）—— S0→S5 流水线（按第 1 页通用模板绘制）" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="8" width="1680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="params" value="真实 config：num_hidden_layers=61 · kv_lora_rank=512 · qk_rope_head_dim=64 · bf16 · block_size=128（NPU refresh_block_size；仅 DeepSeek-V4 特例 32）｜ PP=2 → 31+30 层 · TP=2 → KV头=1 不切（latent 双卡复制）· 可用显存 8.3GiB（教学值）" style="text;html=1;fontSize=12;fontColor=#555555;align=center;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="40" width="1680" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s0T" value="S0 · 块大小决策 —— NPU · block_size = 128（refresh_block_size）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="76" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s0box" value="· refresh_block_size（vllm_ascend/utils.py:1262-1266）：prefix caching / chunked prefill 开启 → 128（本模型非 hybrid，早退分支不触发）&amp;#xa;· DeepSeek-V4 是唯一特例（强制 32）&amp;#xa;· 对照 GPU（第 4 页）：bs 64 → 128，页 ×2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="110" width="820" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="s0fx" value="MLA 页大小公式（源码口径）&amp;#xa;page = bs × (kv_lora 512 + rope 64) × 1头 × dtype_size&amp;#xa;= 128 × 576 × 2B = 147,456B = 144KiB（KV头=1，TP 不切）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="910" y="110" width="830" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="s0n" value="S0 干什么：块大小 64 → 128（页 ×2 → 块数 ÷2）。请求的总显存与块大小无关（61×2×4096×1,152B ≈ 549MiB 恒定），变化的是块粒度与尾块浪费上限。" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="200" width="1680" height="14" as="geometry"/>
                </mxCell>
