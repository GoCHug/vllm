                    <mxGeometry x="992" y="718" width="748" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4ft" value="Full 页 = K 557,056B + V 557,056B = 1,114,112B（零垫 —— 块大小由 attn 页自身推出，天然等于统一页）" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="758" width="1495" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s4lg" value="GDN 页&lt;br&gt;页 = state 固定字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="776" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g1" value="ssm 1MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="776" width="1407" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g2" value="conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" vertex="1" parent="1">
                    <mxGeometry x="1652" y="776" width="66" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g3" value="垫 16KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" vertex="1" parent="1">
                    <mxGeometry x="1718" y="776" width="22" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4eq" value="GDN 页 = ssm 1MiB + conv 48KB + 垫 16KB = 1,114,112B · 两行等长 ✓ · 统一页写回 mamba_page_size_padded → 各层 spec 随之全等" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2e7d32;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="818" width="1680" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="s4s" value="S4 干什么：mamba_page_size_padded = attn 页（:914-934）—— GPU 的统一页就等于 attn 页本身（Full 层零垫），只有 GDN 页尾部垫 16KB。&lt;br&gt;空洞账单：每块 ID 空洞 = 24 个 GDN 页 × 16KB + 8 个 Full 页 × 0 = 384KB，随每个块线性重复 → &lt;b&gt;全池空洞率 ≈ 1.1%&lt;/b&gt;（= 384KB ÷ 每块 34MiB；≠ 384KB ÷ 8.3GiB = 0.004%，那是错误基准）。GPU 空洞远小于 NPU（37%）—— kernel_align=16 步进细 + cdiv 就近覆盖 + K/V 口径让 attn 页天然略大于 GDN 页。align 模式下 mamba_block_size = 272（:911-912）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="838" width="1680" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s5T" value="S5 · 对齐之后：统一页 1,088KB 驱动分组 → 建张量 → BlockPool（按第 1 页通用模板绘制）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="920" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s5d" value="单卡 tp1 · 32 层 spec（页全等 1,088KB）→ 4 组 · 张量数 = max(各组层数) = 8 · 每块 ID 在 8 个张量上各写 1 页（同组一张块表）" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="950" width="1680" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s5aL" value="⑤-1 分组：按 spec 类型切 4 组（get_kv_cache_groups :1760 → 兜底 unify 验收 no-op）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1">
