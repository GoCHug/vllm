                <mxCell id="s0gb" value="conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" vertex="1" parent="1">
                    <mxGeometry x="914" y="158" width="31" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0gt" value="GDN 页 = ssm：32(v头) × 128(k_dim) × 128(v_dim) × 2B(bf16) = 1MiB；conv：(2×16k头 + 32v头) × 128 × 3(kernel-1) × 2B(bf16) = 48KB&lt;br&gt;⇒ 1MiB + 48KB = 1,072KB（不随块大小变）= 16.75 × Full 页 → 页不等，必须对齐" style="text;html=1;fontSize=10;fontColor=#c62828;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="961" y="158" width="779" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0s" value="S0 干什么：建立对齐起点。块大小保持用户/默认 16 —— GPU 的块大小对齐尚未发生（发生在模型加载后的 executor 阶段，见 S1-S2）。KVCacheManager 要求所有层共用统一物理页，差 16.75× 必须拉平 → 进入 S1 四参数。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
