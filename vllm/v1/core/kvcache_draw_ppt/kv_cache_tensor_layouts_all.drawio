                </mxCell>
                <mxCell id="s5req" value="一次调度：请求 R 70 tok → ⌈70/16⌉ = 5 块 ｜ Manager 0 popleft ×5 → [0,1,2,3,4] → NewRequestData(block_ids) ── collective_rpc ──▶ 4 卡同号落写（70 = 4×16 + 6，尾块 6/16）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
