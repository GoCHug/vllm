                </mxCell>
                <mxCell id="s0T" value="S0 · 初始态：spec 原生页 —— Full 64KB vs GDN 1,072KB（差 16.75×）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
