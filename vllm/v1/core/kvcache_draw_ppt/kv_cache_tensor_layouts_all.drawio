                <mxCell id="h6" value="GDN 混合 · GPU（Qwen3.5 单卡 tp1）—— 页对齐演进：Full 64KB / GDN 1,072KB → 1,088KB（S0→S5 每步示意图）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#333333;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="8" width="1680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="param6" value="24 GDN + 8 Full · bf16 · 层序 (3 GDN + 1 Full) × 8 · 教学显存 8.3GiB · 对齐执行者：基类 _align_hybrid_block_size（interface.py:764-934，executor 阶段、模型加载后）· 条宽按字节等比（S0 按初始大页 1,072KB = 700px；S2-S4 按统一页 1,088KB = 1,495px）" style="text;html=1;fontSize=12;fontColor=#555555;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1">
