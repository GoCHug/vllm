                <mxCell id="s0ft" value="Full 页 = 2(K+V) × 4(kv头) × 16(tok) × 256(head_dim) × 2B(bf16) = 64KB" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="292" y="110" width="640" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0lg" value="MambaSpec（GDN）&lt;br&gt;页 = state 固定字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
