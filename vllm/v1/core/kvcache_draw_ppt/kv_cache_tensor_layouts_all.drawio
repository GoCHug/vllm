    <diagram id="p2_fullattn" name="2-FullAttention·Llama-3-8B">
        <mxGraphModel dx="2284" dy="2264" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="FullAttention 类（Llama-3-8B · pp2tp2 · GPU）—— S0→S5 流水线（按第 1 页通用模板绘制）" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="8" width="1680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="params" value="真实 config：num_hidden_layers=32 · 32 Q头 / 8 KV头 · head_dim=128 · bf16 · block_size=16（vLLM 通用默认）｜ PP=2×TP=2 → 每卡 16 层 / 4 KV头（TP 切头）· 可用显存 2GiB（教学值）" style="text;html=1;fontSize=12;fontColor=#555555;align=center;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="40" width="1680" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s0T" value="S0 · 块大小决策 —— GPU · block_size = 16（vLLM 通用默认）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="76" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s0box" value="· 单类型模型，无混合对齐步骤 —— _align_hybrid_block_size 仅 is_hybrid 触发（interface.py:644）&amp;#xa;· block_size = vLLM 默认 16（cache.py:47 DEFAULT_BLOCK_SIZE；用户可 --block-size 覆盖）&amp;#xa;· 对照 NPU（第 3 页）：refresh_block_size（utils.py:1262-1266）在 prefix caching / chunked prefill 开启时提为 128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="110" width="820" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="s0fx" value="页大小公式（源码口径，kv_cache_interface.py:109）&amp;#xa;page = 2(K+V) × bs × num_kv_heads × head_dim × dtype_size&amp;#xa;= 2 × 16 × 4（TP 切头后）× 128 × 2B = 32,768B = 32KiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="910" y="110" width="830" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="s0n" value="S0 干什么：确立基准。单类型模型全层 spec 相同 → 不存在页对齐问题（unify 天然 no-op），流水线就是「提交 spec → 1 组 → 张量 → 池」。" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="200" width="1680" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s1T" value="S1 · spec 构造：每层一份 FullAttentionSpec，32 层 spec 全等（TP 同层相等）—— 页构成如下（条宽等比）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="222" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s1spec" value="FullAttentionSpec（每层一份，32 份全等）&amp;#xa;· block_size = 16 · num_kv_heads = 4（TP 后）&amp;#xa;· head_size = 128 · dtype = bf16&amp;#xa;· page_size_bytes = 32,768B&amp;#xa;is_kv_cache_spec_uniform ✓（页字节唯一）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="256" width="380" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="s1bK · " value="K · 1,024B/token（TP 后）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;fontSize=9;" vertex="1" parent="1">
