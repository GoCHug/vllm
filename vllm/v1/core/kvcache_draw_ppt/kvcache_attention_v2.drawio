                <mxCell id="q_2_k" value="INT4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#5a7db5;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="512" width="150" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="q_2_v" value="h/2 + hv/2 · 末维减半（2×int4=1B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7e2;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="216" y="512" width="544" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="q_3_k" value="NVFP4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#5a7db5;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="542" width="150" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="q_3_v" value="头数翻倍 + block scale（FlashInfer）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7e2;fontSize=10;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="216" y="542" width="544" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="ps" value="&lt;b&gt;page_size_bytes&lt;/b&gt;&lt;br&gt;= block_size × num_kv_heads × (head_size + head_size_v) × dtype_size&lt;br&gt;Llama-3-8B：16 × 8 × 256 × 2B = 64 KB / 块 / 层　·　TP2 切成 4 头 → 32 KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;fontSize=10.5;" parent="1" vertex="1">
                    <mxGeometry x="40" y="588" width="700" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="③ 三种打包形式（backend 决定 K/V 在哪个维）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="780" y="88" width="460" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="pk0" value="&lt;b&gt;形式 A　(num_blocks, H, 16, 2×hd)&lt;/b&gt;&lt;br&gt;K/V 拼最后一维（最常见）&lt;br&gt;backend：FlashAttn · FlashInfer · CPU · Triton · Flex · ROCm Aiter" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="780" y="118" width="460" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="pk1" value="&lt;b&gt;形式 B　(2, nb, 16, H, hd)&lt;/b&gt;&lt;br&gt;K/V 独立第 0 维（kv-first）&lt;br&gt;backend：ROCm Attn" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;fillColor=#ffffff;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="204" width="460" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="pk2" value="&lt;b&gt;形式 C　(nb, 2, 16, H, hd)&lt;/b&gt;&lt;br&gt;K/V 独立第 1 维&lt;br&gt;backend：HPC（SM90+ · hd=128）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="780" y="290" width="460" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="pk_n" value="维度位置不同，字节数完全相同；kv-first 与 blocks-first 并存时统一为 blocks-first" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="780" y="380" width="460" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="④ block table 映射" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="780" y="416" width="460" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="bt" value="逻辑块 [0, 1, 2] → 物理页 [5, 9, 2]&#xa;kernel 按 block_id fancy index 物理张量的 block 维" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=14;fontSize=10.5;" parent="1" vertex="1">
                    <mxGeometry x="780" y="442" width="460" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="sem" value="语义变体（布局全同 Full，只改读写 / 驻留策略）：SlidingWindow · ChunkedLocal · CrossAttention · Sink · RSWA · TQ · EncoderOnly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;verticalAlign=middle;align=left;spacingLeft=14;fontSize=10.5;" parent="1" vertex="1">
                    <mxGeometry x="40" y="664" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="⑤ GPU vs NPU：同一套机制，block_size 不同" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="780" y="522" width="460" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="gpn_gpu" value="&lt;b&gt;GPU · block_size = 16　·　Llama-3-8B（32 层 · num_heads=8 · head_dim=128 · bf16）&lt;/b&gt;&lt;br&gt;shape (num_blocks, num_heads, 16, 2×head_dim)　·　每块每层 65,536 B = 64 KB　·　一块跨 32 层 = 2 MB&lt;br&gt;计算过程：paged kernel 按 block_table gather 16-token 页 → 拼成连续 KV 序列给 attention" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=10.5;strokeWidth=2;fillColor=#eef4fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="780" y="546" width="460" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="gpn_npu" value="&lt;b&gt;NPU · block_size = 128（num_blocks 相应缩小 8 倍）&lt;/b&gt;&lt;br&gt;shape (num_blocks, num_heads, 128, 2×head_dim)　·　每块每层 524,288 B = 512 KB　·　一块跨 32 层 = 16 MB&lt;br&gt;计算过程：大页一次容纳 128 token 的 K/V，访存更连续；paged attention 以 128 对齐写读，block_table 机制与 GPU 相同" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=10.5;strokeWidth=2;fillColor=#f3ecf9;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="638" width="460" height="78" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
