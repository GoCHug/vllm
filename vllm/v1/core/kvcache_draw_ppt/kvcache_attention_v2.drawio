                    <mxGeometry x="942" y="180" width="286" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="gn" value="分组规则：KVCacheSpec 作 dict 的 key、值相等才同组；GDN 24 层按 layers[i::3] 拆成 3 组；每组独立块表 + 独立 manager" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="60" y="254" width="1160" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="② 统一 page：物理池要求所有组每块字节相同 → 全模型统一到最大值 1,097,728 B" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="284" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="u_full" value="Full 页：65,536 B = 64 KB" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10.5;;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="60" y="312" width="320" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="u_gdn" value="GDN 页：1,097,728 B ≈ 1,072 KB" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10.5;;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="60" y="354" width="320" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="u_e" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#b3b3b3;strokeWidth=1.5;dashed=1;endArrow=none;startArrow=none;" parent="1" source="u_full" target="u_gdn" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="u_pad" value="统一后：所有层 page = 1,097,728 B&#xa;GDN 页 = max，原样不动&#xa;Full 页 = 底部 64 KB 真实 K/V + padding ≈ 1,008 KB 垫平（block_size 仍 = 16）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10.5;;fillColor=#fafafa;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="400" y="312" width="410" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="u_why" value="为什么不能靠放大 Full 的 block_size 凑齐？1,097,728 % 65,536 = 49,152 ≠ 0 —— 余数恰好是一份 conv_state，任何 block_size 都整除不了 → padding 是唯一稳妥解；&#xa;代价：Full 层每块浪费 ≈ 1,008 KB，但 Full 仅占 8/32 层，可接受。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;verticalAlign=middle;align=left;spacingLeft=14;fontSize=10.5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="404" width="1180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="③ 物理布局：group_size=8 → 8 张 KVCacheTensor，每张 = 一个「GDN×3 + Full×1」周期" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
