                <mxCell id="se5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="st_4" target="st_5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cmp" value="最易混淆处：家族 A 的块 i = 第 i×block_size ~ (i+1)×block_size−1 各自的 K/V　↔　家族 C 的块 i = 处理完前 i×block_size 个 token 后的累积状态" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10.5;;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="60" y="216" width="1180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="② 一页 = 扁平字节缓冲：(num_blocks, 1, 1, Σ状态字节)，字节固定、与 block_size 无关 —— GPU 与 NPU 同构" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="270" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="cv" value="conv_state 49,152 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="298" width="56" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sv" value="ssm_state（32, 128, 128） · bf16　= 1,048,576 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="116" y="298" width="730" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="cvn" value="Qwen3.5 GDN：page = 49,152 + 1,048,576&#xa;= 1,097,728 B ≈ 1,072 KB / 块 / 层（GPU 与 NPU 相同，与 block_size 无关）" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="852" y="298" width="348" height="60" as="geometry"/>
                </mxCell>
