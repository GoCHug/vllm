                    <mxGeometry x="212" y="576" width="36" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p_5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=7;" parent="1" vertex="1">
                    <mxGeometry x="250" y="576" width="36" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p_6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=7;" parent="1" vertex="1">
                    <mxGeometry x="288" y="576" width="36" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p_7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=7;" parent="1" vertex="1">
                    <mxGeometry x="326" y="576" width="36" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p_lbl" value="物理槽：storage_block_size = 64 // 4 = 16　·　V4 取值 {1, 4, 128}：1=SWA 无压缩 / 4=c4a / 128=c128a；page 公式改用 storage_block_size" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="60" y="610" width="620" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="④ 三版本字节构成（shape 恒定，差异在每 token 打包宽）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="700" y="88" width="540" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="v0" value="&lt;b&gt;V3（bf16）&lt;/b&gt;&lt;br&gt;576 dims × 2B = 1,152 B / token　·　page = 64 × 1,152 B" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;;fillColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="700" y="118" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="v1" value="&lt;b&gt;V3.2（fp8）&lt;/b&gt;&lt;br&gt;NoPE 512B + scale 16B + RoPE 128B = 656 B / token" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;;fillColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="700" y="188" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="v2" value="&lt;b&gt;V4（fp8 + 压缩）&lt;/b&gt;&lt;br&gt;更窄打包 = 584 B / token　·　page = storage_block_size × 584 B" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;;fillColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="700" y="258" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="vn" value="fp8 时物理 dtype 统一 uint8；scale 字节内联在每 token 打包里" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="700" y="336" width="540" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="r5b" value="⑤ GPU vs NPU 计算过程" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="700" y="368" width="540" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="b_gpu" value="&lt;b&gt;GPU · block_size = 64　·　DeepSeek V3（61 层 · kv_lora_rank=512 · qk_rope_dim=64 · bf16）&lt;/b&gt;&lt;br&gt;shape (num_blocks, block_size, 576)　·　每块每层 73,728 B = 72 KB　·　一块跨 61 层 ≈ 4.29 MB&lt;br&gt;计算过程：每 token 低秩投影出 c_t → 写入本块下一个 latent 槽（NoPE 512 + RoPE 64）&lt;br&gt;读取：整页 64 个 latent → 小投影还原各头 K/V" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=10.5;strokeWidth=2;fillColor=#f0f7f0;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="700" y="394" width="540" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="b_npu" value="&lt;b&gt;NPU · block_size = 128（num_blocks 相应缩小 2 倍）&lt;/b&gt;&lt;br&gt;shape (num_blocks, block_size, 576)　·　每块每层 147,456 B = 144 KB　·　一块跨 61 层 ≈ 8.58 MB&lt;br&gt;计算过程：同 GPU，一页容纳 128 个 latent；V4 进一步用 storage_block_size（如 16）压缩物理槽" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=10.5;strokeWidth=2;fillColor=#f3ecf9;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="700" y="518" width="540" height="102" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
