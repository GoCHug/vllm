                <mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" parent="1" source="raw2" target="rv2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="rn" value="四步零拷贝：squeeze(1,2) → 按字节切片 → view(dtype) → view(-1, *shape)；kernel 用 conv_state[block_id] / ssm_state[block_id] 就地读写" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="60" y="504" width="1140" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="④ mamba_cache_mode：常驻几个状态块（决定 prefix caching 能力）" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="534" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="m0" value="&lt;b&gt;none（默认）&lt;/b&gt;&lt;br&gt;· 常驻 1 块，每步原地覆盖&lt;br&gt;· 不支持 prefix caching&lt;br&gt;· max_blocks = 1 + num_spec" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#b3b3b3;" parent="1" vertex="1">
                    <mxGeometry x="60" y="560" width="374" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="&lt;b&gt;align&lt;/b&gt;&lt;br&gt;· 常驻 2 块（最近边界 checkpoint）&lt;br&gt;· 仅尾部命中&lt;br&gt;· max_blocks = 2 + num_spec" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="452" y="560" width="374" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="&lt;b&gt;all&lt;/b&gt;&lt;br&gt;· 每个块边界存一份 checkpoint&lt;br&gt;· 前缀命中 → 从最近 checkpoint 恢复，全量复用&lt;br&gt;· max_blocks = cdiv(max_len, block_size) + num_spec" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=10;fontSize=11;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="844" y="560" width="374" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="c_gpn" value="GPU vs NPU：一页字节恒定、两平台完全同构；差异只在 block_size —— 它只决定 checkpoint 边界间隔（GPU 例每 16 token 落一份、NPU 例每 128 token 落一份）。kernel 都以 conv_state[block_id] / ssm_state[block_id] 就地读写；cache mode（none / align / all）语义一致。Qwen3.5 实算：GPU block_size=16 / NPU block_size=128，每块每层都是 1,097,728 B ≈ 1,072 KB；一块跨 32 层 ≈ 33.5 MB。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;fontSize=10.5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="660" width="1180" height="44" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
