                    <mxGeometry x="40" y="372" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="raw2" value="一块的 page_size_bytes 字节（raw int8 底座）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#333333;fontColor=#ffffff;verticalAlign=middle;align=center;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="400" width="1140" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="rv1" value="conv_state view　(num_blocks, 3072, 3)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10.5;;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="60" y="456" width="560" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="rv2" value="ssm_state view　(num_blocks, 8, 128, 128)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=12;spacingRight=8;fontSize=10.5;;fillColor=#f5f5f5;strokeColor=#b3b3b3;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="640" y="456" width="560" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" parent="1" source="raw2" target="rv1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
