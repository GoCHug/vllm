                <mxCell id="pj3_nb" value="num_blocks ≈ 3,883（spec 同镜像源卡：TP 不切 KV 头，latent 全量复制）" style="text;html=1;fontSize=9;fontColor=#555555;align=left;spacingLeft=4;" vertex="1" parent="1">
