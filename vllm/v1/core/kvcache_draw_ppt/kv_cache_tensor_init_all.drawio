                <mxCell id="s2r" value="16 × cdiv(1,097,728, 16 × 4,096) = 16 × 17 = 272&lt;br&gt;16 步只有 1,024KB &lt; 1,072KB 不够装 → 第 17 步 1,088KB ✓（cdiv 就近向上）&lt;br&gt;只增不减：用户已设更大值则保留（:903-904）；272 非 kernel 对齐数也无妨（align 仅约束步进基数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="486" width="1495" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s3T" value="S3 · 覆盖校验（:903-916）—— attn 页 ≥ GDN 页即通过（就近覆盖，无 assert；与 NPU 的精确整除不同）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="556" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s3k" value="attn 页：272 tok × 4,096B = 1,114,112B（K 557,056 + V 557,056）—— 零垫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
