                <mxCell id="s3s" value="GDN 页 1,097,728B = ssm 1MiB + conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
