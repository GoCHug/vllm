                </mxCell>
                <mxCell id="s4ft" value="Full 页 = K 557,056B + V 557,056B = 1,114,112B（零垫 —— 块大小由 attn 页自身推出，天然等于统一页）" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
