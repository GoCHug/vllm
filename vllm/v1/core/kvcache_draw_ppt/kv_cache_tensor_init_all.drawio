                <mxCell id="s3r" value="1,114,112 ≥ 1,097,728 ✓ 余 16,384B → GDN 页垫 16KB（尾部空隙；GPU 不要求整除，因此空洞小）" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2e7d32;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
