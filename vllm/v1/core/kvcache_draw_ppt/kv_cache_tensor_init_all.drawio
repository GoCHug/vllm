                <mxCell id="rb_n" value="i×512 的每个边界位置都留快照 → find_longest_cache_hit 从右向左可命中任意边界（:1332-1337）· 代价：每请求 cdiv(32K,512)=64 页" style="text;html=1;fontSize=10;fontColor=#7b1fa2;align=left;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="566" width="1010" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="rh" value="前缀命中示例：请求 B 与请求 A 共享前 1536 token" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="618" width="1160" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="hit_none" value="none → miss：B 从 token 0 全量重算 1536 token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#95a3b8;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="646" width="368" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="hit_align" value="align → 命中边界块（若 A 真实提交过该边界）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#95a3b8;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="444" y="646" width="368" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="hit_all" value="all → 命中 pos1536 快照 s3（任意边界皆可）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#95a3b8;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="828" y="646" width="392" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="fm" value="内存公式（MambaSpec.max_memory_usage_bytes，:709-730；数值代入 块大小=512 · 页 2,096KB ≈ 2,096KB · max_len=32K · spec=0）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="688" width="1160" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="fmN" value="none&lt;br&gt;(1+spec) × 页&lt;br&gt;= 1 页 ≈ 2.0MiB/req&lt;br&gt;块表行数 = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="716" width="520" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="fmA" value="align&lt;br&gt;(2+spec) × 页&lt;br&gt;≈ 4.1MiB/req（常驻）&lt;br&gt;块表行数 = cdiv(32K,512) = 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="716" width="540" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="fmB" value="all&lt;br&gt;(cdiv(32K,512)+spec) × 页 = 64 页&lt;br&gt;≈ 131MiB/req（全边界快照）&lt;br&gt;块表行数 = 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="716" width="540" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="⚠ Qwen3.5：mamba_cache_mode 为「all」直接 NotImplementedError（qwen3_5.py:307-311，提示改用 --mamba-cache-mode=align），即只可用 none / align" style="text;html=1;fontSize=11;fontColor=#cc0000;align=left;whiteSpace=wrap;html=1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="828" width="1160" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="Ascend 补丁（patch_mamba_config.py）：PD 分离（AscendStoreConnector）强制 none→align（:136-142）；未开 prefix cache 时 mamba_block_size = max_model_len（:146）" style="text;html=1;fontSize=11;fontColor=#888888;align=left;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="852" width="1160" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="ReplaySSM（低频刷写 HBM 的 decode kernel）仅要求 none / align（cache.py:153-158）；align 下 mamba_block_size 为 replayssm_buffer_len 倍数时刷写最高效" style="text;html=1;fontSize=11;fontColor=#888888;align=left;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="876" width="1160" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="三者对页字节（统一后的 2,096KB ≈ 2,096KB 或 GPU 1,088KB ≈ 1,088KB）无影响 —— 模式只改「留几份状态快照、块表怎么编址、前缀能否命中」" style="text;html=1;fontSize=11;fontColor=#1565c0;align=left;whiteSpace=wrap;html=1;fontStyle=1;" parent="1" vertex="1">
