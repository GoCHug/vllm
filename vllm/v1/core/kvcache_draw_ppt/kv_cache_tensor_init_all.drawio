                </mxCell>
                <mxCell id="a1" value="num_blocks = 4,096 · 每卡 16 张量&#10;每 ID 本卡：16 × 32KiB = 512KiB&#10;每张量：4,096 页 × 32KiB = 128MiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1872" width="660" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="全模型每 ID：32 层 × 2TP × 32KiB = 2MiB&#10;全模型物理：4 卡 × 2GiB = 8GiB ✓&#10;四卡同构 · 无 shrink（PP 均分 16+16）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
