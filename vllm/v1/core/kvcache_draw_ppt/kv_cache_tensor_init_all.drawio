                    <mxGeometry x="60" y="684" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s4lf" value="Full 页&lt;br&gt;block_size = 272" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
