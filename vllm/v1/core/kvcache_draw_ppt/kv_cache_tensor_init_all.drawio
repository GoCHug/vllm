                    <mxGeometry x="60" y="2016" width="240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="leg2" value="TP 镜像卡（KV 头 4–7，虚线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="320" y="2016" width="240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="leg3" value="未高亮 block 槽位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;" vertex="1" parent="1">
