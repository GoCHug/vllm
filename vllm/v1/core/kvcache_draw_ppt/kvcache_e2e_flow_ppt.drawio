                    <mxGeometry x="72" y="294" width="326" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h_c2" value="&lt;b&gt;② 查 · 前缀查找&lt;/b&gt;&#10;&#10;make_block_hash_with_group_id&#10;临时拼 key → BP.get_one_block（bp:61）&#10;用完即弃 —— 不回写请求侧哈希&#10;遇 miss 立即 break（fm:682）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fd;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=10;align=left;spacingLeft=14;spacing=4;fontColor=#1a4a7a;" parent="1" vertex="1">
                    <mxGeometry x="454" y="104" width="366" height="250" as="geometry"/>
