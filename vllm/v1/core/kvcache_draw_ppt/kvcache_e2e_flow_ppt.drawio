                    <mxGeometry x="474" y="294" width="326" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h_c3" value="&lt;b&gt;③ 存 · S4 落库&lt;/b&gt;&#10;&#10;FM.cache_blocks（fm:779）&#10;→ BP.cache_full_blocks（bp:225）&#10;块.block_hash 字段 ＋ 映射表 各记一份&#10;（持久，带 group id）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9f0;strokeColor=#82b366;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=10;align=left;spacingLeft=14;spacing=4;fontColor=#4a7a38;" parent="1" vertex="1">
