                <mxCell id="h_c3s" value="★ 只存写满块；未满块永不入表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=11;verticalAlign=middle;fontColor=#4a7a38;" parent="1" vertex="1">
                    <mxGeometry x="876" y="294" width="326" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h_a12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="h_c1" target="h_c2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="h_a23" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="h_c2" target="h_c3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="h_k1" value="纯 BlockHash：hash(前缀 token_ids) —— 请求侧、跨 group 通用（就存在 request.block_hashes）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#dddddd;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="52" y="382" width="560" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="h_k2" value="BlockHashWithGroupId：( BlockHash, group_id ) —— 池侧、真正入表 / 查表的 key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#dddddd;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;fontColor=#555555;" parent="1" vertex="1">
