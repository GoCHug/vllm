                <mxCell id="d_a" value="&lt;b&gt;局面 A · 行没满 → 原地续写（需 0 块，绝大多数步）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9f0;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;align=left;spacingLeft=12;fontColor=#4a7a38;" parent="1" vertex="1">
