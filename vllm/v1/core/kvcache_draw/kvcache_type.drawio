                <mxCell id="a_mla1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a_mla" target="a_spec_full" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a_mamba" value="&lt;b&gt;MambaSpec&lt;/b&gt;&lt;br&gt;&lt;br&gt;shapes / dtypes&lt;br&gt;page_size_padded: int | None = None&lt;br&gt;mamba_type: MambaAttentionBackendEnum&lt;br&gt;mamba_cache_mode: str = &quot;none&quot;&lt;br&gt;num_speculative_blocks: int = 0&lt;br&gt;─── 关键 ───&lt;br&gt;cache_mode=&quot;align&quot;: max_num_blocks_per_req =&lt;br&gt;&amp;nbsp;&amp;nbsp;cdiv(max_len, block_size) + spec_blocks（暂存式）" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=12;fillColor=#FFCCCC;strokeColor=#9AA7B8;" parent="1" vertex="1">
