                <mxCell id="a_config_quant" value="&lt;b&gt;KVQuantMode&lt;/b&gt;&lt;br&gt;KV cache 量化模式，后端据此分发量化逻辑&lt;br&gt;&lt;br&gt;NONE = 0&lt;br&gt;FP8_PER_TENSOR = 1&amp;nbsp;&amp;nbsp;&amp;nbsp;（当前 fp8 路径）&lt;br&gt;INT8_PER_TOKEN_HEAD = 2&lt;br&gt;FP8_PER_TOKEN_HEAD = 3&lt;br&gt;INT4_PER_TOKEN_HEAD = 4&amp;nbsp;&amp;nbsp;&amp;nbsp;（打包 2×int4/字节, RHT）&lt;br&gt;NVFP4 = 5&amp;nbsp;&amp;nbsp;&amp;nbsp;（打包 fp4 + fp8 block scale）&lt;br&gt;─── 属性 ─── is_per_token_head" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1">
