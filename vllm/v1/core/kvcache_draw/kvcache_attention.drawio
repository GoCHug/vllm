                    <mxGeometry x="500" y="458" width="70" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p4_339" value="头 7" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=8;fontColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="570" y="458" width="70" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="p4_340" value="每格字节 = head_size × dtype = 128×2B；一格 K + 一格 V ⇒ 页面宽 2×128" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="80" y="726" width="560" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p4_341" value="③ 三种打包形式：backend 决定 K/V 拼在哪个维 —— 维度位置不同，字节数完全相同" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="720" y="386" width="840" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p4_342" value="&lt;b&gt;形式 A：(num_blocks, num_kv_heads, block_size, 2×head_size)&lt;/b&gt;&lt;br&gt;K/V 拼在最后一维（最常见，blocks-first）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="720" y="426" width="430" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="p4_343" value="FlashAttn / FlashInfer / CPU / Triton / Flex / ROCm Aiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="426" width="390" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="p4_344" value="&lt;b&gt;形式 B：(2, num_blocks, block_size, num_kv_heads, head_size)&lt;/b&gt;&lt;br&gt;K/V 独立成第 0 维（kv-first，block_dim=1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="720" y="514" width="430" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="p4_345" value="ROCm Attn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="514" width="390" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="p4_346" value="&lt;b&gt;形式 C：(num_blocks, 2, block_size, num_kv_heads, head_size)&lt;/b&gt;&lt;br&gt;K/V 独立成第 1 维（blocks-first）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="720" y="602" width="430" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="p4_347" value="HPC（SM90+, head_size=128）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="602" width="390" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="p4_348" value="④ page_size_bytes 与变体：量化只改字节布局，不改块语义" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="780" width="1100" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p4_349" value="page_size_bytes = block_size × num_kv_heads × (head_size + head_size_v) × dtype_size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="820" width="730" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p4_350" value="Llama-3-8B：= 16 × 8 × (128+128) × 2B = 64 KB / 块 / 层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="876" width="700" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p4_351" value="TP2 切分后 num_kv_heads=4 → 32 KB；Diff-KV：head_size_v≠head_size 时末维显式相加（§4.4）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
