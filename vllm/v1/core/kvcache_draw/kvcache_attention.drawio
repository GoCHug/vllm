                <mxCell id="p8_53" value="分组规则（§8.2）：KVCacheSpec 作 dict key、值相等才同组；GDN 24 层按 layers[i::3] 拆 3 组（保证 PP 下组数对齐）；每组独立 block table + 独立 manager（kv_cache_utils.py:1205-1258）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="418" width="1520" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p8_54" value="② 统一 page 字节：物理池要求所有组每块字节相同 → 全模型统一到 max = 1,097,728 B" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="456" width="1300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p8_55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="496" width="430" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="p8_56" value="统一前：两族 page 相差 ≈17 倍" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="56" y="504" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p8_57" value="conv&lt;br&gt;49,152" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd8a8;strokeColor=#d79b00;fontSize=7;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="90" y="526" width="130" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="p8_58" value="GDN 页&lt;br&gt;1,097,728 B&lt;br&gt;≈ 1072 KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef9f4c;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="90" y="536" width="130" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p8_59" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="290" y="704" width="130" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="p8_60" value="Full 页 65,536 B = 64 KB" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="250" y="684" width="210" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p8_61" value="≠" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=26;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="222" y="606" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p8_62" value="块长不一 → 无法用一个池管理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="56" y="724" width="400" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p8_63" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="510" y="496" width="1050" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="p8_64" value="统一后：所有层 page = 1,097,728 B" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="526" y="504" width="270" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p8_65" value="conv 49,152" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffd8a8;strokeColor=#d79b00;fontSize=7;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="560" y="526" width="190" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="p8_66" value="GDN 页：恰好 = max，不动&lt;br&gt;&lt;br&gt;ssm&lt;br&gt;1,048,576 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef9f4c;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="560" y="538" width="190" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="p8_67" value="padding（空隙）≈ 1,032,192 B ≈ 1008 KB&lt;br&gt;page_size_padded = 1,097,728&lt;br&gt;block_size 保持 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=9;verticalAlign=middle;align=center;fontColor=#333333;dashed=1;fillStyle=hatch;" parent="1" vertex="1">
                    <mxGeometry x="820" y="526" width="210" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="p8_68" value="真实 K/V 64 KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=8;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="820" y="704" width="210" height="12" as="geometry"/>
                </mxCell>
                <mxCell id="p8_69" value="Full 页：内容在底部 64 KB，其余垫平" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="820" y="504" width="220" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p8_70" value="为什么 Full 不能靠放大 block_size 凑齐？&lt;br&gt;&lt;br&gt;1,097,728 % 65,536 = 49,152 ≠ 0&lt;br&gt;（余数 = 一份 conv_state → 任何 bs 下都整除不了）&lt;br&gt;&lt;br&gt;→ FlashAttn/FlashInfer：indexes_kv_by_block_stride=True&lt;br&gt;（num_blocks 在物理布局最外层，支持按 stride 读页）&lt;br&gt;→ 走 padding 分支（§8.3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;verticalAlign=top;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="526" width="470" height="166" as="geometry"/>
                </mxCell>
                <mxCell id="p8_71" value="代价：Full 层每块浪费 ≈1008 KB，但 Full 仅占 8/32 层 —— 可接受。&lt;br&gt;Qwen3.5 禁用 mamba_cache_mode=&#39;all&#39;（qwen3_5.py:307），推荐 align/none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=9;verticalAlign=middle;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="702" width="470" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p8_72" value="③ 物理布局（通用多张量路径）：group_size=8 → 8 个 KVCacheTensor，每个张量 = 一个「GDN×3 + Full×1」周期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="776" width="1500" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p8_73" value="张量 t 大小 = 1,097,728 × num_blocks；shared_by = 各组同位置层 = [layer 4t(GDN), 4t+1(GDN), 4t+2(GDN), 4t+3(Full)]；所有张量共用同一套 block id（0..num_blocks-1，下示前 8 个）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
