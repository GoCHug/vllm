                <mxCell id="p8_160" value="num_blocks = avail // (page × group_size) = avail // (1,097,728 × 8)&lt;br&gt;= avail // 8,781,824&lt;br&gt;例：KV 可用 ≈ 32.7 GiB（35,127,296,000 B）→ num_blocks = &lt;b&gt;4,000&lt;/b&gt;（整除）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1134" width="660" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p8_161" value="&lt;b&gt;BlockPool 全局唯一&lt;/b&gt;（4,000 个 id）&lt;br&gt;1 个 block id 横跨全模型 32 层页：&lt;br&gt;32 × 1,097,728 B ≈ &lt;b&gt;33.5 MB&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="720" y="1134" width="380" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p8_162" value="Qwen3.5 不走 Packed 路径（§8.4）：&lt;br&gt;触发条件要求所有组都是 UniformTypeKVCacheSpecs；&lt;br&gt;Packed 为 DeepSeek V4 默认 / 实验性 opt-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="1134" width="440" height="84" as="geometry"/>
                </mxCell>
