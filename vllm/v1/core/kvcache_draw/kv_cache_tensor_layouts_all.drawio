    <diagram id="p4_gdn" name="6-GDN混合·Qwen3.5">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1660" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="h6" value="GDN 混合 · GPU（Qwen3.5 单卡 tp1）—— 页对齐演进：Full 64KB / GDN 1,072KB → 1,088KB（S0→S5 每步示意图）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#333333;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="8" width="1680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="param6" value="24 GDN + 8 Full · bf16 · 层序 (3 GDN + 1 Full) × 8 · 教学显存 8.3GiB · 对齐执行者：基类 _align_hybrid_block_size（interface.py:764-934，executor 阶段、模型加载后）· 条宽按字节等比（S0 按初始大页 1,072KB = 700px；S2-S4 按统一页 1,088KB = 1,495px）" style="text;html=1;fontSize=12;fontColor=#555555;align=center;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="40" width="1680" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s0T" value="S0 · 初始态：spec 原生页 —— Full 64KB vs GDN 1,072KB（差 16.75×）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="76" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s0lf" value="FullAttentionSpec&lt;br&gt;block_size = 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="110" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0fb" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="245" y="110" width="42" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0ft" value="Full 页 = 2(K+V) × 4(kv头) × 16(tok) × 256(head_dim) × 2B(bf16) = 64KB" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="292" y="110" width="640" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0lg" value="MambaSpec（GDN）&lt;br&gt;页 = state 固定字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="158" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0ga" value="ssm 1MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="158" width="669" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0gb" value="conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" vertex="1" parent="1">
                    <mxGeometry x="914" y="158" width="31" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0gt" value="GDN 页 = ssm：32(v头) × 128(k_dim) × 128(v_dim) × 2B(bf16) = 1MiB；conv：(2×16k头 + 32v头) × 128 × 3(kernel-1) × 2B(bf16) = 48KB&lt;br&gt;⇒ 1MiB + 48KB = 1,072KB（不随块大小变）= 16.75 × Full 页 → 页不等，必须对齐" style="text;html=1;fontSize=10;fontColor=#c62828;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="961" y="158" width="779" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s0s" value="S0 干什么：建立对齐起点。块大小保持用户/默认 16 —— GPU 的块大小对齐尚未发生（发生在模型加载后的 executor 阶段，见 S1-S2）。KVCacheManager 要求所有层共用统一物理页，差 16.75× 必须拉平 → 进入 S1 四参数。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="206" width="1680" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="s1T" value="S1 · _align_hybrid_block_size 读 4 个参数（interface.py:845-882）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="272" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s1g1" value="attn 每 token 页 = 4,096B&lt;br&gt;= 2(K+V) × 4kv头 × 256head_dim × 2B（:845-851，FullAttentionSpec(1) 直接算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="306" width="405" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="s1g2" value="GDN 页 = 1,097,728B（1,072KB）&lt;br&gt;= ssm 1MiB + conv 48KB（:854-865）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="485" y="306" width="405" height="56" as="geometry"/>
