    <diagram id="p6_mamode" name="8-GDN·mamba_cache_mode三模式">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1010" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t6" value="GDN 状态缓存三模式：mamba_cache_mode = none / align / all（cache.py:139-147）" style="text;html=1;fontSize=20;fontColor=#333333;align=center;whiteSpace=wrap;html=1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="150" y="8" width="1500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6" value="示例沿用第 7 页：mamba 块 = 512 token · 页 2,146.3KB ≈ 2.146MB（NPU tp1）· max_model_len=32K · spec=0 ｜ 图示以「1 格 = 1 块边界」代画" style="text;html=1;fontSize=12;fontColor=#555555;align=center;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="42" width="1600" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="defN" value="「none」&lt;br&gt;prefix caching 关闭时的缺省：不缓存状态，每请求只留最新 1 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="78" width="520" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="defA" value="「align」&lt;br&gt;每 step 的末 token 若落在 i×块长 边界才提交该状态；mamba_block_size = attn block_size（可哈希）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="78" width="540" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="defB" value="「all」&lt;br&gt;prefix caching 开启时的缺省（模型支持时）：i×块长 的每个边界位置都保存状态快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="78" width="540" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="rn" value="none —— 单页滚动覆写" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="150" width="1160" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="rn_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="178" width="1160" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="rn_tag" value="none&lt;br&gt;1 页/req&lt;br&gt;prefix ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="70" y="186" width="110" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="rn_f1" value="prefill 4 块&lt;br&gt;块表 = [S0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#c62828;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="200" y="192" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="rn_f2" value="decode…&lt;br&gt;块表 = [S1]（覆写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#c62828;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="540" y="192" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="rn_f3" value="decode…&lt;br&gt;块表 = [S2]（覆写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#c62828;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
