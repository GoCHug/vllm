                    <mxGeometry x="1700" y="672" width="520" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="boxA7c" value="· bs：16 → 128（refresh_block_size :1262-1266：prefix caching / chunked prefill 开启即 128，并覆盖显式小值）&#39;+LBR+&#39;· 派生：page 32KiB → 256KiB · 块数 4096 → 512 · 每 ID 全模型 2MiB → 16MiB&#39;+LBR+&#39;· 70 tok 请求：5 块 → 1 块（块粒度变粗，尾块浪费 58/128 token）&#39;+LBR+&#39;· 调度 / 记账 / 生命周期逻辑与第 2 页完全一致&#39;+LBR+&#39;· 后端：GPU FlashAttention → Ascend attention_v1（页布局同为 (nb, kv头, bs, 2×d)）" style="text;html=1;fontSize=11;fontColor=#555555;align=left;spacingLeft=12;verticalAlign=top;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1712" y="700" width="496" height="196" as="geometry"/>
