                <mxCell id="s2bar" value="四格累计 K 页 = 1MiB = ssm 1,048,576B（本条与 ssm 等长）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="454" width="730" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="s2r" value="1,048,576 ÷ (128 × 2,048) = 4 步&lt;br&gt;⇒ block_size = 128 × 4 = 512&lt;br&gt;步进是基数，不是结果！用户已设更大值则保留（只增不减）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="406" width="700" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s3T" value="S3 · assert 精确铺满（:95-97）—— 整除校验，非就近覆盖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="488" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s3lf" value="assert 校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="522" width="170" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s3k" value="K 页：2,048B × 512 = 1,048,576B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="522" width="730" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="s3eq" value="≡" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#2e7d32;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="981" y="522" width="40" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="s3r" value="无余数 ✓ → block_size 锁定 512；不整除 → assert 报错拒绝启动（页不会悄悄变大）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1036" y="516" width="704" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s3s" value="ssm = 1,048,576B（与上行 K 页等长）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="558" width="730" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="s4T" value="S4 · 垫页 → 两族页全等 2,096KB（统一页 = attn 页 + conv，:110-117）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="596" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s4lf" value="Full 页&lt;br&gt;block_size = 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="630" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4f1" value="K 1MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="630" width="712" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4f2" value="V 1MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="957" y="630" width="712" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4f3" value="conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" parent="1" vertex="1">
                    <mxGeometry x="1669" y="630" width="70" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4ft" value="Full 页 = K 1MiB + V 1MiB + conv 隔离垫 48KB（黄格）= 2,096KB" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="670" width="1494" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s4lg" value="GDN 页&lt;br&gt;页 = state 固定字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="688" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g1" value="ssm 1MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="245" y="688" width="712" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g2" value="conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" parent="1" vertex="1">
                    <mxGeometry x="957" y="688" width="70" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g3" value="垫 1MiB（= ssm 等量）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1027" y="688" width="712" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4eq" value="GDN 页 = ssm 1MiB + conv 48KB + 垫 1MiB = 2,096KB · 两行等长 2,146,304B ✓ · 统一页写回 mamba_page_size_padded → 各层 spec 随之全等" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2e7d32;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="730" width="1680" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="s4s" value="S4 干什么：mamba_page_size_padded = attn_page_size + conv（:113-117）—— conv 隔离块垫在 Full 页尾，GDN 页尾垫 ssm 等量 1MiB。此后每层 spec 带统一页 → unify_kv_cache_spec_page_size 验收 no-op。&lt;br&gt;空洞账单：每块 ID 空洞 = 24 个 GDN 页 × 1MiB + 8 个 Full 页 × 48KB ≈ 24.4MiB，随每个块线性重复 → &lt;b&gt;全池空洞率 ≈ 37%&lt;/b&gt;（= GDN 页占比 24/32 × 页空洞 48.8% + Full 2.3%，即 ≈ 3GiB/8GiB）—— 不是一次性 24MiB。根因：GDN 没有 V，却要为统一页里 V 等量的空间买单；kernel 约束（ssm 页 = attn 页精确整除，:95-97）把块大小锁死在 512，约束内无法取更小块消除空洞。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="750" width="1680" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s5T" value="S5 · 对齐之后：统一页 2,096KB 驱动分组 → 建张量 → BlockPool（按第 1 页通用模板绘制）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="832" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s5d" value="单卡 tp1 · 32 层 spec（页全等 2,096KB）→ 4 组 · 张量数 = max(各组层数) = 8 · 每块 ID 在 8 个张量上各写 1 页（同组一张块表）" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="862" width="1680" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s5aL" value="⑤-1 分组：按 spec 类型切 4 组（get_kv_cache_groups :1760 → 兜底 unify 验收 no-op）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="882" width="1680" height="18" as="geometry"/>
