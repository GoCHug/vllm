                <mxCell id="s2bar" value="GDN 页 1,097,728B = ssm 1MiB + conv 48KB（对照：17 格累计 1,114,112B ≥ 本条，多 16,384B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
