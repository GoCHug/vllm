                </mxCell>
                <mxCell id="s2pad" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="1718" y="454" width="22" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="s2r" value="16 × cdiv(1,097,728, 16 × 4,096) = 16 × 17 = 272&lt;br&gt;16 步只有 1,024KB &lt; 1,072KB 不够装 → 第 17 步 1,088KB ✓（cdiv 就近向上）&lt;br&gt;只增不减：用户已设更大值则保留（:903-904）；272 非 kernel 对齐数也无妨（align 仅约束步进基数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="486" width="1495" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s3T" value="S3 · 覆盖校验（:903-916）—— attn 页 ≥ GDN 页即通过（就近覆盖，无 assert；与 NPU 的精确整除不同）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="556" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s3k" value="attn 页：272 tok × 4,096B = 1,114,112B（K 557,056 + V 557,056）—— 零垫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="590" width="1495" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="s3s" value="GDN 页 1,097,728B = ssm 1MiB + conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="624" width="1473" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="s3p" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="1718" y="624" width="22" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="s3r" value="1,114,112 ≥ 1,097,728 ✓ 余 16,384B → GDN 页垫 16KB（尾部空隙；GPU 不要求整除，因此空洞小）" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2e7d32;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="656" width="1680" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="s4T" value="S4 · 统一页落定：两族页全等 1,088KB（mamba_page_size_padded = attn 页，:914-934）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="684" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s4lf" value="Full 页&lt;br&gt;block_size = 272" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="718" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4f1" value="K 557,056B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="718" width="747" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4f2" value="V 557,056B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="992" y="718" width="748" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4ft" value="Full 页 = K 557,056B + V 557,056B = 1,114,112B（零垫 —— 块大小由 attn 页自身推出，天然等于统一页）" style="text;html=1;fontSize=10;fontColor=#1565c0;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="758" width="1495" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s4lg" value="GDN 页&lt;br&gt;页 = state 固定字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="776" width="170" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g1" value="ssm 1MiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="245" y="776" width="1407" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g2" value="conv 48KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" vertex="1" parent="1">
                    <mxGeometry x="1652" y="776" width="66" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4g3" value="垫 16KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;fontStyle=1;fontColor=#b8860b;" vertex="1" parent="1">
                    <mxGeometry x="1718" y="776" width="22" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s4eq" value="GDN 页 = ssm 1MiB + conv 48KB + 垫 16KB = 1,114,112B · 两行等长 ✓ · 统一页写回 mamba_page_size_padded → 各层 spec 随之全等" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2e7d32;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="818" width="1680" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="s4s" value="S4 干什么：mamba_page_size_padded = attn 页（:914-934）—— GPU 的统一页就等于 attn 页本身（Full 层零垫），只有 GDN 页尾部垫 16KB。&lt;br&gt;空洞账单：每块 ID 空洞 = 24 个 GDN 页 × 16KB + 8 个 Full 页 × 0 = 384KB，随每个块线性重复 → &lt;b&gt;全池空洞率 ≈ 1.1%&lt;/b&gt;（= 384KB ÷ 每块 34MiB；≠ 384KB ÷ 8.3GiB = 0.004%，那是错误基准）。GPU 空洞远小于 NPU（37%）—— kernel_align=16 步进细 + cdiv 就近覆盖 + K/V 口径让 attn 页天然略大于 GDN 页。align 模式下 mamba_block_size = 272（:911-912）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="838" width="1680" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="s5T" value="S5 · 对齐之后：统一页 1,088KB 驱动分组 → 建张量 → BlockPool（按第 1 页通用模板绘制）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="920" width="1680" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s5d" value="单卡 tp1 · 32 层 spec（页全等 1,088KB）→ 4 组 · 张量数 = max(各组层数) = 8 · 每块 ID 在 8 个张量上各写 1 页（同组一张块表）" style="text;html=1;fontSize=10;fontColor=#888888;align=left;" vertex="1" parent="1">
                    <mxGeometry x="60" y="950" width="1680" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="s5aL" value="⑤-1 分组：按 spec 类型切 4 组（get_kv_cache_groups :1760 → 兜底 unify 验收 no-op）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1">
