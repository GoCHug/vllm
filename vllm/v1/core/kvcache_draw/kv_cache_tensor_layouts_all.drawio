                <mxCell id="s1g4" value="kernel 步进 = 128&lt;br&gt;（GPU 是 16，NPU kernel 限制）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b1fa2;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" parent="1" vertex="1">
