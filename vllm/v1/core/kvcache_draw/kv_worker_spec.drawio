        </mxCell>
        <mxCell id="headinfo" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="模型级：共 8 个 KV 头（num_kv_heads=8，head_dim=128）—— 32 个 Query 头不进 KV cache" vertex="1">
