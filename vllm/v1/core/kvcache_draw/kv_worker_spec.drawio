          <mxGeometry height="30" width="1200" x="390" y="2070" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="全 worker 统一  num_blocks = min(1024, 1024, 1024, 1024) = 1024&#xa;（通用分支：建 32 个 per-layer 张量，各 32KiB×1024 = 32MiB，合计恰好 1GiB）&#xa;所有 worker 共享「同一个 block_id 空间」= 共享这唯一一张 BlockPool 表的编号命名&#xa;（共享的是查表/编号命名 → 逻辑；各卡自己的物理 KV 张量仍各按此表单独绑定 → 字节不共享）&#xa;（若某卡显存更小，如 0.5GiB → 512，则整体对齐到 512，保证最弱卡也能分配）" vertex="1">
          <mxGeometry height="170" width="1500" x="390" y="2104" as="geometry" />
        </mxCell>
