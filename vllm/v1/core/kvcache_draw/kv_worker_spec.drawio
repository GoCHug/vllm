        <mxCell id="h6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 6" vertex="1">
