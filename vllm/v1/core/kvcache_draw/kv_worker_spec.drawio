        <mxCell id="headsize" parent="1" style="text;html=1;fontSize=11;fontColor=#888888;align=left;" value="每头 head_dim = 128&#xa;每 token 每头存 K+V → 2×128" vertex="1">
          <mxGeometry height="36" width="200" x="660" y="2312" as="geometry" />
        </mxCell>
        <mxCell id="split_text" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;align=left;" value="↓  TP=2 沿 KV 头维度切分：8 ÷ 2 = 4 头 / 卡　（同一 block_id=42，各卡只落自己那份）" vertex="1">
          <mxGeometry height="22" width="900" x="90" y="2378" as="geometry" />
        </mxCell>
        <mxCell id="e_split" edge="1" parent="1" source="h3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitY=1;entryX=0.5;entryY=0;" target="tp0" />
        <mxCell id="e_split2" edge="1" parent="1" source="h4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitY=1;entryX=0.5;entryY=0;" target="tp1" />
        <mxCell id="tp0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" value="TP0（rank 0 / 2）&#xa;存 KV 头 0–3　·　4 头 × head_dim 128" vertex="1">
          <mxGeometry height="66" width="380" x="100" y="2412" as="geometry" />
        </mxCell>
        <mxCell id="tp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" value="TP1（rank 1 / 3）&#xa;存 KV 头 4–7　·　4 头 × head_dim 128" vertex="1">
          <mxGeometry height="66" width="380" x="520" y="2412" as="geometry" />
        </mxCell>
        <mxCell id="cap8" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="要点：TP 沿 KV 头维度切（8 ÷ 2 = 4）。&#xa;两卡头子集不同，但 page 一样：&#xa;都用 4 头 × 128 → page_size_bytes = 32 KiB。&#xa;→ block_id 仍是 42，行号一致、内容各半。" vertex="1">
          <mxGeometry height="110" width="520" x="1000" y="2412" as="geometry" />
        </mxCell>
        <mxCell id="s9_label" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑨ PP 切层 → 同一 block_id，各存不同层的 KV" vertex="1">
          <mxGeometry height="28" width="900" x="90" y="2518" as="geometry" />
        </mxCell>
        <mxCell id="zoom9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="block_id = 42 的一行 —— KV 按层切分（PP）" vertex="1">
          <mxGeometry height="140" width="700" x="100" y="2560" as="geometry" />
        </mxCell>
        <mxCell id="pp0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="PP0 · 存 层 0–15 的 KV&#xa;（每层 4 头）" vertex="1">
          <mxGeometry height="60" width="290" x="150" y="2632" as="geometry" />
        </mxCell>
        <mxCell id="pp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="PP1 · 存 层 16–31 的 KV&#xa;（每层 4 头）" vertex="1">
          <mxGeometry height="60" width="290" x="460" y="2632" as="geometry" />
        </mxCell>
        <mxCell id="cap9" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="PP 切层也只改变“每块里装什么（哪几层）”。&#xa;block_id=42 在 PP0 放层 0–15 的 KV、PP1 放层 16–31 的 KV；&#xa;每层又都是 4 头 × 128（page 32 KiB）。&#xa;→ 行号一致、内容不同层，block_id 仍是同一个。" vertex="1">
          <mxGeometry height="120" width="520" x="860" y="2568" as="geometry" />
        </mxCell>
        <mxCell id="s10_label" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑩ 这就解释了 ⑥ 的 min(num_blocks) 对齐为什么必不可少 —— 回扣上面「合并」图" vertex="1">
          <mxGeometry height="28" width="1200" x="90" y="2740" as="geometry" />
        </mxCell>
        <mxCell id="link" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingLeft=12;fontSize=12.5;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="关联 ⑥：min(各 worker num_blocks) 对齐 → 全 worker 拥有「相同数量 + 相同编号顺序」的逻辑块 → 才能真正共享同一 block_id 空间&#xa;反之，若各卡 num_blocks 不一致：block_id=42 在某卡存在、另一卡缺席 → 同一段 token 的 KV 无法被统一索引 → 集中式调度崩塌" vertex="1">
          <mxGeometry height="96" width="1500" x="90" y="2774" as="geometry" />
        </mxCell>
        <mxCell id="legend2" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="🔵 token 区间 / 块行　　　🟣 全局逻辑块　　　⬜➡ TP 切头(灰)　　　🔶 PP0 / 🟩 PP1 切层　　　🟨 强调注释" vertex="1">
          <mxGeometry height="22" width="820" x="90" y="2890" as="geometry" />
        </mxCell>
      </root>
