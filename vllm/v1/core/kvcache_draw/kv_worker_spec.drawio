          <mxGeometry height="22" width="1100" x="390" y="2282" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-55" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑦ 为什么全 worker 能共享同一 block_id：block_id 索引的是「token 区间」，不是「某层的第几块」" vertex="1">
          <mxGeometry height="30" width="1480" x="390" y="2330" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-56" parent="1" style="text;html=1;fontSize=12;fontColor=#888888;align=left;" value="PagedAttention 核心：所有层共享同一分块方式，某段连续 token 的 KV 在所有层 / 所有卡里都占用同一个 block_id → block_id 与层无关、与头无关" vertex="1">
          <mxGeometry height="24" width="1480" x="390" y="2358" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12.5;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="请求的一段连续 token&#xa;区块 42：token 96–111&#xa;（16 个 token = block_size）" vertex="1">
          <mxGeometry height="86" width="360" x="400" y="2394" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="逻辑块 block_id = 42&#xa;全局唯一 · 与层无关 · 与头无关" vertex="1">
          <mxGeometry height="86" width="460" x="840" y="2394" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=2;" value="任何 worker 只要说“42”，&#xa;指的就是这一整段 token（96–111）的 KV" vertex="1">
          <mxGeometry height="86" width="420" x="1380" y="2394" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-60" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑧ TP 切的是 KV 头（num_kv_heads）：8 → 每卡 4 头，但同一 block_id" vertex="1">
          <mxGeometry height="28" width="1300" x="390" y="2514" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-61" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="模型级：共 8 个 KV 头（num_kv_heads=8，head_dim=128）—— 32 个 Query 头不进 KV cache" vertex="1">
          <mxGeometry height="20" width="900" x="390" y="2550" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 0" vertex="1">
          <mxGeometry height="46" width="58" x="400" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 1" vertex="1">
          <mxGeometry height="46" width="58" x="464" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 2" vertex="1">
          <mxGeometry height="46" width="58" x="528" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 3" vertex="1">
          <mxGeometry height="46" width="58" x="592" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 4" vertex="1">
          <mxGeometry height="46" width="58" x="656" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 5" vertex="1">
          <mxGeometry height="46" width="58" x="720" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 6" vertex="1">
          <mxGeometry height="46" width="58" x="784" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 7" vertex="1">
          <mxGeometry height="46" width="58" x="848" y="2578" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-70" parent="1" style="text;html=1;fontSize=11;fontColor=#888888;align=left;" value="每头 head_dim = 128&#xa;每 token 每头存 K+V → 2×128" vertex="1">
          <mxGeometry height="36" width="200" x="960" y="2582" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-71" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#333333;align=left;" value="↓  TP=2 沿 KV 头维度切分：8 ÷ 2 = 4 头 / 卡　（同一 block_id=42，各卡只落自己那份）" vertex="1">
          <mxGeometry height="22" width="900" x="390" y="2648" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" value="TP0（rank 0 / 2）&#xa;存 KV 头 0–3　·　4 头 × head_dim 128" vertex="1">
          <mxGeometry height="66" width="380" x="400" y="2682" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" value="TP1（rank 1 / 3）&#xa;存 KV 头 4–7　·　4 头 × head_dim 128" vertex="1">
          <mxGeometry height="66" width="380" x="820" y="2682" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-74" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="要点：TP 沿 KV 头维度切（8 ÷ 2 = 4）。&#xa;两卡头子集不同，但 page 一样：&#xa;都用 4 头 × 128 → page_size_bytes = 32 KiB。&#xa;→ block_id 仍是 42，行号一致、内容各半。" vertex="1">
          <mxGeometry height="110" width="520" x="1300" y="2682" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-75" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑨ PP 切层 → 同一 block_id，各存不同层的 KV" vertex="1">
          <mxGeometry height="28" width="900" x="390" y="2788" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="block_id = 42 的一行 —— KV 按层切分（PP）" vertex="1">
          <mxGeometry height="140" width="700" x="400" y="2830" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="PP0 · 存 层 0–15 的 KV&#xa;（每层 4 头）" vertex="1">
          <mxGeometry height="60" width="290" x="450" y="2902" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="PP1 · 存 层 16–31 的 KV&#xa;（每层 4 头）" vertex="1">
          <mxGeometry height="60" width="290" x="760" y="2902" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-79" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="PP 切层也只改变“每块里装什么（哪几层）”。&#xa;block_id=42 在 PP0 放层 0–15 的 KV、PP1 放层 16–31 的 KV；&#xa;每层又都是 4 头 × 128（page 32 KiB）。&#xa;→ 行号一致、内容不同层，block_id 仍是同一个。" vertex="1">
          <mxGeometry height="120" width="520" x="1160" y="2838" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-80" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑩ 这就解释了 ⑥ 的 min(num_blocks) 对齐为什么必不可少 —— 回扣上面「合并」图" vertex="1">
          <mxGeometry height="28" width="1200" x="390" y="3010" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingLeft=12;fontSize=12.5;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="关联 ⑥：min(各 worker num_blocks) 对齐 → 全 worker 拥有「相同数量 + 相同编号顺序」的逻辑块 → 才能真正共享同一 block_id 空间&#xa;反之，若各卡 num_blocks 不一致：block_id=42 在某卡存在、另一卡缺席 → 同一段 token 的 KV 无法被统一索引 → 集中式调度崩塌" vertex="1">
          <mxGeometry height="96" width="1500" x="390" y="3044" as="geometry" />
        </mxCell>
        <mxCell id="8P-3Xleb93J090cqpLFW-82" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="🔵 token 区间 / 块行　　　🟣 全局逻辑块　　　⬜➡ TP 切头(灰)　　　🔶 PP0 / 🟩 PP1 切层　　　🟨 强调注释" vertex="1">
          <mxGeometry height="22" width="820" x="390" y="3160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
