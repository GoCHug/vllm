        <mxCell id="h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 3" vertex="1">
          <mxGeometry height="46" width="58" x="292" y="2308" as="geometry" />
        </mxCell>
        <mxCell id="h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" value="KV头 4" vertex="1">
          <mxGeometry height="46" width="58" x="356" y="2308" as="geometry" />
