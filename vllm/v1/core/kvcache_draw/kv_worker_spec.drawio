        <mxCell id="e_m1" edge="1" parent="1" source="w1n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;entryX=0.38;entryY=0;" target="blockpool" />
        <mxCell id="e_m2" edge="1" parent="1" source="w2n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#82b366;strokeWidth=2;endArrow=block;entryX=0.62;entryY=0;" target="blockpool" />
        <mxCell id="e_m3" edge="1" parent="1" source="w3n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#82b366;strokeWidth=2;endArrow=block;entryX=0.86;entryY=0;" target="blockpool" />
        <mxCell id="minbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="全 worker 统一  num_blocks = min(1024, 1024, 1024, 1024) = 1024&#xa;（通用分支：建 32 个 per-layer 张量，各 32KiB×1024 = 32MiB，合计恰好 1GiB）&#xa;所有 worker 共享「同一个 block_id 空间」= 共享这唯一一张 BlockPool 表的编号命名&#xa;（共享的是查表/编号命名 → 逻辑；各卡自己的物理 KV 张量仍各按此表单独绑定 → 字节不共享）&#xa;（若某卡显存更小，如 0.5GiB → 512，则整体对齐到 512，保证最弱卡也能分配）" vertex="1">
          <mxGeometry height="170" width="1500" x="90" y="1834" as="geometry" />
        </mxCell>
        <mxCell id="e_min7" edge="1" parent="1" source="minbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;strokeDasharray=4 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="s7_label" />
        <mxCell id="legend" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" value="🔶 PP0（层0–15）　　　🟩 PP1（层16–31）　　　🟣 合并 / 分组 / 统一(全局)　　　🔷 BlockPool(控制器侧唯一)　　　☐➡ 逐卡子视图 / 计算" vertex="1">
          <mxGeometry height="22" width="1100" x="90" y="2012" as="geometry" />
        </mxCell>
        <mxCell id="s7_label" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑦ 为什么全 worker 能共享同一 block_id：block_id 索引的是「token 区间」，不是「某层的第几块」" vertex="1">
          <mxGeometry height="30" width="1480" x="90" y="2060" as="geometry" />
        </mxCell>
        <mxCell id="s7_desc" parent="1" style="text;html=1;fontSize=12;fontColor=#888888;align=left;" value="PagedAttention 核心：所有层共享同一分块方式，某段连续 token 的 KV 在所有层 / 所有卡里都占用同一个 block_id → block_id 与层无关、与头无关" vertex="1">
          <mxGeometry height="24" width="1480" x="90" y="2088" as="geometry" />
        </mxCell>
        <mxCell id="tok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12.5;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="请求的一段连续 token&#xa;区块 42：token 96–111&#xa;（16 个 token = block_size）" vertex="1">
          <mxGeometry height="86" width="360" x="100" y="2124" as="geometry" />
        </mxCell>
        <mxCell id="e_tok" edge="1" parent="1" source="tok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" target="blk" />
        <mxCell id="blk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="逻辑块 block_id = 42&#xa;全局唯一 · 与层无关 · 与头无关" vertex="1">
          <mxGeometry height="86" width="460" x="540" y="2124" as="geometry" />
        </mxCell>
        <mxCell id="note7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=2;" value="任何 worker 只要说“42”，&#xa;指的就是这一整段 token（96–111）的 KV" vertex="1">
          <mxGeometry height="86" width="420" x="1080" y="2124" as="geometry" />
        </mxCell>
        <mxCell id="s8_label" parent="1" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#333333;" value="⑧ TP 切的是 KV 头（num_kv_heads）：8 → 每卡 4 头，但同一 block_id" vertex="1">
