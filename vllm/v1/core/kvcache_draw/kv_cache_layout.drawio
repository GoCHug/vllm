        <!-- ========== 总结 ========== -->
        <mxCell id="summary_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="summary_title" value="三个易混量" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="110" width="340" height="25" as="geometry" />
        </mxCell>
        <mxCell id="summary_content" value="&#xa;group_size = 2（列数/张量数）&#xa;= 每个 group 最多几层&#xa;→ 决定建几个张量&#xa;→ 决定每个 block_id 的物理代价&#xa;   = group_size × page_size&#xa;→ num_blocks 除以它&#xa;&#xa;num_groups = 3（manager 数）&#xa;→ 决定每个请求消耗几个 block_id&#xa;→ 不参与 num_blocks 计算&#xa;&#xa;page_size = 256B（每页字节）&#xa;→ 决定每页大小" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="135" width="340" height="210" as="geometry" />
        </mxCell>

        <!-- 核心公式 -->
        <mxCell id="formula_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" vertex="1" parent="1">
          <mxGeometry x="860" y="390" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="formula_title" value="核心公式" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="860" y="395" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="formula_content" value="建张量：group_size 个&#xa;每个大小 = available ÷ group_size&#xa;每张量页数 = (available÷group_size) ÷ page_size&#xa;&#xa;┌─────────────────────────────┐&#xa;│ num_blocks = available ÷ page_size ÷ group_size │&#xa;│          = 10240 ÷ 256 ÷ 2 = 20             │&#xa;└─────────────────────────────┘&#xa;&#xa;总物理显存 = group_size × page_size × num_blocks&#xa;           = 2 × 256 × 20 = 10240 = available ✓" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="420" width="340" height="105" as="geometry" />
        </mxCell>

        <!-- 为什么不除num_groups -->
        <mxCell id="why_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e7;strokeColor=#d84315;" vertex="1" parent="1">
          <mxGeometry x="860" y="560" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="why_title" value="为什么不除 num_groups=3？" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="860" y="565" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="why_content" value="物理上只建了 2 个张量（group_size=2）&#xa;不是 3 个！&#xa;&#xa;如果除 3：num_blocks = 10240÷256÷3 = 13&#xa;张量0 + 张量1 = 2 × 13 × 256 = 6656B&#xa;只用了 6656B / 10240B = 65%&#xa;&#xa;35% 显存白费了——因为张量数是 2 不是 3" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="590" width="340" height="105" as="geometry" />
        </mxCell>

        <!-- 分配结果汇总 -->
        <mxCell id="alloc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="860" y="710" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="alloc_title" value="1 个请求 = 3 个 group × 1 个 block 位置" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="860" y="715" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="alloc_content" value="Manager 0 → block_id = 5 → 512B&#xa;Manager 1 → block_id = 6 → 512B&#xa;Manager 2 → block_id = 7 → 512B&#xa;  （其中 256B 浪费）&#xa;──────────────────────────&#xa;共消耗 3 个 block ID（= num_groups）&#xa;共锁 3 × 512 = 1536B&#xa;  = num_groups × group_size × page_size&#xa;  = 3 × 2 × 256&#xa;&#xa;池子限制：总 block ID ≤ num_blocks &#xa;→ 一个请求 ≤ num_blocks ÷ num_groups 个位置&#xa;→ 满载 ≈ 20 ÷ 3 ≈ 6 个序列位置" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="740" width="340" height="215" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" vertex="1" parent="1">
          <mxGeometry x="860" y="980" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" value="图例" style="text;html=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="860" y="985" width="360" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="Full Attention 层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="875" y="1010" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="Sliding Window 层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="985" y="1010" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="空占浪费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1095" y="1010" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="block_id（行号）跨张量同页" style="text;html=1;fontSize=10;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="875" y="1035" width="320" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
