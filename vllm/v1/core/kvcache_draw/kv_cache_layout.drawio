        </mxCell>
        <mxCell id="BP7" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="733" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="BP19" value="…  19" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="733" width="55" height="20" as="geometry" />
        </mxCell>

        <!-- ========== 第 5 步：请求分配 ========== -->
        <mxCell id="step5_label" value="⑤ 请求来了 → 3 个 manager 各自从 BlockPool pop 不同 ID" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- Manager 0 -->
        <mxCell id="M0_box" value="Manager 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=5;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="M0_detail" value="pop → block_id = 5&#xa;&#xa;full.0 写 张量0 page 5 (256B)&#xa;full.1 写 张量1 page 5 (256B)&#xa;&#xa;锁了 2 页 = 512B" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="85" y="855" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- Manager 1 -->
        <mxCell id="M1_box" value="Manager 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=5;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="830" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="M1_detail" value="pop → block_id = 6&#xa;&#xa;sw.0 写 张量0 page 6 (256B)&#xa;sw.2 写 张量1 page 6 (256B)&#xa;&#xa;锁了 2 页 = 512B" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="345" y="855" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- Manager 2 -->
        <mxCell id="M2_box" value="Manager 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=5;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="830" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="M2_detail" value="pop → block_id = 7&#xa;&#xa;sw.1 写 张量0 page 7 (256B)&#xa;张量1 page 7 = 空（浪费）&#xa;&#xa;锁了 2 页 = 512B&#xa;（实际只写 256B）" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="605" y="855" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- BlockPool 到 Manager 的箭头 -->
        <mxCell id="arrow_M0" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="BP5" target="M0_box">
          <mxGeometry relative="1" as="geometry" />
