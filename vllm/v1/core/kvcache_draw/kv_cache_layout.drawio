        <mxCell id="summary_title" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=center;" value="三个易混量" vertex="1">
          <mxGeometry height="25" width="340" x="870" y="110" as="geometry" />
        </mxCell>
        <mxCell id="summary_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;" value="group_size = 2（列数/张量数）&lt;br&gt;= 每个 group 最多几层&lt;br&gt;→ 决定建几个张量&lt;br&gt;→ 决定每个 block_id 的物理代价 = group_size x page_size&lt;br&gt;→ num_blocks = available / (group_size x page_size)&lt;br&gt;&lt;br&gt;num_groups = 3（manager 数）&lt;br&gt;→ 决定每个请求消耗几个 block_id&lt;br&gt;→ 不参与 num_blocks 计算&lt;br&gt;&lt;br&gt;page_size = 256B（每页字节）&lt;br&gt;→ 决定每页大小" vertex="1">
          <mxGeometry height="210" width="340" x="870" y="135" as="geometry" />
        </mxCell>
        <mxCell id="formula_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" value="" vertex="1">
          <mxGeometry height="160" width="360" x="860" y="398" as="geometry" />
        </mxCell>
        <mxCell id="formula_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" value="核心公式" vertex="1">
          <mxGeometry height="25" width="360" x="860" y="403" as="geometry" />
        </mxCell>
        <mxCell id="formula_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" value="建张量：group_size 个&lt;br&gt;每个张量大小 = available / group_size&lt;br&gt;每张量页数 = (available/group_size) / page_size&lt;br&gt;&lt;br&gt;num_blocks = available / page_size / group_size&lt;br&gt;         = 10240 / 256 / 2 = 20&lt;br&gt;&lt;br&gt;总物理显存 = group_size x page_size x num_blocks&lt;br&gt;            = 2 x 256 x 20 = 10240 = available" vertex="1">
          <mxGeometry height="130" width="340" x="870" y="425" as="geometry" />
        </mxCell>
        <mxCell id="alloc_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" value="" vertex="1">
          <mxGeometry height="250" width="360" x="860" y="613" as="geometry" />
        </mxCell>
        <mxCell id="alloc_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" value="1 个请求 = 3 个 group x 1 个 block 位置" vertex="1">
