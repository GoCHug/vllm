        </mxCell>
        <!-- ID 格子 -->
        <mxCell id="BP0" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;" vertex="1" parent="1">
