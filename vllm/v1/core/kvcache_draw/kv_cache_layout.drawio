        </mxCell>

        <!-- ========== 第 4 步：BlockPool ========== -->
        <mxCell id="step4_label" value="④ BlockPool（全局唯一，20 个 block ID）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
