        <mxCell id="gc_conv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;" value="conv_state：最近 kernel-1=3 个 token 的 conv 输入（causal_conv 短上下文窗口），无 head 维" vertex="1">
