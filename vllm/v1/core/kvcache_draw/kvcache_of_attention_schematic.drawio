        </mxCell>

        <!-- 补充：page_size vs block_size（不同 attention 是否不同） -->
        <mxCell id="gc_psnote" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;补充 · page_size vs block_size：因 attention 而异吗？&lt;/b&gt;&lt;br&gt;· &lt;b&gt;page_size_bytes&lt;/b&gt; = block_size(每块 token 数) × 每 token 的 KV 字节（FULL/MLA/SW/AttentionSpec）；GDN/Mamba = 固定 state 字节和，&lt;b&gt;不随 block_size 缩放&lt;/b&gt;。&lt;br&gt;· 不同家族原生 page 不同：Full=kv_heads·head·2·dtype、MLA=latent(576)·dtype、GDN=状态固定尺寸。&lt;br&gt;· vLLM 强制统一为单一 page 字节（get_uniform_page_size 断言唯一 / unify_kv_cache_spec_page_size）：&lt;b&gt;AttentionSpec → 放大 block_size(×ratio)&lt;/b&gt;；&lt;b&gt;MambaSpec/GDN → padding&lt;/b&gt;(page_size_padded) 对齐。&lt;br&gt;→ 同一模型内 block_size 默认统一(16)，但统一 page 时&lt;b&gt;部分层块内 token 数被放大&lt;/b&gt;；最终所有层共用一个 page 字节，真实差异 = 每 token KV 字节 与 对齐后的块内 token 数。" vertex="1">
          <mxGeometry height="150" width="3240" x="60" y="2090" as="geometry" />
        </mxCell>
      </root>
