        <mxCell id="gc_tmpnote" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" value="temporal_state：每格 = (v_dim=128 × k_dim=128) 的递归累积矩阵——到&lt;b&gt;当前 token&lt;/b&gt;为止的线性注意力累计态" vertex="1">
