        </mxCell>
        <mxCell id="step1_desc" parent="1" style="text;html=1;fontSize=11;fontColor=#666666;align=center;" value="is_kv_cache_spec_uniform = True (所有 spec 完全相等)&#xa;merge() 直接深拷贝 → 全模型只有一个 group" vertex="1">
          <mxGeometry height="35" width="580" x="90" y="180" as="geometry" />
        </mxCell>
        <mxCell id="step2_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="② 分组结果 → 1 个 group + 1 个 manager" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="245" as="geometry" />
        </mxCell>
        <mxCell id="G_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=0;verticalAlign=top;spacingTop=8;align=center;" value="Group 0  (layer 0 ... layer 31)   group_size = 32" vertex="1">
          <mxGeometry height="100" width="600" x="80" y="285" as="geometry" />
        </mxCell>
        <mxCell id="G_mng" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" value="Manager 0  (唯一的 SingleTypeKVCacheManager)" vertex="1">
          <mxGeometry height="45" width="560" x="100" y="325" as="geometry" />
        </mxCell>
        <mxCell id="step2_desc" parent="1" style="text;html=1;fontSize=11;fontColor=#888888;align=center;" value="group_size = max(32) = 32  →  建 32 个张量（每层独享一个）&#xa;只有 1 个 manager → 每个请求的 1 个 block 位置只消耗 1 个 block ID" vertex="1">
          <mxGeometry height="35" width="600" x="80" y="395" as="geometry" />
        </mxCell>
        <mxCell id="step3_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="③ 物理层建张量 → 32 个张量 = group_size 个" vertex="1">
          <mxGeometry height="30" width="620" x="60" y="445" as="geometry" />
        </mxCell>
        <mxCell id="step3_desc" parent="1" style="text;html=1;fontSize=12;fontColor=#888888;" value="每个张量分到 available / group_size = 8GB / 32 = 256MB → 每张量 256MB / page_size(256KB) = 1024 页" vertex="1">
          <mxGeometry height="20" width="700" x="60" y="470" as="geometry" />
        </mxCell>
        <mxCell id="T_layer0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;spacingTop=5;align=center;" value="张量 0 (layer 0)&#xa;shape: (num_blocks, 32, 16, 256)&#xa;page_size = 256KB&#xa;shared_by = [layer 0]" vertex="1">
