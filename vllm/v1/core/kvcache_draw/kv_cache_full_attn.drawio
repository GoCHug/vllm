        <mxCell id="page5_l0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" value="张量0 page5&#xa;= layer 0 的&#xa;17~32 号 token&#xa;的 K/V (256KB)" vertex="1">
          <mxGeometry height="70" width="100" x="95" y="689" as="geometry" />
        </mxCell>
        <mxCell id="page5_l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" value="张量1 page5&#xa;= layer 1 的&#xa;17~32 号 token&#xa;的 K/V (256KB)" vertex="1">
          <mxGeometry height="70" width="100" x="210" y="689" as="geometry" />
        </mxCell>
        <mxCell id="page5_dots" parent="1" style="text;html=1;fontSize=11;align=center;fontColor=#888888;" value="...&#xa;同一请求的&#xa;同一段 token&#xa;跨层各存一份" vertex="1">
          <mxGeometry height="70" width="100" x="330" y="689" as="geometry" />
        </mxCell>
        <mxCell id="page5_l31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" value="张量31 page5&#xa;= layer 31 的&#xa;17~32 号 token&#xa;的 K/V (256KB)" vertex="1">
          <mxGeometry height="70" width="100" x="445" y="689" as="geometry" />
        </mxCell>
        <mxCell id="page5_link1" edge="1" parent="1" source="page5_l0" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1;dashed=1;endArrow=none;" target="page5_l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page5_link2" edge="1" parent="1" source="page5_l1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1;dashed=1;endArrow=none;" target="page5_dots">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page5_link3" edge="1" parent="1" source="page5_dots" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=1;dashed=1;endArrow=none;" target="page5_l31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page5_desc" parent="1" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" value="1 个 block_id = 32 页（每张量各一页）= 32 x 256KB = 8MB&#xa;同一 block_id 跨所有 32 个张量，每层存自己那份 K/V" vertex="1">
          <mxGeometry height="40" width="600" x="80" y="769" as="geometry" />
        </mxCell>
        <mxCell id="step4_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="④ 逻辑层BlockPool通过block id管理（全局唯一，num_blocks = 1024）" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="850" as="geometry" />
        </mxCell>
        <mxCell id="step4_desc" parent="1" style="text;html=1;fontSize=12;fontColor=#888888;" value="num_blocks = 8GB / 256KB / 32 = 1024  →  BlockPool 里 1024 个 ID（0~1023）" vertex="1">
          <mxGeometry height="20" width="700" x="60" y="875" as="geometry" />
        </mxCell>
        <mxCell id="BP" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;" value="" vertex="1">
          <mxGeometry height="50" width="580" x="80" y="900" as="geometry" />
        </mxCell>
        <mxCell id="BP_label" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=center;" value="BlockPool (1 个)  —  Manager 0 是唯一的取 ID 者" vertex="1">
          <mxGeometry height="20" width="580" x="80" y="902" as="geometry" />
        </mxCell>
        <mxCell id="BP5_full" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="ID: 5" vertex="1">
          <mxGeometry height="20" width="50" x="121" y="925" as="geometry" />
        </mxCell>
        <mxCell id="BP6_full" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="ID: 6" vertex="1">
          <mxGeometry height="20" width="50" x="181" y="925" as="geometry" />
        </mxCell>
        <mxCell id="BP_other" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;" value="ID: ... 1023" vertex="1">
          <mxGeometry height="20" width="80" x="246" y="925" as="geometry" />
        </mxCell>
        <mxCell id="step5_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="⑤ 请求来了 → Manager 0 从 BlockPool 取 block ID" vertex="1">
          <mxGeometry height="30" width="720" x="60" y="970" as="geometry" />
        </mxCell>
        <mxCell id="req_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=5;align=center;" value="请求 (max_model_len=4096 tokens)" vertex="1">
          <mxGeometry height="70" width="260" x="80" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="req_detail" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=center;" value="需要 4096/16 = 256 个 block&#xa;Manager 0 pop 256 个 ID&#xa;= [0,1,2,...255]" vertex="1">
          <mxGeometry height="35" width="250" x="85" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="alloc_arrow" edge="1" parent="1" source="req_box" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" target="BP5_full">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210.03" y="970" />
              <mxPoint x="146.03" y="970" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="alloc_detail" parent="1" style="text;html=1;fontSize=12;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=top;" value="block_id=5 被请求占用&#xa;→ 32 个张量的 page 5 同时被写入&#xa;  (layer 0~31 各存自己那份 K/V)&#xa;&#xa;block_id=6~255 同理&#xa;→ 256 个 block ID 被消耗" vertex="1">
          <mxGeometry height="100" width="250" x="470" y="980" as="geometry" />
        </mxCell>
        <mxCell id="summary_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" value="" vertex="1">
          <mxGeometry height="325" width="360" x="740" y="745" as="geometry" />
        </mxCell>
        <mxCell id="sum_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=center;" value="单 Group vs 多 Group 对比" vertex="1">
          <mxGeometry height="25" width="360" x="740" y="755" as="geometry" />
        </mxCell>
        <mxCell id="sum_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;" value="Llama-7B 单 Group:&lt;br&gt;  num_groups = 1  (1 个 manager)&lt;br&gt;  group_size = 32 (32 层/32 张量)&lt;br&gt;  page_size = 256KB&lt;br&gt;&lt;br&gt;混合模型 多 Group:&lt;br&gt;  num_groups = 3 (3 个 manager)&lt;br&gt;  group_size = 2  (2 张量)&lt;br&gt;  page_size = 256B (统一后)&lt;br&gt;&lt;br&gt;相同点：&lt;br&gt;  BlockPool 全局唯一&lt;br&gt;  group_size = 张量数&amp;nbsp; = 每个block_id消耗的page数&lt;br&gt;  num_blocks = available / (group_size x page_size)&lt;br&gt;&lt;br&gt;不同点：&lt;div&gt;num_groups = manager 数&amp;nbsp;&lt;br&gt;  单Group: 每block_size个token消耗 1 个 block id&lt;br&gt;  多Group:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164));&quot;&gt;每block_size个token消耗&amp;nbsp;&lt;/span&gt;num_groups&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(85, 85, 85), rgb(164, 164, 164));&quot;&gt;&amp;nbsp;个 block id&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="340" x="750" y="780" as="geometry" />
        </mxCell>
        <mxCell id="formula_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" value="" vertex="1">
          <mxGeometry height="195" width="360" x="740" y="285" as="geometry" />
        </mxCell>
        <mxCell id="f_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" value="核心数值" vertex="1">
          <mxGeometry height="25" width="360" x="740" y="290" as="geometry" />
        </mxCell>
        <mxCell id="f_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" value="page_size = 16 x 32 x 256 x 2 = 262,144 B = 256 KB&lt;br&gt;(block_size x kv_heads x 2xhead_size x dtype_size)&lt;br&gt;&lt;br&gt;num_blocks = 8GB / 256KB / 32 = 1,024&lt;br&gt;(available / page_size / group_size)&lt;br&gt;&lt;br&gt;每个 block_id = 32 x 256KB = 8 MB&lt;div&gt;跨所有张量（即group size）各一页&lt;br&gt;(每个逻辑block_id对应物理显存group_size x page_size)&lt;br&gt;&lt;br&gt;总物理 = 32 x 256KB x 1024 = 8 GB&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="340" x="750" y="315" as="geometry" />
        </mxCell>
        <mxCell id="key_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="" vertex="1">
          <mxGeometry height="195" width="360" x="740" y="520" as="geometry" />
        </mxCell>
        <mxCell id="key_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#1b5e20;" value="单 Group 的核心特征" vertex="1">
          <mxGeometry height="25" width="360" x="740" y="525" as="geometry" />
        </mxCell>
        <mxCell id="key_content" parent="1" style="text;html=1;fontSize=12;fontColor=#333333;align=left;spacingLeft=10;" value="1. 只 1 个 manager &lt;br&gt;   → 1 个请求每步只消耗 1 个 block ID&lt;br&gt;   (多 group 是每个 manager 各消耗 1 个)&lt;br&gt;&lt;br&gt;2. 32 个张量每层独享一个&lt;br&gt;   → block_id 跨 32 张量同页&lt;br&gt;&lt;br&gt;3. 所有层共享同一个 block_table&lt;br&gt;   → block_id=5 意味着 layer 0~31都用 page 5, 各存自己的 K/V" vertex="1">
          <mxGeometry height="165" width="340" x="750" y="550" as="geometry" />
        </mxCell>
        <mxCell id="cap_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" value="" vertex="1">
          <mxGeometry height="130" width="360" x="740" y="115" as="geometry" />
        </mxCell>
        <mxCell id="cap_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" value="容量计算" vertex="1">
          <mxGeometry height="25" width="360" x="740" y="120" as="geometry" />
        </mxCell>
        <mxCell id="cap_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=10;fontFamily=Courier New;" value="1 个请求 (4096 tokens):&lt;br&gt;  需要 4096/16 = 256 个 block ID&lt;br&gt;&lt;br&gt;池子容量 = 1024 个 block ID&lt;br&gt;满载 = 1024 / 256 = 4 个并发请求&lt;br&gt;  (4 x 2GB = 8GB = 全部显存)" vertex="1">
          <mxGeometry height="95" width="340" x="750" y="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
