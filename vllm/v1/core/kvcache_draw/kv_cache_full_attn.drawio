        </mxCell>
        <mxCell id="T_layer1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;spacingTop=5;align=center;" value="张量 1 (layer 1)&#xa;shape: (num_blocks, 32, 16, 256)&#xa;page_size = 256KB&#xa;shared_by = [layer 1]" vertex="1">
          <mxGeometry height="100" width="130" x="225" y="500" as="geometry" />
        </mxCell>
        <mxCell id="T_dots" parent="1" style="text;html=1;fontSize=14;align=center;fontColor=#888888;" value="...  ...  ...&#xa;...  ...  ...&#xa;...  ...  ...&#xa;...  ...  ..." vertex="1">
