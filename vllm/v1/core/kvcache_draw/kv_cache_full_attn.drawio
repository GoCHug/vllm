<mxfile host="app.diagrams.net" modified="2026-08-25T00:00:00.000Z" agent="CodeFuse" version="21.0.0">
  <diagram id="kv_cache_full_attn" name="Llama-7B Full Attention 单 Group">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
