        <mxCell id="T_layer31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;spacingTop=5;align=center;" value="张量 31 (layer 31)&#xa;shape: (num_blocks, 32, 16, 256)&#xa;page_size = 256KB&#xa;shared_by = [layer 31]" vertex="1">
          <mxGeometry height="100" width="130" x="495" y="500" as="geometry" />
        </mxCell>
        <mxCell id="T_note" parent="1" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" value="32 个张量，每层独立一个&lt;br&gt;每个张量 1024页，对应block id 0 - 1023&lt;br&gt;每页 = 16 tokens x 32 heads x 256 (K+V) x 2B = 256KB" vertex="1">
          <mxGeometry height="50" width="600" x="80" y="601" as="geometry" />
        </mxCell>
        <mxCell id="page5_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=5;align=center;" value="block_id = 5 的放大图（存17~32号token）" vertex="1">
