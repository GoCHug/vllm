        </mxCell>

        <!-- ========== Side Info Boxes ========== -->

        <!-- Formula box -->
        <mxCell id="formula_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;" value="" vertex="1">
          <mxGeometry height="220" width="400" x="1170" y="170" as="geometry" />
        </mxCell>
        <mxCell id="f_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#01579b;" value="核心数值（每 worker · TP2 切分后）" vertex="1">
          <mxGeometry height="25" width="400" x="1170" y="175" as="geometry" />
        </mxCell>
        <mxCell id="f_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=12;fontFamily=Courier New;" value="page_size = 2×16×4×128×2 = 32,768 B = 32 KB&lt;br&gt;(K+V × block × kv_heads × head_dim × dtype)&lt;br&gt;&lt;br&gt;num_blocks = 2GiB ÷ 32KB ÷ 16 = 4,096&lt;br&gt;(available ÷ page_size ÷ group_size)&lt;br&gt;&lt;br&gt;每 block_id = 16 × 32KB = 512 KB&lt;br&gt;(跨 worker 内 16 张量 = group_size × page_size)&lt;br&gt;&lt;br&gt;每张量 = 32KB × 4096 = 128 MiB&lt;br&gt;&lt;br&gt;总物理(每worker) = 16 × 128 MiB = 2 GiB&lt;br&gt;(= group_size × page_size × num_blocks)" vertex="1">
          <mxGeometry height="190" width="380" x="1180" y="200" as="geometry" />
        </mxCell>

        <!-- Feature box -->
        <mxCell id="key_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="" vertex="1">
          <mxGeometry height="185" width="400" x="1170" y="410" as="geometry" />
        </mxCell>
        <mxCell id="key_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#1b5e20;" value="单 Group 核心特征（pp2tp2 每 worker）" vertex="1">
          <mxGeometry height="25" width="400" x="1170" y="415" as="geometry" />
        </mxCell>
        <mxCell id="key_content" parent="1" style="text;html=1;fontSize=12;fontColor=#333333;align=left;spacingLeft=12;" value="1. 全模型 1 个 FullAttentionManager&lt;br&gt;   → 1 个请求每步只消耗 1 个 block ID&lt;br&gt;&lt;br&gt;2. 张量 shape = (4096, 4, 16, 256)&lt;br&gt;   → TP2 切分后 4 KV头&lt;br&gt;   → block_id 跨 16 张量同页&lt;br&gt;&lt;br&gt;3. 所有层共享同一 block_table&lt;br&gt;   → block_id=2 → layer 0–15 都用 page 2&lt;br&gt;   → 各存自己那份 K/V&lt;br&gt;&lt;br&gt;4. 全局 BlockPool 共享&lt;br&gt;   → 4 worker 共用同一 block_id 空间" vertex="1">
          <mxGeometry height="155" width="380" x="1180" y="440" as="geometry" />
        </mxCell>

        <!-- Capacity box -->
        <mxCell id="cap_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" value="" vertex="1">
          <mxGeometry height="140" width="400" x="1170" y="610" as="geometry" />
        </mxCell>
        <mxCell id="cap_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#4a148c;" value="容量计算（每 worker）" vertex="1">
          <mxGeometry height="25" width="400" x="1170" y="615" as="geometry" />
        </mxCell>
        <mxCell id="cap_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;fontFamily=Courier New;" value="1 个请求 (max_model_len=4096):&lt;br&gt;  需要 4096/16 = 256 个 block ID&lt;br&gt;&lt;br&gt;池子容量 = 4096 个 block ID&lt;br&gt;满载 = 4096 / 256 = 16 个并发请求&lt;br&gt;  (16 × 2GiB = 32GiB = 4 worker 总显存)&lt;br&gt;&lt;br&gt;注: 各 worker 物理独立, 逻辑共享" vertex="1">
          <mxGeometry height="105" width="380" x="1180" y="640" as="geometry" />
        </mxCell>

        <!-- Deploy summary box -->
        <mxCell id="deploy_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" value="" vertex="1">
          <mxGeometry height="240" width="400" x="1170" y="770" as="geometry" />
        </mxCell>
        <mxCell id="deploy_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#795548;" value="pp2tp2 部署要点" vertex="1">
          <mxGeometry height="25" width="400" x="1170" y="775" as="geometry" />
        </mxCell>
        <mxCell id="deploy_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;" value="&lt;b&gt;切分方式：&lt;/b&gt;&lt;br&gt;PP2 线性切层: 32层 → 每 worker 16 层&lt;br&gt;TP2 线性切头: 8 KV头 → 每 worker 4 头&lt;br&gt;&lt;br&gt;&lt;b&gt;分组 → 投影：&lt;/b&gt;&lt;br&gt;① 每卡产出 spec (16 层, 4 头)&lt;br&gt;② merge → 全模型 32 层 1 个 group&lt;br&gt;③ project → 每 worker 16 层&lt;br&gt;④ num_blocks = 2GiB÷32KB÷16 = 4096&lt;br&gt;&lt;br&gt;&lt;b&gt;四卡职责：&lt;/b&gt;&lt;br&gt;W0: 层0-15 × 头0-3&lt;br&gt;W1: 层0-15 × 头4-7&lt;br&gt;W2: 层16-31 × 头0-3&lt;br&gt;W3: 层16-31 × 头4-7&lt;br&gt;&lt;br&gt;&lt;b&gt;BlockPool 对齐：&lt;/b&gt;&lt;br&gt;min(4096,4096,4096,4096) = 4096&lt;br&gt;4 worker 共享 block_id 命名, 字节独立" vertex="1">
          <mxGeometry height="210" width="380" x="1180" y="800" as="geometry" />
        </mxCell>

        <!-- Sharing explanation box (NEW) -->
        <mxCell id="share_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;" value="" vertex="1">
          <mxGeometry height="140" width="400" x="1170" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="share_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#e65100;" value="block_id 的两层共享" vertex="1">
          <mxGeometry height="25" width="400" x="1170" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="share_content" parent="1" style="text;html=1;fontSize=12;fontColor=#555555;align=left;spacingLeft=12;" value="&lt;b&gt;跨 worker（逻辑）:&lt;/b&gt;&lt;br&gt;block_id=2 在 4 worker 中同名&lt;br&gt;→ 来自同一 BlockPool, 调度器视角唯一&lt;br&gt;&lt;br&gt;&lt;b&gt;跨层/头（物理）:&lt;/b&gt;&lt;br&gt;每个 worker 内部 16 张量&lt;br&gt;各存该 worker 负责的层/头的 K/V&lt;br&gt;→ 物理字节互不相同, 逻辑编号统一" vertex="1">
          <mxGeometry height="105" width="380" x="1180" y="1060" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
