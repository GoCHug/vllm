        <mxCell id="title" value="Llama-7B Full Attention 单 Group 布局" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="40" as="geometry" />
        </mxCell>
