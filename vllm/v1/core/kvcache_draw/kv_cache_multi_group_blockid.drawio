          <mxGeometry height="28" width="1000" x="60" y="410" as="geometry" />
        </mxCell>

        <mxCell id="code_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;verticalAlign=top;spacingTop=5;align=left;spacingLeft=12;" value="" vertex="1">
          <mxGeometry height="120" width="1020" x="60" y="445" as="geometry" />
        </mxCell>
        <mxCell id="code_content" parent="1" style="text;html=1;fontSize=12;align=left;spacingLeft=12;fontFamily=Courier New;fontColor=#333333;" value="# NewRequestData.block_ids (sched/output.py:41)&lt;br&gt;block_ids: tuple[list[int], ...]   # 外层 tuple = group, 内层 list = 该 group 的 block_id&lt;br&gt;&lt;br&gt;block_ids = (&lt;br&gt;&amp;nbsp;&amp;nbsp;[0, 1, 2, 3, 4],   &amp;nbsp;# group 0 (Full Attention)  ← 该 group 的 16 个层张量共用这一套 ID&lt;br&gt;&amp;nbsp;&amp;nbsp;[5, 6, 7, 8, 9],   &amp;nbsp;# group 1 (Sliding Window) ← 该 group 的 16 个层张量共用另一套 ID&lt;br&gt;)&lt;br&gt;&lt;br&gt;# get_block_ids() 源码 (kv_cache_manager.py:91):  tuple([blk.block_id for blk in group] for group in self.blocks)" vertex="1">
          <mxGeometry height="105" width="990" x="72" y="452" as="geometry" />
        </mxCell>

