        <!-- 纠正 callout -->
        <mxCell id="correction" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;⚠ 纠正常见误解&lt;/b&gt;&lt;br&gt;不是&quot;调度器预先分好各 group 的 block id 再分发&quot; → 而是各 manager 独立从&lt;b&gt;共享&lt;/b&gt; BlockPool pop（free_block_queue.popleft_n），ID 自然不重叠&lt;br&gt;两阶段分配（kv_cache_coordinator.py:219）：先 touch 所有 group 命中块 → 再各 group 独立 allocate_new_blocks，避免跨组驱逐竞争" vertex="1">
