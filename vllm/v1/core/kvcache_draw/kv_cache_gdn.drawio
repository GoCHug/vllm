<mxfile host="app.diagrams.net" modified="2026-08-25T00:00:00.000Z" agent="CodeFuse" version="21.0.0">
  <diagram id="kv_cache_gdn" name="Qwen3-Next GDN+Attn 混合布局">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Qwen3-Next GDN + Full Attention 混合布局" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="params" value="block_size=64  available=8GB  24 GDN层 + 8 Full层 = 32层  pattern: 3GDN-1Full x 8" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="1000" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step1_label" value="① 模型层：Full Attention (家族A) + GDN (家族C)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L_C0" value="GDN 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="55" height="35" as="geometry" />
        </mxCell>
        <mxCell id="L_C1" value="GDN 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="145" y="125" width="55" height="35" as="geometry" />
        </mxCell>
        <mxCell id="L_C2" value="GDN 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="125" width="55" height="35" as="geometry" />
        </mxCell>
        <mxCell id="L_A0" value="Full 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="125" width="55" height="35" as="geometry" />
        </mxCell>
        <mxCell id="L_dots" value="... 3GDN:1Full x 8 ..." style="text;html=1;fontSize=12;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="370" y="125" width="150" height="35" as="geometry" />
        </mxCell>
        <mxCell id="L_A7" value="Full 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="125" width="55" height="35" as="geometry" />
        </mxCell>
        <mxCell id="step1_family" value="GDN = MambaSpec (家族C): 存固定递归状态, page 与 block_size 无关  /  Full = FullAttentionSpec (家族A): 存每token的 K/V, page 正比于 block_size" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step2_label" value="② 原始 page_size 不同 → 需要 unify" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="205" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gdn_orig" value="GDN (MambaSpec)&#xa;page_size = 262,144 B = 256 KB&#xa;(conv_state + ssm_state 固定字节和)&#xa;block_size = 64 (但 page 不随它变)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="full_orig" value="Full Attention (FullAttentionSpec)&#xa;num_kv_heads=2, head_dim=128, bf16&#xa;page_size = 2 x 64 x 2 x 128 x 2 = 65,536 B = 64 KB&#xa;block_size = 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="240" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="page_diff" value="page_size 不同!&#xa;256KB vs 64KB&#xa;&#xa;is_kv_cache_page_size_uniform = False&#xa;→ 需 unify" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#cc0000;align=center;" vertex="1" parent="1">
          <mxGeometry x="690" y="250" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step3_label" value="③ unify_kv_cache_spec_page_size: 两条路线统一到 max_page=256KB" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gdn_unify" value="GDN: padding&#xa;&#xa;page = 262,144 = max_page&#xa;已是最大 → 不动&#xa;page_size_padded = 262,144&#xa;block_size 保持 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="375" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="full_unify" value="Full Attention: 放大 block_size&#xa;&#xa;page = 65,536 &lt; max_page&#xa;ratio = 262,144 / 65,536 = 4&#xa;block_size: 64 x 4 = 256&#xa;new page = 65,536 x 4 = 256 KB = max_page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="390" y="375" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="unify_note" value="GDN: padding 垫字节 (page 不随 block_size 变)&#xa;Full: 放大 block_size 摊平字节 (page 正比于 block_size)&#xa;两者殊途同归 → 统一 page = 256KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="382" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="arrow_unify" style="strokeColor=#333333;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="325" as="sourcePoint" />
            <mxPoint x="200" y="375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow_unify2" style="strokeColor=#333333;strokeWidth=2;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="325" as="sourcePoint" />
            <mxPoint x="530" y="375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step4_label" value="④ 分组：按 spec 值去重 → 2 类 → 按列拆 4 个子组" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="495" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="group_desc" value="group_size = min(24, 8) = 8 (取小者)&#xa;GDN 24层 → cdiv(24,8)=3 子组, 每组8层 (stride-sliced)&#xa;Full 8层 → 1 子组, 8层" style="text;html=1;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G_gdn0" value="Group 0 (GDN)&#xa;8 layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="570" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G_gdn1" value="Group 1 (GDN)&#xa;8 layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" vertex="1" parent="1">
          <mxGeometry x="225" y="570" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G_gdn2" value="Group 2 (GDN)&#xa;8 layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" vertex="1" parent="1">
          <mxGeometry x="370" y="570" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G_full" value="Group 3 (Full)&#xa;8 layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" vertex="1" parent="1">
          <mxGeometry x="515" y="570" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mgr_label" value="num_groups = 4 managers" style="text;html=1;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="625" width="590" height="20" as="geometry" />
        </mxCell>
        <mxCell id="M_gdn0" value="M0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="95" y="648" width="40" height="25" as="geometry" />
        </mxCell>
        <mxCell id="M_gdn1" value="M1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="648" width="40" height="25" as="geometry" />
        </mxCell>
        <mxCell id="M_gdn2" value="M2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="385" y="648" width="40" height="25" as="geometry" />
        </mxCell>
        <mxCell id="M_full" value="M3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="648" width="40" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step5_label" value="⑤ 建张量：group_size=8 个张量, 每组同位置层共享" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step5_desc" value="每张量 256KB x num_blocks, 每个张量 shared_by 4 层 (各组列0 / 1 / ...)" style="text;html=1;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="60" y="715" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="T0" value="张量0&#xa;shared_by: GDN0(列0), Full0(列0)&#xa;page_size=256KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;verticalAlign=top;spacingTop=3;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="745" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tdots" value="...&#xa;group_size=8&#xa;共8个张量" style="text;html=1;fontSize=14;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="745" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="T7" value="张量7&#xa;shared_by: GDN23(列7), Full7(列7)&#xa;page_size=256KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;verticalAlign=top;spacingTop=3;align=center;" vertex="1" parent="1">
          <mxGeometry x="365" y="745" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="T_note" value="8 个张量, 每个 = 256KB x num_blocks&#xa;张量0 被每个group的第0层共用, 张量1 被1层共用..." style="text;html=1;fontSize=11;fontColor=#555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="num_blocks_box" value="num_blocks = 8GB / 256KB / 8 = 4,096&#xa;= available / page_size / group_size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="855" width="450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bp_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="80" y="910" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bp_label" value="BlockPool (1个) — 4096 个 block ID, 4 个 manager 共享" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="912" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bp_ids" value="ID: 0  1  2  ...  4095" style="text;html=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="935" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step6_label" value="⑥ 请求来了：4 个 manager 各自 pop 不同 block ID" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="alloc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alloc_title" value="1 个请求 = 4 group x 1 个 block 位置" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="60" y="1025" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="alloc_content" value="M0 (GDN g0)  pop ID=10  → GDN写张量0~7 page10 (8x256KB = 2MB)&#xa;M1 (GDN g1)  pop ID=11  → GDN写张量0~7 page11 (2MB)&#xa;M2 (GDN g2)  pop ID=12  → GDN写张量0~7 page12 (2MB)&#xa;M3 (Full g3) pop ID=13  → Full写张量0~7 page13 (2MB)&#xa;&#xa;共消耗 4 个 block ID (= num_groups)&#xa;每个 block_id 锁 256KB x 8 = 2MB (= group_size x page_size)&#xa;共锁 4 x 2MB = 8MB / 位置" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="1045" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gdn_detail_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="360" height="230" as="geometry" />
        </mxCell>
        <mxCell id="gd_title" value="GDN 一个 block 存什么 (家族C)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="860" y="95" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="gd_content" value="物理: (num_blocks, 1, 1, 262,144)&#xa;= 一个扁平字节缓冲&#xa;&#xa;bind_kv_cache 按状态 shape 切分:&#xa;  conv_state: (3072, 3)  = 18,432 B&#xa;  ssm_state:  (8, 128, 128) = 262,144 B&#xa;&#xa;page_size = 18,432 + 262,144 = 280,576 B&#xa;→ padding 到 256KB&#xa;&#xa;每block = 一份固定状态&#xa;与 token 数无关&#xa;block_size 改了 page 也不变" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="120" width="340" height="195" as="geometry" />
        </mxCell>
        <mxCell id="full_detail_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="860" y="340" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fd_title" value="Full 一个 block 存什么 (家族A)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="860" y="345" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="fd_content" value="物理: (num_blocks, 2, 256, 256)  bf16&#xa;     B       H    blk  2xD&#xa;B = blocks, H=2 kv_heads, blk=256 (放大后)&#xa;2xD = 256 (K128 + V128&#xa;&#xa;统一前: block_size=64&#xa;  page = 2x64x2x128x2 = 64KB&#xa;统一后: block_size=256 (x4)&#xa;  page = 64KB x 4 = 256KB&#xa;&#xa;每block = 256 个 token 的 K/V&#xa;page 正比于 block_size" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="365" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="compare_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;" vertex="1" parent="1">
          <mxGeometry x="860" y="570" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cmp_title" value="GDN vs Full 统一对比" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#33691e;" vertex="1" parent="1">
          <mxGeometry x="860" y="575" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="cmp_content" value="基本法: page_size 需要对齐&#xa;&#xa;GDN (MambaSpec):&#xa;  page = 状态字节和 (固定)&#xa;  不随 block_size 变&#xa;  → padding: page_padded=max&#xa;  block_size 保持 64&#xa;&#xa;Full (AttentionSpec):&#xa;  page = blk x heads x D x dt&#xa;  正比于 block_size&#xa;  → 放大 block_size 256KB/64KB=4&#xa;  block_size: 64 -&gt; 256&#xa;&#xa;统一后: page = 256KB (全 group)&#xa;GDN block_size=64, Full block_size=256" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="600" width="340" height="225" as="geometry" />
        </mxCell>
        <mxCell id="key_diff" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="850" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="kd_title" value="关键区别 (vs 单 group Llama)" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="860" y="855" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="kd_content" value="1. 两类层 page_size 天然不同&#xa;   → 需要 unify_kv_cache_spec_page_size&#xa;   GDN padding, Full 放大 block_size&#xa;&#xa;2. Full Attention 的 block_size 被改了&#xa;   64 -&gt; 256 (x4 对齐 page)&#xa;   GDN 的不变 (只设 page_size_padded)&#xa;&#xa;3. 4 个 manager 竞争同一 BlockPool&#xa;   每步消耗 4 个 block ID (= num_groups)&#xa;   每个 block_id 跨 8 张量 (= group_size)" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="880" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;" vertex="1" parent="1">
          <mxGeometry x="860" y="1030" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lg_title" value="图例" style="text;html=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="860" y="1035" width="360" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg_gdn" value="GDN (MambaSpec/家族C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="1060" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg_full" value="Full Attn (家族A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1060" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg_unify" value="黄框 = unify / 关键说明" style="text;html=1;fontSize=10;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="1090" width="320" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
