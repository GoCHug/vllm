        <mxCell id="G_gdn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" value="Group 2 (GDN)&#xa;8 layers" vertex="1">
          <mxGeometry height="50" width="130" x="370" y="635" as="geometry" />
        </mxCell>
        <mxCell id="G_full" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" value="Group 3 (Full)&#xa;8 layers" vertex="1">
          <mxGeometry height="50" width="130" x="515" y="635" as="geometry" />
        </mxCell>
        <mxCell id="mgr_label" parent="1" style="text;html=1;fontSize=10;fontColor=#555555;align=center;" value="num_groups = 4 managers" vertex="1">
          <mxGeometry height="20" width="590" x="80" y="685" as="geometry" />
        </mxCell>
        <mxCell id="M_gdn0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="M0" vertex="1">
          <mxGeometry height="25" width="40" x="95" y="715" as="geometry" />
        </mxCell>
        <mxCell id="M_gdn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="M1" vertex="1">
          <mxGeometry height="25" width="40" x="240" y="715" as="geometry" />
        </mxCell>
        <mxCell id="M_gdn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="M2" vertex="1">
          <mxGeometry height="25" width="40" x="385" y="715" as="geometry" />
        </mxCell>
        <mxCell id="M_full" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="M3" vertex="1">
          <mxGeometry height="25" width="40" x="530" y="715" as="geometry" />
        </mxCell>
        <mxCell id="step5_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="⑤ 建张量：group_size=8 个张量, 每组同位置层共享block id" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="746" as="geometry" />
        </mxCell>
        <mxCell id="step5_desc" parent="1" style="text;html=1;fontSize=11;fontColor=#888888;" value="每张量 256KB x num_blocks&lt;div&gt;num_blocks = available / page_size / group_size = 8GB / 256KB / 8 = 4,096&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="410" x="120" y="776" as="geometry" />
        </mxCell>
        <mxCell id="T0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;verticalAlign=top;spacingTop=3;align=center;" value="张量0&lt;br&gt;page_size=256KB&lt;div&gt;共4096页（num_blocks）&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="170" x="133" y="818" as="geometry" />
        </mxCell>
        <mxCell id="Tdots" parent="1" style="text;html=1;fontSize=14;fontColor=#888888;align=center;" value="...&#xa;group_size=8&#xa;共8个张量" vertex="1">
          <mxGeometry height="60" width="80" x="323" y="818" as="geometry" />
        </mxCell>
        <mxCell id="T7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontSize=10;verticalAlign=top;spacingTop=3;align=center;" value="张量7&lt;br&gt;page_size=256KB&lt;div&gt;共4096页（num_blocks）&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="170" x="418" y="818" as="geometry" />
        </mxCell>
        <mxCell id="T_note" parent="1" style="text;html=1;fontSize=11;fontColor=#555555;align=center;" value="8 个张量, 每个 = 256KB x num_blocks&lt;br&gt;张量0 被每个group的第0层共用, 张量1 被第1层共用..." vertex="1">
          <mxGeometry height="30" width="500" x="80" y="883" as="geometry" />
        </mxCell>
        <mxCell id="bp_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;" value="" vertex="1">
          <mxGeometry height="50" width="500" x="113" y="930" as="geometry" />
        </mxCell>
        <mxCell id="bp_label" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=center;" value="BlockPool (1个) — 4096 个 block ID, 4 个 manager 共享" vertex="1">
          <mxGeometry height="20" width="500" x="113" y="932" as="geometry" />
        </mxCell>
        <mxCell id="bp_ids" parent="1" style="text;html=1;fontSize=12;align=center;" value="ID: 0  1  2  ...  4095" vertex="1">
          <mxGeometry height="20" width="500" x="113" y="955" as="geometry" />
        </mxCell>
        <mxCell id="step6_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="⑥ 请求来了：4 个 manager 各自 pop 不同 block ID" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="990" as="geometry" />
        </mxCell>
        <mxCell id="alloc_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;" value="" vertex="1">
          <mxGeometry height="140" width="575" x="70" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="alloc_title" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#e65100;" value="1 个请求 需要 num_groups 个block id，每个group分配一个block id" vertex="1">
          <mxGeometry height="20" width="600" x="70" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="alloc_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;verticalAlign=top;" value="M0 (GDN g0)  pop ID=10  → GDN写张量0~7 page10 (8x256KB = 2MB)&lt;br&gt;M1 (GDN g1)  pop ID=11  → GDN写张量0~7 page11 (2MB)&lt;br&gt;M2 (GDN g2)  pop ID=12  → GDN写张量0~7 page12 (2MB)&lt;br&gt;M3 (Full g3) pop ID=13  → Full写张量0~7 page13 (2MB)&lt;br&gt;&lt;br&gt;共消耗 4 个 block ID (= num_groups)&lt;br&gt;每个 block_id 锁 256KB x 8 = 2MB (= group_size x page_size)&lt;br&gt;共锁 4 x 2MB = 8MB" vertex="1">
          <mxGeometry height="115" width="580" x="80" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="gdn_detail_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;" value="" vertex="1">
          <mxGeometry height="195" width="360" x="760" y="438" as="geometry" />
        </mxCell>
        <mxCell id="gd_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#b71c1c;" value="GDN 一个 block 存什么 (家族C)" vertex="1">
          <mxGeometry height="25" width="360" x="760" y="443" as="geometry" />
        </mxCell>
        <mxCell id="gd_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" value="物理: (num_blocks, 1, 1, 262,144)&lt;br&gt;= 一个扁平字节缓冲&lt;br&gt;&lt;br&gt;&lt;br&gt;page_size = conv_state_size + ssm_state_size&lt;div&gt;= 262,144&amp;nbsp;B&lt;br&gt;&lt;br&gt;每block = 一份固定状态&amp;nbsp;&lt;br&gt;与 token 数无关&lt;br&gt;block_size 改了 page 也不变&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="340" x="770" y="468" as="geometry" />
        </mxCell>
        <mxCell id="full_detail_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;" value="" vertex="1">
          <mxGeometry height="195" width="360" x="760" y="160" as="geometry" />
        </mxCell>
        <mxCell id="fd_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#0d47a1;" value="Full 一个 block 存什么 (家族A)" vertex="1">
          <mxGeometry height="25" width="360" x="760" y="165" as="geometry" />
        </mxCell>
        <mxCell id="fd_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" value="物理: (num_blocks, 2, 256, 2x128)  bf16&lt;br&gt;H=2 kv_heads,&amp;nbsp;&lt;div&gt;blk=256 (放大后)&lt;br&gt;2xD = 256 (K128 + V128)&lt;br&gt;&lt;br&gt;统一前: block_size=64&lt;br&gt;  page = 2x64x2x128x2 = 64KB&lt;br&gt;统一后: block_size=256&lt;br&gt;  page = 2x256x2x128x2&amp;nbsp;= 256KB&lt;br&gt;&lt;br&gt;每block = 256 个 token 的 K/V&lt;br&gt;page 正比于 block_size&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="340" x="770" y="185" as="geometry" />
        </mxCell>
        <mxCell id="compare_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;" value="" vertex="1">
          <mxGeometry height="260" width="360" x="760" y="705" as="geometry" />
        </mxCell>
        <mxCell id="cmp_title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#33691e;" value="GDN vs Full 统一对比" vertex="1">
          <mxGeometry height="25" width="360" x="760" y="710" as="geometry" />
        </mxCell>
        <mxCell id="cmp_content" parent="1" style="text;html=1;fontSize=11;fontColor=#333333;align=left;spacingLeft=10;fontFamily=Courier New;" value="基本法: page_size 需要对齐&#xa;&#xa;GDN (MambaSpec):&#xa;  page = 状态字节和 (固定)&#xa;  不随 block_size 变&#xa;  → padding: page_padded=max&#xa;  block_size 保持 64&#xa;&#xa;Full (AttentionSpec):&#xa;  page = blk x heads x D x dt&#xa;  正比于 block_size&#xa;  → 放大 block_size 256KB/64KB=4&#xa;  block_size: 64 -&gt; 256&#xa;&#xa;统一后: page = 256KB (全 group)&#xa;GDN block_size=64, Full block_size=256" vertex="1">
          <mxGeometry height="225" width="340" x="770" y="735" as="geometry" />
        </mxCell>
        <mxCell id="Sf8SGeoCo0Z6aehJMkKN-1" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#cc0000;align=center;" value="is_kv_cache_page_size_uniform = False → 需 unify" vertex="1">
          <mxGeometry height="40" width="300" x="215" y="325" as="geometry" />
        </mxCell>
        <mxCell id="Sf8SGeoCo0Z6aehJMkKN-3" edge="1" parent="1" source="step5_desc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="step5_desc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
