  <diagram id="kv_cache_gdn" name="Qwen3-Next GDN+Attn 混合布局">
    <mxGraphModel dx="1988" dy="1222" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="Qwen3-Next GDN + Full Attention 混合布局" vertex="1">
          <mxGeometry height="40" width="700" x="270" y="10" as="geometry" />
        </mxCell>
        <mxCell id="params" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#555555;" value="block_size=64  available=8GB  24 GDN层 + 8 Full层 = 32层  pattern: 3GDN-1Full x 8" vertex="1">
          <mxGeometry height="25" width="1000" x="120" y="50" as="geometry" />
        </mxCell>
        <mxCell id="step1_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="① 模型层：Full Attention (家族A) + GDN (家族C)" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="L_C0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" value="GDN 0" vertex="1">
          <mxGeometry height="35" width="55" x="80" y="125" as="geometry" />
        </mxCell>
        <mxCell id="L_C1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" value="GDN 1" vertex="1">
          <mxGeometry height="35" width="55" x="145" y="125" as="geometry" />
        </mxCell>
        <mxCell id="L_C2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" value="GDN 2" vertex="1">
          <mxGeometry height="35" width="55" x="210" y="125" as="geometry" />
        </mxCell>
        <mxCell id="L_A0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Full 0" vertex="1">
          <mxGeometry height="35" width="55" x="280" y="125" as="geometry" />
        </mxCell>
        <mxCell id="L_dots" parent="1" style="text;html=1;fontSize=12;fontColor=#888888;align=center;" value="... 3GDN:1Full x 8 ..." vertex="1">
          <mxGeometry height="35" width="150" x="370" y="125" as="geometry" />
        </mxCell>
        <mxCell id="L_A7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="Full 7" vertex="1">
          <mxGeometry height="35" width="55" x="530" y="125" as="geometry" />
        </mxCell>
        <mxCell id="step1_family" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" value="GDN = MambaSpec (家族C): 存固定递归状态, page 与 block_size 无关&amp;nbsp;&lt;div&gt;Full = FullAttentionSpec (家族A): 存每token的 K/V, page 正比于 block_size&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="490" x="60" y="165" as="geometry" />
        </mxCell>
        <mxCell id="step2_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="② 原始 page_size 不同 → 需要 unify" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="205" as="geometry" />
        </mxCell>
        <mxCell id="gdn_orig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" value="GDN (MambaSpec)&#xa;page_size = 262,144 B = 256 KB&#xa;(conv_state + ssm_state 固定字节和)&#xa;block_size = 64 (但 page 不随它变)" vertex="1">
          <mxGeometry height="80" width="280" x="80" y="240" as="geometry" />
        </mxCell>
        <mxCell id="full_orig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" value="Full Attention (FullAttentionSpec)&#xa;num_kv_heads=2, head_dim=128, bf16&#xa;page_size = 2 x 64 x 2 x 128 x 2 = 65,536 B = 64 KB&#xa;block_size = 64" vertex="1">
          <mxGeometry height="80" width="280" x="390" y="240" as="geometry" />
        </mxCell>
        <mxCell id="page_diff" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#cc0000;align=center;" value="page_size 不同!&lt;br&gt;256KB vs 64KB" vertex="1">
          <mxGeometry height="60" width="160" x="400" y="195" as="geometry" />
        </mxCell>
        <mxCell id="step3_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="③ unify_kv_cache_spec_page_size:&amp;nbsp;&lt;div&gt;两条路线统一到 max_page=256KB&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="300" x="60" y="365" as="geometry" />
        </mxCell>
        <mxCell id="gdn_unify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=0;" value="GDN: padding&#xa;&#xa;page = 262,144 = max_page&#xa;已是最大 → 不动&#xa;page_size_padded = 262,144&#xa;block_size 保持 64" vertex="1">
          <mxGeometry height="100" width="280" x="80" y="446" as="geometry" />
        </mxCell>
        <mxCell id="full_unify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=0;" value="Full Attention: 放大 block_size&#xa;&#xa;page = 65,536 &lt; max_page&#xa;ratio = 262,144 / 65,536 = 4&#xa;block_size: 64 x 4 = 256&#xa;new page = 65,536 x 4 = 256 KB = max_page" vertex="1">
          <mxGeometry height="100" width="280" x="390" y="446" as="geometry" />
        </mxCell>
        <mxCell id="unify_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;fontColor=#555555;align=center;" value="GDN: padding 垫字节 (page 不随 block_size 变)&#xa;Full: 放大 block_size 摊平字节 (page 正比于 block_size)&#xa;两者殊途同归 → 统一 page = 256KB" vertex="1">
          <mxGeometry height="60" width="280" x="390" y="365" as="geometry" />
        </mxCell>
        <mxCell id="step4_label" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" value="④ 分组：按 spec 值去重 → 2 类 → 按列拆 4 个子组" vertex="1">
          <mxGeometry height="30" width="900" x="60" y="566" as="geometry" />
        </mxCell>
        <mxCell id="group_desc" parent="1" style="text;html=1;fontSize=11;fontColor=#666666;" value="group_size = min(24, 8) = 8 (取小者)&lt;br&gt;GDN 24层 → cdiv(24,8)=3 子组, 每组8层 (stride-sliced)" vertex="1">
          <mxGeometry height="40" width="600" x="80" y="593" as="geometry" />
        </mxCell>
        <mxCell id="G_gdn0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=3;align=center;" value="Group 0 (GDN)&#xa;8 layers" vertex="1">
