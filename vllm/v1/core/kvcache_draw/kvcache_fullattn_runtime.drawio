                <mxCell id="mgr_box" value="&lt;b&gt;FullAttentionManager&lt;/b&gt;（group 0）&#10;allocate_new_blocks(R)&#10;→ get_new_blocks(5)&#10;从空闲队列弹出 5 个 ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
