    <diagram id="kv_cache_full_attn" name="运行时阶段视角（调度器全局记账 → 广播 block_ids → 各卡本地解释）">
        <mxGraphModel dx="1511" dy="648" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
            <root>
