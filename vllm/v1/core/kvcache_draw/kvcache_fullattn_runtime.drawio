                <mxCell id="title" value="KV Cache 运行时阶段视角（请求调度与读写 · Llama-3-8B pp2tp2）" style="text;html=1;fontSize=22;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="30" width="1500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="params" value="Llama-3-8B · 32 层 · 32 Q头 · 8 KV头 · head_dim=128 · fp16(2B) · block_size=16　|　PP=2 × TP=2（4 卡）· 每卡 16 层 / 4 KV头 · BlockPool num_blocks=4096（min 对齐后）" style="text;html=1;fontSize=13;fontStyle=1;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="100" y="74" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="s1_label" value="① 调度器侧：全局 group 记账，block_id 全局唯一" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="100" y="122" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s1_desc" value="Scheduler → KVCacheManager → FullAttentionManager(group 0) → BlockPool.get_new_blocks() —— 全局唯一空闲队列，分配函数不感知 worker / PP / TP" style="text;html=1;fontSize=12;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="100" y="148" width="1500" height="18" as="geometry"/>
                </mxCell>
