                <mxCell id="ids_box" value="&lt;b&gt;分配结果&lt;/b&gt;&#10;[0, 1, 2, 3, 4]&#10;→ req_to_blocks[R]&#10;（per group，全模型 1 组）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="880" y="220" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note_box" value="&lt;b&gt;全局唯一 BlockPool&lt;/b&gt;&#10;所有 group 共享同一空闲队列&#10;group_id 只出现在前缀缓存哈希&#10;BlockHashWithGroupId(hash, 0)&#10;分配逻辑不感知 PP/TP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
