                <mxCell id="sched_title" value="调度器进程（全局视图 · group_id = 0）" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#1a4a7a;" parent="1" vertex="1">
                    <mxGeometry x="100" y="182" width="1500" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="req_box" value="&lt;b&gt;请求 R&lt;/b&gt;（70 token prompt）&#10;首次调度 allocate_slots(R)&#10;前缀未命中&#10;需 ⌈70/16⌉ = 5 个块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="130" y="220" width="280" height="100" as="geometry"/>
