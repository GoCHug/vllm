                </mxCell>
                <mxCell id="pool_bar_title" value="BlockPool · free_block_queue（全局唯一 · 0 .. 4095）—— 橙色 = 本请求已分配的 5 块" style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
