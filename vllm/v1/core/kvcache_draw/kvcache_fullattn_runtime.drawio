                </mxCell>
                <mxCell id="pool_note2" value="ref_cnt：0~4 已由请求 R 持有（运行期 &gt;0 不可驱逐）· 剩余 4091 块仍可分配给后续请求" style="text;html=1;fontSize=11;fontColor=#888888;align=left;" parent="1" vertex="1">
                    <mxGeometry x="840" y="424" width="720" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s2_label" value="② 下发：同一份 block_ids 广播给 4 个 worker" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="100" y="540" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s2_desc" value="SchedulerOutput.new_block_ids = ([0,1,2,3,4])（per group，不混合）→ collective_rpc → 全体 rank —— 调度器只认 block_id，对 PP/TP 布局完全透明" style="text;html=1;fontSize=12;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="100" y="566" width="1500" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="bcast_box" value="&lt;b&gt;SchedulerOutput&lt;/b&gt;&#10;NewRequestData(block_ids=([0, 1, 2, 3, 4]))　── collective_rpc ──▶　Worker 0 / 1 / 2 / 3（同一份 ID，无任何 per-worker 差异）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1976d1;strokeWidth=2;fontSize=12;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="594" width="1500" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s3_label" value="③ worker 侧：同一 block_id，各卡各自解释成本地物理行" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="100" y="700" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s3_desc" value="每卡 16 张量 shape = (4096, 4, 16, 256) · kv = kv_caches[layer][block_ids] 按 dim0 直接索引 · 每写 1 个 block_id = 全模型 32 层 × 8 头同时落盘" style="text;html=1;fontSize=12;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="100" y="726" width="1500" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="w0_card" value="&lt;b&gt;Worker 0 · PP0·TP0&lt;/b&gt;&#10;层 0–15 · KV 头 0–3&#10;&#10;block_ids=[0,1,2,3,4]&#10;→ 16 张量各取行 0~4&#10;写入本卡的 K/V（头 0–3）&#10;每块 5 页 × 16 层 × 32 KiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="754" width="350" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="w1_card" value="&lt;b&gt;Worker 1 · PP0·TP1&lt;/b&gt;&#10;层 0–15 · KV 头 4–7&#10;&#10;block_ids=[0,1,2,3,4]（同一份）&#10;→ 16 张量各取行 0~4&#10;写入本卡的 K/V（头 4–7）&#10;与 W0 同层不同头 → 合并即完整 8 头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="483" y="754" width="350" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="w2_card" value="&lt;b&gt;Worker 2 · PP1·TP0&lt;/b&gt;&#10;层 16–31 · KV 头 0–3&#10;&#10;block_ids=[0,1,2,3,4]（同一份）&#10;→ 16 张量各取行 0~4&#10;写入本卡的 K/V（头 0–3）&#10;与 W0 同批块不同层 → PP 接力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="866" y="754" width="350" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="w3_card" value="&lt;b&gt;Worker 3 · PP1·TP1&lt;/b&gt;&#10;层 16–31 · KV 头 4–7&#10;&#10;block_ids=[0,1,2,3,4]（同一份）&#10;→ 16 张量各取行 0~4&#10;写入本卡的 K/V（头 4–7）&#10;四卡合起来覆盖 32 层 / 8 头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1249" y="754" width="350" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="tp_pp_note" value="TP 切头：W0 ↔ W1 同层、各存 4 头子集　|　PP 切层：W0 ↔ W2 同批块、各存 16 层　|　同一请求 KV 被 4 卡瓜分，调度器对此完全透明" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#555555;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="938" width="1500" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s4_label" value="④ forward 读写与生命周期（每步调度循环内）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="100" y="984" width="1200" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="s4_desc" value="decode 续写：每生成 1 token 复用块尾；块写满即 cache_full_blocks 落哈希；请求结束 free_blocks 回收 —— 全部是 block_id 记账，零显存搬运" style="text;html=1;fontSize=12;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1010" width="1500" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="lc1" value="&lt;b&gt;写入&lt;/b&gt;&#10;attention 算子从 forward_context&#10;取本层 KV cache&#10;按 block_table 逐 token 写&#10;（decode 续写：尾块未满则续写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1038" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="lc2" value="&lt;b&gt;落哈希（前缀缓存）&lt;/b&gt;&#10;块写满 → cache_full_blocks&#10;计算 BlockHash&#10;(hash, group_id=0) 入前缀缓存表&#10;后续请求命中可 touch 复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="480" y="1038" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="lc3" value="&lt;b&gt;引用保护&lt;/b&gt;&#10;运行期 ref_cnt &gt; 0&#10;前缀命中 touch 防驱逐&#10;ref_cnt=0 才可回收/驱逐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="860" y="1038" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="lc4" value="&lt;b&gt;释放&lt;/b&gt;&#10;请求结束 → free_blocks&#10;5 个 ID 回收进空闲队列&#10;ref_cnt=0，可被复用或驱逐&#10;（CoW 时先拷后改）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="1038" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="arrow_lc12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="lc1" target="lc2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow_lc23" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="lc2" target="lc3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow_lc34" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="lc3" target="lc4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="key_note" value="核心对照：调度器只做 block_id 记账（分配 / touch / 释放，零显存拷贝）；物理读写由各 worker 按同一编号就地完成 —— 「调度决策与物理布局完全解耦，block_id 是唯一交互接口」" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1a4a7a;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1180" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="🟦 调度器 / 全局侧（记账）　🟧 PP0 卡（层 0–15）　🟩 PP1 卡（层 16–31）　⬜ BlockPool 空闲块　🟧橙色格 = 本请求已分配　|　分配 → 广播 → 本地解释 → 释放，四步全程同一套 block_id" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1216" width="1500" height="24" as="geometry"/>
                </mxCell>
            </root>
