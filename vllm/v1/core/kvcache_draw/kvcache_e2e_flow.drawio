                <mxCell id="o_u_free" value="④ free · ref_cnt--&#xa;逆序归还" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#4a7a38;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="826" width="240" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="o_u_cache" value="free 队列 + 前缀缓存&#xa;（哈希表条目保留）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="826" width="200" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="o_ue1" value="首次调度成功" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="o_u_wait" target="o_u_run" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_ue2" value="解码结束" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="o_u_run" target="o_u_fin" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_ue3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="o_u_fin" target="o_u_free" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_ue4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="o_u_free" target="o_u_cache" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_loop" value="前缀复用闭环：下一条同前缀请求 ① get_computed_blocks 命中 → touch 摘出队列 ⇒ 零成本复用已算 KV" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=1;fontSize=10;fontStyle=1;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" parent="1" source="o_u_cache" target="o_u_run" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1500" y="960"/>
                            <mxPoint x="570" y="960"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="o_footer" value="🟦 调度 / 逻辑 · 命中复用　　🟧 新分配块 / GPU 物理　　🟨 哈希 / 缓存　　🟥 清零　　|　　阶段细节：第 4 页 prefill · 第 5 页 decode · 第 6 页 释放" style="text;html=1;fontSize=12;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1000" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="o_e2" value="入队 · 预计算链式哈希" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#888888;strokeWidth=1.5;endArrow=block;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="o_llmeng" target="o_sched" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="e2e_p2_components" name="组件分层 · 调用链与 allocate_slots 五步">
        <mxGraphModel dx="915" dy="435" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c_title" value="五组件分层与调用链（逻辑编排 zero-copy · 物理读写经 block_id 间接寻址）" style="text;html=1;fontSize=22;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="24" width="1500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c_sub" value="调用链 KVCacheManager → UnitaryKVCacheCoordinator → FullAttentionManager → BlockPool 只管 block_id 与 ref_cnt；GPUModelRunner 持物理张量 —— 分配/回收/复用全部发生在逻辑层" style="text;html=1;fontSize=13;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="100" y="68" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_km" value="&lt;b&gt;KVCacheManager&lt;/b&gt;（kv_cache_manager.py）&#xa;编排入口 · Scheduler 唯一对接方（单 group）&#xa;对外：get_computed_blocks / allocate_slots / take_new_block_ids / free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="118" width="500" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="c_a1" value="同名方法逐层下放：find_longest_cache_hit / get_num_blocks_to_allocate / allocate_* / cache_blocks / free" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c_km" target="c_coord" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_coord" value="&lt;b&gt;UnitaryKVCacheCoordinator&lt;/b&gt;（kv_cache_coordinator.py）&#xa;单组协调器 —— 单组场景为直通层：single_type_managers[0] 原样透传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="258" width="500" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="c_a2" value="透传（直通）" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c_coord" target="c_fm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_fm" value="&lt;b&gt;FullAttentionManager&lt;/b&gt;（single_type_kv_cache_manager.py）&#xa;单个 attention 类型的 KV cache 管理实现：&#xa;最长前缀查找 · 块数计算 · touch · 分配 · 缓存 · 释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="388" width="500" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="c_a3" value="get_cached_block · get_new_blocks · touch · cache_full_blocks · free_blocks" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c_fm" target="c_bp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_bp" value="&lt;b&gt;BlockPool&lt;/b&gt;（block_pool.py）· 逻辑块池 = KV 数据持有方&#xa;blocks 哈希表（id → KVCacheBlock）· free_block_queue&#xa;cached_block_hash_to_block：前缀缓存表&#xa;get_new_blocks · touch · cache_full_blocks · free_blocks &#xa;运行期 KVCacheManager 的分配/释放只操作 block_id 和 ref_cnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="524" width="500" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c_gc" value="prefill 独有入口 ① get_computed_blocks&#xa;→ find_longest_cache_hit：链式哈希逐块比对，遇 miss 即 break&#xa;只读不写：临时 key（BlockHashWithGroupId）用完即弃，不动 ref_cnt&#xa;max_cache_hit_length = num_tokens − 1（最后 1 个 token 必须重算，最多命中 N−1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="660" y="118" width="460" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="c_rtb" value="req_to_blocks：request_id → [block_id …]&#xa;即请求的 block_table ——&#xa;全部 32 层共享同一份列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="118" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c_hb" value="cached_block_hash_to_block&#xa;BlockHashWithGroupId → KVCacheBlock&#xa;前缀缓存表：满块入表 · 软持有不回收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="252" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c_fbq" value="free_block_queue（双向链）&#xa;分配 = 队首弹出 · touch = 摘除&#xa;释放 = 有 hash 尾插 / 无 hash 头插" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="386" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c_struct_note" value="← 以上三个数据结构都在 BlockPool 内部" style="text;html=1;fontSize=11;align=left;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="502" width="420" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="c_gpu" value="&lt;b&gt;GPUModelRunner&lt;/b&gt;（gpu_model_runner.py）— 物理层，独立持有真实 K/V 张量&#xa;kv_caches[layer]：16 张量 × (4096, 4, 16, 256)（每 worker，pp2tp2）&#xa;_zero_block_ids 清零新块 · forward 内 attention 按 block_table fancy index 第 0 维" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="730" y="524" width="420" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c_s2_label" value="▍allocate_slots 内部五步 —— 调度每步的固定入口，与源码顺序严格一致（prefill 与 decode 同一骨架）" style="text;html=1;fontSize=16;fontStyle=1;align=left;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="100" y="706" width="1450" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c_st1" value="&lt;b&gt;① remove_skipped_blocks&lt;/b&gt;（km:504）&#xa;容量检查【前】先释放滑窗外块&#xa;full attention：get_num_skipped_tokens 恒 0&#xa;实际不弹块 · 仅 SWA / R-SWA 生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="100" y="744" width="272" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c_st2" value="&lt;b&gt;② get_num_blocks_to_allocate&lt;/b&gt;（km:510）&#xa;纯计算：num_new = max(&#xa;cdiv(num_tokens, 16) − num_local_computed, 0)&#xa;比较：available = free − reserved&#xa;不足 → return None → 等下一轮调度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="392" y="744" width="272" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c_st3" value="&lt;b&gt;③ allocate_new_computed_blocks&lt;/b&gt;（km:535）&#xa;先逐组 add_local：touch 命中块&#xa;ref_cnt++ · 摘出 free 队列&#xa;再 allocate_external（主线 0 → 跳过）&#xa;置容量检查【后】→ 避免 touch 后回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="684" y="744" width="272" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c_st4" value="&lt;b&gt;④ allocate_new_blocks&lt;/b&gt;（km:542）&#xa;get_new_blocks(0..N)：free 队首弹出&#xa;→ block_table 追加（req_to_blocks）&#xa;新块 id 记入 new_block_ids&#xa;（交 GPU 清零：take_new_block_ids）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="976" y="744" width="272" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c_st5" value="&lt;b&gt;⑤ cache_blocks&lt;/b&gt;（km:563）&#xa;cache_full_blocks：恰写满的块算哈希入表&#xa;（只缓存已定稿 token）&#xa;未满尾块不入表 · 命中块幂等早退&#xa;新满块 → 前缀缓存持续增长的来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1268" y="744" width="272" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c_a12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" parent="1" source="c_st1" target="c_st2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_a23" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" parent="1" source="c_st2" target="c_st3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_a34" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" parent="1" source="c_st3" target="c_st4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_a45" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" parent="1" source="c_st4" target="c_st5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_uni" value="统一骨架：prefill = 前置 ① get_computed_blocks 查前缀，之后 ①~⑤ 全走（③ touch 固化命中）；decode = 无前缀查找，①③ 空操作、②④⑤ 照走 —— 唯一真正差异是规模：prefill 一次多块（3 块），decode 0 或 1 块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.5;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="920" width="1440" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c_footer" value="🟦 KVCacheManager 入口　　🟪 Coordinator 直通　　🟧 FullAttentionManager 单型实现　　🟩 BlockPool 逻辑池　　🟥 GPUModelRunner 物理层" style="text;html=1;fontSize=12;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1000" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_bridge" value="block_id == 张量第 0 维行号&#xa;（逻辑 ↔ 物理唯一桥接 · 零拷贝）" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=1;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c_bp" target="c_gpu" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="e2e_p3_init" name="启动期 · KV Cache 物理初始化">
        <mxGraphModel dx="2644" dy="1258" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="i_title" value="启动期一次性初始化：模型 spec → num_blocks=4096 → 16 层物理张量（Llama-3-8B · pp2tp2 · 每卡可用 2 GiB）" style="text;html=1;fontSize=22;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="24" width="1500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="i_sub" value="EngineCore._initialize_kv_caches（core.py:248）· 三步走完之后，运行期不再做任何显存规划，只做 block_id / ref_cnt 记账与按行读写" style="text;html=1;fontSize=13;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="100" y="68" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="i_s1" value="&lt;b&gt;① 收 spec（每卡）&lt;/b&gt;&#xa;ModelExecutor collective_rpc → GPUWorker&#xa;遍历本卡 16 个 attention 层 get_kv_cache_spec()&#xa;→ FullAttentionSpec(block_size=16,&#xa;num_kv_heads=4（TP2：8→4）, head_size=128)&#xa;产出 dict[layer, spec] 上交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="110" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="i_s2" value="&lt;b&gt;② 测显存 · 算 num_blocks（调度器统一）&lt;/b&gt;&#xa;determine_available_memory：profile_run 空跑实测&#xa;available = 总显存×util − 权重 − 激活 − CUDAGraph&#xa;get_kv_cache_configs（kv_cache_utils.py:2073）：&#xa;page_size = 2×16×4×128×2B = 32 KiB&#xa;num_blocks = 2 GiB ÷ 32 KiB ÷ 16 层 = 4096（min 对齐）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="580" y="110" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="i_s3" value="&lt;b&gt;③ 申请并绑定张量（每卡）&lt;/b&gt;&#xa;initialize_from_config → GPUModelRunner.initialize_kv_cache&#xa;int8 字节池按字节申请 → view+permute 零拷贝 reshape&#xa;kv_caches[layer] = (4096, 4, 16, 256) × 16 层&#xa;bind：block_id ⇋ 张量第 0 维行号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;strokeWidth=2;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="110" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="i_a1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="i_s1" target="i_s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="i_a2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="i_s2" target="i_s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
