                    <mxGeometry x="100" y="754" width="1400" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="r_n1" value="请求结束 · free&#xa;逆序归还 · ref_cnt--" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=middle;" parent="1" vertex="1">
